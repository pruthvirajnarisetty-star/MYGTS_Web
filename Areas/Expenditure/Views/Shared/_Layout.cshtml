</head>
<body class="preload app-body">
    <div class="exp-watermark"></div>

    <div class="app-shell" id="appShell">
        <!-- SIDEBAR -->
        <aside class="sidebar" id="sidebar" data-testid="app-sidebar">
            <script>
                if (localStorage.getItem('sidebar_collapsed') === 'true' && window.innerWidth > 780) {
                    document.getElementById('appShell').classList.add('collapsed-sidebar');
                    document.getElementById('sidebar').classList.add('collapsed');
                }
            </script>
            <div class="sidebar-header">
                <a class="brand-lockup" href="/Expenditure/Expenses" data-testid="brand-link" style="display: flex; align-items: center; text-decoration: none;">
                    <img src="/images/expenditure_logo.jpg" alt="MYGTS Shield Emblem" class="sidebar-brand-img" />
                    <span class="brand-text"><strong>MYGTS</strong><small>EXPENDITURE</small></span>
                </a>
                <button class="sidebar-toggle" id="sidebarToggle" type="button" aria-label="Toggle sidebar">
                    <svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M21 10H3M21 18H3M21 6H3M21 14H3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </button>
            </div>

            <!-- BRANCH SWITCHER -->
            <div class="branch-switcher-container" style="padding: 0 16px 14px 16px; position: relative;">
                <button id="branchSwitcherBtn" type="button" class="input" style="width: 100%; padding: 6px 12px; font-size: 0.85rem; font-weight: 800; border: 1px solid rgba(255,255,255,0.25); border-radius: 6px; background-color: rgba(2, 132, 199, 0.25); color: #fff; cursor: pointer; display: flex; justify-content: space-between; align-items: center; overflow: hidden;" title="Expenditure">
                    <span class="branch-full">EXPENDITURE</span>
                    <span class="branch-short">E</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="branch-chevron" style="opacity: 0.8;"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </button>
                <div id="branchSwitcherMenu" style="display: none; position: absolute; top: calc(100% - 6px); left: 16px; right: 16px; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 6px; box-shadow: 0 4px 16px rgba(0,0,0,0.25); overflow: hidden; z-index: 1000;">
                    @if (User.HasBranchAccess("DMG"))
                    {
                        <a href="/Dashboard/SwitchBranch?branch=DMG" class="branch-option" data-value="DMG" style="display: block; padding: 8px 12px; color: #0f172a; text-decoration: none; font-weight: 700; transition: background 0.15s; font-size: 0.85rem;">DMG</a>
                    }
                    @if (User.HasBranchAccess("RTO"))
                    {
                        <a href="/Dashboard/SwitchBranch?branch=RTO" class="branch-option" data-value="RTO" style="display: block; padding: 8px 12px; color: #0f172a; text-decoration: none; font-weight: 700; transition: background 0.15s; font-size: 0.85rem;">RTO</a>
                    }
                    @if (User.HasBranchAccess("Expenditure"))
                    {
                        <a href="/Dashboard/SwitchBranch?branch=Expenditure" class="branch-option selected" data-value="Expenditure" style="display: block; padding: 8px 12px; color: #ffffff; background: #0284c7; text-decoration: none; font-weight: 800; font-size: 0.85rem;">EXPENDITURE</a>
                    }
                </div>
            </div>

            <div class="sidebar-section-label">FINANCIAL WORKSPACE</div>
            <nav class="primary-nav" aria-label="Expenditure navigation">
                <a class="nav-link @(currentController == "Expenses" && currentAction != "Create" ? "active" : "")" href="/Expenditure/Expenses" title="Invoices & Proforma (PI) Records">
                    <span class="nav-icon">
                        <svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                            <polyline points="10 9 9 9 8 9"></polyline>
                        </svg>
                    </span>
                    <span class="nav-text">INVOICES & PIs</span>
                </a>

                <a class="nav-link @(currentController == "Transactions" ? "active" : "")" href="/Expenditure/Transactions" title="Customer Transactions from DMG & RTO">
                    <span class="nav-icon">
                        <svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="5" width="20" height="14" rx="2"/>
                            <line x1="2" y1="10" x2="22" y2="10"/>
                        </svg>
                    </span>
                    <span class="nav-text">BRANCH TRANSACTIONS</span>
                </a>

                <a class="nav-link @(currentController == "Credit" ? "active" : "")" href="/Expenditure/Credit" title="Company Credit Ledger">
                    <span class="nav-icon">
                        <svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                            <line x1="1" y1="10" x2="23" y2="10"></line>
                        </svg>
                    </span>
                    <span class="nav-text">COMPANY CREDITS</span>
                </a>

                <a class="nav-link @(currentController == "PreviousYears" ? "active" : "")" href="/Expenditure/PreviousYears" title="Previous Financial Years Archive">
                    <span class="nav-icon">
                        <svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 14 14"></polyline>
                            <path d="M4 12a8 8 0 0 1 14.93-4"></path>
                        </svg>
                    </span>
                    <span class="nav-text">PREVIOUS YEARS</span>
                </a>

                <a class="nav-link @(currentController == "Expenses" && currentAction == "Create" ? "active" : "")" href="/Expenditure/Expenses/Create" title="Add New Invoice / PI Entry">
                    <span class="nav-icon">
                        <svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"/>
                            <line x1="12" y1="8" x2="12" y2="16"/>
                            <line x1="8" y1="12" x2="16" y2="12"/>
                        </svg>
                    </span>
                    <span class="nav-text">ADD ENTRY</span>
                </a>

                @if (isAdmin)
                {
                    <div class="sidebar-section-label" style="margin-top: 20px;">SECURITY & ACCESS</div>
                    <a class="nav-link @(currentController == "Users" ? "active" : "")" href="/Expenditure/Users" title="Expenditure Users">
                        <span class="nav-icon">
                            <svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                <circle cx="9" cy="7" r="4"/>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                            </svg>
                        </span>
                        <span class="nav-text">USER MANAGEMENT</span>
                    </a>
                }

                <div class="sidebar-section-label" style="margin-top: 20px;">HELP & DOCS</div>
                @if (isAdmin)
                {
                    <a class="nav-link @(currentController == "Documents" && currentAction == "Src" ? "active" : "")" href="/Documents/Src?branch=Expenditure" title="System Requirements Specification (Admin Only)">
                        <span class="nav-icon">
                            <svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                <polyline points="14 2 14 8 20 8"/>
                                <line x1="16" y1="13" x2="8" y2="13"/>
                                <line x1="16" y1="17" x2="8" y2="17"/>
                                <polyline points="10 9 9 9 8 9"/>
                            </svg>
                        </span>
                        <span class="nav-text">SRC (SPEC)</span>
                    </a>
                }
                <a class="nav-link @(currentController == "Documents" && currentAction == "UserManual" ? "active" : "")" href="/Documents/UserManual?branch=Expenditure" title="Modular User Manual">
                    <span class="nav-icon">
                        <svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
                            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
                        </svg>
                    </span>
                    <span class="nav-text">USER MANUAL</span>
                </a>

                <div class="sidebar-section-label" style="margin-top: 20px;">BRANCH NAVIGATION</div>
                <a class="nav-link" href="/Account/Login" title="Switch Branch / Logout">
                    <span class="nav-icon">
                        <svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                            <polyline points="16 17 21 12 16 7"/>
                            <line x1="21" y1="12" x2="9" y2="12"/>
                        </svg>
                    </span>
                    <span class="nav-text">SWITCH BRANCH</span>
                </a>

                <a class="nav-link" href="/Account/Logout" title="Sign out of Expenditure">
                    <span class="nav-icon">
                        <svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18.36 6.64a9 9 0 1 1-12.73 0"/>
                            <line x1="12" y1="2" x2="12" y2="12"/>
                        </svg>
                    </span>
                    <span class="nav-text">LOGOUT</span>
                </a>
            </nav>

            <div class="sidebar-footnote">
                <span class="status-dot"></span>
                <span class="footnote-text"><strong>ISOLATED DATA</strong><small>EXPENDITURE_MYGTS.DB</small></span>
            </div>
        </aside>

        <!-- APP MAIN WRAPPER -->
        <div class="app-main">
            <!-- TOPBAR -->
            <header class="topbar">
                <button class="menu-toggle" type="button" id="mobileMenuToggle" aria-label="Toggle navigation">☰</button>
                <div class="topbar-context">
                    <span class="eyebrow">
                        <a href="/Expenditure/Expenses" style="text-decoration: none; color: inherit;">MYGTS</a>
                        <span> / </span>
                        <a href="/Expenditure/Expenses" style="text-decoration: none; color: inherit;">EXPENDITURE</a>
                        @if (!string.IsNullOrEmpty(currentAction) && currentAction != "Index")
                        {
                            <span> / </span>
                            <span>@currentAction</span>
                        }
                    </span>
                    <span class="topbar-title">@ViewData["Title"]</span>
                </div>
                <div class="topbar-actions" style="display: flex; align-items: center; gap: 12px;">
                    <!-- Theme Switcher -->
                    <label for="theme" class="theme" style="--bg: #fff; --transDur: 0.3s; --primary: #0284c7; --primaryT: #0369a1; font-size: 10px; margin: 0 4px; cursor: pointer;">
                        <span class="theme__toggle-wrap">
                            <input id="theme" class="theme__toggle" type="checkbox" role="switch" name="theme" value="dark">
                            <script>
                                if (localStorage.getItem('mygts_theme') === 'dark') {
                                    document.getElementById('theme').checked = true;
                                }
                                document.getElementById('theme').addEventListener('change', function() {
                                    localStorage.setItem('mygts_theme', this.checked ? 'dark' : 'light');
                                });
                            </script>
                            <span class="theme__fill"></span>
                            <span class="theme__icon">
                                <span class="theme__icon-part"></span>
                                <span class="theme__icon-part"></span>
                                <span class="theme__icon-part"></span>
                                <span class="theme__icon-part"></span>
                                <span class="theme__icon-part"></span>
                                <span class="theme__icon-part"></span>
                                <span class="theme__icon-part"></span>
                                <span class="theme__icon-part"></span>
                                <span class="theme__icon-part"></span>
                            </span>
                        </span>
                    </label>

                    <a href="/Expenditure/Expenses/Create" class="button btn-primary" style="display: inline-flex; align-items: center; gap: 6px; padding: 7px 14px; font-size: 0.82rem; font-weight: 800; border-radius: 6px; text-decoration: none;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                        <span>NEW ENTRY</span>
                    </a>

                    <div class="exp-user-pill">
                        <div class="exp-user-avatar">
                            @(userName.Length > 0 ? userName.Substring(0, 1).ToUpper() : "U")
                        </div>
                        <a href="/Users/Profile" class="exp-user-info" style="text-decoration: none; cursor: pointer;" title="View My Profile & Credentials">
                            <span class="exp-user-name">@userName</span>
                            <span class="exp-user-role">@userRole</span>
                        </a>
                        <a href="/Account/Logout" class="exp-logout-btn" title="Sign Out">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                                <polyline points="16 17 21 12 16 7"/>
                                <line x1="21" y1="12" x2="9" y2="12"/>
                            </svg>
                        </a>
                    </div>
                </div>
            </header>

            <main class="page-content" style="padding: 24px 32px 64px 32px; max-width: 1750px; margin: 0 auto; width: 100%; box-sizing: border-box; position: relative; z-index: 1;">
                @RenderBody()
            </main>
        </div>
    </div>

    <script>
        // SIDEBAR COLLAPSE TOGGLE (handled globally by site.js)
        const sidebar = document.getElementById('sidebar');
        const appShell = document.getElementById('appShell');

        // MOBILE TOGGLE
        const mobileMenuToggle = document.getElementById('mobileMenuToggle');
        if (mobileMenuToggle && sidebar) {
            mobileMenuToggle.addEventListener('click', function () {
                sidebar.classList.toggle('mobile-open');
            });
        }

        // BRANCH SWITCHER
        const branchBtn = document.getElementById('branchSwitcherBtn');
        const branchMenu = document.getElementById('branchSwitcherMenu');
        if (branchBtn && branchMenu) {
            branchBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                branchMenu.style.display = branchMenu.style.display === 'none' ? 'block' : 'none';
            });
            document.addEventListener('click', (e) => {
                if (!branchMenu.contains(e.target) && e.target !== branchBtn) {
                    branchMenu.style.display = 'none';
                }
            });
            document.querySelectorAll('.branch-option').forEach(opt => {
                opt.addEventListener('click', function (e) {
                    e.preventDefault();
                    const targetBranch = this.dataset.value || (this.innerText || '').trim();
                    document.cookie = "mygts_branch=" + encodeURIComponent(targetBranch) + ";path=/;max-age=31536000;SameSite=Lax";
                    if (branchMenu) branchMenu.style.display = 'none';
                    try {
                        if (window.sessionStorage) sessionStorage.clear();
                    } catch(e) {}
                    window.location.replace('/Dashboard/SwitchBranch?branch=' + encodeURIComponent(targetBranch));
                });
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        (function() {
            function checkTablePage() {
                if (document.querySelector('.table-wrap, .exp-table-container, .dsh-table-container, .credit-table-container, .vendors-table-card')) {
                    document.documentElement.classList.add('has-table-page');
                    document.body.classList.add('has-table-page');
                } else {
                    document.documentElement.classList.remove('has-table-page');
                    document.body.classList.remove('has-table-page');
                }
            }
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', checkTablePage);
            } else {
                checkTablePage();
            }
        })();
    </script>
</body>
</html>
