        }
        body:has(#theme:checked) .exp-page-btn {
            background: #1e293b !important;
            color: #cbd5e1 !important;
            border-color: #334155 !important;
        }
        body:has(#theme:checked) .exp-page-btn:hover {
            background: #273549 !important;
            color: #ffffff !important;
            border-color: #475569 !important;
        }
        body:has(#theme:checked) .row-pi {
            background-color: rgba(249, 115, 22, 0.12) !important;
        }
        body:has(#theme:checked) .row-pi:hover {
            background-color: rgba(249, 115, 22, 0.20) !important;
        }
        body:has(#theme:checked) .row-invoice {
            background-color: rgba(34, 197, 94, 0.10) !important;
        }
        body:has(#theme:checked) .row-invoice:hover {
            background-color: rgba(34, 197, 94, 0.18) !important;
        }
        body:has(#theme:checked) .row-receipt {
