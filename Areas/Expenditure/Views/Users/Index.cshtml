@model List<MygtsMvc.Models.ExpenditureUserRecord>
@{
    ViewData["Title"] = "USER MANAGEMENT";
    var activeCount = Model.Count(u => u.IsActive);
    var adminCount = Model.Count(u => string.Equals(u.Role, "ADMIN", StringComparison.OrdinalIgnoreCase));
}

<!-- PAGE HEADER -->
<div class="page-heading">
    <div>
        <div class="eyebrow">ADMINISTRATION / ACCESS CONTROL</div>
        <h1 style="font-size: 1.6rem; font-weight: 900; letter-spacing: -0.5px; margin: 2px 0 6px 0;">EXPENDITURE USERS</h1>
        <p style="color: var(--muted); font-size: 0.85rem; font-weight: 600; margin: 0;">
            MANAGE DEDICATED USER ACCOUNTS WITH EXCLUSIVE CREDENTIAL ACCESS TO THE EXPENDITURE BRANCH.
        </p>
    </div>
    <div class="page-heading-actions" style="display: flex; gap: 10px; align-items: center;">
        <a href="/Expenditure/Expenses" class="button btn-secondary" style="font-weight: 800; font-size: 0.82rem; padding: 8px 16px; text-decoration: none;">
            ← BACK TO BOOKKEEPING
        </a>
        <a href="/Expenditure/Users/Create" class="button btn-primary" style="font-weight: 800; font-size: 0.82rem; padding: 8px 18px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            <span>ADD USER</span>
        </a>
    </div>
</div>

<!-- STAT SUMMARY CARDS -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin: 20px 0;">
    <div class="card" style="padding: 18px 20px; border-left: 4px solid #0284c7; display: flex; align-items: center; justify-content: space-between;">
        <div>
            <div style="font-size: 0.72rem; font-weight: 800; color: var(--muted); letter-spacing: 0.5px;">TOTAL USERS</div>
            <div style="font-size: 1.6rem; font-weight: 900; color: var(--ink); margin-top: 4px;">@Model.Count</div>
            <div style="font-size: 0.70rem; font-weight: 700; color: #0284c7; margin-top: 2px;">CONFIGURED ACCOUNTS</div>
        </div>
        <div style="width: 44px; height: 44px; border-radius: 10px; background: rgba(2, 132, 199, 0.1); display: flex; align-items: center; justify-content: center; color: #0284c7;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
    </div>

    <div class="card" style="padding: 18px 20px; border-left: 4px solid #059669; display: flex; align-items: center; justify-content: space-between;">
        <div>
            <div style="font-size: 0.72rem; font-weight: 800; color: var(--muted); letter-spacing: 0.5px;">ACTIVE ACCOUNTS</div>
            <div style="font-size: 1.6rem; font-weight: 900; color: #059669; margin-top: 4px;">@activeCount</div>
            <div style="font-size: 0.70rem; font-weight: 700; color: #059669; margin-top: 2px;">LOGIN PERMITTED</div>
        </div>
        <div style="width: 44px; height: 44px; border-radius: 10px; background: rgba(5, 150, 105, 0.1); display: flex; align-items: center; justify-content: center; color: #059669;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
    </div>

    <div class="card" style="padding: 18px 20px; border-left: 4px solid #7c3aed; display: flex; align-items: center; justify-content: space-between;">
        <div>
            <div style="font-size: 0.72rem; font-weight: 800; color: var(--muted); letter-spacing: 0.5px;">ADMINISTRATORS</div>
            <div style="font-size: 1.6rem; font-weight: 900; color: #7c3aed; margin-top: 4px;">@adminCount</div>
            <div style="font-size: 0.70rem; font-weight: 700; color: #7c3aed; margin-top: 2px;">FULL ACCESS CONTROL</div>
        </div>
        <div style="width: 44px; height: 44px; border-radius: 10px; background: rgba(124, 58, 237, 0.1); display: flex; align-items: center; justify-content: center; color: #7c3aed;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        </div>
    </div>

    <div class="card" style="padding: 18px 20px; border-left: 4px solid #0f766e; display: flex; align-items: center; justify-content: space-between;">
        <div>
            <div style="font-size: 0.72rem; font-weight: 800; color: var(--muted); letter-spacing: 0.5px;">BRANCH DATABASE</div>
            <div style="font-size: 1.1rem; font-weight: 900; color: var(--ink); margin-top: 6px;">EXPENDITURE_MYGTS.DB</div>
            <div style="font-size: 0.70rem; font-weight: 700; color: #0f766e; margin-top: 2px;">STANDALONE SQLITE STORAGE</div>
        </div>
        <div style="width: 44px; height: 44px; border-radius: 10px; background: rgba(15, 118, 110, 0.1); display: flex; align-items: center; justify-content: center; color: #0f766e;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
        </div>
    </div>
</div>

<!-- USERS TABLE CARD -->
<style>
    #usersTable th, #usersTable td {
        text-align: center !important;
        vertical-align: middle !important;
    }
</style>
<div class="card" style="border-radius: 12px; overflow: hidden; box-shadow: 0 4px 16px rgba(0,0,0,0.04);">
    <div class="section-heading" style="padding: 16px 24px; border-bottom: 1px solid var(--line); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; background: #fafbfc;">
        <div>
            <h2 style="font-size: 1.1rem; font-weight: 900; color: var(--ink); margin: 0;">REGISTERED USERS</h2>
            <div style="font-size: 0.75rem; font-weight: 700; color: var(--muted); margin-top: 2px;">
                ONLY USERS IN THIS TABLE CAN SIGN IN TO THE EXPENDITURE BRANCH
            </div>
        </div>
        <div style="display: flex; align-items: center; gap: 10px;">
            <input type="text" id="userFilterInput" placeholder="SEARCH USERS, EMAIL, ROLE..." style="height: 36px; padding: 0 12px; border: 1px solid var(--line); border-radius: 6px; font-size: 0.8rem; font-weight: 600; min-width: 260px; outline: none; background: #ffffff;" />
        </div>
    </div>

    <div class="table-wrap" style="overflow-x: auto;">
        <table class="data-table" id="usersTable" style="width: 100%; border-collapse: collapse; text-align: center; vertical-align: middle;">
            <thead>
                <tr style="background: #f8fafc; border-bottom: 2px solid #e2e8f0;">
                    <th style="width: 120px; text-align: center; vertical-align: middle; padding: 12px 16px; font-weight: 800; font-size: 0.74rem; color: #475569;">ACTIONS</th>
                    <th style="text-align: center; vertical-align: middle; padding: 12px 16px; font-weight: 800; font-size: 0.74rem; color: #475569;">DISPLAY NAME / PROFILE</th>
                    <th style="text-align: center; vertical-align: middle; padding: 12px 16px; font-weight: 800; font-size: 0.74rem; color: #475569;">USERNAME / EMAIL</th>
                    <th style="text-align: center; vertical-align: middle; padding: 12px 16px; font-weight: 800; font-size: 0.74rem; color: #475569;">PLAIN PASSWORD</th>
                    <th style="text-align: center; vertical-align: middle; padding: 12px 16px; font-weight: 800; font-size: 0.74rem; color: #475569;">ROLE</th>
                    <th style="text-align: center; vertical-align: middle; padding: 12px 16px; font-weight: 800; font-size: 0.74rem; color: #475569;">ACCOUNT STATUS</th>
                    <th style="text-align: center; vertical-align: middle; padding: 12px 16px; font-weight: 800; font-size: 0.74rem; color: #475569;">CREATED AT</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    var isAdm = string.Equals(u.Role, "ADMIN", StringComparison.OrdinalIgnoreCase);
                    var initial = string.IsNullOrWhiteSpace(u.DisplayName) ? "U" : u.DisplayName.Substring(0, 1).ToUpper();

                    <tr style="border-bottom: 1px solid #f1f5f9; transition: background 0.15s ease;">
                        <td style="text-align: center; vertical-align: middle; padding: 12px 16px;">
                            <div style="display: inline-flex; align-items: center; justify-content: center; gap: 6px;">
                                <a href="/Expenditure/Users/Edit/@u.Id" class="button btn-secondary" style="font-size: 0.72rem; font-weight: 800; padding: 4px 10px; border-radius: 4px; text-decoration: none; border: 1px solid #cbd5e1;">
                                    EDIT
                                </a>
                                @if (Model.Count > 1)
                                {
                                    <form method="post" action="/Expenditure/Users/Delete" style="display: inline; margin: 0;" onsubmit="return confirm('ARE YOU SURE YOU WANT TO DELETE USER @u.Email?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@u.Id" />
                                        <button type="submit" class="button" style="font-size: 0.72rem; font-weight: 800; padding: 4px 8px; border-radius: 4px; background: #fee2e2; color: #b91c1c; border: 1px solid #fecaca; cursor: pointer;">
                                            DEL
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                        <td style="text-align: center; vertical-align: middle; padding: 12px 16px;">
                            <div style="display: inline-flex; align-items: center; justify-content: center; gap: 12px; text-align: left;">
                                <div style="width: 36px; height: 36px; border-radius: 50%; background: @(isAdm ? "linear-gradient(135deg, #7c3aed, #4c1d95)" : "linear-gradient(135deg, #0284c7, #0369a1)"); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 900; font-size: 0.88rem; flex-shrink: 0; box-shadow: 0 2px 6px rgba(0,0,0,0.15);">
                                    @initial
                                </div>
                                <div>
                                    <div style="font-weight: 800; color: #0f172a; font-size: 0.88rem;">@u.DisplayName</div>
                                    <div style="font-size: 0.72rem; color: #64748b; font-weight: 600;">@u.Email</div>
                                </div>
                            </div>
                        </td>
                        <td style="text-align: center; vertical-align: middle; padding: 12px 16px; font-weight: 700; color: #334155;">
                            @u.Email
                        </td>
                        <td style="text-align: center; vertical-align: middle; padding: 12px 16px; font-family: monospace; font-size: 0.82rem; font-weight: 800; color: #0f172a;">
                            @u.PlainPassword
                        </td>
                        <td style="text-align: center; vertical-align: middle; padding: 12px 16px;">
                            @if (isAdm)
                            {
                                <span style="background: #ede9fe; color: #6d28d9; border: 1px solid #ddd6fe; font-size: 0.72rem; font-weight: 900; padding: 3px 10px; border-radius: 999px; letter-spacing: 0.5px; display: inline-block;">ADMIN</span>
                            }
                            else
                            {
                                <span style="background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; font-size: 0.72rem; font-weight: 800; padding: 3px 10px; border-radius: 999px; letter-spacing: 0.5px; display: inline-block;">USER</span>
                            }
                        </td>
                        <td style="text-align: center; vertical-align: middle; padding: 12px 16px;">
                            @if (u.IsActive)
                            {
                                <span style="display: inline-flex; align-items: center; justify-content: center; gap: 6px; background: #dcfce7; color: #15803d; border: 1px solid #bbf7d0; font-size: 0.72rem; font-weight: 800; padding: 3px 10px; border-radius: 999px;">
                                    <span style="width: 6px; height: 6px; border-radius: 50%; background: #16a34a;"></span>
                                    ACTIVE
                                </span>
                            }
                            else
                            {
                                <span style="display: inline-flex; align-items: center; justify-content: center; gap: 6px; background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; font-size: 0.72rem; font-weight: 800; padding: 3px 10px; border-radius: 999px;">
                                    <span style="width: 6px; height: 6px; border-radius: 50%; background: #dc2626;"></span>
                                    INACTIVE
                                </span>
                            }
                        </td>
                        <td style="text-align: center; vertical-align: middle; padding: 12px 16px; font-size: 0.78rem; font-weight: 700; color: #64748b;">
                            @u.CreatedAt
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    // INSTANT TABLE SEARCH
    document.getElementById('userFilterInput')?.addEventListener('input', function(e) {
        var term = e.target.value.toLowerCase();
        var rows = document.querySelectorAll('#usersTable tbody tr');
        rows.forEach(function(row) {
            var text = row.innerText.toLowerCase();
            row.style.display = text.indexOf(term) > -1 ? '' : 'none';
        });
    });
</script>
