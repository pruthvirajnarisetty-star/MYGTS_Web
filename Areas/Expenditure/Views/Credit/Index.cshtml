@model MygtsMvc.Models.ExpenditureCreditsViewModel
@{
    ViewData["Title"] = "COMPANY CREDITS";
}

<style>
    /* PAGE SPECIFIC STYLES */
    .credit-metric-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(260px, 1fr));
        gap: 16px;
        margin-bottom: 24px;
    }

    @@media (max-width: 1024px) {
        .credit-metric-grid {
            grid-template-columns: 1fr;
        }
    }

    .credit-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 20px 22px;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.04);
        position: relative;
        overflow: hidden;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .credit-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.07);
    }

    .credit-card-glow-blue {
        border-top: 4px solid #0284c7;
    }

    .credit-card-glow-purple {
        border-top: 4px solid #8b5cf6;
    }

    .credit-card-glow-emerald {
        border-top: 4px solid #10b981;
    }

    .credit-metric-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 8px;
    }

    .credit-metric-title {
        font-size: 0.74rem;
        font-weight: 800;
        color: #64748b;
        letter-spacing: 0.8px;
        text-transform: uppercase;
    }

    .credit-metric-value {
        font-size: 1.85rem;
        font-weight: 900;
        letter-spacing: -0.5px;
        color: #0f172a;
        margin-bottom: 8px;
    }

    .credit-metric-subtext {
        font-size: 0.74rem;
        font-weight: 700;
        color: #64748b;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
    }

    .credit-pill {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 2px 7px;
        border-radius: 6px;
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 0.4px;
    }

    .credit-pill-red {
        background: #fef2f2;
        color: #dc2626;
        border: 1px solid #fecaca;
    }

    .credit-pill-green {
        background: #ecfdf5;
        color: #059669;
        border: 1px solid #a7f3d0;
    }

    .credit-pill-blue {
        background: #f0f9ff;
        color: #0284c7;
        border: 1px solid #bae6fd;
    }

    .credit-pill-purple {
        background: #faf5ff;
        color: #7c3aed;
        border: 1px solid #e9d5ff;
    }

    .credit-progress-track {
        width: 100%;
        height: 6px;
        background: #f1f5f9;
        border-radius: 999px;
        overflow: hidden;
        margin-top: 12px;
    }

    .credit-progress-bar {
        height: 100%;
        border-radius: 999px;
    }

    /* REVERSED LAYOUT: TABLE ON LEFT, FORM ON RIGHT */
    .credit-layout-grid {
        display: grid;
        grid-template-columns: 1fr 380px;
        gap: 22px;
        align-items: start;
    }

    @@media (max-width: 1180px) {
        .credit-layout-grid {
            grid-template-columns: 1fr;
        }
    }

    /* COMPLETE STYLES FOR THE CREDIT TABLE CARD */
    .credit-table-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
        overflow: hidden;
    }

    .credit-table-header {
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        padding: 14px 18px;
    }

    .credit-filter-row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
        margin-top: 10px;
    }

    .credit-filter-group {
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .credit-filter-label {
        font-size: 0.70rem;
        font-weight: 800;
        color: #64748b;
        letter-spacing: 0.5px;
        white-space: nowrap;
    }

    .credit-filter-input {
        height: 34px;
        padding: 0 10px;
        font-size: 0.78rem;
        font-weight: 700;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        background: #ffffff;
        color: #0f172a;
        outline: none;
        transition: all 0.15s ease;
    }

    .credit-filter-input:focus {
        border-color: #0284c7;
        box-shadow: 0 0 0 2px rgba(2, 132, 199, 0.15);
    }

    .credit-table-container {
        overflow-x: auto;
        width: 100%;
        background: #ffffff;
    }

    .credit-data-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.82rem;
        text-align: left;
    }

    .credit-data-table thead th {
        background: #f8fafc;
        color: #475569;
        font-size: 0.71rem;
        font-weight: 800;
        letter-spacing: 0.6px;
        text-transform: uppercase;
        border-bottom: 2px solid #e2e8f0;
        padding: 12px 14px;
        white-space: nowrap;
    }

    .credit-data-table tbody td {
        padding: 12px 14px;
        border-bottom: 1px solid #f1f5f9;
        color: #1e293b;
        vertical-align: middle;
    }

    .credit-data-table tbody tr:hover {
        background: #f8fafc;
    }

    .credit-data-table tfoot td {
        background: #f8fafc;
        padding: 12px 14px;
        font-weight: 800;
        border-top: 2px solid #cbd5e1;
        color: #0f172a;
    }

    /* BADGES */
    .credit-dir-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 3px 8px;
        border-radius: 6px;
        font-size: 0.69rem;
        font-weight: 800;
        letter-spacing: 0.4px;
        white-space: nowrap;
    }

    .credit-dir-to-us {
        background: #f0f9ff;
        color: #0369a1;
        border: 1px solid #bae6fd;
    }

    .credit-dir-by-us {
        background: #faf5ff;
        color: #6b21a8;
        border: 1px solid #e9d5ff;
    }

    .credit-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 3px 8px;
        border-radius: 6px;
        font-size: 0.69rem;
        font-weight: 800;
        letter-spacing: 0.4px;
        white-space: nowrap;
    }

    .credit-status-paid {
        background: #ecfdf5;
        color: #065f46;
        border: 1px solid #a7f3d0;
    }

    .credit-status-open {
        background: #fffbeb;
        color: #b45309;
        border: 1px solid #fde68a;
    }

    /* ACTION BUTTONS */
    .credit-action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
        padding: 4px 8px;
        font-size: 0.72rem;
        font-weight: 800;
        border-radius: 5px;
        border: 1px solid transparent;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.12s ease;
        line-height: 1.2;
    }

    .credit-action-btn-settle {
        background: #ecfdf5;
        color: #065f46;
        border-color: #a7f3d0;
    }

    .credit-action-btn-settle:hover {
        background: #d1fae5;
    }

    .credit-action-btn-reopen {
        background: #f1f5f9;
        color: #475569;
        border-color: #cbd5e1;
    }

    .credit-action-btn-reopen:hover {
        background: #e2e8f0;
    }

    .credit-action-btn-edit {
        background: #f0f9ff;
        color: #0369a1;
        border-color: #bae6fd;
    }

    .credit-action-btn-edit:hover {
        background: #e0f2fe;
    }

    .credit-action-btn-del {
        background: #fef2f2;
        color: #991b1b;
        border-color: #fecaca;
    }

    .credit-action-btn-del:hover {
        background: #fee2e2;
    }

    /* FORM CARD STYLING */
    .credit-form-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 22px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
        position: sticky;
        top: 20px;
    }

    .credit-form-title {
        font-size: 0.95rem;
        font-weight: 900;
        color: #0f172a;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .credit-direction-selector {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
        margin-bottom: 14px;
        background: #f1f5f9;
        padding: 4px;
        border-radius: 8px;
    }

    .credit-direction-option {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        font-size: 0.72rem;
        font-weight: 800;
        padding: 8px 6px;
        border-radius: 6px;
        cursor: pointer;
        user-select: none;
        transition: all 0.15s ease;
        color: #64748b;
        background: transparent;
        border: 1px solid transparent;
    }

    .credit-direction-option:hover {
        color: #0f172a;
    }

    .credit-direction-option.selected.to-us {
        background: #ffffff;
        color: #0284c7;
        border-color: #bae6fd;
        box-shadow: 0 2px 5px rgba(0,0,0,0.06);
    }

    .credit-direction-option.selected.by-us {
        background: #ffffff;
        color: #7c3aed;
        border-color: #e9d5ff;
        box-shadow: 0 2px 5px rgba(0,0,0,0.06);
    }

    .credit-input-group {
        margin-bottom: 13px;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .credit-input-label {
        font-size: 0.72rem;
        font-weight: 800;
        color: #475569;
        letter-spacing: 0.5px;
    }

    .credit-input {
        height: 38px;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        padding: 0 12px;
        font-size: 0.85rem;
        font-weight: 700;
        background: #f8fafc;
        color: #0f172a;
        outline: none;
        transition: all 0.15s ease;
    }

    .credit-input:focus {
        border-color: #0284c7;
        background: #ffffff;
        box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.15);
    }

    .credit-textarea {
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        padding: 8px 12px;
        font-size: 0.85rem;
        font-weight: 600;
        background: #f8fafc;
        color: #0f172a;
        outline: none;
        resize: vertical;
        min-height: 56px;
        transition: all 0.15s ease;
    }

    .credit-textarea:focus {
        border-color: #0284c7;
        background: #ffffff;
        box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.15);
    }

    .credit-btn-submit {
        height: 42px;
        width: 100%;
        background: #0284c7;
        color: #ffffff;
        border: none;
        border-radius: 6px;
        font-size: 0.84rem;
        font-weight: 800;
        cursor: pointer;
        transition: background 0.15s;
        margin-top: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .credit-btn-submit:hover {
        background: #0369a1;
    }

    /* MODAL */
    .credit-modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.55);
        z-index: 1050;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(2px);
    }

    .credit-modal.open {
        display: flex;
    }

    .credit-modal-content {
        background: #ffffff;
        border-radius: 12px;
        width: 100%;
        max-width: 480px;
        padding: 24px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    }
</style>

<!-- TOP NAVIGATION TABS -->
<div class="exp-nav-tabs">
    <a href="/Expenditure/Expenses" class="exp-tab">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
        <span>INVOICES & PROFORMA (PI)</span>
    </a>
    <a href="/Expenditure/Transactions" class="exp-tab">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
        <span>BRANCH TRANSACTIONS (DMG & RTO)</span>
        <span class="exp-tab-badge">LIVE SYNC</span>
    </a>
    <a href="/Expenditure/Credit" class="exp-tab active">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
        <span>COMPANY CREDITS</span>
        <span class="exp-tab-badge" style="background: rgba(255,255,255,0.25);">@Model.Credits.Count LINES</span>
    </a>
    <a href="/Expenditure/PreviousYears" class="exp-tab">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 14 14"></polyline><path d="M4 12a8 8 0 0 1 14.93-4"></path></svg>
        <span>PREVIOUS FINANCIAL YEARS</span>
    </a>
</div>

<!-- PAGE HEADING -->
<div class="page-heading">
    <div>
        <div class="eyebrow">FINANCIAL MANAGEMENT & CREDIT LEDGER</div>
        <h1 style="font-size: 1.65rem; font-weight: 900; letter-spacing: -0.5px; margin: 2px 0 4px 0;">COMPANY CREDITS</h1>
        <p style="color: var(--muted); font-size: 0.85rem; font-weight: 600; margin: 0;">
            TRACK CREDIT GIVEN TO US (LIABILITIES) AND CREDIT GIVEN BY US (RECEIVABLES), INCLUDING FULL SETTLEMENT STATUS.
        </p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div style="background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 8px; padding: 12px 18px; margin-bottom: 20px; font-weight: 800; font-size: 0.85rem; color: #065f46; display: flex; align-items: center; gap: 8px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
        <span>@TempData["SuccessMessage"]</span>
    </div>
}

<!-- 3 GRAPHICAL METRIC CARDS -->
<div class="credit-metric-grid">
    <!-- CARD 1: CREDIT GIVEN TO US (WE OWE) -->
    <div class="credit-card credit-card-glow-blue">
        <div class="credit-metric-header">
            <div class="credit-metric-title">CREDIT GIVEN TO US (WE OWE)</div>
            <span class="kpi-pill kpi-pill-blue">LIABILITY</span>
        </div>
        <div class="credit-metric-value" style="color: #0284c7;">
            ₹@Model.TotalGivenToUs.ToString("N2")
        </div>
        <div class="credit-metric-subtext">
            <span class="credit-pill credit-pill-red">OUTSTANDING: ₹@Model.OutstandingGivenToUs.ToString("N2")</span>
            <span class="credit-pill credit-pill-green">PAID OFF: ₹@Model.PaidOffGivenToUs.ToString("N2")</span>
            <span>(@Model.CountGivenToUs LINES)</span>
        </div>
        <div class="credit-progress-track">
            @{
                var pctToUs = Model.TotalGivenToUs > 0 ? (int)((Model.PaidOffGivenToUs / Model.TotalGivenToUs) * 100) : 0;
            }
            <div class="credit-progress-bar" style="width: @pctToUs%; background: linear-gradient(90deg, #0284c7, #38bdf8);" title="@pctToUs% Paid Off"></div>
        </div>
    </div>

    <!-- CARD 2: CREDIT GIVEN BY US (THEY OWE US) -->
    <div class="credit-card credit-card-glow-purple">
        <div class="credit-metric-header">
            <div class="credit-metric-title">CREDIT GIVEN BY US (THEY OWE)</div>
            <span class="kpi-pill kpi-pill-indigo" style="background:#faf5ff; color:#7c3aed; border-color:#e9d5ff;">RECEIVABLE</span>
        </div>
        <div class="credit-metric-value" style="color: #7c3aed;">
            ₹@Model.TotalGivenByUs.ToString("N2")
        </div>
        <div class="credit-metric-subtext">
            <span class="credit-pill credit-pill-red">PENDING: ₹@Model.OutstandingGivenByUs.ToString("N2")</span>
            <span class="credit-pill credit-pill-green">COLLECTED: ₹@Model.PaidOffGivenByUs.ToString("N2")</span>
            <span>(@Model.CountGivenByUs LINES)</span>
        </div>
        <div class="credit-progress-track">
            @{
                var pctByUs = Model.TotalGivenByUs > 0 ? (int)((Model.PaidOffGivenByUs / Model.TotalGivenByUs) * 100) : 0;
            }
            <div class="credit-progress-bar" style="width: @pctByUs%; background: linear-gradient(90deg, #7c3aed, #a855f7);" title="@pctByUs% Collected"></div>
        </div>
    </div>

    <!-- CARD 3: TOTAL OUTSTANDING & SETTLEMENT STATS -->
    <div class="credit-card credit-card-glow-emerald">
        <div class="credit-metric-header">
            <div class="credit-metric-title">TOTAL OUTSTANDING BALANCE</div>
            <span class="kpi-pill kpi-pill-emerald">NET POSITION</span>
        </div>
        <div class="credit-metric-value" style="color: #0f172a;">
            ₹@Model.TotalOutstandingAmount.ToString("N2")
        </div>
        <div class="credit-metric-subtext">
            <span class="credit-pill credit-pill-green">TOTAL CLEARED: ₹@Model.TotalPaidOffAmount.ToString("N2")</span>
            <span>@Model.TotalCompaniesCount PARTIES</span>
            <span>(@Model.TotalCreditLines TOTAL ENTRIES)</span>
        </div>
        <div class="credit-progress-track">
            @{
                var pctAll = Model.TotalCreditAmount > 0 ? (int)((Model.TotalPaidOffAmount / Model.TotalCreditAmount) * 100) : 0;
            }
            <div class="credit-progress-bar" style="width: @pctAll%; background: linear-gradient(90deg, #10b981, #34d399);" title="@pctAll% Overall Cleared"></div>
        </div>
    </div>
</div>

<!-- MAIN LAYOUT: DATA TABLE ON LEFT + ADD FORM ON RIGHT -->
<div class="credit-layout-grid">
    <!-- 1. LEFT COLUMN: DATA TABLE CARD -->
    <div class="credit-table-card">
        <!-- HEADER & COMPREHENSIVE FILTER TOOLBAR -->
        <div class="credit-table-header">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
                <div style="font-weight: 900; color: #0f172a; font-size: 0.95rem; display: flex; align-items: center; gap: 8px;">
                    <span>CREDIT LEDGER</span>
                    <span class="credit-pill credit-pill-blue">@Model.Credits.Count ENTRIES</span>
                    @if (!string.IsNullOrEmpty(Model.SearchQuery) || Model.StatusFilter != "ALL" || Model.DirectionFilter != "ALL" || !string.IsNullOrEmpty(Model.FromDate) || !string.IsNullOrEmpty(Model.ToDate))
                    {
                        <span style="font-size: 0.72rem; color: #0284c7; font-weight: 700;">(FILTERED)</span>
                    }
                </div>
            </div>

            <!-- FILTER FORM -->
            <form method="get" action="/Expenditure/Credit" class="credit-filter-row">
                <!-- SEARCH -->
                <div class="credit-filter-group">
                    <label class="credit-filter-label">SEARCH</label>
                    <input type="text" name="q" value="@Model.SearchQuery" placeholder="PARTY, NOTES, AMOUNT..." class="credit-filter-input" style="width: 175px;" />
                </div>

                <!-- DIRECTION -->
                <div class="credit-filter-group">
                    <label class="credit-filter-label">DIRECTION</label>
                    <select name="dir" class="credit-filter-input" style="width: 135px;">
                        <option value="ALL" selected="@(Model.DirectionFilter == "ALL")">ALL DIRECTIONS</option>
                        <option value="GIVEN_TO_US" selected="@(Model.DirectionFilter == "GIVEN_TO_US")">↓ GIVEN TO US</option>
                        <option value="GIVEN_BY_US" selected="@(Model.DirectionFilter == "GIVEN_BY_US")">↑ GIVEN BY US</option>
                    </select>
                </div>

                <!-- STATUS -->
                <div class="credit-filter-group">
                    <label class="credit-filter-label">STATUS</label>
                    <select name="status" class="credit-filter-input" style="width: 130px;">
                        <option value="ALL" selected="@(Model.StatusFilter == "ALL")">ALL STATUSES</option>
                        <option value="OUTSTANDING" selected="@(Model.StatusFilter == "OUTSTANDING")">⏳ OUTSTANDING</option>
                        <option value="PAID_OFF" selected="@(Model.StatusFilter == "PAID_OFF")">✓ PAID OFF</option>
                    </select>
                </div>

                <!-- DATE RANGE: FROM -->
                <div class="credit-filter-group">
                    <label class="credit-filter-label">FROM</label>
                    <input type="date" name="fromDate" value="@Model.FromDate" class="credit-filter-input" style="width: 130px;" />
                </div>

                <!-- DATE RANGE: TO -->
                <div class="credit-filter-group">
                    <label class="credit-filter-label">TO</label>
                    <input type="date" name="toDate" value="@Model.ToDate" class="credit-filter-input" style="width: 130px;" />
                </div>

                <!-- BUTTONS -->
                <button type="submit" class="button btn-primary" style="height: 34px; padding: 0 14px; font-size: 0.78rem; font-weight: 800;">
                    FILTER
                </button>
                @if (!string.IsNullOrEmpty(Model.SearchQuery) || Model.StatusFilter != "ALL" || Model.DirectionFilter != "ALL" || !string.IsNullOrEmpty(Model.FromDate) || !string.IsNullOrEmpty(Model.ToDate))
                {
                    <a href="/Expenditure/Credit" class="button btn-secondary" style="height: 34px; padding: 0 10px; font-size: 0.78rem; font-weight: 800; display: inline-flex; align-items: center; text-decoration: none;">
                        CLEAR
                    </a>
                }
            </form>
        </div>

        <!-- TABLE CONTAINER -->
        <div class="credit-table-container">
            <table class="credit-data-table">
                <thead>
                    <tr>
                        <th style="width: 130px; text-align: center;">ACTIONS</th>
                        <th style="width: 110px; text-align: center;">STATUS</th>
                        <th style="width: 125px; text-align: center;">DIRECTION</th>
                        <th>COMPANY / PARTY</th>
                        <th style="text-align: right;">AMOUNT (₹)</th>
                        <th style="width: 100px;">DATE</th>
                        <th>DESCRIPTION / PURPOSE</th>
                        <th>NOTES</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Credits.Count == 0)
                    {
                        <tr>
                            <td colspan="8" style="text-align: center; padding: 48px 16px; color: #64748b;">
                                <div style="font-size: 1.1rem; font-weight: 800; color: #0f172a;">NO CREDIT ENTRIES FOUND</div>
                                <div style="font-size: 0.82rem; margin-top: 6px;">USE THE FORM ON THE RIGHT TO RECORD NEW CREDIT ENTRIES.</div>
                            </td>
                        </tr>
                    }
                    @foreach (var c in Model.Credits)
                    {
                        <tr style="@(c.IsPaidOff ? "background: #fcfdfd;" : "")">
                            <!-- ACTIONS -->
                            <td style="text-align: center; white-space: nowrap;">
                                <div style="display: inline-flex; gap: 4px; align-items: center;">
                                    <!-- ONE-CLICK TOGGLE STATUS -->
                                    <form method="post" action="/Expenditure/Credit/ToggleStatus" style="display: inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@c.Id" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                        @if (c.IsPaidOff)
                                        {
                                            <button type="submit" class="credit-action-btn credit-action-btn-reopen" title="Mark as Outstanding / Not Paid Off">
                                                ↺ REOPEN
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="credit-action-btn credit-action-btn-settle" title="Mark as Paid Off / Settled">
                                                ✓ SETTLE
                                            </button>
                                        }
                                    </form>

                                    <!-- EDIT MODAL TRIGGER -->
                                    <button type="button" class="credit-action-btn credit-action-btn-edit" 
                                            onclick="openEditModal('@c.Id', '@c.CompanyName', '@c.CreditAmount', '@c.CreditType', @(c.IsPaidOff ? "true" : "false"), '@(c.PaidOffDate ?? "")', '@c.Date', '@(c.Description ?? "")', '@(c.Notes ?? "")')"
                                            title="Edit Details">
                                        EDIT
                                    </button>

                                    <!-- DELETE -->
                                    <form method="post" action="/Expenditure/Credit/Delete" style="display: inline;" onsubmit="return confirm('DELETE CREDIT ENTRY FOR @c.CompanyName?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@c.Id" />
                                        <button type="submit" class="credit-action-btn credit-action-btn-del" title="Delete">
                                            DEL
                                        </button>
                                    </form>
                                </div>
                            </td>

                            <!-- STATUS -->
                            <td style="text-align: center; white-space: nowrap;">
                                @if (c.IsPaidOff)
                                {
                                    <span class="credit-status-badge credit-status-paid" title="Paid Off / Settled">
                                        ✓ PAID OFF
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(c.PaidOffDate))
                                    {
                                        <div style="font-size: 0.65rem; color: #059669; font-weight: 700; margin-top: 2px;">
                                            @c.PaidOffDate
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span class="credit-status-badge credit-status-open" title="Outstanding / Active">
                                        ⏳ OUTSTANDING
                                    </span>
                                }
                            </td>

                            <!-- DIRECTION -->
                            <td style="text-align: center; white-space: nowrap;">
                                @if (c.IsGivenToUs)
                                {
                                    <span class="credit-dir-badge credit-dir-to-us" title="Given to Us (We Owe Vendor)">
                                        ↓ GIVEN TO US
                                    </span>
                                }
                                else
                                {
                                    <span class="credit-dir-badge credit-dir-by-us" title="Given by Us (Customer Owes Us)">
                                        ↑ GIVEN BY US
                                    </span>
                                }
                            </td>

                            <!-- COMPANY / PARTY -->
                            <td style="font-weight: 800; color: #0f172a; font-size: 0.88rem;">
                                @c.CompanyName
                            </td>

                            <!-- CREDIT AMOUNT -->
                            <td style="text-align: right; font-weight: 900; font-size: 0.95rem; color: @(c.IsGivenToUs ? "#0284c7" : "#7c3aed"); white-space: nowrap;">
                                ₹@c.CreditAmount.ToString("N2")
                            </td>

                            <!-- DATE -->
                            <td style="font-weight: 700; font-size: 0.80rem; white-space: nowrap; color: #475569;">
                                @c.Date
                            </td>

                            <!-- DESCRIPTION -->
                            <td style="font-weight: 600; font-size: 0.82rem; max-width: 180px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                @(string.IsNullOrWhiteSpace(c.Description) ? "—" : c.Description)
                            </td>

                            <!-- NOTES -->
                            <td style="color: #64748b; font-size: 0.78rem; max-width: 160px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                @(string.IsNullOrWhiteSpace(c.Notes) ? "—" : c.Notes)
                            </td>
                        </tr>
                    }
                </tbody>
                @if (Model.Credits.Count > 0)
                {
                    <tfoot>
                        <tr>
                            <td colspan="4" style="text-align: right; letter-spacing: 0.5px;">
                                FILTERED TOTAL (@Model.Credits.Count ENTRIES):
                            </td>
                            <td style="text-align: right; font-size: 1.05rem; font-weight: 900; color: #0f172a; white-space: nowrap;">
                                ₹@Model.FilteredTotalAmount.ToString("N2")
                            </td>
                            <td colspan="3" style="font-size: 0.75rem; color: #64748b;">
                                (OUTSTANDING: ₹@Model.FilteredOutstandingAmount.ToString("N2") | PAID OFF: ₹@Model.FilteredPaidOffAmount.ToString("N2"))
                            </td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>

    <!-- 2. RIGHT COLUMN: ADD NEW CREDIT FORM -->
    <div class="credit-form-card">
        <div class="credit-form-title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
            <span>ADD NEW CREDIT</span>
        </div>

        <form method="post" action="/Expenditure/Credit/Create">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="field-validation-error" style="margin-bottom: 12px;"></div>

            <!-- CREDIT DIRECTION (TOGGLE BUTTONS) -->
            <input type="hidden" asp-for="FormModel.CreditType" id="createCreditTypeInput" value="GIVEN_TO_US" />
            <div class="credit-input-group">
                <label class="credit-input-label">CREDIT DIRECTION *</label>
                <div class="credit-direction-selector">
                    <div id="btnDirToUs" class="credit-direction-option selected to-us" onclick="selectFormDirection('GIVEN_TO_US')">
                        <span>↓ GIVEN TO US</span>
                        <span style="font-size: 0.65rem; font-weight: 600; opacity: 0.85;">(WE OWE THEM)</span>
                    </div>
                    <div id="btnDirByUs" class="credit-direction-option" onclick="selectFormDirection('GIVEN_BY_US')">
                        <span>↑ GIVEN BY US</span>
                        <span style="font-size: 0.65rem; font-weight: 600; opacity: 0.85;">(THEY OWE US)</span>
                    </div>
                </div>
            </div>

            <!-- COMPANY / PARTY NAME -->
            <div class="credit-input-group">
                <label class="credit-input-label" id="lblCompanyName">COMPANY / PARTY NAME *</label>
                <input type="text" asp-for="FormModel.CompanyName" placeholder="E.G. TAISYS / VENDOR / CLIENT" class="credit-input" required />
                <span asp-validation-for="FormModel.CompanyName" class="field-validation-error"></span>
            </div>

            <!-- CREDIT AMOUNT -->
            <div class="credit-input-group">
                <label class="credit-input-label" id="lblCreditAmount">CREDIT AMOUNT (₹) *</label>
                <input type="number" step="0.01" asp-for="FormModel.CreditAmount" placeholder="E.G. 50000.00" class="credit-input" required />
                <span asp-validation-for="FormModel.CreditAmount" class="field-validation-error"></span>
            </div>

            <!-- DATE -->
            <div class="credit-input-group">
                <label class="credit-input-label">RECORD DATE</label>
                <input type="date" asp-for="FormModel.Date" class="credit-input" />
                <span asp-validation-for="FormModel.Date" class="field-validation-error"></span>
            </div>

            <!-- PAID OFF / SETTLED STATUS -->
            <div class="credit-input-group" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 10px 12px; margin-top: 4px;">
                <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; user-select: none; margin: 0; font-size: 0.76rem; font-weight: 800; color: #0f172a;">
                    <input type="checkbox" asp-for="FormModel.IsPaidOff" id="createIsPaidOff" onchange="togglePaidOffDateInput('create')" style="width: 16px; height: 16px; accent-color: #10b981;" />
                    <span>ALREADY PAID OFF / SETTLED</span>
                </label>
                <div id="createPaidOffDateContainer" style="display: none; margin-top: 8px;">
                    <label class="credit-input-label" style="font-size: 0.68rem;">SETTLED / PAID OFF DATE</label>
                    <input type="date" asp-for="FormModel.PaidOffDate" id="createPaidOffDate" class="credit-input" style="height: 34px;" />
                </div>
            </div>

            <!-- DESCRIPTION -->
            <div class="credit-input-group">
                <label class="credit-input-label">DESCRIPTION / PURPOSE</label>
                <input type="text" asp-for="FormModel.Description" placeholder="E.G. 90-DAY CREDIT LINE OR ADVANCE" class="credit-input" />
            </div>

            <!-- NOTES -->
            <div class="credit-input-group">
                <label class="credit-input-label">NOTES / REMARKS</label>
                <textarea asp-for="FormModel.Notes" placeholder="ADDITIONAL TERMS, DUES OR AGREEMENT..." class="credit-textarea"></textarea>
            </div>

            <button type="submit" class="credit-btn-submit">
                <span>+ SAVE CREDIT ENTRY</span>
            </button>
        </form>
    </div>
</div>

<!-- EDIT MODAL -->
<div class="credit-modal" id="editCreditModal">
    <div class="credit-modal-content">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; border-bottom: 1px solid #f1f5f9; padding-bottom: 10px;">
            <h3 style="font-size: 1.05rem; font-weight: 900; margin: 0; color: #0f172a;">EDIT CREDIT ENTRY</h3>
            <button type="button" onclick="closeEditModal()" style="background: none; border: none; font-size: 1.3rem; cursor: pointer; color: #64748b; line-height: 1;">&times;</button>
        </div>
        <form method="post" action="/Expenditure/Credit/Edit">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" id="modalCreditId" />

            <!-- DIRECTION -->
            <div class="credit-input-group">
                <label class="credit-input-label">CREDIT DIRECTION *</label>
                <select name="CreditType" id="modalCreditType" class="credit-input" style="font-weight: 800;">
                    <option value="GIVEN_TO_US">↓ GIVEN TO US (WE OWE THEM)</option>
                    <option value="GIVEN_BY_US">↑ GIVEN BY US (THEY OWE US)</option>
                </select>
            </div>

            <!-- COMPANY NAME -->
            <div class="credit-input-group">
                <label class="credit-input-label">COMPANY / PARTY NAME *</label>
                <input type="text" name="CompanyName" id="modalCompanyName" class="credit-input" required />
            </div>

            <!-- CREDIT AMOUNT -->
            <div class="credit-input-group">
                <label class="credit-input-label">CREDIT AMOUNT (₹) *</label>
                <input type="number" step="0.01" name="CreditAmount" id="modalCreditAmount" class="credit-input" required />
            </div>

            <!-- DATE -->
            <div class="credit-input-group">
                <label class="credit-input-label">RECORD DATE</label>
                <input type="date" name="Date" id="modalDate" class="credit-input" />
            </div>

            <!-- PAID OFF / SETTLED STATUS -->
            <div class="credit-input-group" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 10px 12px;">
                <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; user-select: none; margin: 0; font-size: 0.76rem; font-weight: 800; color: #0f172a;">
                    <input type="checkbox" name="IsPaidOff" id="modalIsPaidOff" value="true" onchange="togglePaidOffDateInput('modal')" style="width: 16px; height: 16px; accent-color: #10b981;" />
                    <span>ALREADY PAID OFF / SETTLED</span>
                </label>
                <div id="modalPaidOffDateContainer" style="display: none; margin-top: 8px;">
                    <label class="credit-input-label" style="font-size: 0.68rem;">SETTLED / PAID OFF DATE</label>
                    <input type="date" name="PaidOffDate" id="modalPaidOffDate" class="credit-input" style="height: 34px;" />
                </div>
            </div>

            <!-- DESCRIPTION -->
            <div class="credit-input-group">
                <label class="credit-input-label">DESCRIPTION / PURPOSE</label>
                <input type="text" name="Description" id="modalDescription" class="credit-input" />
            </div>

            <!-- NOTES -->
            <div class="credit-input-group">
                <label class="credit-input-label">NOTES / REMARKS</label>
                <textarea name="Notes" id="modalNotes" class="credit-textarea"></textarea>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 16px;">
                <button type="button" onclick="closeEditModal()" class="button btn-secondary" style="padding: 0 16px;">CANCEL</button>
                <button type="submit" class="button btn-primary" style="padding: 0 20px;">UPDATE</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function selectFormDirection(dir) {
        document.getElementById('createCreditTypeInput').value = dir;
        const btnToUs = document.getElementById('btnDirToUs');
        const btnByUs = document.getElementById('btnDirByUs');
        if (dir === 'GIVEN_TO_US') {
            btnToUs.className = 'credit-direction-option selected to-us';
            btnByUs.className = 'credit-direction-option';
            document.getElementById('lblCreditAmount').textContent = 'CREDIT GIVEN TO US (₹) *';
        } else {
            btnToUs.className = 'credit-direction-option';
            btnByUs.className = 'credit-direction-option selected by-us';
            document.getElementById('lblCreditAmount').textContent = 'CREDIT GIVEN BY US (₹) *';
        }
    }

    function togglePaidOffDateInput(prefix) {
        const chk = document.getElementById(prefix + 'IsPaidOff');
        const container = document.getElementById(prefix + 'PaidOffDateContainer');
        const dateInput = document.getElementById(prefix + 'PaidOffDate');
        if (chk && container) {
            if (chk.checked) {
                container.style.display = 'block';
                if (!dateInput.value) {
                    const today = new Date().toISOString().split('T')[0];
                    dateInput.value = today;
                }
            } else {
                container.style.display = 'none';
            }
        }
    }

    function openEditModal(id, company, amount, creditType, isPaidOff, paidDate, date, desc, notes) {
        document.getElementById('modalCreditId').value = id;
        document.getElementById('modalCompanyName').value = company;
        document.getElementById('modalCreditAmount').value = amount;
        document.getElementById('modalCreditType').value = creditType || 'GIVEN_TO_US';
        
        const chkPaid = document.getElementById('modalIsPaidOff');
        chkPaid.checked = !!isPaidOff;
        document.getElementById('modalPaidOffDate').value = paidDate || '';
        togglePaidOffDateInput('modal');

        document.getElementById('modalDate').value = date;
        document.getElementById('modalDescription').value = desc;
        document.getElementById('modalNotes').value = notes;
        document.getElementById('editCreditModal').classList.add('open');
    }

    function closeEditModal() {
        document.getElementById('editCreditModal').classList.remove('open');
    }

    document.getElementById('editCreditModal')?.addEventListener('click', (e) => {
        if (e.target.id === 'editCreditModal') {
            closeEditModal();
        }
    });
</script>
}
