@model IReadOnlyList<ManualReminder>
@{
    ViewData["Title"] = "Completed follow-ups";
}

<div class="glass-wrapper">
    <div class="page-heading">
        <div>
            <div class="eyebrow">Reminders / Archive</div>
            <h1>Completed follow-ups</h1>
            <p>Archive of finished operational reminders and resolved team tasks.</p>
        </div>
        <a class="btn-back" asp-action="Index">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
            Back to reminders
        </a>
    </div>

    <div class="card" style="padding: 24px; max-width: 900px; margin: 0 auto;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid var(--border); padding-bottom: 14px;">
            <div>
                <h3 style="margin: 0; font-size: 1.05rem; font-weight: 700; color: var(--text-main); display: flex; align-items: center; gap: 8px;">
                    <span>📁</span> Resolved Tasks History
                    <span class="badge-count" style="background: #e2e8f0; color: #475569;">@Model.Count</span>
                </h3>
            </div>
            <span style="font-size: 0.8rem; color: var(--muted);">Click Reopen to move any item back to active follow-ups</span>
        </div>

        @if (Model.Count > 0)
        {
            <div style="position: relative; margin-bottom: 16px;">
                <input id="completedSearchInput" class="input shadow-md" style="padding: 0 40px; border-radius: 9999px; height: 38px; width: 100%; border: 1px solid var(--line); font-size: 13px;" placeholder="Search completed follow-ups by title, details, user..." oninput="filterCompletedNotes()" />
                <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--muted);"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            </div>
        }

        @if (Model.Count == 0)
        {
            <div style="padding: 48px 24px; text-align: center; color: var(--muted);">
                <div style="font-size: 2.5rem; margin-bottom: 10px;">✨</div>
                <h3 style="margin: 0; color: var(--text-main); font-size: 1.1rem; font-weight: 700;">No completed follow-ups yet</h3>
                <p style="margin: 6px 0 16px; font-size: 0.85rem;">When you mark items as completed on the reminders board, they will be archived here.</p>
                <a asp-action="Index" class="btn-primary" style="display: inline-flex; align-items: center; gap: 6px; text-decoration: none; padding: 7px 16px; font-size: 0.85rem;">
                    Go to reminders
                </a>
            </div>
        }
        else
        {
            <div class="completed-note-list" style="display: flex; flex-direction: column; gap: 12px;">
                @foreach (var item in Model)
                {
                    <article class="card note-item done" style="padding: 16px; border-left: 4px solid #10b981; background: var(--surface-hover); margin: 0;">
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 12px;">
                            <div style="flex: 1;">
                                <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                                    <h3 style="margin: 0; font-size: 0.96rem; font-weight: 700; color: var(--text-main); text-decoration: line-through; opacity: 0.85;">
                                        @item.Title
                                    </h3>
                                    <span class="badge-done" style="background: #d1fae5; color: #065f46; font-size: 0.72rem; font-weight: 700; padding: 2px 8px; border-radius: 999px;">✓ Done</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(item.Details))
                                {
                                    <p style="margin: 8px 0 0; font-size: 0.85rem; color: var(--muted); line-height: 1.45;">@item.Details</p>
                                }
                            </div>
                        </div>

                        <div style="margin-top: 12px; padding-top: 10px; border-top: 1px dashed var(--border); display: flex; justify-content: space-between; align-items: center; font-size: 0.8rem;">
                            <span style="color: var(--muted);">
                                <strong>Due:</strong> @(string.IsNullOrWhiteSpace(item.DueDate) ? "None" : DateValue.Short(item.DueDate))
                            </span>

                            <div style="display: flex; gap: 12px; align-items: center;">
                                @if (User.CanEditModule("Reminders"))
                                {
                                    <form asp-action="Complete" method="post" style="display: inline; margin: 0;">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="returnUrl" value="@Url.Action("Completed", "Reminders")" />
                                        <button class="button-link" type="submit" style="font-size: 0.8rem; font-weight: 600; color: var(--blue-600);">
                                            ↺ Reopen
                                        </button>
                                    </form>
                                    <form asp-action="Delete" method="post" style="display: inline; margin: 0;" onsubmit="return confirm('Are you sure you want to permanently delete this completed reminder?');">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="returnUrl" value="@Url.Action("Completed", "Reminders")" />
                                        <button class="button-link" type="submit" style="font-size: 0.8rem; color: var(--danger);">
                                            Delete
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</div>

<script>
function filterCompletedNotes() {
    const q = document.getElementById('completedSearchInput').value.trim().toLowerCase();
    document.querySelectorAll('.completed-note-list .note-item').forEach(item => {
        item.style.display = (!q || item.textContent.toLowerCase().includes(q)) ? '' : 'none';
    });
}
</script>
