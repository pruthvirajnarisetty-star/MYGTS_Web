@model CompanyRechargeAddDevicesViewModel
@{
    ViewData["Title"] = $"Add Devices to Batch: {Model.PoNumber}";
    var effectiveAdvance = Model.AdvanceAmount + Model.CarriedForwardAmount - Model.CarriedOutAmount;
}

<style>
    .cr-batch-banner {
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 20px 24px;
        margin-bottom: 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
    }
    .cr-banner-stat {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }
    .cr-banner-stat-title {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--muted);
    }
    .cr-banner-stat-val {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--text-main);
    }
    .cr-table-input {
        width: 100%;
        height: 36px;
        padding: 4px 10px;
        border-radius: 6px;
        border: 1px solid var(--line);
        background: var(--paper);
        color: var(--text-main);
        font-size: 0.88rem;
        transition: border-color 0.2s, box-shadow 0.2s;
    }
    .cr-table-input:focus {
        border-color: var(--accent);
        outline: none;
        box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.15);
    }
    .cr-table-input.mono {
        font-family: monospace;
        letter-spacing: 0.02em;
    }
    .cr-lookup-status {
        font-size: 0.72rem;
        color: #10b981;
        display: none;
        margin-top: 2px;
    }
    .cr-summary-bar {
        position: sticky;
        bottom: 0;
        z-index: 20;
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 16px 24px;
        box-shadow: 0 -4px 20px rgba(0,0,0,0.08);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: wrap;
        margin-top: 24px;
    }
    .cr-summary-item {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }
    .cr-summary-label {
        font-size: 0.74rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--muted);
    }
    .cr-summary-val {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--text-main);
    }
    .cr-modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.6);
        backdrop-filter: blur(4px);
        z-index: 1000;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 16px;
    }
    .cr-modal-backdrop.active {
        display: flex;
    }
    .cr-modal-box {
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: 12px;
        width: 100%;
        max-width: 620px;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2);
        overflow: hidden;
    }
</style>

<div class="page-heading">
    <div>
        <div class="eyebrow">Carrier & Network Management</div>
        <h1>Add Devices to Batch: @Model.PoNumber</h1>
        <p>Assign vehicle SIM devices for renewal or reactivation under this batch advance payment.</p>
    </div>
    <div>
        <a asp-action="Index" class="button secondary">&larr; Back to Batches</a>
    </div>
</div>

<!-- BATCH CONTEXT BANNER -->
<div class="cr-batch-banner">
    <div style="display: flex; gap: 24px; align-items: center; flex-wrap: wrap;">
        <div class="cr-banner-stat">
            <span class="cr-banner-stat-title">PO Number</span>
            <span class="cr-banner-stat-val" style="color: #2563eb;">@Model.PoNumber</span>
        </div>
        <div class="cr-banner-stat">
            <span class="cr-banner-stat-title">Carrier</span>
            <span class="cr-banner-stat-val">@Model.Provider</span>
        </div>
        <div class="cr-banner-stat">
            <span class="cr-banner-stat-title">Date</span>
            <span class="cr-banner-stat-val">@(string.IsNullOrWhiteSpace(Model.Date) ? "—" : DateValue.Short(Model.Date))</span>
        </div>
        <div class="cr-banner-stat">
            <span class="cr-banner-stat-title">Effective Advance</span>
            <span class="cr-banner-stat-val">₹@effectiveAdvance.ToString("N2")</span>
        </div>
        <div class="cr-banner-stat">
            <span class="cr-banner-stat-title">Already Billed</span>
            <span class="cr-banner-stat-val" style="color: #7c3aed;">₹@Model.TotalAmountExisting.ToString("N2") (@Model.ExistingDeviceCount units)</span>
        </div>
        <div class="cr-banner-stat">
            <span class="cr-banner-stat-title">Available Balance</span>
            <span class="cr-banner-stat-val" style="color: @(Model.RemainingBalance > 0 ? "#10b981" : "#ef4444");">
                ₹@Model.RemainingBalance.ToString("N2")
            </span>
        </div>
    </div>
</div>

<form asp-action="AddDevices" method="post" id="addDevicesForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="BatchId" />
    <input type="hidden" asp-for="PoNumber" />
    <input type="hidden" asp-for="Provider" />
    <input type="hidden" asp-for="AdvanceAmount" />
    <input type="hidden" asp-for="CarriedForwardAmount" />
    <input type="hidden" asp-for="CarriedOutAmount" />
    <input type="hidden" asp-for="TotalAmountExisting" />
    <input type="hidden" asp-for="RemainingBalance" />
    <input type="hidden" asp-for="DefaultRechargeRate" />
    <input type="hidden" asp-for="DefaultReactivationRate" />

    <!-- DEVICE ROWS CARD -->
    <div class="card" style="padding: 24px; margin-bottom: 24px;">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; flex-wrap: wrap; gap: 12px;">
            <div>
                <h3 style="margin: 0; font-size: 1.15rem; color: var(--text-main); display: flex; align-items: center; gap: 8px;">
                    <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
                    New Devices to Add
                </h3>
                <div style="font-size: 0.84rem; color: var(--muted); margin-top: 2px;">
                    Enter <strong>Vehicle Number</strong>, IMEI, or ICCID. Entering any one auto-fills linked device info from the database.
                </div>
            </div>

            <div style="display: flex; gap: 10px; align-items: center;">
                <button type="button" class="button secondary small" onclick="openBulkPasteModal()">
                    <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="margin-right: 4px;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 13h6m-3-3v6m5 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                    Bulk Paste from Excel / CSV
                </button>
                <button type="button" class="button btn-primary small" onclick="addRow()">
                    + Add Row
                </button>
            </div>
        </div>

        <div class="table-wrap" style="overflow-x: auto;">
            <table class="data-table" id="itemsTable" style="width: 100%; margin: 0;">
                <thead>
                    <tr>
                        <th style="width: 44px; text-align: center;">#</th>
                        <th style="width: 180px;">Vehicle Number *</th>
                        <th style="width: 180px;">IMEI</th>
                        <th style="width: 220px;">ICCID</th>
                        <th style="width: 150px;">Request ID</th>
                        <th style="width: 150px;">Action Type</th>
                        <th style="width: 130px; text-align: right;">Rate (₹)</th>
                        <th style="width: 50px; text-align: center;"></th>
                    </tr>
                </thead>
                <tbody id="itemsBody">
                </tbody>
            </table>
        </div>
    </div>

    <!-- STICKY SUMMARY & SUBMIT BAR -->
    <div class="cr-summary-bar">
        <div style="display: flex; gap: 24px; align-items: center; flex-wrap: wrap;">
            <div class="cr-summary-item">
                <span class="cr-summary-label">Batch Advance</span>
                <span class="cr-summary-val">₹@effectiveAdvance.ToString("N2")</span>
            </div>
            <div class="cr-summary-item">
                <span class="cr-summary-label">Previously Billed</span>
                <span class="cr-summary-val" style="color: #7c3aed;">₹@Model.TotalAmountExisting.ToString("N2")</span>
            </div>
            <div class="cr-summary-item">
                <span class="cr-summary-label">New Devices Cost (<span id="dispCount">0</span> units)</span>
                <span class="cr-summary-val" style="color: #2563eb;" id="dispNewCost">₹0.00</span>
            </div>
            <div class="cr-summary-item">
                <span class="cr-summary-label">Projected Remaining Balance</span>
                <span class="cr-summary-val" id="dispProjectedBalance">₹@Model.RemainingBalance.ToString("N2")</span>
            </div>
        </div>

        <div style="display: flex; gap: 12px; align-items: center;">
            <a asp-action="Index" class="button secondary">Cancel</a>
            <button type="submit" class="button btn-primary" style="padding: 10px 28px; font-size: 0.95rem;">
                Save Devices to Batch
            </button>
        </div>
    </div>
</form>

<!-- BULK PASTE MODAL -->
<div class="cr-modal-backdrop" id="bulkPasteModal" onclick="closeBulkPasteModal(event)">
    <div class="cr-modal-box" onclick="event.stopPropagation();">
        <div style="padding: 20px 24px; border-bottom: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between;">
            <div>
                <h3 style="margin: 0; font-size: 1.15rem; color: var(--text-main);">Bulk Paste from Excel / CSV</h3>
                <div style="font-size: 0.84rem; color: var(--muted); margin-top: 2px;">
                    Paste copied rows from your spreadsheet (e.g. IMSI Procurement sheet)
                </div>
            </div>
            <button type="button" onclick="closeBulkPasteModal()" style="background: none; border: none; font-size: 1.5rem; color: var(--muted); cursor: pointer; line-height: 1;">&times;</button>
        </div>

        <div style="padding: 20px 24px;">
            <p style="font-size: 0.85rem; color: var(--muted); margin-top: 0; margin-bottom: 8px;">
                Supported column order (Tab or Comma separated):<br />
                <code>Vehicle Number [tab] IMEI [tab] ICCID [tab] Request ID [tab] Type (optional)</code><br />
                <em>(Or paste rows with just IMEI/ICCID &mdash; Vehicle Number and details will auto-link from database)</em>
            </p>
            <textarea id="bulkPasteInput" rows="10" class="input" style="width: 100%; font-family: monospace; font-size: 0.85rem; padding: 10px; resize: vertical;" placeholder="KA01AB1234	861234567890123	8991234567890123456	REQ-001	Renewal&#10;KA01CD5678	861234567890124	8991234567890123457		Reactivation"></textarea>
            
            <div style="display: flex; gap: 12px; margin-top: 12px; align-items: center;">
                <label style="font-size: 0.85rem; font-weight: 600;">Default Type for rows without type:</label>
                <select id="bulkDefaultType" class="select" style="width: 140px; height: 34px;">
                    <option value="Renewal">Renewal</option>
                    <option value="Reactivation">Reactivation</option>
                </select>
            </div>
        </div>

        <div style="padding: 16px 24px; background: rgba(0,0,0,0.02); border-top: 1px solid var(--line); display: flex; justify-content: flex-end; gap: 12px;">
            <button type="button" class="button secondary" onclick="closeBulkPasteModal()">Cancel</button>
            <button type="button" class="button btn-primary" onclick="processBulkPaste()">Parse & Add Rows</button>
        </div>
    </div>
</div>

<script>
    const DEFAULT_RECHARGE_RATE = @Model.DefaultRechargeRate;
    const DEFAULT_REACTIVATION_RATE = @Model.DefaultReactivationRate;
    const EFFECTIVE_ADVANCE = @effectiveAdvance;
    const EXISTING_BILLED = @Model.TotalAmountExisting;

    document.addEventListener('DOMContentLoaded', function () {
        // Start with 3 empty rows
        addRow();
        addRow();
        addRow();
        recalcAddFinancials();
    });

    function addRow(data) {
        data = data || {};
        const tbody = document.getElementById('itemsBody');
        const rowIndex = tbody.children.length;

        const actionType = data.ActionType || 'Renewal';
        const rate = (data.PerDeviceAmount !== undefined && data.PerDeviceAmount > 0) 
            ? data.PerDeviceAmount 
            : (actionType === 'Reactivation' ? DEFAULT_REACTIVATION_RATE : DEFAULT_RECHARGE_RATE);

        const tr = document.createElement('tr');
        tr.id = 'row-' + rowIndex;
        tr.innerHTML = `
            <td style="text-align: center; color: var(--muted); font-size: 0.8rem; vertical-align: middle;">
                <span class="row-num">${rowIndex + 1}</span>
                <input type="hidden" name="Items[${rowIndex}].SlNo" value="${rowIndex + 1}" class="sl-no-input" />
            </td>
            <td>
                <input type="text" name="Items[${rowIndex}].VehicleNo" value="${data.VehicleNo || ''}" class="cr-table-input mono vehicle-input" placeholder="e.g. KA01AB1234" onblur="lookupDeviceRow(this, ${rowIndex}, 'vehicle')" />
                <div class="cr-lookup-status"></div>
            </td>
            <td>
                <input type="text" name="Items[${rowIndex}].Imei" value="${data.Imei || ''}" class="cr-table-input mono imei-input" placeholder="15 digits" onblur="lookupDeviceRow(this, ${rowIndex}, 'imei')" />
            </td>
            <td>
                <input type="text" name="Items[${rowIndex}].Iccid" value="${data.Iccid || ''}" class="cr-table-input mono iccid-input" placeholder="19-20 digits" onblur="lookupDeviceRow(this, ${rowIndex}, 'iccid')" />
            </td>
            <td>
                <input type="text" name="Items[${rowIndex}].RequestId" value="${data.RequestId || ''}" class="cr-table-input mono" placeholder="Request ID" />
            </td>
            <td>
                <select name="Items[${rowIndex}].ActionType" class="select action-type-select" style="height: 36px; padding: 4px 8px; font-size: 0.88rem;" onchange="onActionTypeChange(this, ${rowIndex})">
                    <option value="Renewal" ${actionType === 'Renewal' ? 'selected' : ''}>Renewal</option>
                    <option value="Reactivation" ${actionType === 'Reactivation' ? 'selected' : ''}>Reactivation</option>
                </select>
            </td>
            <td>
                <input type="number" step="0.01" min="0" name="Items[${rowIndex}].PerDeviceAmount" value="${rate}" class="cr-table-input rate-input" style="text-align: right; font-weight: 600;" oninput="recalcAddFinancials()" />
            </td>
            <td style="text-align: center; vertical-align: middle;">
                <button type="button" class="button ghost small" style="color: var(--danger); padding: 2px 6px; font-size: 1.1rem; line-height: 1;" onclick="removeRow(${rowIndex})" title="Remove row">&times;</button>
            </td>
        `;

        tbody.appendChild(tr);
        recalcAddFinancials();
    }

    function removeRow(index) {
        const row = document.getElementById('row-' + index);
        if (row) {
            row.remove();
            reindexRows();
            recalcAddFinancials();
        }
    }

    function reindexRows() {
        const tbody = document.getElementById('itemsBody');
        const rows = tbody.children;
        for (let i = 0; i < rows.length; i++) {
            const tr = rows[i];
            tr.id = 'row-' + i;
            const numSpan = tr.querySelector('.row-num');
            if (numSpan) numSpan.textContent = (i + 1);

            const slInput = tr.querySelector('.sl-no-input');
            if (slInput) slInput.value = (i + 1);

            tr.querySelectorAll('input, select').forEach(el => {
                const name = el.getAttribute('name');
                if (name && name.startsWith('Items[')) {
                    el.setAttribute('name', name.replace(/Items\[\d+\]/, `Items[${i}]`));
                }
            });

            const btn = tr.querySelector('button[onclick^="removeRow"]');
            if (btn) btn.setAttribute('onclick', `removeRow(${i})`);

            const vehicleInput = tr.querySelector('.vehicle-input');
            if (vehicleInput) vehicleInput.setAttribute('onblur', `lookupDeviceRow(this, ${i}, 'vehicle')`);
            const imeiInput = tr.querySelector('.imei-input');
            if (imeiInput) imeiInput.setAttribute('onblur', `lookupDeviceRow(this, ${i}, 'imei')`);
            const iccidInput = tr.querySelector('.iccid-input');
            if (iccidInput) iccidInput.setAttribute('onblur', `lookupDeviceRow(this, ${i}, 'iccid')`);
            const actionSelect = tr.querySelector('.action-type-select');
            if (actionSelect) actionSelect.setAttribute('onchange', `onActionTypeChange(this, ${i})`);
        }
    }

    function onActionTypeChange(select, rowIndex) {
        const row = document.getElementById('row-' + rowIndex);
        if (!row) return;
        const rateInput = row.querySelector('.rate-input');
        if (rateInput) {
            if (select.value === 'Reactivation') {
                rateInput.value = DEFAULT_REACTIVATION_RATE;
            } else {
                rateInput.value = DEFAULT_RECHARGE_RATE;
            }
        }
        recalcAddFinancials();
    }

    function lookupDeviceRow(input, rowIndex, triggerField) {
        const val = input.value.trim();
        if (!val || val.length < 3) return;

        const row = document.getElementById('row-' + rowIndex);
        if (!row) return;

        const vehicleInput = row.querySelector('.vehicle-input');
        const imeiInput = row.querySelector('.imei-input');
        const iccidInput = row.querySelector('.iccid-input');
        const statusDiv = row.querySelector('.cr-lookup-status');

        fetch(`/CompanyRecharges/LookupDevice?query=${encodeURIComponent(val)}`)
            .then(res => res.json())
            .then(data => {
                if (data.found) {
                    if (data.vehicleNo && !vehicleInput.value) vehicleInput.value = data.vehicleNo;
                    if (data.imei && !imeiInput.value) imeiInput.value = data.imei;
                    if (data.iccid && !iccidInput.value) iccidInput.value = data.iccid;

                    if (statusDiv) {
                        statusDiv.style.display = 'block';
                        statusDiv.textContent = '✓ Linked: ' + (data.vehicleNo || data.imei);
                        setTimeout(() => { statusDiv.style.display = 'none'; }, 4000);
                    }
                }
            })
            .catch(() => {});
    }

    function recalcAddFinancials() {
        const rateInputs = document.querySelectorAll('.rate-input');
        let newCost = 0;
        let count = 0;

        rateInputs.forEach(inp => {
            const r = parseFloat(inp.value) || 0;
            const tr = inp.closest('tr');
            const v = tr.querySelector('.vehicle-input')?.value.trim();
            const im = tr.querySelector('.imei-input')?.value.trim();
            const ic = tr.querySelector('.iccid-input')?.value.trim();
            if (v || im || ic) {
                newCost += r;
                count++;
            }
        });

        const projectedBalance = EFFECTIVE_ADVANCE - EXISTING_BILLED - newCost;

        document.getElementById('dispCount').textContent = count;
        document.getElementById('dispNewCost').textContent = '₹' + newCost.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

        const dispProjected = document.getElementById('dispProjectedBalance');
        dispProjected.textContent = '₹' + projectedBalance.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        if (projectedBalance > 0) {
            dispProjected.style.color = '#10b981';
        } else if (projectedBalance < 0) {
            dispProjected.style.color = '#ef4444';
        } else {
            dispProjected.style.color = 'var(--text-main)';
        }
    }

    function openBulkPasteModal() {
        document.getElementById('bulkPasteModal').classList.add('active');
        document.getElementById('bulkPasteInput').focus();
    }
    function closeBulkPasteModal(e) {
        if (!e || e.target.id === 'bulkPasteModal' || e.target.tagName === 'BUTTON') {
            document.getElementById('bulkPasteModal').classList.remove('active');
        }
    }

    function processBulkPaste() {
        const text = document.getElementById('bulkPasteInput').value;
        const defaultType = document.getElementById('bulkDefaultType').value;
        if (!text.trim()) {
            closeBulkPasteModal();
            return;
        }

        const lines = text.split(/\r?\n/);

        lines.forEach(line => {
            const trimmed = line.trim();
            if (!trimmed) return;

            const cols = trimmed.includes('\t') ? trimmed.split('\t') : trimmed.split(',');

            let vehicle = '';
            let imei = '';
            let iccid = '';
            let reqId = '';
            let actType = defaultType;

            if (cols.length >= 1) vehicle = cols[0].trim();
            if (cols.length >= 2) imei = cols[1].trim();
            if (cols.length >= 3) iccid = cols[2].trim();
            if (cols.length >= 4) reqId = cols[3].trim();
            if (cols.length >= 5 && cols[4].trim()) {
                const t = cols[4].trim().toLowerCase();
                actType = t.includes('reactivat') ? 'Reactivation' : 'Renewal';
            }

            if (cols.length === 1) {
                if (/^\d{15}$/.test(vehicle)) {
                    imei = vehicle;
                    vehicle = '';
                } else if (/^\d{18,22}$/.test(vehicle)) {
                    iccid = vehicle;
                    vehicle = '';
                }
            }

            addRow({
                VehicleNo: vehicle,
                Imei: imei,
                Iccid: iccid,
                RequestId: reqId,
                ActionType: actType,
                PerDeviceAmount: actType === 'Reactivation' ? DEFAULT_REACTIVATION_RATE : DEFAULT_RECHARGE_RATE
            });
        });

        document.getElementById('bulkPasteInput').value = '';
        closeBulkPasteModal();
        recalcAddFinancials();
    }
</script>
