@model ImportViewModel
@{
    var currentBranch = (string?)ViewBag.CurrentBranch ?? (Context.Request.Cookies["mygts_branch"] == "RTO" ? "RTO" : "DMG");
    ViewData["Title"] = $"Import {currentBranch} invoices & devices";
    ViewData["BodyClass"] = "form-background-container";
}

<div class="page-heading">
    <div>
        <div class="eyebrow">Procurement / Data Import</div>
        <h1>Import @(currentBranch) invoices &amp; device rosters</h1>
        <p>Upload a multi-sheet Excel file (.xlsx) containing the main Invoices sheet and individual sheets for each invoice's devices.</p>
    </div>
    <div style="display: flex; gap: 8px; align-items: center;">
        <a class="button secondary" asp-action="DownloadSampleInvoice" asp-route-branch="@currentBranch" title="Download multi-sheet sample invoices Excel template">📥 Download sample package (.xlsx)</a>
        <a class="button ghost" asp-action="Index">← Back to invoices</a>
    </div>
</div>

<form class="card form-card" asp-action="Import" method="post" enctype="multipart/form-data" style="max-width: 720px; margin: 0 auto;">
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
    
    <div style="background: rgba(59, 130, 246, 0.08); border-left: 4px solid var(--blue-600); border-radius: 8px; padding: 16px; margin-bottom: 22px; font-size: 0.88rem; color: var(--text-main); line-height: 1.55;">
        <div style="font-weight: 700; margin-bottom: 6px; display: flex; align-items: center; gap: 8px; color: var(--blue-700);">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
            Multi-sheet workbook format:
        </div>
        <ul style="margin: 6px 0 0 18px; padding: 0;">
            <li style="margin-bottom: 6px;">
                <strong>Main sheet:</strong> Must be named <code>Invoices</code>, <code>Invoices_DMG</code>, or <code>Invoices_RTO</code>. It defines each invoice with date, device type, invoice number, quantity, rate, courier, etc.
            </li>
            <li style="margin-bottom: 6px;">
                <strong>Per-invoice sheets:</strong> In the same file, include a separate worksheet named with each <strong>Invoice number</strong> (e.g. <code>INV-@(currentBranch)-2026-001</code>) containing its device roster (with columns <code>serial number</code>, <code>iccid</code>, <code>imei</code>).
            </li>
            <li>
                <strong>Automatic economics:</strong> The system imports all invoices and their associated devices together, computes the exact 18% GST loaded cost per device, and updates linked transaction profits.
            </li>
        </ul>
    </div>
    
    <div class="field">
        <label asp-for="Workbook" class="form-label" style="font-weight: 600;">Choose multi-sheet spreadsheet file (.xlsx)</label>
        <input asp-for="Workbook" class="input" type="file" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required />
        <span asp-validation-for="Workbook" class="validation-summary-errors"></span>
    </div>

    <div class="field" style="margin-top: 18px; background: rgba(59, 130, 246, 0.05); border: 1px dashed #93c5fd; border-radius: 8px; padding: 14px 16px; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;">
        <div>
            <strong style="color: var(--text-main); font-size: 0.9rem; display: block;">Sample @(currentBranch) multi-sheet template</strong>
            <span style="color: var(--muted); font-size: 0.82rem;">Download our sample workbook featuring the main Invoices sheet and individual invoice device sheets.</span>
        </div>
        <a class="button secondary" asp-action="DownloadSampleInvoice" asp-route-branch="@currentBranch" style="display: inline-flex; align-items: center; gap: 6px; font-size: 0.85rem; padding: 6px 14px; text-decoration: none;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Download sample package (.xlsx)
        </a>
    </div>
    
    <div class="form-actions" style="margin-top: 24px; display: flex; justify-content: flex-end; gap: 10px;">
        <a class="button ghost" asp-action="Index">Cancel</a>
        <button class="button btn-primary" type="submit" style="padding: 10px 22px; font-weight: 600;">
            Upload and import invoices →
        </button>
    </div>
</form>
