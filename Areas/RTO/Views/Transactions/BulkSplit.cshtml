    window.isMultiUtrActive = false;

    window.toggleMultiUtr = function() {
        const container = document.getElementById('field-bulk-payments-container');
        const rowsContainer = document.getElementById('bulk-payments-rows');
        const btnText = document.getElementById('btn-toggle-multi-utr-text');
        const btnIcon = document.getElementById('btn-toggle-multi-utr-icon');
        if (!container || !rowsContainer) return;

        if (container.style.display === 'none' || !container.style.display) {
            container.style.display = 'block';
            window.isMultiUtrActive = true;
            if (btnText) btnText.textContent = 'Hide Multiple UTRs Panel';
            if (btnIcon) btnIcon.textContent = '➖';

            if (rowsContainer.querySelectorAll('.bulk-payment-row').length === 0) {
                const curDate = new Date().toISOString().split('T')[0];
                const curMode = (document.querySelector('select[name="PaymentMode"]')?.value || 'Bank transfer').trim();
                const curTotal = parseFloat(document.getElementById('total-payment-input')?.value) || 0;
                const curUtr = (document.querySelector('input[name="Utr"]')?.value || '').trim();
                const curPaidTo = (document.querySelector('input[name="PaidTo"]')?.value || '').trim();

                addBulkPaymentRow({
                    date: curDate,
                    mode: curMode,
                    amount: curTotal > 0 ? curTotal : '',
                    utr: curUtr,
                    paidTo: curPaidTo
                });

                addBulkPaymentRow({
                    date: curDate,
                    mode: curMode,
                    amount: '',
                    utr: '',
                    paidTo: curPaidTo
                });
            }
            onBulkPaymentsChanged();
        } else {
            container.style.display = 'none';
            window.isMultiUtrActive = false;
            if (btnText) btnText.textContent = 'Add Multiple UTRs / Part Payments';
            if (btnIcon) btnIcon.textContent = '➕';
        }
    };

    window.collapseMultiUtr = function() {
        const container = document.getElementById('field-bulk-payments-container');
        const rowsContainer = document.getElementById('bulk-payments-rows');
        const btnText = document.getElementById('btn-toggle-multi-utr-text');
        const btnIcon = document.getElementById('btn-toggle-multi-utr-icon');
        if (container) container.style.display = 'none';
        if (btnText) btnText.textContent = 'Add Multiple UTRs / Part Payments';
        if (btnIcon) btnIcon.textContent = '➕';
        window.isMultiUtrActive = false;
        if (rowsContainer) {
            const firstRow = rowsContainer.querySelector('.bulk-payment-row');
            if (firstRow) {
                const amt = firstRow.querySelector('.bulk-pay-amount')?.value;
                const utr = firstRow.querySelector('.bulk-pay-utr')?.value;
                const paidTo = firstRow.querySelector('.bulk-pay-paidto')?.value;
                const mode = firstRow.querySelector('.bulk-pay-mode')?.value;
                const totalInput = document.getElementById('total-payment-input');
                const utrInput = document.querySelector('input[name="Utr"]');
                const paidToInput = document.querySelector('input[name="PaidTo"]');
                const modeInput = document.querySelector('select[name="PaymentMode"]');
                if (amt && totalInput) totalInput.value = amt;
                if (utr && utrInput) utrInput.value = utr;
                if (paidTo && paidToInput) paidToInput.value = paidTo;
                if (mode && modeInput) modeInput.value = mode;
            }
            rowsContainer.innerHTML = '';
        }
        if (window.calculateRemaining) window.calculateRemaining();
    };

    window.addBulkPaymentRow = function(data = {}) {
        const rowsContainer = document.getElementById('bulk-payments-rows');
        if (!rowsContainer) return;
        const count = rowsContainer.querySelectorAll('.bulk-payment-row').length;
        const defaultDate = new Date().toISOString().split('T')[0];
        const row = document.createElement('div');
        row.className = 'bulk-payment-row';
        row.style.display = 'grid';
        row.style.gridTemplateColumns = '135px 125px 130px 1.4fr 140px 38px';
        row.style.gap = '8px';
        row.style.alignItems = 'center';
        row.style.background = 'rgba(0,0,0,0.15)';
        row.style.padding = '8px 10px';
        row.style.borderRadius = '8px';
        row.style.border = '1px solid rgba(255,255,255,0.05)';

        const valDate = data.date || defaultDate;
        const valMode = data.mode || (document.querySelector('select[name="PaymentMode"]')?.value || 'Bank transfer');
        const valAmount = (data.amount !== undefined && data.amount !== null && data.amount !== '') ? data.amount : '';
        const valUtr = data.utr || '';
        const valPaidTo = data.paidTo || (document.querySelector('input[name="PaidTo"]')?.value || '');

        row.innerHTML = `
            <input name="BulkPayments[${count}].Date" type="date" class="input bulk-pay-date" style="height: 38px; font-size: 0.82rem;" value="${valDate}" title="Payment Date" />
            <select name="BulkPayments[${count}].PaymentMode" class="select bulk-pay-mode" style="height: 38px; font-size: 0.82rem;">
                <option value="Bank transfer" ${valMode === 'Bank transfer' || valMode === 'Banking' ? 'selected' : ''}>Bank transfer</option>
                <option value="UPI" ${valMode === 'UPI' ? 'selected' : ''}>UPI</option>
                <option value="Cash" ${valMode === 'Cash' ? 'selected' : ''}>Cash</option>
                <option value="Cheque" ${valMode === 'Cheque' ? 'selected' : ''}>Cheque</option>
            </select>
            <input name="BulkPayments[${count}].Amount" type="number" step="0.01" min="0" class="input bulk-pay-amount" placeholder="Amount (₹)" style="height: 38px; font-size: 0.85rem;" value="${valAmount}" oninput="onBulkPaymentsChanged()" />
            <input name="BulkPayments[${count}].Utr" type="text" class="input bulk-pay-utr" placeholder="UTR / Reference" style="height: 38px; font-size: 0.85rem;" value="${valUtr}" oninput="onBulkPaymentsChanged()" />
            <input name="BulkPayments[${count}].PaidTo" type="text" class="input bulk-pay-paidto" placeholder="Paid To" style="height: 38px; font-size: 0.85rem;" value="${valPaidTo}" oninput="onBulkPaymentsChanged()" />
            <button type="button" class="deleteButton" style="width: 34px; height: 34px;" onclick="removeBulkPaymentRow(this)" title="Remove payment row">
                <svg viewBox="0 0 448 512" class="bin"><path d="M135.2 17.7L128 32H32C14.3 32 0 46.3 0 64S14.3 96 32 96H416c17.7 0 32-14.3 32-32s-14.3-32-32-32H320l-7.2-14.3C307.4 6.8 296.3 0 284.2 0H163.8c-12.1 0-23.2 6.8-28.6 17.7zM416 128H32L53.2 467c1.6 25.3 22.6 45 47.9 45H346.9c25.3 0 46.3-19.7 47.9-45L416 128z"></path></svg>
            </button>
        `;
        rowsContainer.appendChild(row);
        onBulkPaymentsChanged();
    };

    window.removeBulkPaymentRow = function(btn) {
        const row = btn.closest('.bulk-payment-row');
        if (row) row.remove();
        reindexBulkPayments();
        onBulkPaymentsChanged();
    };

    function reindexBulkPayments() {
        const rowsContainer = document.getElementById('bulk-payments-rows');
        if (!rowsContainer) return;
        const rows = rowsContainer.querySelectorAll('.bulk-payment-row');
        rows.forEach((row, idx) => {
            const dt = row.querySelector('.bulk-pay-date');
            const pm = row.querySelector('.bulk-pay-mode');
            const amt = row.querySelector('.bulk-pay-amount');
            const utr = row.querySelector('.bulk-pay-utr');
            const pt = row.querySelector('.bulk-pay-paidto');
            if (dt) dt.name = `BulkPayments[${idx}].Date`;
            if (pm) pm.name = `BulkPayments[${idx}].PaymentMode`;
            if (amt) amt.name = `BulkPayments[${idx}].Amount`;
            if (utr) utr.name = `BulkPayments[${idx}].Utr`;
            if (pt) pt.name = `BulkPayments[${idx}].PaidTo`;
        });
    }

    window.onBulkPaymentsChanged = function() {
        const rowsContainer = document.getElementById('bulk-payments-rows');
        if (!rowsContainer) return;
        const rows = rowsContainer.querySelectorAll('.bulk-payment-row');
        if (rows.length === 0) return;

        let total = 0;
        const utrs = [];
        const paids = [];
        const modes = [];

        rows.forEach(r => {
            const a = parseFloat(r.querySelector('.bulk-pay-amount')?.value) || 0;
            total += a;
            const u = (r.querySelector('.bulk-pay-utr')?.value || '').trim();
            if (u && !utrs.includes(u)) utrs.push(u);
            const pt = (r.querySelector('.bulk-pay-paidto')?.value || '').trim();
            if (pt && !paids.includes(pt)) paids.push(pt);
            const m = (r.querySelector('.bulk-pay-mode')?.value || '').trim();
            if (m && !modes.includes(m)) modes.push(m);
        });

        const totalBadge = document.getElementById('bulk-payments-total-display');
        if (totalBadge) totalBadge.textContent = '₹' + total.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

        const totalInput = document.getElementById('total-payment-input');
        if (totalInput && total > 0) {
            totalInput.value = total.toFixed(2);
        }

        const utrInput = document.querySelector('input[name="Utr"]');
        if (utrInput && utrs.length > 0) {
            utrInput.value = utrs.join(' | ');
        }
        const paidToInput = document.querySelector('input[name="PaidTo"]');
        if (paidToInput && paids.length > 0) {
            paidToInput.value = paids.join(', ');
        }
        const modeInput = document.querySelector('select[name="PaymentMode"]');
        if (modeInput && modes.length === 1) {
            modeInput.value = modes[0];
        }

        if (window.calculateRemaining) window.calculateRemaining();
    };
});
</script>
