        row.innerHTML = `
            <input name="BulkAllocations[${count}].VehicleNo" type="text" class="input bulk-vehicle-input" value="${vehNo || ''}" placeholder="e.g. KA34C8377" required autocomplete="off" />
            <input name="BulkAllocations[${count}].Imei" type="text" class="input bulk-imei-input" placeholder="IMEI" style="font-family: monospace; font-size: 0.82rem;" />
            <div class="bulk-lifecycle-wrap" style="display: flex; align-items: center;">
                <span class="badge bulk-lifecycle-badge" style="font-size: 0.75rem; padding: 4px 10px; text-transform: uppercase; display: none;"></span>
                <span class="bulk-lifecycle-empty" style="color: var(--muted); font-size: 0.85rem;">—</span>
            </div>
            <input name="BulkAllocations[${count}].Amount" type="number" step="0.01" class="input bulk-amount-input" value="${amt || ''}" placeholder="Amount" required />
            <div style="display: flex; gap: 4px; align-items: center;">
                <select name="BulkAllocations[${count}].Extras" class="select bulk-extras-select" style="min-width: 80px;" onchange="this.nextElementSibling.style.display = (this.value && this.value !== 'None') ? 'inline-block' : 'none'; window.calculateRemaining && window.calculateRemaining();">
                    <option value="None" ${defExtras === 'None' ? 'selected' : ''}>None</option>
                    <option value="DMG" ${defExtras === 'DMG' ? 'selected' : ''}>DMG</option>
                    <option value="Tracking" ${defExtras === 'Tracking' ? 'selected' : ''}>Tracking</option>
                </select>
                <input name="BulkAllocations[${count}].ExtrasAmount" type="number" step="0.01" class="input bulk-extras-amount" placeholder="Deduct" style="width: 70px; display: none;" value="0" oninput="window.calculateRemaining && window.calculateRemaining();" />
            </div>
            <input name="BulkAllocations[${count}].ActivationDate" type="date" class="input bulk-activation-input" title="Activation Date" />
            <input name="BulkAllocations[${count}].NewExpiryDate" type="date" class="input bulk-expiry-input" title="New Expiry Date" />
            <button type="button" class="deleteButton" style="width: 32px; height: 32px; justify-self: center;" onclick="if(document.querySelectorAll('.bulk-row').length > 1) { this.closest('.bulk-row').remove(); window.reindexRows(); window.calculateRemaining(); }">
              <svg viewBox="0 0 448 512" class="bin"><path d="M135.2 17.7L128 32H32C14.3 32 0 46.3 0 64S14.3 96 32 96H416c17.7 0 32-14.3 32-32s-14.3-32-32-32H320l-7.2-14.3C307.4 6.8 296.3 0 284.2 0H163.8c-12.1 0-23.2 6.8-28.6 17.7zM416 128H32L53.2 467c1.6 25.3 22.6 45 47.9 45H346.9c25.3 0 46.3-19.7 47.9-45L416 128z"></path></svg>
            </button>
        `;
        bulkRowsContainer.appendChild(row);
        bindEvents(row);
        if (vehNo) {
            window.lookupVehicleDates(row, vehNo);
        }
    }

    document.querySelectorAll('.bulk-row').forEach(row => bindEvents(row));
    if (paymentForSelect) paymentForSelect.addEventListener("change", window.calculateRemaining);

    if (totalInput) totalInput.addEventListener("input", window.calculateRemaining);
    window.calculateRemaining();

