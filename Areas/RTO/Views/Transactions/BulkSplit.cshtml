    window.applyDefaultExtrasToAll = function(extrasVal) {
        document.querySelectorAll('.bulk-extras-select').forEach(sel => {
            sel.value = extrasVal;
            const deduct = sel.nextElementSibling;
            if (deduct) deduct.style.display = (extrasVal && extrasVal !== 'None') ? 'inline-block' : 'none';
        });
    };

    const deviceCostMap = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.DeviceCostMap ?? new Dictionary<string, decimal>()));
    const priceRecharge = parseFloat('@(ViewBag.PriceRecharge ?? "0")') || 0;
    const priceReactivation = parseFloat('@(ViewBag.PriceReactivation ?? "0")') || 0;
    const commCost = parseFloat('@(ViewBag.CommissionCost ?? "0")') || 0;
    const simCost = parseFloat('@(ViewBag.SimCost1Year ?? "0")') || 0;
    const adminCostConfig = parseFloat('@(ViewBag.AdminCost ?? "0")') || 0;
    const currentBranch = 'RTO';
    const paymentForSelect = document.getElementById("payment-for");

    window.calculateRemaining = function() {
        const total = parseFloat(totalInput.value) || 0;
        const val = paymentForSelect ? paymentForSelect.value : "None";
        const isActivation = (val === "Activation" || val === "Device");
        const isReactivation = (val === "Reactivation");
        const isRecharge = (val === "Recharge");

        let totalBaseAmount = 0;
        let totalSubtracted = 0;
        let totalCost = 0;
        let vehicleCount = 0;

        document.querySelectorAll('.bulk-row').forEach(row => {
            const amtInp = row.querySelector('.bulk-amount-input');
            const extAmtInp = row.querySelector('.bulk-extras-amount');
            const vehInp = row.querySelector('.bulk-vehicle-input');

            const rAmt = amtInp ? (parseFloat(amtInp.value) || 0) : 0;
            const rExt = extAmtInp ? (parseFloat(extAmtInp.value) || 0) : 0;
            const vehNo = vehInp ? (vehInp.value || "").trim().toUpperCase() : "";

            if ((amtInp && amtInp.value !== "") || vehNo !== "") {
                vehicleCount++;
            }

            totalBaseAmount += rAmt;
            totalSubtracted += rExt;

            let unitCost = 0;
            if (isActivation) {
                unitCost = (deviceCostMap && deviceCostMap[vehNo] !== undefined)
                    ? parseFloat(deviceCostMap[vehNo])
                    : (row.dataset.unitCost ? parseFloat(row.dataset.unitCost) : 0);
                if (currentBranch === 'RTO') {
                    unitCost += (commCost + simCost);
                }
                unitCost += adminCostConfig;
            } else if (isReactivation) {
                unitCost = priceReactivation;
            } else if (isRecharge) {
                unitCost = priceRecharge;
            } else {
                unitCost = 0;
            }
            totalCost += unitCost;
        });

        const netReceived = totalBaseAmount - totalSubtracted;
        const profit = netReceived - totalCost;
        const margin = totalBaseAmount > 0 ? ((profit / totalBaseAmount) * 100).toFixed(1) : "0.0";
        const unallocated = total - totalBaseAmount;

        const formatCurrency = (val) => new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR', minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(val);

        if (unallocatedInput) {
            unallocatedInput.value = formatCurrency(unallocated);
            unallocatedInput.style.color = unallocated < 0 ? "var(--danger)" : (unallocated === 0 ? "var(--success)" : "var(--text)");
        }

        const traceBaseAmount = document.getElementById("trace-base-amount");
        const traceSubtracted = document.getElementById("trace-subtracted");
        const traceCost = document.getElementById("trace-cost");
        const traceProfit = document.getElementById("trace-profit");
        const traceAmountBreakdown = document.getElementById("trace-amount-breakdown");
        const traceSubtractedBreakdown = document.getElementById("trace-subtracted-breakdown");
        const traceCostBreakdown = document.getElementById("trace-cost-breakdown");
        const traceProfitMargin = document.getElementById("trace-profit-margin");

        if (traceBaseAmount) traceBaseAmount.textContent = formatCurrency(totalBaseAmount);
        if (traceSubtracted) traceSubtracted.textContent = formatCurrency(totalSubtracted);
        if (traceCost) traceCost.textContent = formatCurrency(totalCost);
        if (traceAmountBreakdown) traceAmountBreakdown.textContent = `Allocated across ${vehicleCount} vehicle${vehicleCount === 1 ? '' : 's'}`;
        if (traceSubtractedBreakdown) traceSubtractedBreakdown.textContent = totalSubtracted > 0 ? `${formatCurrency(totalSubtracted)} deductions` : 'No deductions';
        if (traceCostBreakdown) {
            traceCostBreakdown.textContent = isActivation ? 'Device & activation cost' : (isReactivation ? 'Reactivation fees' : 'SIM & recharge cost');
        }

        if (traceProfit) {
            traceProfit.textContent = formatCurrency(profit);
            if (profit < 0) traceProfit.style.color = "var(--danger)";
            else if (profit > 0) traceProfit.style.color = "var(--success)";
            else traceProfit.style.color = "inherit";
        }
        if (traceProfitMargin) {
            traceProfitMargin.textContent = `${margin}% net margin (${formatCurrency(netReceived)} net)`;
        }
    };

    window.lookupVehicleDates = function(row, vehNo) {
        if (!vehNo || vehNo.trim().length < 3) return;
        const actInput = row.querySelector('.bulk-activation-input');
        const expInput = row.querySelector('.bulk-expiry-input');
        const badge = row.querySelector('.bulk-lifecycle-badge');
        const empty = row.querySelector('.bulk-lifecycle-empty');
        
        fetch('/RTO/Transactions/GetDeviceInfo?vehicleNo=' + encodeURIComponent(vehNo.trim()), { credentials: 'same-origin' })
            .then(res => res.json())
            .then(data => {
                if (data && data.isFound) {
                    const imeiInput = row.querySelector('.bulk-imei-input');
                    if (imeiInput && data.imei && (!imeiInput.value || row.dataset.autoFilled === 'true')) {
                        imeiInput.value = data.imei;
                    }
                    if (data.type) {
                        row.dataset.deviceType = data.type;
                    }
                    if (data.latestExpiryDate) {
                        row.dataset.prevExpiry = data.latestExpiryDate;
                    }
                    if (data.activationDate && (!actInput.value || row.dataset.autoFilled === 'true')) {
                        actInput.value = data.activationDate;
                    }
                    const calculatedExp = data.calculatedExpiry || data.latestExpiryDate;
                    if (calculatedExp && (!expInput.value || (row.dataset.autoFilled === 'true' && row.dataset.expiryManual !== 'true'))) {
                        expInput.value = calculatedExp;
                    }
                    const status = (data.status || data.Status || '').trim();
                    if (badge && empty) {
                        if (status) {
                            badge.textContent = status;
                            badge.className = 'badge bulk-lifecycle-badge ' + status.toLowerCase().replace(/\s+/g, '-');
                            badge.style.display = 'inline-block';
                            empty.style.display = 'none';
                        } else {
                            badge.style.display = 'none';
                            empty.style.display = 'inline';
                        }
                    }
                    if (data.unitCost !== undefined) {
                        row.dataset.unitCost = data.unitCost;
                    }
                    row.dataset.autoFilled = 'true';
                    window.calculateRemaining && window.calculateRemaining();
                }
            })
            .catch(err => console.error('Vehicle lookup error:', err));
    };

    function bindEvents(row) {
        const amtInput = row.querySelector('.bulk-amount-input');
        if (amtInput) amtInput.addEventListener("input", window.calculateRemaining);
        const extAmtInput = row.querySelector('.bulk-extras-amount');
        if (extAmtInput) extAmtInput.addEventListener("input", window.calculateRemaining);
        
        const vehInput = row.querySelector('.bulk-vehicle-input');
        if (vehInput) {
            vehInput.addEventListener("change", function() {
                window.lookupVehicleDates(row, this.value);
            });
            vehInput.addEventListener("blur", function() {
                if (!row.dataset.autoFilled) {
                    window.lookupVehicleDates(row, this.value);
                }
            });
        }

        const actInput = row.querySelector('.bulk-activation-input');
        const expInput = row.querySelector('.bulk-expiry-input');
        if (expInput) {
            expInput.addEventListener("input", function() {
                row.dataset.expiryManual = 'true';
            });
            expInput.addEventListener("change", function() {
                row.dataset.expiryManual = 'true';
            });
        }
        if (actInput && expInput) {
            actInput.addEventListener("change", function() {
                if (!actInput.value) return;
                const pFor = (paymentForSelect && paymentForSelect.value ? paymentForSelect.value : '').toLowerCase();
                if (pFor === 'other' || pFor === 'others') return;
                const devType = (row.dataset.deviceType || '').toUpperCase();
                const isNew = devType.includes('2') || devType === 'NEW' || pFor.includes('new') || pFor.includes('activation');
                if (isNew) {
                    const d = new Date(actInput.value);
                    if (isNaN(d.getTime())) return;
                    d.setFullYear(d.getFullYear() + 2);
                    expInput.value = d.toISOString().split('T')[0];
                } else {
                    const baseStr = row.dataset.prevExpiry || actInput.value;
                    const d = new Date(baseStr);
                    if (isNaN(d.getTime())) return;
                    d.setFullYear(d.getFullYear() + 1);
                    expInput.value = d.toISOString().split('T')[0];
                }
            });
        }
    }

    window.reindexRows = function() {
        const rows = document.querySelectorAll('.bulk-row');
        rows.forEach((row, idx) => {
            const veh = row.querySelector('.bulk-vehicle-input');
            const imei = row.querySelector('.bulk-imei-input');
            const amt = row.querySelector('.bulk-amount-input');
            const ext = row.querySelector('.bulk-extras-select');
            const extAmt = row.querySelector('.bulk-extras-amount');
            const act = row.querySelector('.bulk-activation-input');
            const exp = row.querySelector('.bulk-expiry-input');
            if (veh) veh.name = `BulkAllocations[${idx}].VehicleNo`;
            if (imei) imei.name = `BulkAllocations[${idx}].Imei`;
            if (amt) amt.name = `BulkAllocations[${idx}].Amount`;
            if (ext) ext.name = `BulkAllocations[${idx}].Extras`;
            if (extAmt) extAmt.name = `BulkAllocations[${idx}].ExtrasAmount`;
            if (act) act.name = `BulkAllocations[${idx}].ActivationDate`;
            if (exp) exp.name = `BulkAllocations[${idx}].NewExpiryDate`;
        });
    };

    window.distributeEvenly = function() {
        const rows = document.querySelectorAll('.bulk-row');
        if (rows.length === 0) return;
        const total = parseFloat(totalInput.value) || 0;
        if (total <= 0) {
            alert('Please enter a valid Total Payment first.');
            totalInput.focus();
            return;
        }
        const perRow = Math.floor((total / rows.length) * 100) / 100;
        let sum = 0;
        rows.forEach((r, idx) => {
            const input = r.querySelector('.bulk-amount-input');
            if (idx === rows.length - 1) {
                input.value = (total - sum).toFixed(2);
            } else {
                input.value = perRow.toFixed(2);
                sum += perRow;
            }
        });
        window.calculateRemaining();
    };

    window.setSameAmountForAll = function() {
        const val = prompt('Enter payment amount per vehicle (₹):', '2000');
        if (!val) return;
        const amt = parseFloat(val);
        if (isNaN(amt) || amt <= 0) return;
        const rows = document.querySelectorAll('.bulk-row');
        rows.forEach(r => {
            const input = r.querySelector('.bulk-amount-input');
            if (input) input.value = amt.toFixed(2);
        });
        const total = (amt * rows.length).toFixed(2);
        if (!totalInput.value || parseFloat(totalInput.value) === 0) {
            totalInput.value = total;
        }
        window.calculateRemaining();
    };

    window.setSameActivationForAll = function() {
        const firstRowAct = document.querySelector('.bulk-row .bulk-activation-input');
        const defaultVal = (firstRowAct && firstRowAct.value) ? firstRowAct.value : new Date().toISOString().split('T')[0];
        const val = prompt('Enter activation date for all vehicles (YYYY-MM-DD):', defaultVal);
        if (!val || !val.trim()) return;
        const cleanVal = val.trim();
        const d = new Date(cleanVal);
        if (isNaN(d.getTime())) {
            alert('Please enter a valid date in YYYY-MM-DD format.');
            return;
        }
        const isoAct = d.toISOString().split('T')[0];
        const pFor = (paymentForSelect && paymentForSelect.value ? paymentForSelect.value : '').toLowerCase();
        const isOther = pFor === 'other' || pFor === 'others';
        const isNew = pFor.includes('new') || pFor.includes('activation');

        const expD = new Date(isoAct);
        expD.setFullYear(expD.getFullYear() + (isNew ? 2 : 1));
        const isoExp = expD.toISOString().split('T')[0];

        document.querySelectorAll('.bulk-row').forEach(r => {
            const actInput = r.querySelector('.bulk-activation-input');
            const expInput = r.querySelector('.bulk-expiry-input');
            if (actInput) actInput.value = isoAct;
            if (expInput && !isOther) {
                expInput.value = isoExp;
                r.dataset.expiryManual = 'true';
            }
        });
    };

    window.setSameExpiryForAll = function() {
        const firstRowExp = document.querySelector('.bulk-row .bulk-expiry-input');
        const defaultVal = (firstRowExp && firstRowExp.value) ? firstRowExp.value : new Date().toISOString().split('T')[0];
        const val = prompt('Enter new expiry date for all vehicles (YYYY-MM-DD):', defaultVal);
        if (!val || !val.trim()) return;
        const cleanVal = val.trim();
        const d = new Date(cleanVal);
        if (isNaN(d.getTime())) {
            alert('Please enter a valid date in YYYY-MM-DD format.');
            return;
        }
        const iso = d.toISOString().split('T')[0];
        document.querySelectorAll('.bulk-row').forEach(r => {
            const expInput = r.querySelector('.bulk-expiry-input');
            if (expInput) {
                expInput.value = iso;
                r.dataset.expiryManual = 'true';
            }
        });
    };

    window.openQuickPasteModal = function() {
        const text = prompt('Paste vehicle registration numbers (separated by commas, spaces, or lines):');
        if (!text) return;
        const vehicles = text.split(/[\r\n,;\t\s]+/).map(v => v.trim()).filter(v => v.length >= 4);
        if (vehicles.length === 0) {
            alert('No valid vehicle numbers found.');
            return;
        }
        const firstRowVeh = document.querySelector('.bulk-row .bulk-vehicle-input');
        let startIdx = 0;
        if (firstRowVeh && !firstRowVeh.value.trim()) {
            firstRowVeh.value = vehicles[0];
            const firstRow = firstRowVeh.closest('.bulk-row');
            window.lookupVehicleDates(firstRow, vehicles[0]);
            startIdx = 1;
        }
        for (let i = startIdx; i < vehicles.length; i++) {
            addVehicleRow(vehicles[i], '');
        }
        window.reindexRows();
        window.calculateRemaining();
    };

    function addVehicleRow(vehNo, amt) {
        const row = document.createElement("div");
        row.className = "bulk-row";
        row.style.display = "grid";
        row.style.gridTemplateColumns = "1.8fr 1.1fr 1.2fr 1.3fr 1.3fr 1.3fr 40px";
        row.style.gap = "10px";
