        </h2>

        <span id="addLookupStatus" class="rc-lookup-hint" style="display:none;">

            <span class="rc-lookup-dot" id="addLookupDot"></span>

            <span id="addLookupText"></span>

        </span>

    </div>

    <div class="rc-add-body">

        <div class="rc-form-grid" id="addFormGrid">



            <div class="rc-form-field">

                <label class="rc-form-label" for="aVehicle">Vehicle No <span style="color:#ef4444;">*</span></label>

                <input type="text" id="aVehicle" class="input" placeholder="e.g. MH12AB1234" oninput="scheduleAddLookup()" autocomplete="off" required>

            </div>



            <div class="rc-form-field">

                <label class="rc-form-label" for="aDeviceStatus">Device Status</label>

                <input type="text" id="aDeviceStatus" class="input" placeholder="Auto-fills from device" readonly style="background: var(--surface); font-weight: 600;">

            </div>



            <div class="rc-form-field">

                <label class="rc-form-label" for="aImei">IMEI <span style="color:#ef4444;">*</span></label>

                <input type="text" id="aImei" class="input" placeholder="15-digit IMEI" oninput="scheduleAddLookup()" required>

            </div>



            <div class="rc-form-field">

                <label class="rc-form-label" for="aIccid">ICCID <span style="color:#ef4444;">*</span></label>

                <input type="text" id="aIccid" class="input" placeholder="ICCID" oninput="scheduleAddLookup()" required>

            </div>



            <div class="rc-form-field">

                <label class="rc-form-label" for="aSimAirtel">SIM – Airtel <span style="color:#ef4444;">*</span></label>

                <input type="text" id="aSimAirtel" class="input" placeholder="Airtel SIM No" oninput="scheduleAddLookup()" required>

            </div>



            <div class="rc-form-field">

                <label class="rc-form-label" for="aSimBsnl">SIM – BSNL <span style="color:#ef4444;">*</span></label>

                <input type="text" id="aSimBsnl" class="input" placeholder="BSNL SIM No" oninput="scheduleAddLookup()" required>

            </div>



            <div class="rc-form-field">

                <label class="rc-form-label" for="aVendor">Vendor <span style="color:#ef4444;">*</span></label>

                <input type="text" id="aVendor" class="input" placeholder="Vendor name" required>

            </div>



            <div class="rc-form-field">

                <label class="rc-form-label" for="aOperator">Network Operator <span style="color:#ef4444;">*</span></label>

                <select id="aOperator" class="select" data-custom-dropdown="NetworkOperator" data-custom-title="Network Operator" required>
                        <option value="">— Select —</option>
                        <option value="Taisys">Taisys</option>
                        <option value="Sensorise">Sensorise</option>
                    </select>

            </div>



            <div class="rc-form-field">

                <label class="rc-form-label" for="aRechargeDate">Recharge Date <span style="color:#ef4444;">*</span></label>

                <input type="date" id="aRechargeDate" class="input" onchange="onAddDateChange()" required>

            </div>



            <div class="rc-form-field">

                <label class="rc-form-label" for="aPrevExpiry">Prev. Expiry Date <span style="color:#ef4444;">*</span></label>

                <input type="date" id="aPrevExpiry" class="input" oninput="onPrevExpiryChange(true)" onchange="onPrevExpiryChange(true)" required>

            </div>



            <div class="rc-form-field">

                <label class="rc-form-label" for="aActivationDate">Activation Date</label>

                <input type="date" id="aActivationDate" class="input" oninput="onAddActDateChange()" onchange="onAddActDateChange()">

            </div>



            <div class="rc-form-field">

                <label class="rc-form-label" for="aExpiry">New Expiry Date</label>

                <input type="date" id="aExpiry" class="input">

            </div>



            <div class="rc-form-field">

                <label class="rc-form-label">Recharge Status <span style="color:#ef4444;">*</span></label>

                <div class="rc-toggle-group" id="addStatusToggle">

                    <button type="button" class="rc-toggle-btn active" data-val="Pending"   onclick="setToggle('addStatusToggle','Pending');onAddStatusToggle('Pending')">Pending</button>

                    <button type="button" class="rc-toggle-btn"        data-val="Processed" onclick="setToggle('addStatusToggle','Processed');onAddStatusToggle('Processed')">Processed</button>

                </div>

                <input type="hidden" id="aStatus" value="Pending">

            </div>



            <div class="rc-form-field">

                <label class="rc-form-label">Payment Status <span style="color:#ef4444;">*</span></label>

                <div class="rc-toggle-group" id="payToggle">

                    <button type="button" class="rc-toggle-btn active" data-val="Not Paid" onclick="setToggle('payToggle','Not Paid')">Not Paid</button>

                    <button type="button" class="rc-toggle-btn"        data-val="Paid"     onclick="setToggle('payToggle','Paid')">Paid</button>

                </div>

                <input type="hidden" id="aPayment" value="Not Paid">

            </div>



            <div class="rc-form-field span-2">

                <label class="rc-form-label" for="aNotes">Notes</label>

                <input type="text" id="aNotes" class="input" placeholder="Notes (optional)">

            </div>

        </div>



        <div class="rc-form-footer">

            <button type="button" class="button ghost" onclick="clearAddForm()">Clear</button>

            <button type="button" class="button btn-primary" id="btnAdd" onclick="submitAdd()">

                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" style="margin-right:5px"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>

                Add Recharge

            </button>

        </div>

    </div>

</div>

@* ── Filter bar ── *@

<div class="rc-filter-bar">

    <div class="rc-search-wrap">

        <svg class="rc-search-icon" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>

        <input type="text" id="rcSearch" class="input rc-search-input" placeholder="Search vehicle, IMEI, ICCID, SIM…" oninput="filterCards()">

    </div>

    <button type="button" class="button secondary small" onclick="toggleAllCards(false)" style="height:38px; font-size:.8rem;">Collapse All</button>

    <button type="button" class="button secondary small" onclick="toggleAllCards(true)" style="height:38px; font-size:.8rem;">Expand All</button>

    <button type="button" class="button secondary small" onclick="clearRechargeFilters()" style="height:38px; font-size:.8rem; display:inline-flex; align-items:center; gap:5px;" title="Reset all filters">

        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>

        <span>Clear filters</span>

    </button>

    <span class="rc-count-badge" id="rcCount"></span>

</div>



@* ── Recharges List (Inventory Batch Style Dropdown Cards) ── *@

<div class="rc-batch-list" id="rcCards">

    @if (Model.Recharges.Count == 0)

    {

        <div id="rcEmptyState" class="card" style="padding:48px; text-align:center; color:var(--muted);">

            <svg width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" style="margin:0 auto 12px; display:block; opacity:.4;"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>

            No recharge records yet. Use the form below to add your first entry.

        </div>

    }

    else

    {

        @foreach (var r in Model.Recharges)

        {

            var todayStrVal = DateTime.UtcNow.ToString("yyyy-MM-dd");

            var localTodayStrVal = DateTime.UtcNow.AddHours(5.5).ToString("yyyy-MM-dd");

            var isProcessed = r.RechargeStatus?.Equals("Processed", StringComparison.OrdinalIgnoreCase) == true;

            var isPending   = r.RechargeStatus?.Equals("Pending", StringComparison.OrdinalIgnoreCase) == true;

            var isPendingToday = isPending && (string.IsNullOrWhiteSpace(r.RechargeDate) || r.RechargeDate.CompareTo(localTodayStrVal) <= 0 || r.RechargeDate.CompareTo(todayStrVal) <= 0);

            var isPaid      = r.PaymentStatus?.Equals("Paid", StringComparison.OrdinalIgnoreCase) == true;

            var statusCls   = isProcessed ? "rc-card--processed" : (isPendingToday ? "rc-card--pending rc-card--pending-today" : "rc-card--pending");

            var sBadge      = isProcessed ? "badge-processed" : "badge-pending";

            var pBadge      = isPaid ? "badge-paid" : "badge-notpaid";



            string devStatus = "";

            if (!string.IsNullOrWhiteSpace(r.VehicleNo) && devStatusMap != null && devStatusMap.TryGetValue(r.VehicleNo.Trim(), out var ds))

            {

                devStatus = ds;

            }



            <div class="rc-card @statusCls"

                 data-vehicle="@r.VehicleNo"

                 data-imei="@r.Imei"

                 data-iccid="@r.Iccid"

                 data-sim-airtel="@r.SimAirtel"

                 data-sim-bsnl="@r.SimBsnl"

                 data-status="@r.RechargeStatus?.ToLowerInvariant()"

                 data-payment="@r.PaymentStatus?.ToLowerInvariant()"

                 data-operator="@r.NetworkOperator?.ToLowerInvariant()"

                 data-pending-today="@(isPendingToday ? "true" : "false")"

                 data-recharge-date="@r.RechargeDate">



                @* Header bar (Click to toggle accordion dropdown) *@

                <div class="rc-card-header" onclick="toggleCard(this)">

                    <div class="rc-card-left">

                        <svg class="rc-chevron" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>

                        <div class="rc-card-title-group">

                            <div class="rc-card-title-row">

                                <span class="rc-card-vehicle">@(string.IsNullOrWhiteSpace(r.VehicleNo) ? "No Vehicle" : r.VehicleNo)</span>

                                @if (isPendingToday)

                                {

                                    <span class="rc-badge" style="background: #fee2e2; color: #b91c1c; border: 1.5px solid #fca5a5; font-weight: 800; display: inline-flex; align-items: center; gap: 4px;">⚡ Pending Today</span>

                                }

                                else

                                {

                                    <span class="rc-badge @sBadge">@r.RechargeStatus</span>

                                }

                                <span class="rc-badge @pBadge">@r.PaymentStatus</span>

                                @if (!string.IsNullOrWhiteSpace(devStatus))

                                {

                                    <span class="rc-badge badge-device" title="Fleet device status">@devStatus</span>

                                }

                                @if (!string.IsNullOrWhiteSpace(r.NetworkOperator))

                                {

                                    <span class="rc-badge badge-operator">@r.NetworkOperator</span>

                                }

                            </div>

                            <div class="rc-card-subtitle">

                                <span>Recharge: <strong>@(string.IsNullOrWhiteSpace(r.RechargeDate) ? "—" : r.RechargeDate)</strong></span>

                                <span>&middot;</span>

                                <span>Prev Exp: <strong>@(string.IsNullOrWhiteSpace(r.PreviousExpiryDate) ? "—" : r.PreviousExpiryDate)</strong></span>

                                <span>&middot;</span>

                                <span>Act Date: <strong>@(string.IsNullOrWhiteSpace(r.ActivationDate) ? "—" : r.ActivationDate)</strong></span>

                                <span>&middot;</span>

                                <span>New Exp: <strong>@(string.IsNullOrWhiteSpace(r.ExpiryDate) ? "—" : r.ExpiryDate)</strong></span>

                                @if (!string.IsNullOrWhiteSpace(r.Vendor))

                                {

                                    <span>&middot;</span>

                                    <span>Vendor: @r.Vendor</span>

                                }

                            </div>

                        </div>

                    </div>



                    @* Action buttons (stay clickable even when dropdown is collapsed) *@

                    <div class="rc-card-actions" onclick="event.stopPropagation()">

                        @{

                            string? txnId = null;

                            if (isPaid && rechargeTxnMap != null)

                            {

                                rechargeTxnMap.TryGetValue(r.Id, out txnId);

                            }

                        }

                        @if (isPaid)

                        {

                            var editTxnUrl = !string.IsNullOrEmpty(txnId)

                                ? $"/{currentBranch}/Transactions/Edit/{txnId}?rechargeId={r.Id}"

                                : $"/{currentBranch}/Recharges/OpenTransaction?id={r.Id}&vehicleNo={Uri.EscapeDataString(r.VehicleNo ?? "")}";



                            <a href="@editTxnUrl"

                               class="rc-pay-btn rc-pay-btn--paid"

                               title="View / Edit payment transaction for @r.VehicleNo">

                                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>

                                Paid

                            </a>

                        }

                        else

                        {

                            <a href="/@currentBranch/Transactions/Create?vehicleNo=@(Uri.EscapeDataString(r.VehicleNo ?? ""))&paymentFor=None&rechargeId=@r.Id"

                               class="rc-pay-btn rc-pay-btn--due"

                               title="Add payment transaction for @r.VehicleNo">

                                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>

                                Pay Now

                            </a>

                        }



                        <button type="button" class="rc-edit-btn" onclick="openEdit(this)" title="Edit recharge">

                            <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>

                            Edit

                        </button>



                        <button type="button" class="rc-delete-btn" onclick="deleteCard('@r.Id', this)" title="Delete recharge">

                            <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>

                        </button>

                    </div>

                </div>



                @* Hidden fields stored on hidden inputs for easy edit retrieval *@

                <div class="rc-card-data" style="display:none;"

                     data-id="@r.Id"

                     data-vehicle="@r.VehicleNo"

                     data-imei="@r.Imei"

                     data-iccid="@r.Iccid"

                     data-sim-airtel="@r.SimAirtel"

                     data-sim-bsnl="@r.SimBsnl"

                     data-vendor="@r.Vendor"

                     data-operator="@r.NetworkOperator"

                     data-payment="@r.PaymentStatus"

                     data-status="@r.RechargeStatus"

                     data-recharge-date="@r.RechargeDate"

                     data-expiry="@r.ExpiryDate"

                     data-prev-expiry="@r.PreviousExpiryDate"

                     data-act-date="@r.ActivationDate"

                     data-notes="@r.Notes">

                </div>



                @* Collapsible details body (starts collapsed) *@

                <div class="rc-card-body" style="display:none;">

                    <div class="rc-grid">

                        <div class="rc-field">

                            <span class="rc-field-label">Vehicle No</span>

                            <span class="rc-field-value">@(string.IsNullOrWhiteSpace(r.VehicleNo) ? "—" : r.VehicleNo)</span>

                        </div>

                        <div class="rc-field">

                            <span class="rc-field-label">IMEI</span>

                            <span class="rc-field-value mono @(string.IsNullOrWhiteSpace(r.Imei) ? "muted" : "")">@(string.IsNullOrWhiteSpace(r.Imei) ? "—" : r.Imei)</span>

                        </div>

                        <div class="rc-field">

                            <span class="rc-field-label">ICCID</span>

                            <span class="rc-field-value mono @(string.IsNullOrWhiteSpace(r.Iccid) ? "muted" : "")">@(string.IsNullOrWhiteSpace(r.Iccid) ? "—" : r.Iccid)</span>

                        </div>

                        <div class="rc-field">

                            <span class="rc-field-label">SIM – Airtel</span>

                            <span class="rc-field-value mono @(string.IsNullOrWhiteSpace(r.SimAirtel) ? "muted" : "")">@(string.IsNullOrWhiteSpace(r.SimAirtel) ? "—" : r.SimAirtel)</span>

                        </div>

                        <div class="rc-field">

                            <span class="rc-field-label">SIM – BSNL</span>

                            <span class="rc-field-value mono @(string.IsNullOrWhiteSpace(r.SimBsnl) ? "muted" : "")">@(string.IsNullOrWhiteSpace(r.SimBsnl) ? "—" : r.SimBsnl)</span>

                        </div>

                        <div class="rc-field">

                            <span class="rc-field-label">Vendor</span>

                            <span class="rc-field-value @(string.IsNullOrWhiteSpace(r.Vendor) ? "muted" : "")">@(string.IsNullOrWhiteSpace(r.Vendor) ? "—" : r.Vendor)</span>

                        </div>

                        <div class="rc-field">

                            <span class="rc-field-label">Network Operator</span>

                            <span class="rc-field-value @(string.IsNullOrWhiteSpace(r.NetworkOperator) ? "muted" : "")">@(string.IsNullOrWhiteSpace(r.NetworkOperator) ? "—" : r.NetworkOperator)</span>

                        </div>

                        <div class="rc-field">

                            <span class="rc-field-label">Recharge Date</span>

                            <span class="rc-field-value">@(string.IsNullOrWhiteSpace(r.RechargeDate) ? "—" : r.RechargeDate)</span>

                        </div>

                        <div class="rc-field">

                            <span class="rc-field-label">Prev. Expiry Date</span>

                            <span class="rc-field-value @(string.IsNullOrWhiteSpace(r.PreviousExpiryDate) ? "muted" : "")">@(string.IsNullOrWhiteSpace(r.PreviousExpiryDate) ? "—" : r.PreviousExpiryDate)</span>

                        </div>

                        <div class="rc-field">

                            <span class="rc-field-label">Activation Date</span>

                            <span class="rc-field-value @(string.IsNullOrWhiteSpace(r.ActivationDate) ? "muted" : "")">@(string.IsNullOrWhiteSpace(r.ActivationDate) ? "—" : r.ActivationDate)</span>

                        </div>

                        <div class="rc-field">

                            <span class="rc-field-label">New Expiry Date</span>

                            <span class="rc-field-value @(string.IsNullOrWhiteSpace(r.ExpiryDate) ? "muted" : "")">@(string.IsNullOrWhiteSpace(r.ExpiryDate) ? "—" : r.ExpiryDate)</span>

                        </div>

                    </div>

                    @if (!string.IsNullOrWhiteSpace(r.Notes))

                    {

                        <div class="rc-card-notes">📝 @r.Notes</div>

                    }

                </div>

            </div>

        }

    }

</div>

<div id="rcNoResults" style="display:none; padding:36px; text-align:center; color:var(--muted);">

    No recharge records match the current filters.

</div>






