</div>



<script>

const todayStr = new Date().toISOString().split('T')[0];



// Set today as default recharge date on load

document.getElementById('aRechargeDate').value = todayStr;



// ── Accordion Card Toggle ──

function toggleCard(headerEl) {

    const card = headerEl.closest('.rc-card');

    const body = headerEl.nextElementSibling?.classList.contains('rc-card-body') 

        ? headerEl.nextElementSibling 

        : headerEl.parentElement.querySelector('.rc-card-body');

    const chevron = headerEl.querySelector('.rc-chevron');

    if (body) {

        const isCollapsed = body.style.display === 'none';

        body.style.display = isCollapsed ? '' : 'none';

        card.classList.toggle('is-open', isCollapsed);

        if (chevron) chevron.style.transform = isCollapsed ? 'rotate(0deg)' : 'rotate(-90deg)';

    }

}



function toggleAllCards(expand) {

    document.querySelectorAll('#rcCards .rc-card').forEach(card => {

        const body = card.querySelector('.rc-card-body');

        const chevron = card.querySelector('.rc-chevron');

        if (body) {

            body.style.display = expand ? '' : 'none';

            card.classList.toggle('is-open', expand);

            if (chevron) chevron.style.transform = expand ? 'rotate(0deg)' : 'rotate(-90deg)';

        }

    });

}



// ── Toggle group ──

function setToggle(groupId, value) {

    const hiddenMap = { addStatusToggle: 'aStatus', payToggle: 'aPayment', editStatusToggle: 'eStatus', editPayToggle: 'ePayment' };

    document.getElementById(groupId).querySelectorAll('.rc-toggle-btn').forEach(b => b.classList.toggle('active', b.dataset.val === value));

    document.getElementById(hiddenMap[groupId]).value = value;

}



// ── Auto-expiry on add form ──

function calculateExpiryFromDate(dateStr, isNewRto) {

    if (!dateStr) return '';

    const parts = dateStr.split('-');

    if (parts.length !== 3) return '';

    const y = parseInt(parts[0], 10);

    const m = parseInt(parts[1], 10) - 1;

    const d = parseInt(parts[2], 10);

    const monthsToAdd = isNewRto ? 23 : 11;

    const daysToAdd = 15;

    const dt = new Date(y, m + monthsToAdd, d + daysToAdd);

    const resY = dt.getFullYear();

    const resM = String(dt.getMonth() + 1).padStart(2, '0');

    const resD = String(dt.getDate()).padStart(2, '0');

    return `${resY}-${resM}-${resD}`;

}



function addYearsToDate(dateStr, years) {

    if (!dateStr) return '';

    dateStr = String(dateStr).trim();

    let y, m, d;

    let match = dateStr.match(/^(\d{4})[-\/.](\d{1,2})[-\/.](\d{1,2})/);

    if (match) {

        y = parseInt(match[1], 10);

        m = match[2].padStart(2, '0');

        d = match[3].padStart(2, '0');

    } else {

        match = dateStr.match(/^(\d{1,2})[-\/.](\d{1,2})[-\/.](\d{4})/);

        if (match) {

            y = parseInt(match[3], 10);

            m = match[2].padStart(2, '0');

            d = match[1].padStart(2, '0');

        } else {

            return '';

        }

    }

    y += (years || 1);

    if (isNaN(y) || y < 1900 || y > 2100) return '';

    if (m === '02' && d === '29') {

        const isLeap = (y % 4 === 0 && y % 100 !== 0) || (y % 400 === 0);

        return `${y}-02-${isLeap ? '29' : '28'}`;

    }

    return `${y}-${m}-${d}`;

}



// Dynamically updates New Expiry Date when Prev. Expiry Date changes

function onPrevExpiryChange(isAdd) {

    const prefix = isAdd ? 'a' : 'e';

    const statusVal = document.getElementById(prefix + 'Status')?.value || '';

    const expInput = document.getElementById(prefix + 'Expiry');

    if (!expInput) return;



    const prevExp = (document.getElementById(prefix + 'PrevExpiry')?.value || '').trim();

    if (prevExp) {

        const next = addYearsToDate(prevExp, 1);

        if (next) {

            if (statusVal === 'Processed' || expInput.value) {

                expInput.value = next;

            }

        }

    } else if (statusVal === 'Processed') {

        const actInput = document.getElementById(prefix + 'ActivationDate');

        const rechargeDate = (document.getElementById(prefix + 'RechargeDate')?.value || todayStr).trim();

        if (actInput && actInput.value) {

            expInput.value = calculateExpiryFromDate(actInput.value, false);

        } else {

            expInput.value = calculateExpiryFromDate(rechargeDate || todayStr, false);

        }

    }

}



// Applies Taisys-specific lifecycle recharge rules or generic recharge expiry rules

function applyTaisysRechargeDates(isAdd) {

    const prefix = isAdd ? 'a' : 'e';

    const statusVal = document.getElementById(prefix + 'Status')?.value || '';

    if (statusVal !== 'Processed') return;



    if (isAdd) {

        onAddStatusToggle('Processed');

    } else {

        onEditStatusToggle('Processed');

    }

}



function onAddStatusToggle(status) {

    const actInput = document.getElementById('aActivationDate');

    const expInput = document.getElementById('aExpiry');

    if (status === 'Processed') {

        const opVal = (document.getElementById('aOperator')?.value || '').trim();

        const isTaisys = opVal.toLowerCase().includes('taisys');

        const devStatus = (document.getElementById('aDeviceStatus')?.value || '').trim().toLowerCase();

        const prevExpiry = (document.getElementById('aPrevExpiry')?.value || '').trim();

        const rechargeDate = (document.getElementById('aRechargeDate')?.value || todayStr).trim();



        if (isTaisys && (devStatus.includes('terminat') || devStatus.includes('dead'))) {

            actInput.value = actInput.value || rechargeDate;

            expInput.value = calculateExpiryFromDate(actInput.value || rechargeDate, false);

        } else {

            actInput.value = actInput.value || rechargeDate || todayStr;

            if (prevExpiry) {

                expInput.value = addYearsToDate(prevExpiry, 1);

            } else {

                expInput.value = calculateExpiryFromDate(actInput.value, false);

            }

        }

    } else {

        actInput.value = '';

        expInput.value = '';

    }

}



function onAddActDateChange() {

    const actInput = document.getElementById('aActivationDate');

    const expInput = document.getElementById('aExpiry');

    const prevExp = (document.getElementById('aPrevExpiry')?.value || '').trim();

    if (!expInput) return;

    if (prevExp) {

        expInput.value = addYearsToDate(prevExp, 1);

    } else if (actInput && actInput.value) {

        const isNewRto = '@currentBranch' === 'RTO';

        expInput.value = calculateExpiryFromDate(actInput.value, isNewRto);

    } else {

        expInput.value = '';

    }

}



function onEditStatusToggle(status) {

    const actInput = document.getElementById('eActivationDate');

    const expInput = document.getElementById('eExpiry');

    if (status === 'Processed') {

        const opVal = (document.getElementById('eOperator')?.value || '').trim();

        const isTaisys = opVal.toLowerCase().includes('taisys');

        const devStatus = (document.getElementById('eDeviceStatus')?.value || '').trim().toLowerCase();

        const prevExpiry = (document.getElementById('ePrevExpiry')?.value || '').trim();

        const rechargeDate = (document.getElementById('eRechargeDate')?.value || todayStr).trim();



        if (isTaisys && (devStatus.includes('terminat') || devStatus.includes('dead'))) {

            actInput.value = actInput.value || rechargeDate;

            expInput.value = calculateExpiryFromDate(actInput.value || rechargeDate, false);

        } else {

            actInput.value = actInput.value || rechargeDate || todayStr;

            if (prevExpiry) {

                expInput.value = addYearsToDate(prevExpiry, 1);

            } else {

                expInput.value = expInput.value || calculateExpiryFromDate(actInput.value, false);

            }

        }

    } else {

        actInput.value = '';

        expInput.value = '';

    }

}



function onEditActDateChange() {

    const actInput = document.getElementById('eActivationDate');

    const expInput = document.getElementById('eExpiry');

    const prevExp = (document.getElementById('ePrevExpiry')?.value || '').trim();

    if (!expInput) return;

    if (prevExp) {

        expInput.value = addYearsToDate(prevExp, 1);

    } else if (actInput && actInput.value) {

        const isNewRto = '@currentBranch' === 'RTO';

        expInput.value = calculateExpiryFromDate(actInput.value, isNewRto);

    } else {

        expInput.value = '';

    }

}



function onAddDateChange() {

    if (document.getElementById('aStatus').value === 'Processed') {

        onAddStatusToggle('Processed');

    }

}



// ── Lookup (add form) ──

let addLookupTimer = null;

function scheduleAddLookup() {

    clearTimeout(addLookupTimer);

    addLookupTimer = setTimeout(doAddLookup, 300);

}

async function doAddLookup() {

    const q = document.getElementById('aVehicle').value.trim()

           || document.getElementById('aImei').value.trim()

           || document.getElementById('aIccid').value.trim()

           || document.getElementById('aSimAirtel').value.trim()

           || document.getElementById('aSimBsnl').value.trim();

    if (!q || q.length < 3) { hideLookupStatus(); return; }

    try {

        const res = await fetch(`@Url.Action("Lookup", "Recharges")?query=${encodeURIComponent(q)}`);

        if (!res.ok) return;

        const data = await res.json();

        if (data.found) {

            if (data.vehicleNo       && !document.getElementById('aVehicle').value)   document.getElementById('aVehicle').value   = data.vehicleNo;

            if (data.imei            && !document.getElementById('aImei').value)      document.getElementById('aImei').value      = data.imei;

            if (data.iccid           && !document.getElementById('aIccid').value)     document.getElementById('aIccid').value     = data.iccid;

            if (data.simAirtel       && !document.getElementById('aSimAirtel').value) document.getElementById('aSimAirtel').value = data.simAirtel;

            if (data.simBsnl         && !document.getElementById('aSimBsnl').value)   document.getElementById('aSimBsnl').value   = data.simBsnl;

            if (data.vendor          && !document.getElementById('aVendor').value)    document.getElementById('aVendor').value    = data.vendor;

            if (data.networkOperator) {

                const opSelect = document.getElementById('aOperator');

                if (opSelect) {

                    let matched = false;

                    for (let i = 0; i < opSelect.options.length; i++) {

                        if (opSelect.options[i].value.trim().toLowerCase() === data.networkOperator.trim().toLowerCase()) {

                            opSelect.selectedIndex = i;

                            matched = true;

                            break;

                        }

                    }

                    if (!matched && data.networkOperator.trim()) {

                        const opt = document.createElement('option');

                        opt.value = data.networkOperator.trim();

                        opt.textContent = data.networkOperator.trim();

                        const addNew = opSelect.querySelector('option[value="__ADD_NEW__"]');

                        if (addNew) opSelect.insertBefore(opt, addNew);

                        else opSelect.appendChild(opt);

                        opSelect.value = data.networkOperator.trim();

                    }

                }

            }

            if (data.latestExpiryDate) {

                document.getElementById('aPrevExpiry').value = data.latestExpiryDate;

            }

            if (data.status) {

                document.getElementById('aDeviceStatus').value = data.status;

            }

            if (document.getElementById('aStatus').value === 'Processed') {

                onAddStatusToggle('Processed');

            } else if (data.activationDate) {

                document.getElementById('aActivationDate').value = data.activationDate;

            }

            const statusText = data.status ? ` (Status: ${data.status})` : '';

            showLookupStatus(`Device found: ${data.vehicleNo || q}${statusText}`, true);

        } else {

            showLookupStatus('No device found with that identifier', false);

        }

    } catch { hideLookupStatus(); }

}

function showLookupStatus(msg, found) {

    document.getElementById('addLookupStatus').style.display = 'flex';

    document.getElementById('addLookupDot').className = 'rc-lookup-dot ' + (found ? 'found' : 'notfound');

    document.getElementById('addLookupText').textContent = msg;

}

function hideLookupStatus() { document.getElementById('addLookupStatus').style.display = 'none'; }



// ── Clear add form ──

function clearAddForm() {

    ['aVehicle','aImei','aIccid','aSimAirtel','aSimBsnl','aVendor','aNotes','aDeviceStatus','aActivationDate'].forEach(id => document.getElementById(id).value = '');

    document.getElementById('aOperator').value     = '';

    document.getElementById('aRechargeDate').value = todayStr;

    document.getElementById('aPrevExpiry').value   = '';

    document.getElementById('aExpiry').value       = '';

    setToggle('addStatusToggle', 'Pending');

    setToggle('payToggle', 'Not Paid');

    hideLookupStatus();

}



// ── Validation helper ──

function validateRechargeForm(prefix) {

    const fields = [

        { id: prefix + 'Vehicle', name: 'Vehicle No' },

        { id: prefix + 'Imei', name: 'IMEI' },

        { id: prefix + 'Iccid', name: 'ICCID' },

        { id: prefix + 'SimAirtel', name: 'SIM – Airtel' },

        { id: prefix + 'SimBsnl', name: 'SIM – BSNL' },

        { id: prefix + 'Vendor', name: 'Vendor' },

        { id: prefix + 'Operator', name: 'Network Operator' },

        { id: prefix + 'RechargeDate', name: 'Recharge Date' },

        { id: prefix + 'PrevExpiry', name: 'Prev. Expiry Date' }

    ];



    // Clear optional fields border

    [prefix + 'ActivationDate', prefix + 'Expiry', prefix + 'Notes'].forEach(id => {

        const el = document.getElementById(id);

        if (el) { el.style.borderColor = ''; el.style.boxShadow = ''; }

    });



    const missing = [];

    let firstInvalidEl = null;



    fields.forEach(f => {

        const el = document.getElementById(f.id);

        if (!el) return;

        const val = el.value ? el.value.trim() : '';

        if (!val) {

            missing.push(f.name);

            el.style.borderColor = '#ef4444';

            el.style.boxShadow = '0 0 0 1px #ef4444';

            if (!firstInvalidEl) firstInvalidEl = el;

        } else {

            el.style.borderColor = '';

            el.style.boxShadow = '';

        }

    });



    if (missing.length > 0) {

        Swal.fire({

            icon: 'warning',

            title: 'All Fields Are Required',

            html: `<div style="text-align: left; font-size: 0.88rem; line-height: 1.5;">

                <p style="margin-bottom: 8px;">Please fill in all the required fields before submitting this recharge.</p>

                <strong>Missing required fields:</strong>

                <ul style="margin: 8px 0 0 16px; padding: 0; color: #dc2626;">

                    ${missing.map(m => `<li>${m}</li>`).join('')}

                </ul>

            </div>`,

            confirmButtonColor: '#2563eb'

        });

        if (firstInvalidEl) firstInvalidEl.focus();

        return false;

    }

    return true;

}



// ── Duplicate checking helpers ──

function normalizeDateStr(d) {

    if (!d) return '';

    d = (d + '').trim();

    const isoMatch = d.match(/^(\d{4})[-\/](\d{1,2})[-\/](\d{1,2})/);

    if (isoMatch) {

        return `${isoMatch[1]}-${isoMatch[2].padStart(2, '0')}-${isoMatch[3].padStart(2, '0')}`;

    }

    const dmyMatch = d.match(/^(\d{1,2})[-\/](\d{1,2})[-\/](\d{4})/);

    if (dmyMatch) {

        return `${dmyMatch[3]}-${dmyMatch[2].padStart(2, '0')}-${dmyMatch[1].padStart(2, '0')}`;

    }

    const dt = new Date(d);

    if (!isNaN(dt.getTime())) {

        const y = dt.getFullYear();

        const m = String(dt.getMonth() + 1).padStart(2, '0');

        const day = String(dt.getDate()).padStart(2, '0');

        return `${y}-${m}-${day}`;

    }

    return d.toLowerCase();

}



function isSameDevice(vehA, imeiA, iccidA, vehB, imeiB, iccidB) {

    const vA = (vehA || '').trim().toLowerCase();

    const vB = (vehB || '').trim().toLowerCase();

    const iA = (imeiA || '').trim().toLowerCase();

    const iB = (imeiB || '').trim().toLowerCase();

    const cA = (iccidA || '').trim().toLowerCase();

    const cB = (iccidB || '').trim().toLowerCase();



    if (vA && vB && vA === vB) return true;

    if (iA && iB && iA === iB) return true;

    if (cA && cB && cA === cB) return true;

    if (iA && cB && iA === cB) return true;

    if (cA && iB && cA === iB) return true;

    return false;

}



function isSameRechargePeriod(newA, prevA, newB, prevB) {

    const cNewA = normalizeDateStr(newA);

    const cNewB = normalizeDateStr(newB);

    const cPrevA = normalizeDateStr(prevA);

    const cPrevB = normalizeDateStr(prevB);



    const hasNewA = !!cNewA;

    const hasNewB = !!cNewB;



    if (hasNewA && hasNewB) {

        return cNewA === cNewB;

    }



    if (!hasNewA && !hasNewB) {

        if (cPrevA && cPrevB) {

            return cPrevA === cPrevB;

        }

        return true;

    }



    const specifiedNew = hasNewA ? cNewA : cNewB;

    const otherPrev = hasNewA ? cPrevB : cPrevA;



    if (specifiedNew && otherPrev) {

        return specifiedNew === otherPrev;

    }



    return false;

}



function checkDuplicateRecharge(vehicle, imei, iccid, expiry, prevExpiry, excludeId) {

    const cleanVeh = (vehicle || '').trim();

    const cleanImei = (imei || '').trim();

    const cleanIccid = (iccid || '').trim();



    if (!cleanVeh && !cleanImei && !cleanIccid) return null;



    const cards = document.querySelectorAll('.rc-card-data');

    for (const card of cards) {

        const d = card.dataset;

        if (!d) continue;

        if (excludeId && d.id === excludeId) continue;



        const sameDev = isSameDevice(cleanVeh, cleanImei, cleanIccid, d.vehicle, d.imei, d.iccid);

        if (!sameDev) continue;



        if (isSameRechargePeriod(expiry, prevExpiry, d.expiry, d.prevExpiry)) {

            return {

                id: d.id,

                vehicle: d.vehicle,

                imei: d.imei,

                iccid: d.iccid,

                expiryDate: d.expiry,

                prevExpiryDate: d.prevExpiry

            };

        }

    }

    return null;

}



// ── Submit add ──

async function submitAdd() {

    if (!validateRechargeForm('a')) {

        return;

    }



    const vehicle = document.getElementById('aVehicle').value.trim();

    const imei = document.getElementById('aImei').value.trim();

    const iccid = document.getElementById('aIccid').value.trim();

    const expiry = document.getElementById('aExpiry').value.trim();

    const prevExpiry = document.getElementById('aPrevExpiry').value.trim();



    const dup = checkDuplicateRecharge(vehicle, imei, iccid, expiry, prevExpiry, null);

    if (dup) {

        Swal.fire({

            icon: 'warning',

            title: 'Already Present',

            text: 'Recharge record is already present.',

            confirmButtonColor: '#2563eb'

        });

        return;

    }



    const btn = document.getElementById('btnAdd');

    btn.disabled = true;

    const oldHtml = btn.innerHTML;

    btn.innerHTML = 'Saving...';

    const payload = [{

        VehicleNo:          vehicle,

        Imei:               imei,

        Iccid:              iccid,

        SimAirtel:          document.getElementById('aSimAirtel').value.trim(),

        SimBsnl:            document.getElementById('aSimBsnl').value.trim(),

        Vendor:             document.getElementById('aVendor').value.trim(),

        NetworkOperator:    document.getElementById('aOperator').value,

        PaymentStatus:      document.getElementById('aPayment').value,

        RechargeStatus:     document.getElementById('aStatus').value,

        RechargeDate:       document.getElementById('aRechargeDate').value,

        ExpiryDate:         expiry,

        PreviousExpiryDate: document.getElementById('aPrevExpiry').value,

        ActivationDate:     document.getElementById('aActivationDate').value,

        Notes:              document.getElementById('aNotes').value.trim(),

    }];

    try {

        const res = await fetch('@Url.Action("BulkSave", "Recharges")', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });

        if (res.ok) {

            await Swal.fire({ icon: 'success', title: 'Recharge Saved!', timer: 800, showConfirmButton: false });

            window.location.reload();

        } else {

            const errData = await res.json().catch(() => ({}));

            if (errData.duplicate || (errData.message && errData.message.toLowerCase().includes('already present'))) {

                Swal.fire({

                    icon: 'warning',

                    title: 'Already Present',

                    text: 'Recharge record is already present.',

                    confirmButtonColor: '#2563eb'

                });

            } else {

                Swal.fire('Validation Error', errData.message || (res.status === 405 ? 'Request routing error. Please refresh the page.' : 'Failed to save recharge. Please check the details and try again.'), 'error');

            }

            btn.disabled = false;

            btn.innerHTML = oldHtml;

        }

    } catch {

        Swal.fire('Error', 'Network error.', 'error');

        btn.disabled = false;

        btn.innerHTML = oldHtml;

    }

}



// ── Edit modal ──

function openEdit(btn) {

    const card = btn.closest('.rc-card');

    const d = card.querySelector('.rc-card-data')?.dataset || btn.dataset;

    document.getElementById('eId').value             = d.id           || '';

    document.getElementById('eVehicle').value        = d.vehicle      || '';

    document.getElementById('eDeviceStatus').value   = card.querySelector('.badge-device')?.textContent.trim() || '';

    document.getElementById('eImei').value           = d.imei         || '';

    document.getElementById('eIccid').value          = d.iccid        || '';

    document.getElementById('eSimAirtel').value      = d.simAirtel    || '';

    document.getElementById('eSimBsnl').value        = d.simBsnl      || '';

    document.getElementById('eVendor').value         = d.vendor       || '';

    const eOp = (d.operator || '').trim();

    const eSelect = document.getElementById('eOperator');

    if (eSelect) {

        let matched = false;

        for (let i = 0; i < eSelect.options.length; i++) {

            if (eSelect.options[i].value.trim().toLowerCase() === eOp.toLowerCase()) {

                eSelect.selectedIndex = i;

                matched = true;

                break;

            }

        }

        if (!matched && eOp) {

            const opt = document.createElement('option');

            opt.value = eOp;

            opt.textContent = eOp;

            const addNew = eSelect.querySelector('option[value="__ADD_NEW__"]');

            if (addNew) eSelect.insertBefore(opt, addNew);

            else eSelect.appendChild(opt);

            eSelect.value = eOp;

        } else if (!eOp) {

            eSelect.value = '';

        }

    }

    document.getElementById('eRechargeDate').value   = d.rechargeDate || '';

    document.getElementById('ePrevExpiry').value     = d.prevExpiry   || '';

    document.getElementById('eActivationDate').value = d.actDate      || '';

    document.getElementById('eExpiry').value         = d.expiry       || '';

    document.getElementById('eNotes').value          = d.notes        || '';

    setToggle('editStatusToggle', d.status  || 'Pending');

    setToggle('editPayToggle',    d.payment || 'Not Paid');

    if ((d.status || '').toLowerCase() === 'processed' || document.getElementById('eStatus').value === 'Processed') {

        if (!document.getElementById('eActivationDate').value || !document.getElementById('eExpiry').value) {

            onEditStatusToggle('Processed');

        }

    }

    document.getElementById('editModalBg').classList.add('open');

    document.body.style.overflow = 'hidden';

    setTimeout(() => document.getElementById('eVehicle').focus(), 50);

}

function closeEdit(e) { if (e.target === document.getElementById('editModalBg')) closeEditModal(); }

function closeEditModal() {

    document.getElementById('editModalBg').classList.remove('open');

    document.body.style.overflow = '';

}



// ── Submit edit ──

async function submitEdit() {

    if (!validateRechargeForm('e')) {

        return;

    }



    const editId = document.getElementById('eId').value;

    const vehicle = document.getElementById('eVehicle').value.trim();

    const imei = document.getElementById('eImei').value.trim();

    const iccid = document.getElementById('eIccid').value.trim();

    const expiry = document.getElementById('eExpiry').value.trim();

    const prevExpiry = document.getElementById('ePrevExpiry').value.trim();



    const dup = checkDuplicateRecharge(vehicle, imei, iccid, expiry, prevExpiry, editId);

    if (dup) {

        Swal.fire({

            icon: 'warning',

            title: 'Already Present',

            text: 'Recharge record is already present.',

            confirmButtonColor: '#2563eb'

        });

        return;

    }



    const btn = document.getElementById('btnSaveEdit');

    btn.disabled = true;

    const oldHtml = btn.innerHTML;

    btn.innerHTML = 'Saving...';

    const payload = [{

        Id:                 editId,

        VehicleNo:          vehicle,

        Imei:               imei,

        Iccid:              iccid,

        SimAirtel:          document.getElementById('eSimAirtel').value.trim(),

        SimBsnl:            document.getElementById('eSimBsnl').value.trim(),

        Vendor:             document.getElementById('eVendor').value.trim(),

        NetworkOperator:    document.getElementById('eOperator').value,

        PaymentStatus:      document.getElementById('ePayment').value,

        RechargeStatus:     document.getElementById('eStatus').value,

        RechargeDate:       document.getElementById('eRechargeDate').value,

        ExpiryDate:         expiry,

        PreviousExpiryDate: document.getElementById('ePrevExpiry').value,

        ActivationDate:     document.getElementById('eActivationDate').value,

        Notes:              document.getElementById('eNotes').value.trim(),

    }];

    try {

        const res = await fetch('@Url.Action("BulkSave", "Recharges")', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });

        if (res.ok) {

            closeEditModal();

            await Swal.fire({ icon: 'success', title: 'Updated!', timer: 800, showConfirmButton: false });

            window.location.reload();

        } else {

            const errData = await res.json().catch(() => ({}));

            if (errData.duplicate || (errData.message && errData.message.toLowerCase().includes('already present'))) {

                Swal.fire({

                    icon: 'warning',

                    title: 'Already Present',

                    text: 'Recharge record is already present.',

                    confirmButtonColor: '#2563eb'

                });

            } else {

                Swal.fire('Validation Error', errData.message || (res.status === 405 ? 'Request routing error. Please refresh the page.' : 'Failed to save changes. Please check the details and try again.'), 'error');

            }

            btn.disabled = false;

            btn.innerHTML = oldHtml;

        }

    } catch {

        Swal.fire('Error', 'Network error.', 'error');

        btn.disabled = false;

        btn.innerHTML = oldHtml;

    }

}



// ── Delete ──

async function deleteCard(id, btn) {

    const confirmed = await Swal.fire({ title: 'Delete this recharge?', text: 'This cannot be undone.', icon: 'warning', showCancelButton: true, confirmButtonColor: '#b42318', confirmButtonText: 'Delete', cancelButtonText: 'Cancel' });

    if (!confirmed.isConfirmed) return;

    try {

        const res = await fetch('@Url.Action("Delete", "Recharges")', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: 'id=' + encodeURIComponent(id) });

        if (res.ok) { btn.closest('.rc-card').remove(); updateCount(); }

        else Swal.fire('Error', 'Failed to delete.', 'error');

    } catch { Swal.fire('Error', 'Network error.', 'error'); }

}



let currentActiveTab = 'all';



function filterByTab(tabName) {

    currentActiveTab = tabName.toLowerCase();

    document.querySelectorAll('.filter-tab-btn').forEach(btn => {

        btn.classList.toggle('active', btn.dataset.tab === currentActiveTab);

    });



    const filterStatusEl = document.getElementById('filterStatus');

    if (filterStatusEl) {

        if (currentActiveTab === 'pending-today') {

            filterStatusEl.value = 'pending-today';

        } else if (currentActiveTab === 'pending') {

            filterStatusEl.value = 'pending';

        } else if (currentActiveTab === 'processed') {

            filterStatusEl.value = 'processed';

        } else if (currentActiveTab === 'all') {

            filterStatusEl.value = '';

        }

    }

    const filterPayEl = document.getElementById('filterPayment');

    if (filterPayEl) {

        if (currentActiveTab === 'not paid') {

            filterPayEl.value = 'not paid';

        } else if (currentActiveTab === 'paid') {

            filterPayEl.value = 'paid';

        }

    }

    filterCards();

}



function onStatusSelectChange() {

    const statusVal = document.getElementById('filterStatus').value.toLowerCase();

    if (statusVal === 'pending-today') {

        currentActiveTab = 'pending-today';

    } else if (statusVal === 'pending') {

        currentActiveTab = 'pending';

    } else if (statusVal === 'processed') {

        currentActiveTab = 'processed';

    } else {

        currentActiveTab = 'all';

    }

    document.querySelectorAll('.filter-tab-btn').forEach(btn => {

        btn.classList.toggle('active', btn.dataset.tab === currentActiveTab);

    });

    filterCards();

}



function clearRechargeFilters() {

    currentActiveTab = 'all';

    document.querySelectorAll('.filter-tab-btn').forEach(btn => {

        btn.classList.toggle('active', btn.dataset.tab === 'all');

    });

    const s = document.getElementById('rcSearch');

    if (s) s.value = '';

    ['filterStatus', 'filterPayment', 'filterOperator'].forEach(id => {

        const el = document.getElementById(id);

        if (el) {

            el.value = '';

            el.dispatchEvent(new Event('change', { bubbles: true }));

        }

    });

    filterCards();

}



// ── Filter ──

function filterCards() {

    const q        = (document.getElementById('rcSearch')?.value || '').toLowerCase();

    const status   = (document.getElementById('filterStatus')?.value || '').toLowerCase();

    const payment  = (document.getElementById('filterPayment')?.value || '').toLowerCase();

    const opFilter = (document.getElementById('filterOperator')?.value || '').toLowerCase();

    let visible = 0, done = 0, pend = 0, pendToday = 0, paid = 0, due = 0;

    document.querySelectorAll('#rcCards .rc-card').forEach(card => {

        const text = card.textContent.toLowerCase();

        const cStatus = (card.dataset.status || '').toLowerCase();

        const cPayment = (card.dataset.payment || '').toLowerCase();

        const cOperator = (card.dataset.operator || '').toLowerCase();

        const isPendToday = card.dataset.pendingToday === 'true';



        let matchesStatus = true;

        if (status === 'pending-today' || currentActiveTab === 'pending-today') {

            matchesStatus = (cStatus === 'pending' && isPendToday);

        } else if (status) {

            matchesStatus = (cStatus === status);

        }



        const show = (!q || text.includes(q))

                  && matchesStatus

                  && (!payment  || cPayment === payment)

                  && (!opFilter || cOperator.includes(opFilter));

        card.style.display = show ? '' : 'none';

        if (show) {

            visible++;

            if (cStatus === 'processed') done++;

            if (cStatus === 'pending') pend++;

            if (cStatus === 'pending' && isPendToday) pendToday++;

            if (cPayment === 'paid') paid++;

            if (cPayment === 'not paid') due++;

        }

    });

    const total = document.querySelectorAll('#rcCards .rc-card').length;

    document.getElementById('rcNoResults').style.display = (visible === 0 && total > 0) ? 'block' : 'none';

    updateCount(visible, total);



    const elTotal     = document.getElementById('statValTotal');

    const elPendToday = document.getElementById('statValPendToday');

    const elDone      = document.getElementById('statValDone');

    const elPend      = document.getElementById('statValPend');

    const elPaid      = document.getElementById('statValPaid');

    const elDue       = document.getElementById('statValDue');

    if (elTotal) elTotal.textContent = visible;

    if (elPendToday) elPendToday.textContent = pendToday;

    if (elDone)  elDone.textContent  = done;

    if (elPend)  elPend.textContent  = pend;

    if (elPaid)  elPaid.textContent  = paid;

    if (elDue)   elDue.textContent   = due;

}

function updateCount(v, t) {

    if (v === undefined) {

        const cards = document.querySelectorAll('#rcCards .rc-card');

        v = [...cards].filter(c => c.style.display !== 'none').length;

        t = cards.length;

    }

    document.getElementById('rcCount').textContent = v === t ? `${t} record${t !== 1 ? 's' : ''}` : `${v} of ${t}`;

}



// ── Filtered Export ──

function exportFilteredRecharges() {

    const q       = (document.getElementById('rcSearch')?.value || '').trim();

    const status  = (document.getElementById('filterStatus')?.value || '').trim();

    const payment = (document.getElementById('filterPayment')?.value || '').trim();

    const op      = (document.getElementById('filterOperator')?.value || '').trim();

    window.location.href = `@Url.Action("Export", "Recharges")?q=${encodeURIComponent(q)}&status=${encodeURIComponent(status)}&payment=${encodeURIComponent(payment)}&op=${encodeURIComponent(op)}`;

}



// ── Keyboard ──

document.addEventListener('keydown', e => { if (e.key === 'Escape') closeEditModal(); });

document.addEventListener('DOMContentLoaded', () => {

    updateCount();

    const aPrev = document.getElementById('aPrevExpiry');

    if (aPrev) {

        aPrev.addEventListener('input', () => onPrevExpiryChange(true));

        aPrev.addEventListener('change', () => onPrevExpiryChange(true));

    }

    const ePrev = document.getElementById('ePrevExpiry');

    if (ePrev) {

        ePrev.addEventListener('input', () => onPrevExpiryChange(false));

        ePrev.addEventListener('change', () => onPrevExpiryChange(false));

    }

});

</script>

