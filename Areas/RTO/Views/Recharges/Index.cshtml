                </div>



                <div class="rc-form-field">

                    <label class="rc-form-label" for="ePrevExpiry">Prev. Expiry Date <span style="color:#ef4444;">*</span></label>

                    <input type="date" id="ePrevExpiry" class="input" oninput="onPrevExpiryChange(false)" onchange="onPrevExpiryChange(false)" required>

                </div>



                <div class="rc-form-field">

                    <label class="rc-form-label" for="eActivationDate">Activation Date</label>

                    <input type="date" id="eActivationDate" class="input" oninput="onEditActDateChange()" onchange="onEditActDateChange()">

                </div>



                <div class="rc-form-field">

                    <label class="rc-form-label" for="eExpiry">New Expiry Date</label>

                    <input type="date" id="eExpiry" class="input">

