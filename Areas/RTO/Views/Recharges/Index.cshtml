                <div class="rc-form-field">

                    <label class="rc-form-label">Recharge Status <span style="color:#ef4444;">*</span></label>

                    <div class="rc-toggle-group" id="editStatusToggle">

                        <button type="button" class="rc-toggle-btn" data-val="Pending"   onclick="setToggle('editStatusToggle','Pending');onEditStatusToggle('Pending')">Pending</button>

                        <button type="button" class="rc-toggle-btn" data-val="Processed" onclick="setToggle('editStatusToggle','Processed');onEditStatusToggle('Processed')">Processed</button>

