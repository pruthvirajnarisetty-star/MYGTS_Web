    function setTransactionMode(mode) {
        const currentModeInput = document.getElementById('CurrentMode');
        if (currentModeInput) currentModeInput.value = mode;

        const stdToggle = document.getElementById('standard-toggle');
        const mergeToggle = document.getElementById('merge-toggle');
        const bulkToggle = document.getElementById('bulk-toggle');

        if (stdToggle) stdToggle.checked = (mode === 'Standard');
        if (mergeToggle) mergeToggle.checked = (mode === 'MergePartPayments');
        if (bulkToggle) bulkToggle.checked = (mode === 'BulkAllocation');

        try {
            const url = new URL(window.location.href);
            const modeParam = mode === 'MergePartPayments' ? 'merge' : (mode === 'BulkAllocation' ? 'bulk' : 'standard');
            url.searchParams.set('mode', modeParam);
            window.history.replaceState({}, '', url.toString());
            sessionStorage.setItem('dmg_create_txn_mode', modeParam);
        } catch(e) {}

        updateVisibility();
    }
    window.setTransactionMode = setTransactionMode;

    // Multiple UTR / Payments for Bulk Split
    window.isMultiUtrActive = false;

    
    // Bulk Payment Row Presets
    window.applyBulkPaymentPreset = function(type) {
        const rowsContainer = document.getElementById('bulk-payments-rows');
        if (!rowsContainer) return;
        
        let targetTotal = 0;
        document.querySelectorAll('.bulk-amount-input').forEach(inp => {
            targetTotal += parseFloat(inp.value) || 0;
        });
        if (targetTotal <= 0) {
            targetTotal = parseFloat(document.getElementById('total-payment-input')?.value || document.getElementById('TotalPayment')?.value) || 0;
        }

        const curDate = (document.getElementById('txn-date')?.value || new Date().toISOString().split('T')[0]).trim();
        const curPaidTo = (document.querySelector('#field-paid-to input')?.value || '').trim();

        if (type === '50-50' || type === 'upi-cash' || type === 'upi-bank') {
            const mode1 = 'UPI';
            const mode2 = (type === 'upi-cash') ? 'Cash' : 'Bank transfer';
            const half = targetTotal > 0 ? (targetTotal / 2).toFixed(2) : '';

            rowsContainer.innerHTML = '';
            addBulkPaymentRow({
                date: curDate,
                mode: mode1,
                amount: half,
                utr: '',
                paidTo: curPaidTo
            });
            addBulkPaymentRow({
                date: curDate,
                mode: mode2,
                amount: half,
                utr: '',
                paidTo: curPaidTo
            });
        } else if (type === 'even') {
            let rows = rowsContainer.querySelectorAll('.bulk-payment-row');
            if (rows.length === 0) {
                addBulkPaymentRow({ date: curDate, mode: 'UPI', amount: '', utr: '', paidTo: curPaidTo });
                rows = rowsContainer.querySelectorAll('.bulk-payment-row');
            }
            if (targetTotal > 0 && rows.length > 0) {
                const share = (targetTotal / rows.length).toFixed(2);
                rows.forEach(r => {
                    const amtInp = r.querySelector('.bulk-pay-amount');
                    if (amtInp) amtInp.value = share;
                });
            }
        }
        
        if (window.onBulkPaymentsChanged) window.onBulkPaymentsChanged();
    };

    window.toggleMultiUtr = function() {
        const container = document.getElementById('field-bulk-payments-container');
        const rowsContainer = document.getElementById('bulk-payments-rows');
        const btnText = document.getElementById('btn-toggle-multi-utr-text');
        const btnIcon = document.getElementById('btn-toggle-multi-utr-icon');
        if (!container || !rowsContainer) return;

        if (container.style.display === 'none' || !container.style.display) {
            container.style.display = 'block';
            window.isMultiUtrActive = true;
            if (btnText) btnText.textContent = 'Hide Multiple UTRs Panel';
            if (btnIcon) btnIcon.textContent = '➖';

            // If no rows exist yet, prefill Row 0 from current top fields and add Row 1
            if (rowsContainer.querySelectorAll('.bulk-payment-row').length === 0) {
                const curDate = (document.getElementById('txn-date')?.value || new Date().toISOString().split('T')[0]).trim();
                const curMode = (document.getElementById('payment-mode')?.value || 'UPI').trim();
                const curTotal = parseFloat(document.getElementById('total-payment-input')?.value || document.getElementById('TotalPayment')?.value) || 0;
                const curUtr = (document.querySelector('#field-utr input')?.value || '').trim();
                const curPaidTo = (document.querySelector('#field-paid-to input')?.value || '').trim();

                addBulkPaymentRow({
                    date: curDate,
                    mode: curMode,
                    amount: curTotal > 0 ? curTotal : '',
                    utr: curUtr,
                    paidTo: curPaidTo
                });

                // Add a second empty row ready for additional UTR
                addBulkPaymentRow({
                    date: curDate,
                    mode: curMode,
                    amount: '',
                    utr: '',
                    paidTo: curPaidTo
                });
            }
            onBulkPaymentsChanged();
        } else {
            container.style.display = 'none';
            window.isMultiUtrActive = false;
            if (btnText) btnText.textContent = 'Add Multiple UTRs / Part Payments';
            if (btnIcon) btnIcon.textContent = '➕';
        }
    };

    window.collapseMultiUtr = function() {
        const container = document.getElementById('field-bulk-payments-container');
        const rowsContainer = document.getElementById('bulk-payments-rows');
        const btnText = document.getElementById('btn-toggle-multi-utr-text');
        const btnIcon = document.getElementById('btn-toggle-multi-utr-icon');
        if (container) container.style.display = 'none';
        if (btnText) btnText.textContent = 'Add Multiple UTRs / Part Payments';
        if (btnIcon) btnIcon.textContent = '➕';
        window.isMultiUtrActive = false;
        if (rowsContainer) {
            const firstRow = rowsContainer.querySelector('.bulk-payment-row');
            if (firstRow) {
                const amt = firstRow.querySelector('.bulk-pay-amount')?.value;
                const utr = firstRow.querySelector('.bulk-pay-utr')?.value;
                const paidTo = firstRow.querySelector('.bulk-pay-paidto')?.value;
                const mode = firstRow.querySelector('.bulk-pay-mode')?.value;
                const totalInput = document.getElementById('total-payment-input') || document.getElementById('TotalPayment');
                const utrInput = document.querySelector('#field-utr input');
                const paidToInput = document.querySelector('#field-paid-to input');
                const modeInput = document.getElementById('payment-mode');
                if (amt && totalInput) totalInput.value = amt;
                if (utr && utrInput) utrInput.value = utr;
                if (paidTo && paidToInput) paidToInput.value = paidTo;
                if (mode && modeInput) modeInput.value = mode;
            }
            rowsContainer.innerHTML = '';
