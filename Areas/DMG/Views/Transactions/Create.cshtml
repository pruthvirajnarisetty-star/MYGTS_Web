    // Robust Vendor Auto-Detection based on bulk devices
    window.autoDetectVendorFromBulkDevices = function() {
        const rows = document.querySelectorAll('.bulk-row');
        const vendorCounts = {};
        let firstVendor = '';
        rows.forEach(r => {
            const v = (r.dataset.vendor || '').trim();
            if (v) {
                if (!firstVendor) firstVendor = v;
                vendorCounts[v] = (vendorCounts[v] || 0) + 1;
            }
        });

        let detected = firstVendor;
        let maxCount = 0;
        for (const [v, count] of Object.entries(vendorCounts)) {
            if (count > maxCount) {
                maxCount = count;
                detected = v;
            }
        }

        if (detected) {
            setVendorFieldValue(detected);
        }
    };

    function setVendorFieldValue(vendorName) {
        if (!vendorName) return;
        const vSel = document.getElementById('vendorSelect');
        const vInp = document.getElementById('vendorInput');
        const vWrap = document.getElementById('vendorCustomWrap');
        const btnToggle = document.getElementById('btnToggleCustomVendor');

        let foundOption = false;
        if (vSel) {
            for (let i = 0; i < vSel.options.length; i++) {
                if (vSel.options[i].value && vSel.options[i].value.trim().toLowerCase() === vendorName.trim().toLowerCase()) {
                    vSel.selectedIndex = i;
                    foundOption = true;
                    break;
                }
