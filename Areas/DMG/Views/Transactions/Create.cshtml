@model TransactionFormViewModel
@{
    ViewData["Title"] = "New transaction";
    ViewData["BodyClass"] = "form-background-container";
    var currentBranch = "DMG";
}

<style>
/* Hide the default checkbox */
.merge-checkbox input {
 position: absolute;
 opacity: 0;
 cursor: pointer;
 height: 0;
 width: 0;
}

.merge-checkbox {
 display: block;
 position: relative;
 cursor: pointer;
 font-size: 16px;
 user-select: none;
}

/* Create a custom checkbox */
.checkmark {
 position: relative;
 top: 0;
 left: 0;
 height: 1.3em;
 width: 1.3em;
 background-color: #ccc;
 transition: all 0.3s;
 border-radius: 5px;
}

/* When the checkbox is checked, add a blue background */
.merge-checkbox input:checked ~ .checkmark {
 background-color: #47da99;
 animation: pop 0.5s;
 animation-direction: alternate;
}

/* Create the checkmark/indicator (hidden when not checked) */
.checkmark:after {
 content: "";
 position: absolute;
 display: none;
}

/* Show the checkmark when checked */
.merge-checkbox input:checked ~ .checkmark:after {
 display: block;
}

/* Style the checkmark/indicator */
.merge-checkbox .checkmark:after {
 left: 0.45em;
 top: 0.25em;
 width: 0.25em;
 height: 0.5em;
 border: solid white;
 border-width: 0 0.15em 0.15em 0;
 transform: rotate(45deg);
}

@@keyframes pop {
 0% { transform: scale(1); }
 50% { transform: scale(0.9); }
 100% { transform: scale(1); }
}

.advanced-row {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 16px;
    background: rgba(0,0,0,0.02);
    border-radius: 8px;
    margin: 16px 0;
    grid-column: 1 / -1;
}
</style>

<div class="glass-wrapper">
<div class="page-heading">
    <div>
        <div class="eyebrow">Financial operations / new entry</div>
        <h1>Add transaction</h1>
        <p>Capture the payment and its operational effect on a device.</p>
    </div>
    <a class="btn-back" asp-action="Index">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
        Back to transactions
    </a>
</div>

<form class="card form-card" asp-action="Create" method="post" style="margin: 0 auto;" novalidate>
    <div asp-validation-summary="All" class="validation-summary-errors"></div>
    

    <div class="form-grid">
        <input type="hidden" asp-for="CurrentMode" id="CurrentMode" />
        
        <div class="field" id="field-date">
            <label asp-for="Date" class="form-label">Date</label>
            <input asp-for="Date" type="date" class="input" id="txn-date" />
        </div>
        
        <div class="field" id="field-vehicle">
            <label asp-for="VehicleNo" class="form-label">Vehicle number</label>
            <input asp-for="VehicleNo" class="input" id="vehicle-input" placeholder="e.g. MH12AB1234" required />
            <div id="vehicle-error" class="form-error" style="display:none; color: var(--danger); font-size: 0.85rem; margin-top: 4px;">Not available in the data</div>
            <span asp-validation-for="VehicleNo" class="form-error"></span>
        </div>
        
        <div class="field" id="field-lifecycle">
            <label class="form-label">Life Cycle</label>
            @{
                var createLc = ViewBag.DeviceLifecycle as string ?? ViewBag.Lifecycle as string ?? "";
            }
            <input type="text" id="txn-lifecycle" class="input" readonly style="background: var(--line); font-weight: 600;" value="@createLc" placeholder="Auto-filled from vehicle" />
        </div>

        <input type="hidden" asp-for="Type" value="New" id="type-select" />

        <div class="field" id="field-vendor">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                <label asp-for="Vendor" class="form-label" style="margin: 0;">Vendor</label>
                <button type="button" id="btnToggleCustomVendor" onclick="toggleCustomVendorInput()" style="background: none; border: none; color: var(--cyan); font-size: 0.78rem; font-weight: 600; cursor: pointer; padding: 0;">+ New Vendor</button>
            </div>
            <select class="select" id="vendorSelect" onchange="onVendorSelectChange(this.value)">
                <option value="">-- Select Vendor from List --</option>
                @foreach (var v in (ViewBag.KnownVendors as IEnumerable<string> ?? Enumerable.Empty<string>()))
                {
                    <option value="@v" selected="@(string.Equals(Model?.Vendor, v, StringComparison.OrdinalIgnoreCase))">@v</option>
                }
            </select>
            <div id="vendorCustomWrap" style="display: none; margin-top: 6px;">
                <input asp-for="Vendor" id="vendorInput" class="input" placeholder="Type vendor name..." autocomplete="off" oninput="onVendorInputChange(this.value)" />
            </div>
            <span asp-validation-for="Vendor" class="form-error"></span>
        </div>

        <div class="field" id="field-batch-id" style="display: none;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                <label asp-for="BatchId" class="form-label" style="margin: 0;">Batch ID</label>
                <span style="font-size: 0.72rem; color: var(--muted);" id="batchIdHint">Format: XXX - DDMYYYY</span>
            </div>
            <input asp-for="BatchId" class="input" id="BatchId" placeholder="e.g. GOV - 26092026" style="font-family: monospace; font-weight: 600; letter-spacing: 0.05em;" />
        </div>
        
        <div class="field" id="field-invoice-id">
            <label asp-for="InvoiceId" class="form-label">Invoice ID</label>
            <input asp-for="InvoiceId" class="input" readonly style="background: var(--line);" />
        </div>
        
        <div class="field" id="field-imei">
            <label asp-for="Imei" class="form-label">IMEI number</label>
            <input asp-for="Imei" class="input" id="txn-imei" readonly style="background: var(--line);" placeholder="Auto-filled from vehicle" />
        </div>

        <div class="field" id="field-network-operator">
            <label asp-for="NetworkOperator" class="form-label">Network Operator</label>
            <select asp-for="NetworkOperator" class="select" id="txn-network-operator" onchange="window.onNetworkOperatorChange && window.onNetworkOperatorChange(this.value)">
                <option value="">— Select Operator —</option>
                <option value="Taisys (MYGTS)">Taisys (MYGTS)</option>
                <option value="Taisys (Babu)">Taisys (Babu)</option>
                <option value="SMT">SMT</option>
                <option value="Sensorise">Sensorise</option>
            </select>
        </div>
        
        <div class="field" id="field-payment-for">
            <label asp-for="PaymentFor" class="form-label">Payment for</label>
            <select asp-for="PaymentFor" class="select" id="payment-for" onchange="window.calculateTransactionTotals && window.calculateTransactionTotals()">
                <option value="None">None</option>
                <option value="Activation">Activation</option>
                <option value="Recharge">Recharge</option>
                <option value="Reactivation">Reactivation</option>
                <option value="Other">Other</option>
            </select>
        </div>

        <div class="field" id="field-extras">
            <label asp-for="Extras" class="form-label">Extras</label>
            <select asp-for="Extras" class="select" id="extras-select" onchange="const f = document.getElementById('field-extras-amount'); if(f) f.style.display = (this.value && this.value !== 'None' && this.value !== '0') ? 'block' : 'none'; if(window.updateExtrasAmountVisibility) window.updateExtrasAmountVisibility(); else if(window.calculateTransactionTotals) window.calculateTransactionTotals();">
                <option value="None">None</option>
                <option value="DMG">DMG</option>
                <option value="Tracking">Tracking</option>
            </select>
        </div>

        <div class="field" id="field-extras-amount" style="display: none;">
            <label asp-for="ExtrasAmount" class="form-label">Extras deduction amount (₹)</label>
            <input asp-for="ExtrasAmount" id="ExtrasAmount" name="ExtrasAmount" class="input" type="number" step="0.01" value="@(Model?.ExtrasAmount ?? 0)" placeholder="e.g. 200.00" oninput="window.calculateTransactionTotals && window.calculateTransactionTotals()" />
        </div>

        <div class="advanced-row" style="grid-column: 1 / -1; display: flex; gap: 24px; padding: 12px 0;">
            <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;" onclick="setTransactionMode('Standard')">
                <input type="radio" name="TransactionTypeSelector" value="Standard" id="standard-toggle" @(Model?.CurrentMode == EntryMode.Standard || Model?.CurrentMode == null ? "checked" : "") onchange="setTransactionMode('Standard')" style="width: 16px; height: 16px; cursor: pointer;">
                <span style="font-weight: 600; font-size: 0.9rem;">NORMAL</span>
            </label>
            <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;" onclick="setTransactionMode('MergePartPayments')">
                <input type="radio" name="TransactionTypeSelector" value="MergePartPayments" id="merge-toggle" @(Model?.CurrentMode == EntryMode.MergePartPayments ? "checked" : "") onchange="setTransactionMode('MergePartPayments')" style="width: 16px; height: 16px; cursor: pointer;">
                <span style="font-weight: 600; font-size: 0.9rem;">MERGE PAYMENT</span>
            </label>
            <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;" onclick="setTransactionMode('BulkAllocation')">
                <input type="radio" name="TransactionTypeSelector" value="BulkAllocation" id="bulk-toggle" @(Model?.CurrentMode == EntryMode.BulkAllocation ? "checked" : "") onchange="setTransactionMode('BulkAllocation')" style="width: 16px; height: 16px; cursor: pointer;">
                <span style="font-weight: 600; font-size: 0.9rem;">BULK SPLIT</span>
            </label>
        </div>

        <!-- Advance Credit / Balance Section (if any exists for selected vendor) -->
        <div id="advanceCreditSection" class="advance-credit-card" style="grid-column: 1 / -1; display: none; margin-bottom: 8px; padding: 14px 18px; border-radius: 12px; background: linear-gradient(135deg, rgba(16, 185, 129, 0.08) 0%, rgba(6, 78, 59, 0.15) 100%); border: 1px solid rgba(16, 185, 129, 0.35); box-shadow: 0 4px 16px rgba(0,0,0,0.25);">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                <div style="display: flex; align-items: center; gap: 12px;">
                    <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(16, 185, 129, 0.2); display: flex; align-items: center; justify-content: center; font-size: 1.25rem;">
                        💳
                    </div>
                    <div>
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <span style="font-size: 0.95rem; font-weight: 700; color: #fff; letter-spacing: 0.2px;">VENDOR ADVANCE CREDIT DETECTED</span>
                            <span class="badge" style="background: rgba(16, 185, 129, 0.25); color: #34d399; font-size: 0.72rem; padding: 2px 7px; border-radius: 6px; font-weight: 600; text-transform: uppercase;">Unspent Balance</span>
                        </div>
                        <div style="font-size: 0.8rem; color: #94a3b8; margin-top: 2px;">
                            Previous credit available for <strong id="advVendorNameText" style="color: #38bdf8;"></strong>
                        </div>
                    </div>
                </div>

                <!-- Side amount badge: "show the amount on the side to see how much is there" -->
                <div style="text-align: right; background: rgba(15, 23, 42, 0.6); padding: 8px 16px; border-radius: 10px; border: 1px solid rgba(16, 185, 129, 0.3);">
                    <div style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.5px; color: #94a3b8; font-weight: 600;">Available Credit</div>
                    <div id="advAvailableAmtBadge" style="font-size: 1.35rem; font-weight: 800; color: #34d399; letter-spacing: -0.5px; line-height: 1.2;">₹0.00</div>
                </div>
            </div>

            <div style="margin-top: 12px; padding-top: 12px; border-top: 1px solid rgba(255,255,255,0.08); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px;">
                <div style="display: flex; flex-wrap: wrap; gap: 8px; font-size: 0.8rem; color: #cbd5e1;">
                    <span style="padding: 4px 10px; background: rgba(255,255,255,0.04); border-radius: 6px; border: 1px solid rgba(255,255,255,0.06);">📅 <span id="advDateText">—</span></span>
                    <span style="padding: 4px 10px; background: rgba(255,255,255,0.04); border-radius: 6px; border: 1px solid rgba(255,255,255,0.06);">🏦 <span id="advModeText">—</span></span>
                    <span style="padding: 4px 10px; background: rgba(255,255,255,0.04); border-radius: 6px; border: 1px solid rgba(255,255,255,0.06);">👤 Paid To: <strong id="advPaidToText">—</strong></span>
                    <span style="padding: 4px 10px; background: rgba(56, 189, 248, 0.1); border-radius: 6px; border: 1px solid rgba(56, 189, 248, 0.25); color: #38bdf8; font-family: monospace;">UTR: <span id="advUtrText">—</span></span>
                </div>

                <div style="display: flex; align-items: center; gap: 16px;">
                    <!-- User requested: "make the default on" -->
                    <label style="display: inline-flex; align-items: center; gap: 8px; cursor: pointer; user-select: none; margin: 0;">
                        <input type="checkbox" id="ApplyAdvanceCredit" name="ApplyAdvanceCredit" value="true" checked style="width: 18px; height: 18px; accent-color: #10b981; cursor: pointer;" onchange="window.toggleAdvanceCredit && window.toggleAdvanceCredit(this.checked)" />
                        <span style="font-weight: 700; font-size: 0.88rem; color: #f8fafc;">Apply Advance Credit</span>
                    </label>

                    <div id="advAmountInputWrap" style="display: inline-flex; align-items: center; gap: 6px;">
                        <span style="font-size: 0.78rem; color: #94a3b8;">Use (₹):</span>
                        <input type="number" step="0.01" min="0" id="AdvanceCreditAmount" name="AdvanceCreditAmount" class="input" style="width: 120px; height: 34px; padding: 4px 8px; font-size: 0.88rem; text-align: right;" oninput="window.onAdvanceAmountChange && window.onAdvanceAmountChange()" />
                    </div>
                </div>
            </div>

            <input type="hidden" id="AdvanceCreditId" name="AdvanceCreditId" value="@(Model?.AdvanceCreditId ?? "")" />
            <input type="hidden" id="AdvanceCreditUtr" name="AdvanceCreditUtr" value="@(Model?.AdvanceCreditUtr ?? "")" />
            <input type="hidden" id="AdvanceCreditDate" name="AdvanceCreditDate" value="@(Model?.AdvanceCreditDate ?? "")" />
            <input type="hidden" id="AdvanceCreditMode" name="AdvanceCreditMode" value="@(Model?.AdvanceCreditMode ?? "")" />
            <input type="hidden" id="AdvanceCreditPaidTo" name="AdvanceCreditPaidTo" value="@(Model?.AdvanceCreditPaidTo ?? "")" />
            <input type="hidden" id="AvailableAdvanceBalance" name="AvailableAdvanceBalance" value="@(Model?.AvailableAdvanceBalance?.ToString("0.00") ?? "")" />
        </div>

        <div class="field" id="field-payment-mode">
            <label asp-for="PaymentMode" class="form-label">Payment mode</label>
            <select asp-for="PaymentMode" class="select" id="payment-mode" required>
                <option value="">Select mode</option>
                <option value="UPI">UPI</option>
                <option value="Cash">Cash</option>
                <option value="Banking">Banking</option>
            </select>
            <input type="text" id="bulk-payment-mode-display" class="input" readonly style="display: none; background: rgba(255,255,255,0.06); cursor: default; font-weight: 600;" placeholder="Auto from payments..." />
        </div>
        
        <div class="field" id="field-amount">
            <div style="display: flex; justify-content: space-between; align-items: baseline;">
                <label asp-for="Amount" class="form-label" style="margin-bottom: 0;">Total payment (Base amount)</label>
                <span id="admin-cost-badge" style="display: none; font-size: 0.78rem; color: #d97706; font-weight: 600;"></span>
            </div>
            <input asp-for="Amount" class="input" type="number" step="0.01" placeholder="e.g. 1500.00" style="margin-top: 6px;" oninput="window.calculateTransactionTotals && window.calculateTransactionTotals()" />
        </div>

        <!-- Manual Device Cost Option (Re-aligned) -->
        <div class="field" id="field-manual-device-cost" style="display: flex; flex-direction: column; justify-content: flex-end;">
            <label class="form-label" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                <span>Device Cost Override</span>
                <span class="muted" style="font-size: 0.72rem; font-weight: normal; opacity: 0.75;">Manual deduction</span>
            </label>
            <div style="display: flex; gap: 8px; align-items: center; min-height: 42px;">
                <label style="display: inline-flex; align-items: center; gap: 7px; cursor: pointer; margin: 0; padding: 9px 12px; background: rgba(255,255,255,0.03); border: 1px solid var(--line); border-radius: 8px; white-space: nowrap; height: 42px;">
                    <input type="checkbox" id="chkManualDeviceCost" name="IsManualDeviceCost" value="true" @(Model?.IsManualDeviceCost == true ? "checked" : "") style="width: 16px; height: 16px; cursor: pointer; accent-color: var(--primary);" onchange="window.toggleManualDeviceCost && window.toggleManualDeviceCost(this.checked)" />
                    <span style="font-size: 0.82rem; font-weight: 600; color: var(--ink);">Manual</span>
                </label>
                <div id="box-manual-device-cost" style="flex: 1; @(Model?.IsManualDeviceCost == true ? "" : "display: none;")">
                    <input type="number" step="0.01" min="0" id="ManualDeviceCost" name="ManualDeviceCost" value="@(Model?.ManualDeviceCost?.ToString("0.00") ?? "")" class="input" placeholder="₹ Cost deduction" style="height: 42px;" oninput="if(window.calculateTransactionTotals) window.calculateTransactionTotals();" />
                </div>
            </div>
        </div>
        
        <div class="field" id="field-total" style="display: none;">
            <label asp-for="TotalPayment" class="form-label">Total payment</label>
            <input asp-for="TotalPayment" id="total-payment-input" class="input" type="number" step="0.01" placeholder="e.g. 2000.00" disabled />
        </div>
        

        
        <div class="field" id="field-utr">
            <label asp-for="Utr" class="form-label">UTR / reference</label>
            <input asp-for="Utr" class="input" placeholder="e.g. UTR123456789" />
        </div>
        
        <div class="field" id="field-paid-to">
            <label asp-for="PaidTo" class="form-label">Paid to</label>
            <input asp-for="PaidTo" class="input" placeholder="e.g. John Doe" />
        </div>
        

        <div class="field" id="field-activation">
            <label asp-for="ActivationDate" class="form-label">Activation date</label>
            <input asp-for="ActivationDate" type="date" class="input" id="activation-date" />
        </div>
        
        <div class="field" id="field-expiry">
            <label asp-for="NewExpiryDate" class="form-label">New expiry date</label>
            <input asp-for="NewExpiryDate" type="date" class="input" id="new-expiry" placeholder="YYYY-MM-DD" />
        </div>

        <!-- Bulk Multi-Payment / Multi-UTR Section -->
        <div class="field full" id="field-bulk-payments-toggle" style="display: none; margin-top: -4px; margin-bottom: 6px;">
            <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px;">
                <button type="button" class="button secondary small" id="btn-toggle-multi-utr" onclick="toggleMultiUtr()" style="font-size: 0.8rem; padding: 6px 14px; border-radius: 8px; display: inline-flex; align-items: center; gap: 6px; cursor: pointer; border: 1px dashed rgba(255,255,255,0.25);">
                    <span id="btn-toggle-multi-utr-icon">➕</span>
                    <span id="btn-toggle-multi-utr-text">Add Multiple UTRs / Part Payments</span>
                </button>
                <span class="muted" style="font-size: 0.74rem;">Record multiple payment transfers / UTRs for this bulk split</span>
            </div>
        </div>

        <div class="field full" id="field-bulk-payments-container" style="display: none; background: rgba(255,255,255,0.02); border: 1px solid var(--line); border-radius: 10px; padding: 16px; margin-top: 2px; margin-bottom: 12px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; flex-wrap: wrap; gap: 8px;">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="font-size: 0.84rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--ink);">Bulk Payments & UTR Receipts</span>
                    <span class="muted" style="font-size: 0.74rem;">Add each transfer's amount, mode, UTR, and recipient</span>
                </div>
                <div style="display: flex; gap: 8px; align-items: center;">
                                        <button type="button" class="button secondary small" onclick="applyBulkPaymentPreset('50-50')" style="font-size: 0.76rem; padding: 5px 10px; border-radius: 6px; display: inline-flex; align-items: center; gap: 4px;" title="Split total into two equal 50/50 payments">
                        <span>⚡ 50/50 Split</span>
                    </button>
                    <button type="button" class="button secondary small" onclick="applyBulkPaymentPreset('even')" style="font-size: 0.76rem; padding: 5px 10px; border-radius: 6px; display: inline-flex; align-items: center; gap: 4px;" title="Divide total amount equally among all payment rows">
                        <span>⚖️ Even Split</span>
                    </button>
                    <button type="button" class="button secondary small" onclick="applyBulkPaymentPreset('upi-cash')" style="font-size: 0.76rem; padding: 5px 10px; border-radius: 6px; display: inline-flex; align-items: center; gap: 4px;" title="Set up UPI + Cash payments">
                        <span>➕ UPI + Cash</span>
                    </button>
                    <button type="button" class="button secondary small" onclick="applyBulkPaymentPreset('upi-bank')" style="font-size: 0.76rem; padding: 5px 10px; border-radius: 6px; display: inline-flex; align-items: center; gap: 4px;" title="Set up UPI + Bank transfer payments">
                        <span>➕ UPI + Bank</span>
                    </button>
                    <button type="button" class="button secondary small" id="btn-add-bulk-payment-row" onclick="addBulkPaymentRow()" style="font-size: 0.78rem; padding: 5px 12px; border-radius: 6px;">
                        + Add Another Payment / UTR
                    </button>
                    <button type="button" class="button ghost small" onclick="collapseMultiUtr()" style="font-size: 0.78rem; padding: 5px 10px; color: var(--muted);" title="Return to single payment mode">
                        Single UTR Mode
                    </button>
                </div>
            </div>

            <!-- Column Headings -->
            <div class="bulk-payments-header" style="display: grid; grid-template-columns: 135px 125px 130px 1.4fr 140px 38px; gap: 8px; margin-bottom: 6px; padding: 0 4px;">
                <div style="font-size: 0.72rem; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em;">Payment Date</div>
                <div style="font-size: 0.72rem; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em;">Payment Mode</div>
                <div style="font-size: 0.72rem; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em;">Amount (₹)</div>
                <div style="font-size: 0.72rem; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em;">UTR / Reference</div>
                <div style="font-size: 0.72rem; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em;">Paid To</div>
                <div></div>
            </div>

            <div id="bulk-payments-rows" style="display: flex; flex-direction: column; gap: 8px;">
                <!-- Dynamic rows injected here -->
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 12px; padding-top: 10px; border-top: 1px dashed var(--line); font-size: 0.85rem; flex-wrap: wrap; gap: 8px;">
                <span class="muted" style="font-size: 0.76rem;">The sum of all payment rows automatically sets Total Payment above</span>
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="font-weight: 600;">Total Payments:</span>
                    <strong id="bulk-payments-total-display" style="font-size: 1.05rem; color: var(--primary);">₹0.00</strong>
                </div>
            </div>
        </div>

        <div class="field full" id="field-bulk-vehicles" style="display: none; background: rgba(0,0,0,0.02); padding: 20px; border-radius: 10px; border: 1px solid var(--line);">
