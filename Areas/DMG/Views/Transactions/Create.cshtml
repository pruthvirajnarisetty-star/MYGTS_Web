        }

        if (foundOption && vSel) {
            if (vInp) vInp.value = vSel.value;
            if (vWrap) vWrap.style.display = 'none';
            if (btnToggle) btnToggle.textContent = '+ New Vendor';
        } else {
            if (vSel) vSel.value = '';
            if (vInp) vInp.value = vendorName;
            if (vWrap) vWrap.style.display = 'block';
