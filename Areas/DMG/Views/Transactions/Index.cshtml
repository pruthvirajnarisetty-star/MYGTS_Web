<section class="card tx-table-card" style="width: 100%; overflow: hidden;">

    @if (Model.TotalPages > 1)

    {

        <div style="padding: 12px 20px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--line); flex-wrap: wrap; gap: 12px;">

            <div style="font-size: 0.85rem; color: var(--muted);">

                Showing @((Model.Page - 1) * Model.PageSize + 1) to @Math.Min(Model.Page * Model.PageSize, Model.TotalItems) of @Model.TotalItems transactions (Page @Model.Page of @Model.TotalPages)

            </div>

            <div style="display: flex; align-items: center; gap: 6px;">

                <span style="font-size: 0.82rem; color: var(--muted); font-weight: 500;">Jump to page:</span>

                <button type="button" class="button secondary" title="Previous Page" @(Model.Page <= 1 ? "disabled" : "") onclick="goToTopPage(@(Model.Page - 1))" style="padding: 0 8px; height: 32px; min-width: 32px; display: inline-flex; align-items: center; justify-content: center; @(Model.Page <= 1 ? "opacity: 0.4; cursor: not-allowed;" : "")">

                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>

                </button>

                <select class="select page-jump-select" data-pagination="true" onchange="goToTopPage(this.value)" style="height: 32px; padding: 0 24px 0 8px; font-size: 0.82rem; font-weight: 600; width: auto; background-image: none !important;">

                    @for (int p = 1; p <= Model.TotalPages; p++)

                    {

                        <option value="@p" selected="@(p == Model.Page)">Page @p of @Model.TotalPages</option>

                    }

                </select>

                <button type="button" class="button secondary" title="Next Page" @(Model.Page >= Model.TotalPages ? "disabled" : "") onclick="goToTopPage(@(Model.Page + 1))" style="padding: 0 8px; height: 32px; min-width: 32px; display: inline-flex; align-items: center; justify-content: center; @(Model.Page >= Model.TotalPages ? "opacity: 0.4; cursor: not-allowed;" : "")">

                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>

                </button>

            </div>

        </div>

    }

    <div class="table-wrap" style="width: 100%;">

        <table class="data-table" style="width: 100%; min-width: 1800px;">

            <thead>

                <tr>

                    <th style="width: 50px; min-width: 50px;"></th>

                    <th style="width: 70px; min-width: 70px;"><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-PaymentMode="@Model.PaymentMode" asp-route-FilterVendor="@Model.FilterVendor" asp-route-PaymentFor="@Model.PaymentFor" asp-route-TransactionType="@Model.TransactionType" asp-route-SortColumn="slno" asp-route-SortDirection="@SortDir("slno")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">S.No. @SortIcon("slno")</a></th>

                    <th><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-PaymentMode="@Model.PaymentMode" asp-route-FilterVendor="@Model.FilterVendor" asp-route-PaymentFor="@Model.PaymentFor" asp-route-TransactionType="@Model.TransactionType" asp-route-SortColumn="vehicle" asp-route-SortDirection="@SortDir("vehicle")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">Vehicle No @SortIcon("vehicle")</a></th>
                    <th style="min-width: 140px;"><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-PaymentMode="@Model.PaymentMode" asp-route-FilterVendor="@Model.FilterVendor" asp-route-PaymentFor="@Model.PaymentFor" asp-route-TransactionType="@Model.TransactionType" asp-route-SortColumn="imei" asp-route-SortDirection="@SortDir("imei")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">IMEI @SortIcon("imei")</a></th>

                    <th><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-PaymentMode="@Model.PaymentMode" asp-route-FilterVendor="@Model.FilterVendor" asp-route-PaymentFor="@Model.PaymentFor" asp-route-TransactionType="@Model.TransactionType" asp-route-SortColumn="date" asp-route-SortDirection="@SortDir("date")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">Date @SortIcon("date")</a></th>

                    <th><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-PaymentMode="@Model.PaymentMode" asp-route-FilterVendor="@Model.FilterVendor" asp-route-PaymentFor="@Model.PaymentFor" asp-route-TransactionType="@Model.TransactionType" asp-route-SortColumn="vendor" asp-route-SortDirection="@SortDir("vendor")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">Vendor @SortIcon("vendor")</a></th>

                    <th><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-PaymentMode="@Model.PaymentMode" asp-route-FilterVendor="@Model.FilterVendor" asp-route-PaymentFor="@Model.PaymentFor" asp-route-TransactionType="@Model.TransactionType" asp-route-SortColumn="mode" asp-route-SortDirection="@SortDir("mode")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">Payment Mode @SortIcon("mode")</a></th>

                    <th><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-PaymentMode="@Model.PaymentMode" asp-route-FilterVendor="@Model.FilterVendor" asp-route-PaymentFor="@Model.PaymentFor" asp-route-TransactionType="@Model.TransactionType" asp-route-SortColumn="payment" asp-route-SortDirection="@SortDir("payment")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">Payment For @SortIcon("payment")</a></th>

                    <th style="white-space: nowrap;">Network Operator</th>

                    <th class="numeric"><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-PaymentMode="@Model.PaymentMode" asp-route-FilterVendor="@Model.FilterVendor" asp-route-PaymentFor="@Model.PaymentFor" asp-route-TransactionType="@Model.TransactionType" asp-route-SortColumn="amount" asp-route-SortDirection="@SortDir("amount")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">Amount @SortIcon("amount")</a></th>

                    <th>UTR / Transaction ID</th>

                    <th>Paid To</th>

                    @if (currentBranch != "RTO")

