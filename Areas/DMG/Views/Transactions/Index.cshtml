                                                <span style="font-size: 0.82rem; font-weight: 700; color: var(--text);">Total: <strong style="color: #10b981; font-size: 0.92rem;">@(item.Amount.HasValue ? item.Amount.Value.ToString("C") : "—")</strong></span>
                                                <span style="font-size: 0.82rem; font-weight: 700; color: var(--text);">Total Profit: <strong style="color: #10b981; font-size: 0.92rem;">@(item.Profit.HasValue ? item.Profit.Value.ToString("C") : "—")</strong></span>
                                                <button type="button" onclick="toggleDetails('bulk-@item.Id')" style="background: none; border: none; font-size: 0.8rem; color: var(--muted); cursor: pointer; padding: 2px 6px;">✕ Close</button>
                                            </div>
                                        </div>
                                        <div style="overflow-x: auto;">
                                            <table style="width: 100%; border-collapse: collapse; font-size: 0.78rem;">
                                                <thead>
                                                    <tr style="background: rgba(0,0,0,0.02); border-bottom: 1px solid var(--line, #e2e8f0); text-align: left; color: var(--muted);">
                                                        <th style="padding: 6px 10px;">#</th>
                                                        <th style="padding: 6px 10px;">Vehicle No</th>
                                                        <th style="padding: 6px 10px;">IMEI</th>
                                                        <th style="padding: 6px 10px;">Operator</th>
                                                        <th style="padding: 6px 10px;">Activation Date</th>
                                                        <th style="padding: 6px 10px;">New Expiry Date</th>
                                                        <th style="padding: 6px 10px; text-align: right;">Amount (₹)</th>
                                                        <th style="padding: 6px 10px; text-align: right;">Individual Profit (₹)</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @{ int bPartIdx = 1; }
                                                    @foreach (var bp in bulkParts)
                                                    {
                                                        <tr style="border-bottom: 1px solid var(--line, #e2e8f0);">
                                                            <td style="padding: 6px 10px; color: var(--muted);">@(bPartIdx++)</td>
                                                            <td style="padding: 6px 10px; font-weight: 600;">@bp.VehicleNo</td>
                                                            <td style="padding: 6px 10px; font-family: monospace;">@(string.IsNullOrWhiteSpace(bp.Imei) ? "—" : bp.Imei)</td>
                                                            <td style="padding: 6px 10px;">@(string.IsNullOrWhiteSpace(bp.Operator) ? "—" : bp.Operator)</td>
                                                            <td style="padding: 6px 10px; white-space: nowrap; min-width: 100px;">@(string.IsNullOrWhiteSpace(bp.ActivationDate) ? "—" : DateValue.Short(bp.ActivationDate))</td>
                                                            <td style="padding: 6px 10px; white-space: nowrap; min-width: 100px;">@(string.IsNullOrWhiteSpace(bp.NewExpiryDate) ? "—" : DateValue.Short(bp.NewExpiryDate))</td>
                                                            <td style="padding: 6px 10px; text-align: right; font-weight: 600;">@bp.Amount.ToString("C")</td>
                                                            <td style="padding: 6px 10px; text-align: right; font-weight: 700; color: @(bp.Profit >= 0 ? "#16a34a" : "#dc2626");">
                                                                @(bp.Profit >= 0 ? "+" : "")@bp.Profit.ToString("C")
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }

                    }

                }

            </tbody>

        </table>

    </div>

    

    @if (Model.TotalItems > 0)

    {

        <div style="padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; border-top: 1px solid rgba(0,0,0,0.05);">

            <div style="font-size: 0.9rem; color: var(--muted);">

                Showing @((Model.Page - 1) * Model.PageSize + 1) to @Math.Min(Model.Page * Model.PageSize, Model.TotalItems) of @Model.TotalItems entries

            </div>

        <div style="display: flex; gap: 4px; align-items: center;">

            @{

                var startPage = Math.Max(1, Model.Page - 2);

                var endPage = Math.Min(Model.TotalPages, Model.Page + 2);

                

                if (startPage > 1) {

                    <a class="button secondary" asp-action="Index" asp-route-Query="@Model.Query" asp-route-PaymentMode="@Model.PaymentMode" asp-route-FilterVendor="@Model.FilterVendor" asp-route-PaymentFor="@Model.PaymentFor" asp-route-TransactionType="@Model.TransactionType" asp-route-SortColumn="@Model.SortColumn" asp-route-SortDirection="@Model.SortDirection" asp-route-PageSize="@Model.PageSize" asp-route-Page="1" style="padding: 4px 10px; min-width: auto; height: 32px; font-size: 13px;">1</a>

                    if (startPage > 2) {

                        <span style="padding: 4px 8px; color: var(--muted);">...</span>

                    }

                }

                

                for (int i = startPage; i <= endPage; i++)

                {

                    if (i == Model.Page) {

                        <button class="button primary" disabled style="padding: 4px 10px; min-width: auto; height: 32px; font-size: 13px;">@i</button>

                    } else {

                        <a class="button secondary" asp-action="Index" asp-route-Query="@Model.Query" asp-route-PaymentMode="@Model.PaymentMode" asp-route-FilterVendor="@Model.FilterVendor" asp-route-PaymentFor="@Model.PaymentFor" asp-route-TransactionType="@Model.TransactionType" asp-route-SortColumn="@Model.SortColumn" asp-route-SortDirection="@Model.SortDirection" asp-route-PageSize="@Model.PageSize" asp-route-Page="@i" style="padding: 4px 10px; min-width: auto; height: 32px; font-size: 13px;">@i</a>

                    }

                }

                

                if (endPage < Model.TotalPages) {

                    if (endPage < Model.TotalPages - 1) {

                        <span style="padding: 4px 8px; color: var(--muted);">...</span>

                    }

                    <a class="button secondary" asp-action="Index" asp-route-Query="@Model.Query" asp-route-PaymentMode="@Model.PaymentMode" asp-route-FilterVendor="@Model.FilterVendor" asp-route-PaymentFor="@Model.PaymentFor" asp-route-TransactionType="@Model.TransactionType" asp-route-SortColumn="@Model.SortColumn" asp-route-SortDirection="@Model.SortDirection" asp-route-PageSize="@Model.PageSize" asp-route-Page="@Model.TotalPages" style="padding: 4px 10px; min-width: auto; height: 32px; font-size: 13px;">@Model.TotalPages</a>

                }

            }

        </div>

        </div>

    }

</section>



