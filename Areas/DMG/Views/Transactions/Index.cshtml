                                    </button>
                                }
                                else if (isBulk && bulkParts != null)
                                {
                                    <button type="button" onclick="toggleDetails('bulk-@item.Id', this)" class="btn-merge-accordion-toggle" style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.35); border-radius: 6px; padding: 4px 10px; font-size: 0.75rem; font-weight: 700; color: #10b981; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; transition: all 0.2s ease;" title="Click to view bulk vehicle breakdown">
                                        <span>Bulk (@bulkParts.Count Vehicles)</span>
