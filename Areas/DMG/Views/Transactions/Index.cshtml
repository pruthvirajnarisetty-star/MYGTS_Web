                                    </button>
                                }
                                else if (isBulk)
                                {
                                    <button type="button" onclick="toggleDetails('bulk-@item.Id', this)" title="Expand bulk allocation vehicle breakdown" style="background: rgba(16, 185, 129, 0.08); border: 1px solid rgba(16, 185, 129, 0.25); border-radius: 4px; padding: 1px 4px; margin-left: 4px; color: #10b981; cursor: pointer; vertical-align: middle; display: inline-flex; align-items: center;">
