                                    else if (distinctDates.Count == 1)
                                    {
                                        <span>@distinctDates[0]</span>
                                    }
                                    else
                                    {
                                        <span>@(string.IsNullOrWhiteSpace(item.Date) ? "—" : DateValue.Short(item.Date))</span>
                                    }
                                }
                                else
                                {
                                    <span>@(string.IsNullOrWhiteSpace(item.Date) ? "—" : DateValue.Short(item.Date))</span>
                                }
                            </td>
