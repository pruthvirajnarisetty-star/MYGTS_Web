@model TransactionFilterViewModel

@{

    ViewData["Title"] = "Transactions";

    string SortDir(string col) => Model.SortColumn == col && Model.SortDirection == "asc" ? "desc" : "asc";

    string SortIcon(string col) => Model.SortColumn == col ? (Model.SortDirection == "desc" ? " ↓" : " ↑") : " ↑↓";

    var currentBranch = "DMG";

    string PaymentModeClass(string? mode)
    {
        if (string.IsNullOrWhiteSpace(mode)) return "badge-mode-default";
        var m = mode.Trim().ToUpperInvariant();
        if (m.Contains("UPI")) return "badge-mode-upi";
        if (m.Contains("CASH")) return "badge-mode-cash";
        if (m.Contains("BANK") || m.Contains("IMPS") || m.Contains("NEFT") || m.Contains("RTGS") || m.Contains("ONLINE")) return "badge-mode-bank";
        if (m.Contains("CHEQUE") || m.Contains("CHECK")) return "badge-mode-cheque";
        return "badge-mode-default";
    }




    string PaymentForClass(string? pfor)
    {
        if (string.IsNullOrWhiteSpace(pfor)) return "badge-for-default";
        var p = pfor.Trim().ToUpperInvariant();
        if (p.Contains("RECHARGE")) return "badge-for-recharge";
        if (p.Contains("ACTIVATION") && !p.Contains("REACTIVATION")) return "badge-for-activation";
        if (p.Contains("REACTIVATION")) return "badge-for-reactivation";
        if (p.Contains("RENEWAL")) return "badge-for-renewal";
        return "badge-for-default";
    }

}



<style>

    .content-area { max-width: none !important; padding-left: 20px !important; padding-right: 20px !important; }

</style>



<div class="page-heading">

    <div>

        <div class="eyebrow">Financial operations / ledger</div>

        <h1>Transactions</h1>

        <p>Record device payments, recharges, expiry changes, and vendor movement with source-level clarity.</p>

    </div>

    

    <div class="page-heading-actions">

        <a class="button secondary" asp-action="DownloadSample" asp-route-branch="@currentBranch" title="Download sample transactions Excel template (.xlsx)">📥 Sample sheet</a>

        @if (User.CanEditModule("Transactions"))

        {

            <a class="button secondary" asp-action="Import" data-testid="transactions-import">↑ Import transactions</a>

            <button type="button" class="button secondary" id="btnOpenVendorCreditsDrawer" title="View Vendor Advance & Credit Balances" onclick="window.openVendorCreditsDrawer && window.openVendorCreditsDrawer()" style="display: inline-flex; align-items: center; gap: 8px;">
                <span>💳 Vendor Credits</span>
                <span class="badge" style="background: rgba(16, 185, 129, 0.2); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.4); font-weight: 700; padding: 2px 8px; border-radius: 999px; font-size: 0.8rem;">
                    ₹@(ViewBag.TotalActiveCredit != null ? ((decimal)ViewBag.TotalActiveCredit).ToString("N2") : "0.00")
                </span>
            </button>

            <a class="button secondary" asp-action="ExportAll" asp-route-Query="@Model.Query" asp-route-PaymentMode="@Model.PaymentMode" asp-route-FilterVendor="@Model.FilterVendor" asp-route-PaymentFor="@Model.PaymentFor" asp-route-TransactionType="@Model.TransactionType" asp-route-FromDate="@Model.FromDate" asp-route-ToDate="@Model.ToDate" asp-route-SortColumn="@Model.SortColumn" asp-route-SortDirection="@Model.SortDirection" data-testid="transactions-export">↓ Export transactions</a>
            <a class="button secondary" asp-action="ExportAll" asp-route-TransactionType="Bulk" asp-route-FromDate="@Model.FromDate" asp-route-ToDate="@Model.ToDate" title="Export only bulk split transactions with breakdown">📊 Export Bulk</a>

            <a class="button btn-primary" asp-action="Create" data-testid="transaction-add">+ Add transaction</a>

        }

        else

        {

            <button type="button" class="button secondary" id="btnOpenVendorCreditsDrawer" title="View Vendor Advance & Credit Balances" onclick="window.openVendorCreditsDrawer && window.openVendorCreditsDrawer()" style="display: inline-flex; align-items: center; gap: 8px;">
                <span>💳 Vendor Credits</span>
                <span class="badge" style="background: rgba(16, 185, 129, 0.2); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.4); font-weight: 700; padding: 2px 8px; border-radius: 999px; font-size: 0.8rem;">
                    ₹@(ViewBag.TotalActiveCredit != null ? ((decimal)ViewBag.TotalActiveCredit).ToString("N2") : "0.00")
                </span>
            </button>

            <a class="button secondary" asp-action="ExportAll" asp-route-Query="@Model.Query" asp-route-PaymentMode="@Model.PaymentMode" asp-route-FilterVendor="@Model.FilterVendor" asp-route-PaymentFor="@Model.PaymentFor" asp-route-TransactionType="@Model.TransactionType" asp-route-FromDate="@Model.FromDate" asp-route-ToDate="@Model.ToDate" asp-route-SortColumn="@Model.SortColumn" asp-route-SortDirection="@Model.SortDirection" data-testid="transactions-export">↓ Export transactions</a>
            <a class="button secondary" asp-action="ExportAll" asp-route-TransactionType="Bulk" asp-route-FromDate="@Model.FromDate" asp-route-ToDate="@Model.ToDate" title="Export only bulk split transactions with breakdown">📊 Export Bulk</a>

        }

    </div>

</div>



<form class="card toolbar" method="get" asp-action="Index">

    <div class="filter-grid" style="align-items: flex-end;">

        <div class="field toolbar-search">

            <label for="QueryInput" class="form-label" style="margin-bottom: 4px; display: block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-main);">SEARCH</label>

            <div style="position: relative; width: 100%;">

                <button type="button" style="position: absolute; top: 50%; transform: translateY(-50%); left: 16px; padding: 0; background: transparent; border: none; display: flex; align-items: center; justify-content: center;">

                    <svg width="17" height="16" fill="none" xmlns="http://www.w3.org/2000/svg" style="width: 20px; height: 20px; color: #4b5563;">

                        <path d="M7.667 12.667A5.333 5.333 0 107.667 2a5.333 5.333 0 000 10.667zM14.334 14l-2.9-2.9" stroke="currentColor" stroke-width="1.333" stroke-linecap="round" stroke-linejoin="round"></path>

                    </svg>

                </button>

                <input type="hidden" asp-for="Query" id="Query" />

                <input type="hidden" asp-for="SortColumn" />

                <input type="hidden" asp-for="SortDirection" />

                <input id="QueryInput" name="QueryInput" class="input shadow-md w-full" style="padding: 0 44px; border-radius: 9999px; height: 42px; width: 100%; border: 1px solid var(--line); outline: none; transition: all 0.3s; font-size: 14px;" placeholder="Add a filter..." type="text" onfocus="this.style.borderColor='#3b82f6'" onblur="this.style.borderColor='var(--line)'" />

                <button type="button" onclick="document.getElementById('QueryInput').value=''; document.getElementById('Query').value=''; this.closest('form').submit();" style="position: absolute; top: 50%; transform: translateY(-50%); right: 12px; padding: 0; background: transparent; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center;">

                    <svg xmlns="http://www.w3.org/2000/svg" style="width: 20px; height: 20px; color: #4b5563;" fill="none" viewBox="0 0 24 24" stroke="currentColor">

                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>

                    </svg>

                </button>

            </div>

        </div>

        

        
        <div class="field">
            <label asp-for="TransactionType" class="form-label">Type</label>
            <select asp-for="TransactionType" class="select @(!string.IsNullOrEmpty(Model.TransactionType) ? "filter-active" : "")">
                <option value="">All types</option>
                <option value="Bulk">Bulk Split only</option>
                <option value="Merge">Merge Payment only</option>
                <option value="Standard">Normal only</option>
            </select>
        </div>

        <div class="field">

            <label asp-for="PaymentMode" class="form-label">Payment mode</label>

            <select asp-for="PaymentMode" class="select @(!string.IsNullOrEmpty(Model.PaymentMode) ? "filter-active" : "")">

                <option value="">All modes</option>

                @foreach (var option in Model.PaymentModeOptions)

                {

                    <option value="@option">@option</option>

                }

            </select>

        </div>

        

        <div class="field">

            <label asp-for="PaymentFor" class="form-label">Payment for</label>

            <select asp-for="PaymentFor" class="select @(!string.IsNullOrEmpty(Model.PaymentFor) ? "filter-active" : "")">

                <option value="">All types</option>

                @foreach (var option in Model.PaymentForOptions)

                {

                    <option value="@option">@option</option>

                }

            </select>

        </div>

        

        <div class="field">

            <label asp-for="FilterVendor" class="form-label">Vendor</label>

            <select asp-for="FilterVendor" asp-items="Model.VendorOptions" class="select @(!string.IsNullOrEmpty(Model.FilterVendor) ? "filter-active" : "")">

                <option value="">All vendors</option>

            </select>

        </div>

        <div class="field" style="min-width: 140px; flex: 0 0 auto;">
            <label class="form-label" for="FromDate" style="margin-bottom: 4px; display: block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-main);">From Date</label>
            <input type="date" id="FromDate" name="FromDate" value="@Model.FromDate" class="input @(!string.IsNullOrEmpty(Model.FromDate) ? "filter-active" : "")" style="height: 42px; border-radius: 8px; width: 100%; font-size: 13px;" onchange="this.form.requestSubmit ? this.form.requestSubmit() : this.form.submit()" />
        </div>

        <div class="field" style="min-width: 140px; flex: 0 0 auto;">
            <label class="form-label" for="ToDate" style="margin-bottom: 4px; display: block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-main);">To Date</label>
            <input type="date" id="ToDate" name="ToDate" value="@Model.ToDate" class="input @(!string.IsNullOrEmpty(Model.ToDate) ? "filter-active" : "")" style="height: 42px; border-radius: 8px; width: 100%; font-size: 13px;" onchange="this.form.requestSubmit ? this.form.requestSubmit() : this.form.submit()" />
        </div>

        <div class="field">

            <label class="form-label" asp-for="PageSize">Rows per page</label>

            <select class="select" asp-for="PageSize" onchange="this.form.requestSubmit ? this.form.requestSubmit() : this.form.submit()">

                <option value="10">10</option>
                <option value="20">20</option>
                <option value="50">50</option>
                <option value="100">100</option>
                <option value="1000000">All</option>
            </select>

        </div>



        <div class="field" style="min-width: 140px;">

            <label class="form-label" for="PageSelect" style="margin-bottom: 4px; display: block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-main);">Page</label>

            <div style="display: flex; align-items: center; gap: 4px;">

                <button type="button" class="button secondary" title="Previous Page" @(Model.Page <= 1 ? "disabled" : "") onclick="goToTopPage(@(Model.Page - 1))" style="padding: 0 8px; height: 42px; border-radius: 8px; min-width: 34px; display: inline-flex; align-items: center; justify-content: center; @(Model.Page <= 1 ? "opacity: 0.4; cursor: not-allowed;" : "")">

                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>

                </button>

                <select class="select" id="PageSelect" name="Page" onchange="goToTopPage(this.value)" style="height: 42px; border-radius: 8px; padding: 0 26px 0 10px; font-weight: 600; width: auto;">

                    @for (int p = 1; p <= Math.Max(1, Model.TotalPages); p++)

                    {

                        if (p == Model.Page)

                        {

                            <option value="@p" selected>@p / @(Model.TotalPages == 0 ? 1 : Model.TotalPages)</option>

                        }

                        else

                        {

                            <option value="@p">@p / @(Model.TotalPages == 0 ? 1 : Model.TotalPages)</option>

                        }

                    }

                </select>

                <button type="button" class="button secondary" title="Next Page" @(Model.Page >= Model.TotalPages ? "disabled" : "") onclick="goToTopPage(@(Model.Page + 1))" style="padding: 0 8px; height: 42px; border-radius: 8px; min-width: 34px; display: inline-flex; align-items: center; justify-content: center; @(Model.Page >= Model.TotalPages ? "opacity: 0.4; cursor: not-allowed;" : "")">

                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>

                </button>

            </div>

        </div>



        <div class="field toolbar-actions">

            <button class="button btn-primary" type="submit" style="height: 42px; border-radius: 8px; padding: 0 20px; white-space: nowrap;">Apply filters</button>

            <a asp-action="Index" asp-route-clear="true" class="button secondary" style="height: 42px; border-radius: 8px; padding: 0 16px; display: inline-flex; align-items: center; gap: 6px; text-decoration: none; white-space: nowrap;" title="Reset all filters">

                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>

                <span>Clear filters</span>

            </a>

        </div>

    </div>

    @{

        var queryTerms = string.IsNullOrWhiteSpace(Model.Query) ? Array.Empty<string>() : Model.Query.Trim().Split('|', StringSplitOptions.RemoveEmptyEntries);
        var hasDateRange = !string.IsNullOrEmpty(Model.FromDate) || !string.IsNullOrEmpty(Model.ToDate);

    }

    @if (queryTerms.Length > 0 || hasDateRange)

    {

        <div class="flex flex-wrap gap-2 mt-4" style="padding-bottom: 8px; width: 100%;">

            @foreach (var term in queryTerms)

            {

                <span class="filter-chip inline-flex items-center gap-1 px-3 py-1 text-sm rounded-full">

                    @term

                    <button type="button" onclick="removeChip('@term')" class="text-gray-400 hover:text-gray-700">

                        <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>

                    </button>

                </span>

            }

            @if (hasDateRange)
            {
                <span class="filter-chip inline-flex items-center gap-1 px-3 py-1 text-sm rounded-full">
                    Date: @(Model.FromDate ?? "...") to @(Model.ToDate ?? "...")
                    <button type="button" onclick="clearDateFields()" class="text-gray-400 hover:text-gray-700">
                        <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </button>
                </span>
            }

        </div>

    }

</form>



<script>

    function goToTopPage(pageNum) {
        if (!pageNum || pageNum < 1) pageNum = 1;
        var form = document.querySelector('form.toolbar');
        if (!form) return;
        var pageSelect = document.getElementById('PageSelect');
        if (pageSelect) pageSelect.value = pageNum;
        var queryInput = document.getElementById('QueryInput');
        if (queryInput && queryInput.value.trim() === '') {
            queryInput.disabled = true;
        }
        window._isPageChange = true;
        if (form.requestSubmit) {
            form.requestSubmit();
        } else {
            form.submit();
        }
    }



    document.querySelector('form.toolbar').addEventListener('submit', function(e) {

        var queryInput = document.getElementById('QueryInput');

        var queryHidden = document.getElementById('Query');

        if (queryInput && queryInput.value.trim() !== '') {

            var current = queryHidden.value ? queryHidden.value + '|' : '';

            queryHidden.value = current + queryInput.value.trim();

            queryInput.value = ''; // Don't submit the visual input

        }

        if (!window._isPageChange) {

            var pageSelect = document.getElementById('PageSelect');

            if (pageSelect) pageSelect.value = '1';

            var pageInput = this.querySelector('input[name="Page"]');

            if (pageInput) pageInput.value = '1';

        }

        window._isPageChange = false;

    });



    function removeChip(term) {

        var queryHidden = document.getElementById('Query');

        var terms = queryHidden.value.split('|').filter(t => t !== '' && t !== term);

        queryHidden.value = terms.join('|');

        window._isPageChange = false;

        document.querySelector('form.toolbar').submit();

    }

    function clearDateFields() {
        var fd = document.getElementById('FromDate');
        var td = document.getElementById('ToDate');
        if (fd) fd.value = '';
        if (td) td.value = '';
        window._isPageChange = false;
        var form = document.querySelector('form.toolbar');
        if (form) (form.requestSubmit ? form.requestSubmit() : form.submit());
    }

</script>



