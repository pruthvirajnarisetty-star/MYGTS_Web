@model ReminderPageViewModel







@{







    ViewData["Title"] = "Reminders";







    var currentBranch = Context.Request.Cookies["mygts_branch"] == "RTO" ? "RTO" : "DMG";







    var vendorPhoneMap = (ViewBag.VendorPhoneMap as Dictionary<string, string>) ?? new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);















    // Gather urgent expiries (expiring today or within 1 day)







    var urgentList = (ViewBag.UrgentDevices as List<DeviceRecord>) ?? new List<DeviceRecord>();







    if (urgentList.Count == 0 && Model.Buckets.TryGetValue("Expiring This Week", out var expiringList))







    {







        urgentList = expiringList.Where(d => DateValue.DaysFromNow(d.LatestExpiryDate) is >= 0 and <= 1).ToList();







    }







}















<div class="page-heading">







    <div>







        <div class="eyebrow">Operational risk / follow-up</div>







        <h1>Reminders</h1>







        <p>Surface expiry, renewals, and team follow-ups before they become fleet interruptions.</p>







    </div>







</div>















<div class="reminder-grid">







    @foreach (var bucket in Model.Buckets)







    {







        var isUrgent = bucket.Key == "Unpaid Vehicles" && bucket.Value.Count > 0;







        var borderStyle = isUrgent ? "border: 2px solid var(--red-600);" : "";







        var textStyle = isUrgent ? "color: var(--red-600);" : "";







        







        <a class="card reminder-card" 







           style="@borderStyle"







           asp-controller="Devices" 







           asp-action="Index" 







           asp-route-SpecialFilter="@bucket.Key">







            <h3 style="@textStyle">







                @if(isUrgent) { <span style="margin-right:4px;">🚨</span> }







                @bucket.Key







            </h3>







            <div class="reminder-count" style="@textStyle">@bucket.Value.Count</div>







            <p style="@(isUrgent ? "color: var(--red-600); font-weight: 500;" : "")">







                @(isUrgent ? "URGENT: Outstanding payment collection" : "Open operational records")







                <span style="float:right; color: @(isUrgent ? "var(--red-600)" : "var(--blue-600)");">↗</span>







            </p>







        </a>







    }







    







    <a class="card reminder-card" 







       style="@(Model.PendingRecharges.Count > 0 ? "border: 2px solid #d97706;" : "")"







       asp-controller="Recharges" 







       asp-action="Index" 







       asp-route-status="Pending">







        <h3 style="@(Model.PendingRecharges.Count > 0 ? "color: #d97706;" : "")">







            @if(Model.PendingRecharges.Count > 0) { <span style="margin-right:4px;">⚡</span> }







            Pending Recharges







        </h3>







        <div class="reminder-count" style="@(Model.PendingRecharges.Count > 0 ? "color: #d97706;" : "")">@Model.PendingRecharges.Count</div>







        <p style="@(Model.PendingRecharges.Count > 0 ? "color: #d97706; font-weight: 500;" : "")">







            SIM activations needing operator processing







            <span style="float:right; color: #d97706;">↗</span>







        </p>







    </a>















    <a class="card reminder-card" 







       style="@(Model.UnpaidRecharges.Count > 0 ? "border: 2px solid var(--red-600);" : "")"







       asp-controller="Recharges" 







       asp-action="Index" 







       asp-route-payment="Not Paid">







        <h3 style="@(Model.UnpaidRecharges.Count > 0 ? "color: var(--red-600);" : "")">







            @if(Model.UnpaidRecharges.Count > 0) { <span style="margin-right:4px;">🚨</span> }







            Unpaid Recharges







        </h3>







        <div class="reminder-count" style="@(Model.UnpaidRecharges.Count > 0 ? "color: var(--red-600);" : "")">@Model.UnpaidRecharges.Count</div>







        <p style="@(Model.UnpaidRecharges.Count > 0 ? "color: var(--red-600); font-weight: 500;" : "")">







            Processed recharges awaiting payment collection







            <span style="float:right; color: var(--red-600);">↗</span>







        </p>







    </a>







</div>















<div class="card toolbar" style="margin-top: 24px; margin-bottom: 24px; padding: 14px 20px;">







    <div class="filter-grid" style="align-items: flex-end; justify-content: space-between;">







        <div class="field toolbar-search" style="width: 340px; max-width: 400px; min-width: 240px; flex: 0 1 340px;">







            <label for="reminderSearchInput" class="form-label" style="margin-bottom: 4px; display: block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-main);">SEARCH REMINDERS</label>







            <div style="position: relative; width: 100%;">







                <button type="button" style="position: absolute; top: 50%; transform: translateY(-50%); left: 16px; padding: 0; background: transparent; border: none; display: flex; align-items: center; justify-content: center; pointer-events: none;">







                    <svg width="17" height="16" fill="none" xmlns="http://www.w3.org/2000/svg" style="width: 20px; height: 20px; color: #4b5563;">







                        <path d="M7.667 12.667A5.333 5.333 0 107.667 2a5.333 5.333 0 000 10.667zM14.334 14l-2.9-2.9" stroke="currentColor" stroke-width="1.333" stroke-linecap="round" stroke-linejoin="round"></path>







                    </svg>







                </button>







                <input id="reminderSearchInput" class="input shadow-md w-full" style="padding: 0 44px; border-radius: 9999px; height: 42px; width: 100%; border: 1px solid var(--line); outline: none; transition: all 0.3s; font-size: 14px;" placeholder="Search vehicle, note, vendor, phone..." type="text" oninput="filterReminders()" onfocus="this.style.borderColor='#3b82f6'" onblur="this.style.borderColor='var(--line)'" />







                <button type="button" id="reminderSearchClearBtn" onclick="clearReminderSearch()" style="display: none; position: absolute; top: 50%; transform: translateY(-50%); right: 12px; padding: 0; background: transparent; border: none; cursor: pointer; align-items: center; justify-content: center;">







                    <svg xmlns="http://www.w3.org/2000/svg" style="width: 20px; height: 20px; color: #4b5563;" fill="none" viewBox="0 0 24 24" stroke="currentColor">







                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>







                    </svg>







                </button>







            </div>







        </div>







        <div class="field toolbar-actions">







            <button type="button" class="button secondary" onclick="clearReminderSearch()" style="height: 42px; border-radius: 8px; padding: 0 16px; display: inline-flex; align-items: center; gap: 6px;" title="Reset search">







                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>







                <span>Clear</span>







            </button>







            <span id="reminderSearchResultsCount" style="font-size: 0.82rem; color: var(--muted); font-weight: 600; padding-left: 4px;"></span>







        </div>







    </div>







</div>















<div class="reminders-split-layout">







    <!-- Left Column: Imminent Expiries (Suspensions Today & Suspension Tomorrow) with 1-Click WhatsApp -->







    <section class="urgent-dispatch-panel">

        @{

            var totalActionable = urgentList.Count + Model.PendingRecharges.Count + Model.UnpaidRecharges.Count;

        }

        <div class="panel-header" style="flex-wrap: wrap; gap: 10px;">

            <div>

                <h2 style="margin: 0; font-size: 1.15rem; font-weight: 700; display: flex; align-items: center; gap: 8px; color: var(--text-main);">

                    <span>🚨</span> Imminent Expiries &amp; Recharge Follow-ups

                    @if (totalActionable > 0)

                    {

                        <span class="badge-urgent-count">@totalActionable Actionable</span>

                    }

                </h2>

                <p class="muted" style="margin: 2px 0 0; font-size: 0.8rem;">Vehicles expiring today/tomorrow &amp; SIM recharges requiring action across @currentBranch.</p>

            </div>

            <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">

                <button type="button" class="button secondary small" onclick="openBatchWhatsAppModal()" style="font-size: 0.78rem; font-weight: 700; color: #25D366; display: flex; align-items: center; gap: 5px;">

                    <span>📢</span> Batch WhatsApp

                </button>

                @if (urgentList.Count > 0)

                {

                    <a asp-controller="Devices" asp-action="Index" asp-route-SpecialFilter="Suspensions Today" class="button-link" style="font-size: 0.8rem;">View in fleet &rarr;</a>

                }

                <a asp-controller="Recharges" asp-action="Index" class="button-link" style="font-size: 0.8rem; color: #d97706;">Recharges &rarr;</a>

            </div>

        </div>



        @if (totalActionable > 0)

        {

            <div class="dispatch-filter-pills">

                <button type="button" class="dispatch-pill is-active" onclick="filterDispatchType('all', this)">

                    All Actionable <span class="pill-badge">@totalActionable</span>

                </button>

                <button type="button" class="dispatch-pill" onclick="filterDispatchType('expiries', this)">

                    🚨 Imminent Expiries <span class="pill-badge">@urgentList.Count</span>

                </button>

                @if (Model.UnpaidRecharges.Count > 0)

                {

                    <button type="button" class="dispatch-pill" onclick="filterDispatchType('unpaid', this)">

                        💳 Recharge Payment Due <span class="pill-badge">@Model.UnpaidRecharges.Count</span>

                    </button>

                }

                @if (Model.PendingRecharges.Count > 0)

                {

                    <button type="button" class="dispatch-pill" onclick="filterDispatchType('pending', this)">

                        ⚡ Pending Activation <span class="pill-badge">@Model.PendingRecharges.Count</span>

                    </button>

                }

            </div>

        }



        @if (totalActionable == 0)

        {

            <div class="card empty-state" style="padding: 32px 20px; text-align: center;">

                <div style="font-size: 2rem; margin-bottom: 8px;">🎉</div>

                <strong style="color: var(--text-main);">No vehicles expiring or pending recharges</strong>

                <p class="muted" style="margin: 4px 0 0; font-size: 0.85rem;">All active subscriptions and SIM recharges in @currentBranch branch are currently in good standing.</p>

            </div>

        }

        else

        {

            <div class="urgent-card-list">

                <div id="urgentNoResults" class="card empty-state" style="display: none; padding: 28px 20px; text-align: center; color: var(--muted);">

                    <div style="font-size: 1.6rem; margin-bottom: 6px;">🔍</div>

                    <strong>No actionable items match your filter / search</strong>

                </div>



                @* 1. Imminent Vehicle Expiries *@

                @foreach (var dev in urgentList)

                {

                    var daysLeft = DateValue.DaysFromNow(dev.LatestExpiryDate) ?? 0;

                    var isSuspension = daysLeft == 0;

                    var tagClass = isSuspension ? "tag-suspension" : "tag-tomorrow";

                    var tagText = isSuspension ? "Suspension Today" : "Suspension Tomorrow";

                    

                    var rawPhone = dev.CellNo?.Trim() ?? "";

                    var cleanPhone = new string(rawPhone.Where(char.IsDigit).ToArray());

                    if (cleanPhone.Length == 10) cleanPhone = "91" + cleanPhone;

                    var expiryStr = DateValue.Short(dev.LatestExpiryDate);

                    var vendorName = string.IsNullOrWhiteSpace(dev.Vendor) ? "Vendor" : dev.Vendor;

                    var msgOwner = $"*MYGTS SERVICES*\n\u200B\nDear Customer,\n\u200B\nYour *One State One GPS* recharge for vehicle *{dev.VehicleNo}* will expire on *{expiryStr}*.\n\u200B\nKindly renew the recharge before the expiry date to avoid interruption of GPS tracking services.\n\u200B\nThank you,\n*MYGTS SERVICES*\n\u200B\n--------------------------------\n\u200B\n*ಮೈ ಜಿಟಿಎಸ್ ಸರ್ವಿಸಸ್ (MYGTS SERVICES)*\n\u200B\nಪ್ರಿಯ ಗ್ರಾಹಕರೇ,\n\u200B\nನಿಮ್ಮ ವಾಹನ *{dev.VehicleNo}* ನ ಒಂದು ರಾಜ್ಯ ಒಂದು ಜಿಪಿಎಸ್ (One State One GPS) ರಿಚಾರ್ಜ್ *{expiryStr}* ರಂದು ಮುಕ್ತಾಯಗೊಳ್ಳಲಿದೆ.\n\u200B\nಜಿಪಿಎಸ್ ಟ್ರ್ಯಾಕಿಂಗ್ ಸೇವೆಗಳಲ್ಲಿ ಯಾವುದೇ ಅಡಚಣೆಯನ್ನು ತಪ್ಪಿಸಲು ದಯವಿಟ್ಟು ಮುಕ್ತಾಯದ ದಿನಾಂಕದ ಮೊದಲು ರಿಚಾರ್ಜ್ ಅನ್ನು ನವೀಕರಿಸಿ (Renew).\n\u200B\nಧನ್ಯವಾದಗಳು,\n*ಮೈ ಜಿಟಿಎಸ್ ಸರ್ವಿಸಸ್ (MYGTS SERVICES)*";

                    var msgVendor = $"*MYGTS SERVICES*\n\u200B\nDear {vendorName},\n\u200B\nThe GPS recharge for your client's vehicle *{dev.VehicleNo}* will expire on *{expiryStr}*.\n\u200B\nPlease ensure the renewal is completed before the expiry date.\n\u200B\nThank you,\n*MYGTS SERVICES*\n\u200B\n--------------------------------\n\u200B\n*ಮೈ ಜಿಟಿಎಸ್ ಸರ್ವಿಸಸ್ (MYGTS SERVICES)*\n\u200B\nಪ್ರಿಯ {vendorName},\n\u200B\nನಿಮ್ಮ ಕ್ಲೈಂಟ್‌ನ ವಾಹನ *{dev.VehicleNo}* ನ ಒಂದು ರಾಜ್ಯ ಒಂದು ಜಿಪಿಎಸ್ (One State One GPS) ರಿಚಾರ್ಜ್ *{expiryStr}* ರಂದು ಮುಕ್ತಾಯಗೊಳ್ಳಲಿದೆ.\n\u200B\nಜಿಪಿಎಸ್ ಟ್ರ್ಯಾಕಿಂಗ್ ಸೇವೆಗಳಲ್ಲಿ ಯಾವುದೇ ಅಡಚಣೆಯನ್ನು ತಪ್ಪಿಸಲು ದಯವಿಟ್ಟು ಮುಕ್ತಾಯದ ದಿನಾಂಕದ ಮೊದಲು ರಿಚಾರ್ಜ್ ಅನ್ನು ನವೀಕರಿಸಿ (Renew).\n\u200B\nಧನ್ಯವಾದಗಳು,\n*ಮೈ ಜಿಟಿಎಸ್ ಸರ್ವಿಸಸ್ (MYGTS SERVICES)*";

                    var waOwnerUrl = string.IsNullOrWhiteSpace(cleanPhone)

                        ? $"https://web.whatsapp.com/send?text={Uri.EscapeDataString(msgOwner)}"

                        : $"https://web.whatsapp.com/send?phone={cleanPhone}&text={Uri.EscapeDataString(msgOwner)}";

                    var vendorPhone = !string.IsNullOrWhiteSpace(dev.Vendor) && vendorPhoneMap.TryGetValue(dev.Vendor.Trim(), out var vp) ? vp : "";

                    var cleanVendorPhone = new string(vendorPhone.Where(char.IsDigit).ToArray());

                    if (cleanVendorPhone.Length == 10) cleanVendorPhone = "91" + cleanVendorPhone;

                    var waVendorUrl = !string.IsNullOrWhiteSpace(cleanVendorPhone)

                        ? $"https://web.whatsapp.com/send?phone={cleanVendorPhone}&text={Uri.EscapeDataString(msgVendor)}"

                        : $"https://web.whatsapp.com/send?text={Uri.EscapeDataString(msgVendor)}";



                    <div class="card urgent-dev-card dispatch-item dispatch-item-expiries @(isSuspension ? "card-danger" : "card-warning")" id="urgent-dev-@dev.VehicleNo">

                        <div class="dev-card-main">

                            <div class="dev-card-info">

                                <div class="dev-vehicle-line">

                                    <span class="vehicle-no">@dev.VehicleNo</span>

                                    <span class="status-pill @tagClass">@tagText</span>

                                    @if (!string.IsNullOrWhiteSpace(dev.NetworkOperator))

                                    {

                                        <span class="badge" style="font-size: 0.72rem; background: #e0f2fe; color: #0369a1; font-weight: 600; padding: 2px 7px; border-radius: 4px; border: 1px solid #bae6fd;">@dev.NetworkOperator</span>

                                    }

                                </div>

                                <div class="dev-meta-line">

                                    <span><strong>Owner:</strong> @(string.IsNullOrWhiteSpace(dev.Owner) ? "Not Assigned" : dev.Owner)</span>

                                    @if (!string.IsNullOrWhiteSpace(dev.CellNo))

                                    {

                                        <span>&bull; <strong>Phone:</strong> @dev.CellNo</span>

                                    }

                                    <span>&bull; <strong>Vendor:</strong> @(string.IsNullOrWhiteSpace(dev.Vendor) ? "—" : dev.Vendor)</span>

                                    @if (!string.IsNullOrWhiteSpace(dev.NetworkOperator))

                                    {

                                        <span>&bull; <strong>Operator:</strong> @dev.NetworkOperator</span>

                                    }

                                    <span>&bull; <strong>Expiry:</strong> @expiryStr</span>

                                </div>

                            </div>



                            <div class="dev-card-actions">

                                <div class="wa-picker" style="position: relative; display: inline-block;">

                                    <button type="button" class="button-wa" onclick="toggleWaPicker(this)" title="Send WhatsApp message">

                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>

                                        WhatsApp ▾

                                    </button>

                                    <div class="wa-picker-dropdown" style="display:none; position:absolute; bottom: calc(100% + 6px); left:0; background:#ffffff; border:1px solid #cbd5e1; border-radius:8px; box-shadow:0 10px 25px -5px rgba(0,0,0,0.25), 0 8px 10px -6px rgba(0,0,0,0.2); min-width:240px; z-index:9999; overflow:hidden;">

                                        <div style="padding:8px 12px 6px; font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.06em; color:#475569; background:#f8fafc; border-bottom:1px solid #e2e8f0;">Send message to</div>

                                        <a href="@waOwnerUrl" target="_blank" onclick="closeWaPicker(this)" style="display:flex; flex-direction:column; padding:10px 14px; text-decoration:none; color:#0f172a; background:#ffffff; transition:background 0.15s;" onmouseover="this.style.background='#f1f5f9'" onmouseout="this.style.background='#ffffff'">

                                            <span style="font-weight:600; font-size:0.85rem;">👤 Owner@(!string.IsNullOrWhiteSpace(dev.Owner) ? $" — {dev.Owner}" : "")</span>

                                            <span style="font-size:0.75rem; color:#64748b;">@(string.IsNullOrWhiteSpace(dev.CellNo) ? "No phone number on file" : dev.CellNo)</span>

                                        </a>

                                        <a href="@waVendorUrl" target="_blank" onclick="closeWaPicker(this)" style="display:flex; flex-direction:column; padding:10px 14px; text-decoration:none; color:#0f172a; background:#ffffff; border-top:1px solid #e2e8f0; transition:background 0.15s;" onmouseover="this.style.background='#f1f5f9'" onmouseout="this.style.background='#ffffff'">

                                            <span style="font-weight:600; font-size:0.85rem;">🏪 Vendor@(!string.IsNullOrWhiteSpace(dev.Vendor) ? $" — {dev.Vendor}" : "")</span>

                                            <span style="font-size:0.75rem; color:#64748b;">@(string.IsNullOrWhiteSpace(cleanVendorPhone) ? "No phone set — add via Vendors page" : vendorPhone)</span>

                                        </a>

                                    </div>

                                </div>

                                <button type="button" class="button-informed" onclick="markVehicleInformed('@dev.VehicleNo')" title="Snooze alert until tomorrow">

                                    Informed

                                </button>

                                <a asp-controller="Transactions" asp-action="Create" asp-route-VehicleNo="@dev.VehicleNo" class="btn-renew-action">

                                    Collect / Renew

                                </a>

                            </div>

                        </div>

                    </div>

                }



                @* 2. Recharge Payment Due Cards *@

                @foreach (var rc in Model.UnpaidRecharges)

                {

                    var title = !string.IsNullOrWhiteSpace(rc.VehicleNo) ? rc.VehicleNo : (!string.IsNullOrWhiteSpace(rc.Imei) ? rc.Imei : rc.Iccid);

                    var vendorName = rc.Vendor?.Trim() ?? "";

                    vendorPhoneMap.TryGetValue(vendorName, out var vendorPhone);

                    var cleanVendorPhone = new string((vendorPhone ?? "").Where(char.IsDigit).ToArray());

                    if (cleanVendorPhone.Length == 10) cleanVendorPhone = "91" + cleanVendorPhone;



                    var msgVendor = $"*MYGTS SERVICES*\n\u200B\nDear {(string.IsNullOrWhiteSpace(vendorName) ? "Vendor" : vendorName)},\n\u200B\nThe GPS recharge for vehicle *{rc.VehicleNo}* was processed on *{rc.RechargeDate}*. Please clear the pending payment.\n\u200B\nThank you,\n*MYGTS SERVICES*";

                    var waVendorUrl = !string.IsNullOrWhiteSpace(cleanVendorPhone)

                        ? $"https://web.whatsapp.com/send?phone={cleanVendorPhone}&text={Uri.EscapeDataString(msgVendor)}"

                        : $"https://web.whatsapp.com/send?text={Uri.EscapeDataString(msgVendor)}";



                    <div class="card urgent-dev-card dispatch-item dispatch-item-unpaid card-danger" id="recharge-unpaid-@rc.Id" style="border-left: 4px solid #ef4444; background: #fffafa;">

                        <div class="dev-card-main">

                            <div class="dev-card-info">

                                <div class="dev-vehicle-line">

                                    <span class="vehicle-no">💳 @title</span>

                                    <span class="status-pill tag-danger" style="background: #fee2e2; color: #dc2626; border: 1px solid #fca5a5; font-size: 0.72rem; padding: 2px 7px; border-radius: 4px;">Payment Due</span>

                                    @if (!string.IsNullOrWhiteSpace(rc.NetworkOperator))

                                    {

                                        <span class="badge" style="font-size: 0.72rem; background: #e0f2fe; color: #0369a1; font-weight: 600; padding: 2px 7px; border-radius: 4px; border: 1px solid #bae6fd;">@rc.NetworkOperator</span>

                                    }

                                </div>

                                <div class="dev-meta-line">

                                    <span><strong>Vendor:</strong> @(string.IsNullOrWhiteSpace(rc.Vendor) ? "—" : rc.Vendor)</span>

                                    @if (!string.IsNullOrWhiteSpace(cleanVendorPhone))

                                    {

                                        <span>&bull; <strong>Phone:</strong> @cleanVendorPhone</span>

                                    }

                                    @if (!string.IsNullOrWhiteSpace(rc.NetworkOperator))

                                    {

                                        <span>&bull; <strong>Operator:</strong> @rc.NetworkOperator</span>

                                    }

                                    <span>&bull; <strong>Processed:</strong> @rc.RechargeDate</span>

                                    @if (rc.AmountPaid > 0)

                                    {

