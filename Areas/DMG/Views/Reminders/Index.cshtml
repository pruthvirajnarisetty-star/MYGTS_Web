                                            <button type="button" class="audience-preset-btn audience-preset-self" onclick="setAudiencePreset('@@me', 'TargetAudience-@reminder.Id')">👤 @@me (Self)</button>







                                            <button type="button" class="audience-preset-btn" onclick="setAudiencePreset('@@Admin', 'TargetAudience-@reminder.Id')">@@Admin</button>







                                            <button type="button" class="audience-preset-btn" onclick="setAudiencePreset('@@Executive', 'TargetAudience-@reminder.Id')">@@Executive</button>







                                            <button type="button" class="audience-preset-btn" onclick="setAudiencePreset('@@Team', 'TargetAudience-@reminder.Id')">@@Team</button>







                                            <button type="button" class="audience-preset-btn" onclick="setAudiencePreset('@@User', 'TargetAudience-@reminder.Id')">@@User</button>







                                        </div>







                                        <input class="input" name="TargetAudience" id="TargetAudience-@reminder.Id" value="@reminder.TargetAudience" list="audiencePresetsList" style="font-size: 0.84rem;" />







                                    </div>















                                    <div class="field" style="margin-bottom: 10px;">







                                        <label class="form-label" for="Details-@reminder.Id" style="font-size: 0.78rem;">Details</label>







                                        <textarea class="textarea" name="Details" id="Details-@reminder.Id" style="font-size: 0.84rem; min-height: 55px;">@reminder.Details</textarea>







                                    </div>















                                    <div class="field" style="margin-bottom: 12px;">







                                        <label class="form-label" for="DueDate-@reminder.Id" style="font-size: 0.78rem;">Due date</label>







                                        <input class="input" type="date" name="DueDate" id="DueDate-@reminder.Id" value="@reminder.DueDate" style="font-size: 0.84rem;" />







                                    </div>















                                    <div style="display: flex; gap: 8px; justify-content: flex-end;">







                                        <button type="button" class="button secondary" onclick="toggleEditNote('@reminder.Id')" style="font-size: 0.78rem; padding: 4px 10px;">Cancel</button>







                                        <button type="submit" class="button primary" style="font-size: 0.78rem; padding: 4px 14px;">Save Changes</button>







                                    </div>







                                </form>







                            </div>







                        }







                    </article>







                }







            }







        </div>







    </section>







</div>



























