<script>







function setAudiencePreset(val, targetInputId = 'TargetAudience') {







    const input = document.getElementById(targetInputId);







    if (!input) return;







    if (val === '@@all' || val === '@@me') {







        input.value = val;







        return;







    }







    let cur = input.value.trim();







    if (cur === '@@all' || cur === '@@me' || cur === '') {







        input.value = val;







    } else {







        const parts = cur.split(',').map(s => s.trim()).filter(Boolean);







        if (!parts.includes(val)) {







            parts.push(val);







            input.value = parts.join(', ');







        }







    }







}















function toggleEditNote(id) {







    const viewEl = document.getElementById('note-view-' + id);







    const editEl = document.getElementById('note-edit-' + id);







    if (!viewEl || !editEl) return;







    if (editEl.style.display === 'none' || editEl.style.display === '') {







        editEl.style.display = 'block';







        viewEl.style.display = 'none';







        const titleInput = editEl.querySelector('input[name="Title"]');







        if (titleInput) titleInput.focus();







    } else {







        editEl.style.display = 'none';







        viewEl.style.display = 'block';







    }







}















function toggleReminderForm() {







    const container = document.getElementById('createReminderContainer');







    const icon = document.getElementById('btnIcon');







    const text = document.getElementById('btnText');







    if (!container) return;







    if (container.style.display === 'none' || container.style.display === '') {







        container.style.display = 'block';







        if (icon) icon.textContent = '✕';







        if (text) text.textContent = 'Close';







        const titleInput = document.getElementById('Title');







        if (titleInput) titleInput.focus();







    } else {







        container.style.display = 'none';







        if (icon) icon.textContent = '+';







        if (text) text.textContent = 'Add Note';







    }







}















function toggleWaPicker(btn) {







    const dropdown = btn.nextElementSibling;







    const isOpen = dropdown.style.display !== 'none';







    document.querySelectorAll('.wa-picker-dropdown').forEach(d => d.style.display = 'none');







    if (!isOpen) dropdown.style.display = 'block';







}















function closeWaPicker(link) {







    const dropdown = link.closest('.wa-picker-dropdown');







    if (dropdown) dropdown.style.display = 'none';







}















document.addEventListener('click', function(e) {







    if (!e.target.closest('.wa-picker')) {







        document.querySelectorAll('.wa-picker-dropdown').forEach(d => d.style.display = 'none');







    }







});



















function filterDispatchType(type, btn) {



    document.querySelectorAll('.dispatch-pill').forEach(p => p.classList.remove('is-active'));



    if (btn) btn.classList.add('is-active');







    const items = document.querySelectorAll('.dispatch-item');



    items.forEach(item => {



        if (type === 'all') {



            item.dataset.typeHidden = 'false';



        } else if (type === 'expiries' && item.classList.contains('dispatch-item-expiries')) {



            item.dataset.typeHidden = 'false';



        } else if (type === 'unpaid' && item.classList.contains('dispatch-item-unpaid')) {



            item.dataset.typeHidden = 'false';



        } else if (type === 'pending' && item.classList.contains('dispatch-item-pending')) {



            item.dataset.typeHidden = 'false';



        } else {



            item.dataset.typeHidden = 'true';



        }



    });



    filterReminders();



}







function filterReminders() {







    const input = document.getElementById('reminderSearchInput');







    const clearBtn = document.getElementById('reminderSearchClearBtn');







    const resultsCount = document.getElementById('reminderSearchResultsCount');







    if (!input) return;















    const query = input.value.trim().toLowerCase();







    if (clearBtn) clearBtn.style.display = query.length > 0 ? 'flex' : 'none';















    let totalMatches = 0;















    // 1. Filter Imminent Expiries







    const urgentCards = document.querySelectorAll('.urgent-dev-card');







    let urgentMatches = 0;







    urgentCards.forEach(card => {
        if (card.dataset.typeHidden === 'true') {
            card.style.display = 'none';
            return;
        }
        const text = card.textContent.toLowerCase();







        if (!query || text.includes(query)) {







            card.style.display = '';







            urgentMatches++;







            totalMatches++;







        } else {







            card.style.display = 'none';







        }







    });







    const urgentNoResults = document.getElementById('urgentNoResults');







    if (urgentNoResults) {







        urgentNoResults.style.display = (urgentCards.length > 0 && urgentMatches === 0 && query) ? 'block' : 'none';







    }















    // 2. Filter Follow-ups / Notes







    const noteItems = document.querySelectorAll('.followups-panel .note-item');







    let noteMatches = 0;







    noteItems.forEach(note => {







        const text = note.textContent.toLowerCase();







        if (!query || text.includes(query)) {







            note.style.display = '';







            noteMatches++;







            totalMatches++;







        } else {







            note.style.display = 'none';







        }







    });







    const followupsNoResults = document.getElementById('followupsNoResults');







    if (followupsNoResults) {







        followupsNoResults.style.display = (noteItems.length > 0 && noteMatches === 0 && query) ? 'block' : 'none';







    }















    // Update result counter badge







    if (resultsCount) {







        if (query) {







            resultsCount.textContent = `${totalMatches} matching item${totalMatches === 1 ? '' : 's'}`;







        } else {







            resultsCount.textContent = '';







        }







    }







}















function clearReminderSearch() {







    const input = document.getElementById('reminderSearchInput');







    if (input) {







        input.value = '';







        input.focus();







        filterReminders();







    }







}















// Auto-populate search from URL query if present (e.g. /Reminders?q=KA28)







document.addEventListener('DOMContentLoaded', function() {







    const params = new URLSearchParams(window.location.search);







    const q = params.get('q') || params.get('query') || params.get('search');







    if (q) {







        const input = document.getElementById('reminderSearchInput');







        if (input) {







            input.value = q;







            filterReminders();







        }







    }







});







</script>







