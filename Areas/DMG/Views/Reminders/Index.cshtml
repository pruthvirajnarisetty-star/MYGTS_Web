                    </div>







                    







                    <div class="form-actions" style="margin-top: 8px;">







                        <button class="button primary" type="submit" style="font-size: 0.85rem; padding: 6px 14px;">Save Reminder</button>







                    </div>







                </form>







            </div>







        }















        <div class="note-list">







