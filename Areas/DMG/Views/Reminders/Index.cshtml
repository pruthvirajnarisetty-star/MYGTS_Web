                            <label class="form-label" for="TargetAudience" style="font-size: 0.8rem; margin: 0; font-weight: 700;">Visible to / CC</label>







                            <span style="font-size: 0.72rem; color: var(--muted);">Who can see this follow-up</span>







                        </div>







                        <div style="display: flex; gap: 6px; margin-bottom: 6px; flex-wrap: wrap;">







