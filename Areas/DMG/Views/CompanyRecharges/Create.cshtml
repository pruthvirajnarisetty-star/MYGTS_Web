@model CompanyRechargeBatchFormViewModel
@{
    ViewData["Title"] = "New Taisys Batch";
    var defaultRechargeRate = ViewBag.DefaultRechargeRate as decimal? ?? 1298m;
    var defaultReactivationRate = ViewBag.DefaultReactivationRate as decimal? ?? 1534m;
    var candidateBatches = ViewBag.CandidateBatches as List<CompanyRechargeBatch> ?? new List<CompanyRechargeBatch>();
}

<style>
    .cr-form-header-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 20px;
        margin-bottom: 24px;
    }
</style>

<div class="page-heading">
    <div>
        <div class="eyebrow">Carrier Management</div>
        <h1>New Taisys Batch</h1>
        <p>Record a new Taisys advance payment batch. Device rows (renewals/reactivations) are added directly inside the batch table.</p>
    </div>
    <div>
        <a asp-action="Index" class="button secondary">&larr; Back to Taisys</a>
    </div>
</div>

<form asp-action="Create" method="post" id="batchForm">
    @Html.AntiForgeryToken()

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
    {
        <div class="alert alert-danger" style="padding: 12px 18px; margin-bottom: 20px; border-radius: 8px; background: rgba(239, 68, 68, 0.12); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.3);">
            <div asp-validation-summary="All"></div>
        </div>
    }

    <!-- BATCH DETAILS CARD -->
    <div class="card" style="padding: 28px; max-width: 960px; margin-bottom: 24px;">
        <h3 style="margin-top: 0; margin-bottom: 20px; font-size: 1.15rem; color: var(--text-main); display: flex; align-items: center; gap: 8px;">
            <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            Batch Advance Payment Details
        </h3>

        <div class="cr-form-header-grid">
            <div class="field" style="margin: 0;">
                <label class="form-label" asp-for="Provider">Carrier Provider *</label>
                <select asp-for="Provider" class="select" style="height: 44px; font-weight: 600;" id="providerSelect">
                    <option value="BlueMine">🔵 BlueMine (Rates: ₹@(((decimal?)ViewBag.BluemineRechargeRate ?? 1156.40m).ToString("N2")) / ₹@(((decimal?)ViewBag.BluemineReactRate ?? 1392.40m).ToString("N2")))</option>
                    <option value="MYGTS">🟣 MYGTS (Rates: ₹@(((decimal?)ViewBag.MygtsRechargeRate ?? 1298.00m).ToString("N2")) / ₹@(((decimal?)ViewBag.MygtsReactRate ?? 1534.00m).ToString("N2")))</option>
                </select>
            </div>

            <div class="field" style="margin: 0;">
                <label class="form-label" asp-for="PoNumber">PO Number *</label>
                <input asp-for="PoNumber" class="input" placeholder="e.g. PI/24-25/3964" required style="height: 44px; font-weight: 600;" autofocus />
                <span asp-validation-for="PoNumber" class="text-danger" style="font-size: 0.8rem;"></span>
            </div>

            <div class="field" style="margin: 0;">
                <label class="form-label" asp-for="PaymentReferenceNo">Payment Ref No (CMS / UTR)</label>
                <input asp-for="PaymentReferenceNo" class="input" placeholder="e.g. CMS5309995167" style="height: 44px;" />
            </div>

            <div class="field" style="margin: 0;">
                <label class="form-label" asp-for="BatchDate">Batch Date *</label>
                <input asp-for="BatchDate" type="date" class="input" required style="height: 44px;" />
            </div>

            <div class="field" style="margin: 0;">
                <label class="form-label" asp-for="AdvanceAmount">Advance Amount Paid (₹) *</label>
                <input asp-for="AdvanceAmount" type="number" step="0.01" min="0" class="input" placeholder="50000.00" required style="height: 44px; font-weight: 700; font-size: 1.1rem; color: #2563eb;" />
                <small style="color: var(--muted); font-size: 0.8rem; margin-top: 4px; display: block;">Total advance money transferred to the network provider.</small>
            </div>
        </div>

        <!-- CARRY FORWARD LEFTOVER BALANCE SECTION -->
        <div style="background: rgba(248, 250, 252, 0.7); border: 1px dashed var(--line); border-radius: 10px; padding: 18px 20px; margin-top: 14px; margin-bottom: 20px;">
            <div style="display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap;">
                <div>
                    <label class="form-label" style="font-weight: 700; color: var(--text-main); margin-bottom: 2px;">
                        Carry Forward Leftover Balance from Previous Batch (Optional)
                    </label>
                    <div style="font-size: 0.84rem; color: var(--muted);">
                        Roll leftover funds from an earlier batch into this new batch so that zero company money is stranded or wasted.
                    </div>
                </div>

                <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
                    <select id="carryForwardSelect" class="select" style="min-width: 280px; height: 40px;" onchange="onCarryForwardSelect(this)">
                        <option value="">-- None (No carry forward) --</option>
                        @foreach (var b in candidateBatches)
                        {
                            var bRemaining = b.RemainingBalance;
                            <option value="@b.Id" data-po="@b.PoNumber" data-balance="@bRemaining">
                                @b.PoNumber &mdash; Leftover: ₹@bRemaining.ToString("N2")
                            </option>
                        }
                    </select>

                    <div style="display: flex; align-items: center; gap: 6px;">
                        <span style="font-size: 0.85rem; color: var(--muted);">Credit: ₹</span>
                        <input asp-for="CarriedForwardAmount" type="number" step="0.01" min="0" class="input" style="width: 120px; height: 40px; font-weight: 700; color: #10b981;" readonly="readonly" id="carriedForwardInput" />
                        <input type="hidden" asp-for="TransferredFromBatchPo" id="transferredFromBatchPo" />
                        <input type="hidden" name="sourceCarryBatchId" id="sourceCarryBatchId" />
                    </div>
                </div>
            </div>
        </div>

        <div class="field" style="margin-bottom: 24px;">
            <label class="form-label" asp-for="Notes">Notes / Remarks</label>
            <input asp-for="Notes" class="input" placeholder="e.g. 50k payment sent via CMS for quarterly SIM recharges" style="height: 42px;" />
        </div>

        <div style="padding: 16px 20px; border-radius: 8px; background: rgba(59, 130, 246, 0.06); border: 1px solid rgba(59, 130, 246, 0.2); margin-bottom: 24px; display: flex; align-items: center; gap: 12px;">
            <svg width="22" height="22" fill="none" stroke="#2563eb" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <div style="font-size: 0.88rem; color: var(--text-main);">
                <strong>Next Step:</strong> After clicking <em>Save Batch</em>, your batch will be created and you can enter device rows directly inside the batch table.
            </div>
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 14px; align-items: center; border-top: 1px solid var(--line); padding-top: 20px;">
            <a asp-action="Index" class="button secondary">Cancel</a>
            <button type="submit" class="button btn-primary" style="padding: 10px 32px; font-size: 0.95rem; font-weight: 600;">
                Save Batch
            </button>
        </div>
    </div>
</form>

<script>
    function onCarryForwardSelect(select) {
        const opt = select.options[select.selectedIndex];
        const carriedInput = document.getElementById('carriedForwardInput');
        const poHidden = document.getElementById('transferredFromBatchPo');
        const sourceIdHidden = document.getElementById('sourceCarryBatchId');

        if (opt && opt.value) {
            const bal = parseFloat(opt.getAttribute('data-balance')) || 0;
            const po = opt.getAttribute('data-po') || '';
            carriedInput.value = bal.toFixed(2);
            poHidden.value = po;
            sourceIdHidden.value = opt.value;
        } else {
            carriedInput.value = '0.00';
            poHidden.value = '';
            sourceIdHidden.value = '';
        }
    }
</script>
