                                <input type="checkbox">
                                <div class="quick-add-btn" tabindex="0">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" viewBox="0 0 16 16"><path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/></svg> New
                                </div>
                                <nav class="popup-window" style="--nav-position-left: unset; --nav-position-right: 0;">
                                    <ul>
                                        @if (User.CanEditModule("Devices")) { <li><a asp-area="@currentBranch" asp-controller="Devices" asp-action="Create">Device</a></li> }
                                        @if (User.CanEditModule("Invoices")) { <li><a asp-area="@currentBranch" asp-controller="Invoices" asp-action="Create">Invoice</a></li> }
                                        @if (User.CanEditModule("Transactions")) { <li><a asp-area="@currentBranch" asp-controller="Transactions" asp-action="Create">Transaction</a></li> }
                                    </ul>
                                </nav>
                            </label>
                        </div>
                    }

                    <!-- Theme Switcher -->
                    <label for="theme" class="theme" style="--bg: #fff; --transDur: 0.3s; --primary: @(currentBranch == "RTO" ? "var(--orange-600)" : "var(--blue-600)"); --primaryT: @(currentBranch == "RTO" ? "var(--orange-500)" : "var(--blue-500)"); font-size: 10px; margin: 0 4px;">
                        <span class="theme__toggle-wrap">
                            <input id="theme" class="theme__toggle" type="checkbox" role="switch" name="theme" value="dark">
                            <script>
                                if (localStorage.getItem('mygts_theme') === 'dark') {
                                    document.getElementById('theme').checked = true;
                                }
                                document.getElementById('theme').addEventListener('change', function() {
                                    localStorage.setItem('mygts_theme', this.checked ? 'dark' : 'light');
                                    if (typeof drawFleetChart === 'function') {
                                        drawFleetChart();
                                    }
                                });
                            </script>
                            <span class="theme__fill"></span>
                            <span class="theme__icon">
                                <span class="theme__icon-part"></span>
                                <span class="theme__icon-part"></span>
                                <span class="theme__icon-part"></span>
                                <span class="theme__icon-part"></span>
                                <span class="theme__icon-part"></span>
                                <span class="theme__icon-part"></span>
                                <span class="theme__icon-part"></span>
                                <span class="theme__icon-part"></span>
                                <span class="theme__icon-part"></span>
                            </span>
                        </span>
                    </label>

                    <!-- Notification Bell Alert Center (placed directly left of Exec) -->
                    <div class="notification-center">
                        <input type="checkbox" id="notification-toggle" style="display: none;">
                        <label for="notification-toggle" class="notification-popup-toggle" style="margin: 0; cursor: pointer; display: inline-flex; align-items: center;">
                            <div class="notification @(alertCount > 0 ? "has-alerts" : "")" data-count="@alertCount" tabindex="0" title="@(alertCount > 0 ? $"{alertCount} device(s) expiring within 7 days" : "No expiring devices")">
                                <div class="bell-container">
                                    <div class="bell"></div>
                                </div>
                            </div>
                        </label>
                            
                        <div class="notification-drawer">
                                <div class="notification-header">
                                    <div class="notification-header-row">
                                        <div class="notification-title-wrap">
                                            <h4 class="notification-title">
                                                <span>🔔</span> @(isExecutive ? "Alerts & Follow-ups" : "My Alerts")
                                            </h4>
                                            @if (alertCount > 0)
                                            {
                                                <span class="alert-pill-count" id="headerAlertCount">@alertCount DUE</span>
                                            }
                                        </div>
                                        <div class="notification-header-actions">
                                            <button type="button" class="btn-clear-all" onclick="clearAllNotifications()" title="Clear all notifications">Clear all</button>
                                        </div>
                                    </div>
                                    <p class="notification-subtitle">
                                        @if (isExecutive)
                                        {
                                            if (openFollowups.Any())
                                            {
                                                @($"{overdueAlerts.Count} overdue, {expiringWeekAlerts.Count} expiring, {openFollowups.Count} follow-up(s)")
                                            }
                                            else if (overdueAlerts.Any())
                                            {
                                                @($"{overdueAlerts.Count} overdue, {expiringWeekAlerts.Count} expiring in {currentBranch}")
                                            }
                                            else if (alertCount > 0)
                                            {
                                                @($"{alertCount} alert(s) in {currentBranch}")
                                            }
                                            else
                                            {
                                                @("All devices and follow-ups are up to date")
                                            }
                                        }
                                        else
                                        {
                                            @(openFollowups.Any() ? $"{openFollowups.Count} alert(s) addressed to you" : "No alerts addressed to you")
                                        }
                                    </p>
                                </div>

                                <!-- Alert Search Bar -->
                                <div class="notification-search-box">
                                    <div style="position: relative; width: 100%; display: flex; align-items: center;">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; left: 10px; color: var(--muted, #64748b); pointer-events: none;">
                                            <circle cx="11" cy="11" r="8"></circle>
                                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                        </svg>
                                        <input type="text" id="alertSearchInput" class="input" placeholder="Search vehicle, owner, cell, or alert..." oninput="filterAlerts(this.value)" autocomplete="off" style="width: 100%; height: 32px; font-size: 0.78rem; padding: 4px 28px 4px 30px; border-radius: 6px; outline: none;" />
                                        <button type="button" id="alertSearchClear" onclick="clearAlertSearch()" title="Clear search" style="display: none; position: absolute; right: 6px; background: none; border: none; cursor: pointer; color: var(--muted, #64748b); padding: 4px; line-height: 1;">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                        </button>
                                    </div>
                                </div>

                                <div class="notification-list">
                                    @if (alertCount == 0 && !overdueAlerts.Any() && !lifecycleShiftList.Any() && !openFollowups.Any() && !pendingRechargeAlerts.Any() && !unpaidRechargeAlerts.Any())
                                    {
                                        <div style="padding: 24px 16px; text-align: center; color: var(--muted); font-size: 0.85rem;">
                                            <div style="font-size: 1.8rem; margin-bottom: 6px;">🎉</div>
                                            <strong style="color: var(--text-main);">@(isExecutive ? "No alerts or overdue devices" : "No active alerts")</strong>
                                            <div style="font-size: 0.75rem; margin-top: 2px;">@(isExecutive ? $"Subscriptions and follow-ups across {currentBranch} branch are in good standing." : "You have no pending alerts or follow-ups addressed to you.")</div>
                                        </div>
                                    }
                                    else
                                    {
                                        @if (overdueAlerts.Any())
                                        {
                                            <div class="notification-section" data-section-id="overdue">
                                                <div class="notification-section-divider urgent-divider" data-section="overdue" onclick="toggleAlertSection('overdue', this)" onkeydown="onSectionHeaderKeydown(event, 'overdue')" role="button" aria-expanded="false" tabindex="0">
                                                    <span class="section-title">🚨 Overdue &amp; Expired (@overdueAlerts.Count)</span>
                                                    <span class="section-chevron"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></span>
                                                </div>
                                                <div id="section-body-overdue" class="notification-section-body" style="display:none;">

                                            @{
                                                var displayOverdue = overdueAlerts.Take(15).ToList();
                                            }
                                            @foreach (var alertDev in displayOverdue)
                                            {
                                                var daysPast = alertDev.DaysPastExpiry ?? Math.Abs(DateValue.DaysFromNow(alertDev.LatestExpiryDate) ?? 0);
