    <script>
    (function initRecharge5PmAlarm() {
        function checkAndTrigger() {
            const now = new Date();
            const hour = now.getHours();

            // Trigger when 5:00 PM (17:00) or later
            if (hour >= 17) {
                const todayStr = now.toISOString().slice(0, 10);
                const snoozeUntil = sessionStorage.getItem('recharge_5pm_snooze_until');
                if (snoozeUntil && Date.now() < parseInt(snoozeUntil, 10)) {
                    return;
                }
                const dismissedDay = sessionStorage.getItem('recharge_5pm_dismissed_day');
                if (dismissedDay === todayStr) {
                    return;
                }

                fetch('/Recharges/PendingAlert')
                    .then(r => {
                        if (!r.ok) return null;
                        return r.json();
                    })
                    .then(data => {
                        if (data && data.count > 0) {
                            showRecharge5PmModal(data);
                        }
                    })
                    .catch(function(err) {});
            }
        }

        function scheduleExact5Pm() {
            const now = new Date();
            const target5pm = new Date();
            target5pm.setHours(17, 0, 0, 0);

            if (now < target5pm) {
                const msUntil5pm = target5pm.getTime() - now.getTime();
                setTimeout(checkAndTrigger, msUntil5pm);
            } else {
                checkAndTrigger();
            }
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', scheduleExact5Pm);
        } else {
            scheduleExact5Pm();
        }

        // Periodic heartbeat every 60 seconds
        setInterval(checkAndTrigger, 60000);
    })();

    function showRecharge5PmModal(data) {
        const modal = document.getElementById('recharge5PmAlertModal');
        const countEl = document.getElementById('recharge5PmAlertCount');
        const listEl = document.getElementById('recharge5PmAlertList');
        if (!modal) return;

        if (countEl) countEl.textContent = data.count;
        if (listEl) {
            listEl.innerHTML = (data.items || []).map(function(item) {
                var title = item.vehicleNo || item.imei || 'Device';
                var vendor = item.vendor ? ' &bull; ' + item.vendor : '';
                var op = item.operatorName ? ' (' + item.operatorName + ')' : '';
                return '<div style="display:flex; justify-content:space-between; align-items:center; padding:7px 0; border-bottom:1px solid rgba(0,0,0,0.06); font-size:0.82rem;">' +
                       '<div><strong>' + title + '</strong><span style="color:#64748b; font-size:0.75rem; margin-left:6px;">' + op + vendor + '</span></div>' +
                       '<span style="color:#d97706; font-weight:700; font-size:0.72rem; background:#fef3c7; padding:2px 7px; border-radius:4px;">Pending</span>' +
                       '</div>';
            }).join('') || '<div style="color:#64748b; font-size:0.8rem; padding:4px 0;">No items found</div>';
        }

        modal.style.display = 'flex';
    }

    function closeRecharge5PmAlert(dismissForDay) {
        const modal = document.getElementById('recharge5PmAlertModal');
        if (modal) modal.style.display = 'none';

        if (dismissForDay) {
            const todayStr = new Date().toISOString().slice(0, 10);
            sessionStorage.setItem('recharge_5pm_dismissed_day', todayStr);
        } else {
            sessionStorage.setItem('recharge_5pm_snooze_until', (Date.now() + 15 * 60 * 1000).toString());
        }
    }
    </script>
}
