@using System.Security.Claims
@inject MygtsMvc.Services.IAppDataStore AppDataStore
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var role = User.FindFirstValue(ClaimTypes.Role) ?? "Team";
    var shortRole = role switch {
        "Executive" => "Exec",
        "Operations" => "Ops",
        "Finance" => "Fin",
        "Viewer" => "View",
        "Manager" => "Mgr",
        "Admin" => "Admin",
        _ => role
    };
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var routeArea = ViewContext.RouteData.Values["area"]?.ToString();
    var currentBranch = !string.IsNullOrWhiteSpace(routeArea)
        ? (string.Equals(routeArea, "RTO", StringComparison.OrdinalIgnoreCase) ? "RTO" : (string.Equals(routeArea, "Expenditure", StringComparison.OrdinalIgnoreCase) ? "Expenditure" : "DMG"))
        : (Context.Request.Cookies["mygts_branch"] == "RTO" ? "RTO" : (string.Equals(Context.Request.Cookies["mygts_branch"], "Expenditure", StringComparison.OrdinalIgnoreCase) ? "Expenditure" : "DMG"));
    var branchClass = currentBranch == "RTO" ? "branch-rto" : "";
    var logoSrc = currentBranch == "RTO" ? "/RTO.jpg" : (currentBranch == "Expenditure" ? "/images/expenditure_logo.jpg" : "/images/logo.jpg");
    var faviconIco = currentBranch == "RTO" ? "/favicon-rto.ico" : "/favicon.ico";
    var faviconPng = currentBranch == "RTO" ? "/favicon-rto-32x32.png" : "/favicon-32x32.png";
    var appleIcon = currentBranch == "RTO" ? "/apple-touch-icon-rto.png" : "/apple-touch-icon.png";

    var isExecutive = User.IsExecutive();
    var todayStr = DateTime.UtcNow.ToString("yyyy-MM-dd");

    var alertSnapshot = signedIn ? await AppDataStore.SnapshotAsync() : null;
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var currentLoggedInUser = alertSnapshot?.Users.FirstOrDefault(u => 
        (!string.IsNullOrEmpty(currentUserId) && u.Id == currentUserId) ||
        string.Equals(u.Email, User.Identity?.Name, StringComparison.OrdinalIgnoreCase) ||
        string.Equals(u.DisplayName, User.Identity?.Name, StringComparison.OrdinalIgnoreCase));
    var userWhatsAppPref = currentLoggedInUser?.WhatsAppPreference ?? "Ask";
    var configMap = alertSnapshot?.Config.ToDictionary(k => k.Key, k => k.Value, StringComparer.OrdinalIgnoreCase)
                    ?? new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

    // Devices already synced in SnapshotAsync
    var isExpenditureBranch = string.Equals(currentBranch, "Expenditure", StringComparison.OrdinalIgnoreCase);

    var allFleetDevices = (!isExpenditureBranch && alertSnapshot?.Devices != null)
        ? alertSnapshot.Devices
            .Where(d => string.Equals(d.Branch, currentBranch, StringComparison.OrdinalIgnoreCase)
                        && !string.IsNullOrWhiteSpace(d.VehicleNo) 
                        && !string.Equals(d.LifecycleStatus, "Replaced", StringComparison.OrdinalIgnoreCase)
                        && !d.IsNotInUse)
            .ToList()
        : new List<DeviceRecord>();

    var overdueAlerts = isExecutive && !isExpenditureBranch
        ? allFleetDevices
            .Where(d => {
                var daysLeft = DateValue.DaysFromNow(d.LatestExpiryDate);
                var daysPast = d.DaysPastExpiry ?? (daysLeft.HasValue ? -daysLeft.Value : 0);
                return daysLeft.HasValue 
                    && daysLeft.Value < 0 
                    && daysPast <= 30
                    && (string.IsNullOrWhiteSpace(d.InformedDate) || d.InformedDate != todayStr);
            })
            .OrderByDescending(d => d.DaysPastExpiry ?? 0)
            .ToList()
        : new List<DeviceRecord>();

    var expiringWeekAlerts = isExecutive
        ? allFleetDevices
            .Where(d => DateValue.DaysFromNow(d.LatestExpiryDate) is >= 0 and <= 7
                        && (string.IsNullOrWhiteSpace(d.InformedDate) || d.InformedDate != todayStr))
            .OrderBy(d => DateValue.DaysFromNow(d.LatestExpiryDate))
            .ToList()
        : new List<DeviceRecord>();

    var sensoriseSuspensionCount = alertSnapshot?.Devices
        .Count(d => string.Equals(d.Branch, "DMG", StringComparison.OrdinalIgnoreCase)
                    && string.Equals(d.NetworkOperator, "Sensorise", StringComparison.OrdinalIgnoreCase)
                    && string.Equals(d.LifecycleStatus, "Suspension", StringComparison.OrdinalIgnoreCase)) ?? 0;

    var sensoriseTerminatedCount = alertSnapshot?.Devices
        .Count(d => string.Equals(d.Branch, "DMG", StringComparison.OrdinalIgnoreCase)
                    && string.Equals(d.NetworkOperator, "Sensorise", StringComparison.OrdinalIgnoreCase)
                    && string.Equals(d.LifecycleStatus, "Terminated", StringComparison.OrdinalIgnoreCase)) ?? 0;

    var sensoriseSuspensionOrTerminationCount = sensoriseSuspensionCount + sensoriseTerminatedCount;

    int suspensionDays = 30;
    int terminationDays = 20;
    if (configMap.TryGetValue("SUSPENSION_DAYS", out var sStr) && int.TryParse(sStr, out var sVal)) suspensionDays = sVal;
    if (configMap.TryGetValue("TERMINATION_DAYS", out var tStr) && int.TryParse(tStr, out var tVal)) terminationDays = tVal;

    var lifecycleShiftList = isExecutive
        ? allFleetDevices
            .Select(d => {
                var daysPast = d.DaysPastExpiry ?? (DateValue.DaysFromNow(d.LatestExpiryDate).HasValue ? -DateValue.DaysFromNow(d.LatestExpiryDate)!.Value : 0);
                string? fromStatus = null;
                string? toStatus = null;
                string? shiftType = null;
                string? desc = null;
                string? filterUrl = null;

                if (string.Equals(d.LifecycleStatus, "Suspension", StringComparison.OrdinalIgnoreCase) && daysPast is >= 1 and <= 3)
                {
                    fromStatus = "Active";
                    toStatus = "Suspension";
                    shiftType = "Suspension";
                    desc = "Entered Suspension window (grace period active)";
                    filterUrl = "/Devices?Lifecycle=Suspension";
                }
                else if (string.Equals(d.LifecycleStatus, "Terminated", StringComparison.OrdinalIgnoreCase) && daysPast > suspensionDays && daysPast <= suspensionDays + 7)
                {
                    fromStatus = "Suspension";
                    toStatus = "Terminated";
                    shiftType = "Terminated";
                    desc = "Suspension window ended - Status shifted to Terminated";
                    filterUrl = "/Devices?Lifecycle=Terminated";
                }
                else if (string.Equals(d.LifecycleStatus, "Dead", StringComparison.OrdinalIgnoreCase) && daysPast > (suspensionDays + terminationDays) && daysPast <= (suspensionDays + terminationDays + 7))
                {
                    fromStatus = "Terminated";
                    toStatus = "Dead";
                    shiftType = "Dead";
                    desc = "Termination window ended - Status shifted to Dead / Deactivated";
                    filterUrl = "/Devices?Lifecycle=Dead";
                }

                if (fromStatus == null) return null;
                return new LifecycleShiftAlert
                {
                    VehicleNo = d.VehicleNo,
                    Owner = d.Owner ?? "",
                    CellNo = d.CellNo ?? "",
                    Vendor = d.Vendor ?? "",
                    FromStatus = fromStatus,
                    ToStatus = toStatus ?? "",
                    ShiftType = shiftType ?? "",
                    Description = desc ?? "",
                    FilterUrl = filterUrl ?? "",
                    ExpiryStr = DateValue.Short(d.LatestExpiryDate),
                    DaysPast = daysPast
                };
            })
            .Where(s => s != null)
            .Select(s => s!)
            .OrderByDescending(s => s.DaysPast)
            .ToList()
        : new List<LifecycleShiftAlert>();

    var canViewReminders = User.CanViewModule("Reminders");
    var canEditReminders = User.CanEditModule("Reminders");
    var canViewRecharges = User.CanViewModule("Recharges");
    var branchRecharges = canViewRecharges && alertSnapshot?.Recharges != null
        ? alertSnapshot.Recharges
            .Where(r => string.Equals(r.Branch, currentBranch, StringComparison.OrdinalIgnoreCase))
            .ToList()
        : new List<RechargeRecord>();

    var localTodayStr = DateTime.UtcNow.AddHours(5.5).ToString("yyyy-MM-dd");
    var pendingRechargeAlerts = branchRecharges
        .Where(r => string.Equals(r.RechargeStatus, "Pending", StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(r => r.CreatedAt)
        .ToList();

    var pendingRechargesTodayCount = branchRecharges
        .Count(r => string.Equals(r.RechargeStatus, "Pending", StringComparison.OrdinalIgnoreCase)
                    && (string.IsNullOrWhiteSpace(r.RechargeDate) || r.RechargeDate.CompareTo(localTodayStr) <= 0 || r.RechargeDate.CompareTo(todayStr) <= 0));

    var unpaidRechargesCount = branchRecharges
        .Count(r => !string.Equals(r.PaymentStatus, "Paid", StringComparison.OrdinalIgnoreCase));

    var unpaidRechargeAlerts = branchRecharges
        .Where(r => string.Equals(r.RechargeStatus, "Processed", StringComparison.OrdinalIgnoreCase)
                    && !string.Equals(r.PaymentStatus, "Paid", StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(r => r.RechargeDate)
        .ToList();

    var openFollowups = alertSnapshot?.ManualReminders
        .Where(r => !r.IsComplete 
                    && (string.Equals(r.Branch, currentBranch, StringComparison.OrdinalIgnoreCase) || string.IsNullOrWhiteSpace(r.Branch))
                    && User.IsAddressedInReminder(r))
        .OrderBy(r => DateValue.Parse(r.DueDate))
        .ToList() ?? new List<ManualReminder>();

    var distinctVehicles = new HashSet<string>(overdueAlerts.Select(d => d.VehicleNo), StringComparer.OrdinalIgnoreCase);
    foreach (var d in expiringWeekAlerts) distinctVehicles.Add(d.VehicleNo);
    var alertCount = distinctVehicles.Count + lifecycleShiftList.Count + openFollowups.Count + pendingRechargeAlerts.Count + unpaidRechargeAlerts.Count;

    var vendorPhoneMap = alertSnapshot?.Vendors?
        .Where(v => !string.IsNullOrWhiteSpace(v.Name) && !string.IsNullOrWhiteSpace(v.Phone))
        .GroupBy(v => v.Name.Trim(), StringComparer.OrdinalIgnoreCase)
        .ToDictionary(g => g.Key, g => g.First().Phone.Trim(), StringComparer.OrdinalIgnoreCase)
        ?? new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#001d6c" />
    <title>@(ViewData["Title"] is null ? $"MYGTS ({currentBranch})" : $"{ViewData["Title"]} · MYGTS ({currentBranch})")</title>
    <link rel="icon" type="image/png" sizes="32x32" href="@(faviconPng)?v=2" />
    <link rel="icon" type="image/x-icon" href="@(faviconIco)?v=2" />
    <link rel="shortcut icon" href="@(faviconIco)?v=2" />
    <link rel="apple-touch-icon" sizes="180x180" href="@(appleIcon)?v=2" />
    <link rel="stylesheet" href="~/css/site.css?v=15" asp-append-version="true" />
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js" asp-append-version="true" defer></script>
    <style>
        .notification-center {
            position: relative;
            display: inline-flex;
            align-items: center;
        }
        /* Custom Bell with one div */
        .bell {
            border: 2.17px solid var(--ink);
            border-radius: 10px 10px 0 0;
            width: 15px;
            height: 17px;
            background: transparent;
            display: block;
            position: relative;
            top: -3px;
        }
        .bell::before,
        .bell::after {
            content: "";
            background: var(--ink);
            display: block;
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
            height: 2.17px;
        }
        .bell::before {
            top: 100%;
            width: 20px;
        }
        .bell::after {
            top: calc(100% + 4px);
            width: 7px;
        }
        /* container main styling */
        .notification {
            background: transparent;
            border: none;
            padding: 8px 10px;
            border-radius: 50px;
            cursor: pointer;
            transition: 300ms;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        /* notifications number with before */
        .notification.has-alerts::before {
            content: attr(data-count);
            color: white;
            font-size: 10px;
            font-weight: 700;
            min-width: 14px;
            height: 14px;
            padding: 0 3px;
            border-radius: 50%;
            background-color: #ef4444;
            position: absolute;
            right: 2px;
            top: 2px;
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 1000;
            line-height: 1;
        }
        /* container background hover effect */
        .notification:hover {
            background: rgba(170, 170, 170, 0.12);
        }
        /* container animations */
        .notification:hover > .bell-container {
            animation: bell-animation 650ms ease-out 0s 1 normal both;
        }
        /* bell ring and scale animation */
        @@keyframes bell-animation {
            20% {
                transform: rotate(15deg);
            }
            40% {
                transform: rotate(-15deg);
                scale: 1.1;
            }
            60% {
                transform: rotate(10deg);
                scale: 1.1;
            }
            80% {
                transform: rotate(-10deg);
            }
            0%, 100% {
                transform: rotate(0deg);
            }
        }
        /* Solid Opaque Alert Drawer */
        .notification-drawer {
            display: none;
            position: absolute;
            top: calc(100% + 10px);
            right: 0;
            width: 420px;
            max-width: calc(100vw - 24px);
            background: #ffffff !important;
            border: 1px solid #cbd5e1;
            border-radius: 14px;
            box-shadow: 0 20px 45px -10px rgba(0, 0, 0, 0.25), 0 8px 18px -4px rgba(0, 0, 0, 0.12);
            z-index: 1100;
            overflow: hidden;
            animation: popIn 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        }
        body:has(#theme:checked) .notification-drawer {
            background: #1e293b !important;
            border-color: #334155;
            box-shadow: 0 20px 45px -10px rgba(0, 0, 0, 0.6);
        }
        #notification-toggle:checked ~ .notification-drawer {
            display: block;
        }
        .notification-header {
            padding: 14px 18px 12px;
            background: #f8fafc;
            border-bottom: 1px solid #e2e8f0;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }
        body:has(#theme:checked) .notification-header {
            background: #0f172a;
            border-bottom-color: #334155;
        }
        .notification-header-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            gap: 10px;
        }
        .notification-title-wrap {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            min-width: 0;
            flex-shrink: 1;
        }
        .notification-title {
            margin: 0;
            font-size: 0.88rem;
            font-weight: 800;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: var(--text-main);
            letter-spacing: 0.02em;
            text-transform: uppercase;
            white-space: nowrap;
        }
        .notification-header-actions {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            flex-shrink: 0;
        }
        .notification-subtitle {
            margin: 0;
            font-size: 0.72rem;
            font-weight: 600;
            color: var(--muted);
            line-height: 1.35;
            letter-spacing: 0.01em;
            word-break: normal;
        }
        .alert-pill-count {
            background: #fee2e2;
            color: #b91c1c;
            font-size: 0.68rem;
            font-weight: 800;
            padding: 2px 8px;
            border-radius: 999px;
            border: 1px solid rgba(239, 68, 68, 0.25);
            white-space: nowrap !important;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            line-height: 1.2;
            flex-shrink: 0;
        }
        body:has(#theme:checked) .alert-pill-count {
            background: #451a1a;
            color: #fca5a5;
            border-color: rgba(239, 68, 68, 0.35);
        }
        .btn-clear-all {
            background: transparent;
            border: 1px solid var(--border);
            color: var(--muted);
            font-size: 0.70rem;
            font-weight: 700;
            padding: 3px 9px;
            border-radius: 5px;
            cursor: pointer;
            transition: all 0.15s ease;
            white-space: nowrap !important;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            line-height: 1.2;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }
        .btn-clear-all:hover {
            background: var(--surface-hover);
            color: var(--danger);
            border-color: var(--danger);
        }
        body:has(#theme:checked) .btn-clear-all {
            border-color: #334155;
            color: #94a3b8;
        }
        body:has(#theme:checked) .btn-clear-all:hover {
            background: rgba(239, 68, 68, 0.15);
            color: #f87171;
            border-color: #ef4444;
        }
        .notification-search-box {
            padding: 8px 14px;
            background: #f8fafc;
            border-bottom: 1px solid #e2e8f0;
            display: flex;
            align-items: center;
        }
        body:has(#theme:checked) .notification-search-box {
            background: #0f172a;
            border-bottom-color: #334155;
        }
        .notification-search-box input {
            background: #ffffff;
            color: #0f172a;
            border: 1px solid #cbd5e1;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }
        .notification-search-box input:focus {
            border-color: var(--primary, #0056b3);
            box-shadow: 0 0 0 2px rgba(0, 86, 179, 0.15);
        }
        body:has(#theme:checked) .notification-search-box input {
            background: #1e293b;
            color: #f8fafc;
            border-color: #475569;
        }
        body:has(#theme:checked) .notification-search-box input:focus {
            border-color: #38bdf8;
            box-shadow: 0 0 0 2px rgba(56, 189, 248, 0.2);
        }
        .btn-dismiss-alert {
            background: transparent;
            border: none;
            color: var(--muted);
            font-size: 1.15rem;
            line-height: 1;
            padding: 0 4px;
            cursor: pointer;
            border-radius: 4px;
            transition: all 0.15s ease;
        }
        .btn-dismiss-alert:hover {
            color: var(--danger);
            background: rgba(239, 68, 68, 0.1);
        }
        .notification-list {
            max-height: 380px;
            overflow-y: auto;
            background: #ffffff;
        }
        body:has(#theme:checked) .notification-list {
            background: #1e293b;
        }
        .notification-item {
            padding: 12px 18px;
            border-bottom: 1px solid #f1f5f9;
            background: #ffffff;
            transition: background 0.15s ease, opacity 0.2s ease, transform 0.2s ease;
        }
        body:has(#theme:checked) .notification-item {
            background: #1e293b;
            border-bottom-color: #334155;
        }
        .notification-item:hover {
            background: #f8fafc;
        }
        body:has(#theme:checked) .notification-item:hover {
            background: #253248;
        }
        .notification-item.urgent-today {
            border-left: 4px solid #ef4444;
            background: #fffafa;
        }
        body:has(#theme:checked) .notification-item.urgent-today {
            background: #2c1c24;
        }
        .notification-item.urgent-tomorrow {
            border-left: 4px solid #f97316;
            background: #fffcf8;
        }
        body:has(#theme:checked) .notification-item.urgent-tomorrow {
            background: #2b221d;
        }
        .notification-item.urgent-soon {
            border-left: 4px solid #3b82f6;
        }
        .notification-item.urgent-overdue {
            border-left: 4px solid #dc2626;
            background: #fef2f2 !important;
        }
        body:has(#theme:checked) .notification-item.urgent-overdue {
            background: #361618 !important;
            border-left-color: #ef4444;
        }
        .urgent-overdue .expiry-tag {
            background: #fee2e2 !important;
            color: #991b1b !important;
            font-weight: 800;
        }
        body:has(#theme:checked) .urgent-overdue .expiry-tag {
            background: #7f1d1d !important;
            color: #fecaca !important;
        }
        .notification-section-divider.urgent-divider {
            background: #fee2e2;
            border-color: #fca5a5;
            color: #991b1b;
        }
        body:has(#theme:checked) .notification-section-divider.urgent-divider {
            background: #451a1a;
            border-color: #7f1d1d;
            color: #fca5a5;
        }
        .notification-section-divider.shift-divider {
            background: #e0e7ff;
            border-color: #c7d2fe;
            color: #3730a3;
        }
        body:has(#theme:checked) .notification-section-divider.shift-divider {
            background: #1e1e38;
            border-color: #3730a3;
            color: #c7d2fe;
        }
        .notification-section-divider.expiring-divider {
            background: #fef3c7;
            border-color: #fde68a;
            color: #92400e;
        }
        body:has(#theme:checked) .notification-section-divider.expiring-divider {
            background: #38240f;
            border-color: #78350f;
            color: #fde68a;
        }
        .notification-section-divider.followups-divider {
            background: #ede9fe;
            border-color: #ddd6fe;
            color: #5b21b6;
        }
        body:has(#theme:checked) .notification-section-divider.followups-divider {
            background: #25163a;
            border-color: #5b21b6;
            color: #ddd6fe;
        }
        .notification-section-divider.pending-recharge-divider {
            background: #fef3c7;
            border-color: #fde68a;
            color: #b45309;
        }
        body:has(#theme:checked) .notification-section-divider.pending-recharge-divider {
            background: #3b2506;
            border-color: #78350f;
            color: #fcd34d;
        }
        .notification-section-divider.unpaid-recharge-divider {
            background: #fee2e2;
            border-color: #fca5a5;
            color: #b91c1c;
        }
        body:has(#theme:checked) .notification-section-divider.unpaid-recharge-divider {
            background: #3a1515;
            border-color: #7f1d1d;
            color: #fca5a5;
        }
        .notification-item.lifecycle-shift-item {
            border-left: 4px solid #6366f1;
            background: #f8fafc;
        }
        body:has(#theme:checked) .notification-item.lifecycle-shift-item {
            background: #1a1e2e;
            border-left-color: #818cf8;
        }
        .shift-badge {
            font-size: 0.70rem;
            font-weight: 700;
            padding: 2px 7px;
            border-radius: 4px;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }
        .shift-badge.shift-suspension {
            background: #fef3c7;
            color: #92400e;
            border: 1px solid rgba(217, 119, 6, 0.25);
        }
        body:has(#theme:checked) .shift-badge.shift-suspension {
            background: #78350f;
            color: #fef3c7;
        }
        .shift-badge.shift-terminated {
            background: #ffedd5;
            color: #c2410c;
            border: 1px solid rgba(234, 88, 12, 0.25);
        }
        body:has(#theme:checked) .shift-badge.shift-terminated {
            background: #7c2d12;
            color: #fed7aa;
        }
        .shift-badge.shift-dead {
            background: #f1f5f9;
            color: #334155;
            border: 1px solid rgba(71, 85, 105, 0.25);
        }
        body:has(#theme:checked) .shift-badge.shift-dead {
            background: #1e293b;
            color: #cbd5e1;
        }
        .button-filter-shift {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            height: 28px;
            padding: 0 10px;
            font-size: 0.74rem;
            font-weight: 600;
            border-radius: 6px;
            background: rgba(99, 102, 241, 0.12);
            color: #4f46e5;
            border: 1px solid rgba(99, 102, 241, 0.3);
            text-decoration: none;
