        /* User Profile Dropdown Menu */
        .user-profile-dropdown {
            position: relative;
            display: inline-flex;
            align-items: center;
        }
        .user-menu-btn {
            display: flex;
            align-items: center;
            gap: 7px;
            padding: 4px 8px;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.15s ease;
            color: var(--text-main);
            font-weight: 600;
            font-size: 0.86rem;
            border: 1px solid transparent;
        }
        .user-menu-btn:hover {
            background: var(--surface-hover);
            border-color: var(--border);
        }
        .dropdown-chevron {
            color: var(--muted);
            transition: transform 0.2s ease;
        }
        .user-profile-dropdown .popup input:checked ~ .user-menu-btn .dropdown-chevron {
            transform: rotate(180deg);
        }
