                    <img src="@(currentBranch == "RTO" ? "/RTO_logo_black.png" : (currentBranch == "Expenditure" ? "/images/expenditure_logo.jpg" : "/MYGTS_logo_black.png"))" alt="MYGTS Logo" class="brand-logo logo-dark" style="height: 32px; border-radius: 4px; margin-right: 8px; display: none;" />
                    <span class="brand-text"><strong>MYGTS</strong><small>@(currentBranch == "Expenditure" ? "EXPENDITURE" : "Fleet intelligence")</small></span>
                </a>
