                                                <div class="notification-section-divider shift-divider" data-section="shifts" onclick="toggleAlertSection('shifts', this)" onkeydown="onSectionHeaderKeydown(event, 'shifts')" role="button" aria-expanded="false" tabindex="0">
                                                    <span class="section-title">⚡ Recent Lifecycle Shifts (@lifecycleShiftList.Count)</span>
                                                    <span class="section-chevron"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></span>
                                                </div>
                                                <div id="section-body-shifts" class="notification-section-body" style="display:none;">

                                            @foreach (var s in lifecycleShiftList)
                                            {
                                                <div class="notification-item lifecycle-shift-item" id="shift-item-@s.VehicleNo-@s.ShiftType">
                                                    <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 8px;">
                                                        <div style="flex: 1; min-width: 0;">
                                                            <div style="font-weight: 700; font-size: 0.88rem; color: var(--text-main); display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">
                                                                <span>@s.VehicleNo</span>
                                                                <span class="shift-badge shift-@s.ShiftType.ToLowerInvariant()">⚡ @s.FromStatus &rarr; @s.ToStatus</span>
                                                            </div>
                                                            <div style="font-size: 0.77rem; color: var(--muted); margin-top: 3px;">
                                                                @s.Description &bull; Expired: @s.ExpiryStr (@s.DaysPast d ago)
                                                            </div>
                                                            @if (!string.IsNullOrWhiteSpace(s.Owner) || !string.IsNullOrWhiteSpace(s.Vendor))
                                                            {
                                                                <div style="font-size: 0.73rem; color: var(--muted); margin-top: 2px;">
                                                                    @(string.IsNullOrWhiteSpace(s.Owner) ? "" : s.Owner)
                                                                    @(string.IsNullOrWhiteSpace(s.Vendor) ? "" : $" ({s.Vendor})")
                                                                </div>
                                                            }
                                                        </div>
                                                        <button type="button" class="btn-dismiss-alert" onclick="dismissLifecycleShift('@s.VehicleNo', '@s.ShiftType')" title="Dismiss notification">&times;</button>
                                                    </div>
                                                    <div class="notification-actions" style="margin-top: 8px;">
                                                        <a href="@s.FilterUrl" class="button-filter-shift">
                                                            View @s.ToStatus Devices &rarr;
                                                        </a>
                                                        @if (s.ShiftType == "Suspension")
                                                        {
                                                            <a asp-controller="Transactions" asp-action="Create" asp-route-VehicleNo="@s.VehicleNo" class="button-renew">
                                                                Collect / Renew
                                                            </a>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                                </div>
                                            </div>
                                        }

                                        @if (pendingRechargeAlerts.Any())
                                        {
                                            <div class="notification-section" data-section-id="pending-recharges">
                                                <div class="notification-section-divider pending-recharge-divider" data-section="pending-recharges" onclick="toggleAlertSection('pending-recharges', this)" onkeydown="onSectionHeaderKeydown(event, 'pending-recharges')" role="button" aria-expanded="false" tabindex="0">
                                                    <span class="section-title">⚡ Pending Recharges (@pendingRechargeAlerts.Count)</span>
                                                    <span class="section-chevron"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></span>
                                                </div>
                                                <div id="section-body-pending-recharges" class="notification-section-body" style="display:none;">
                                                    @foreach (var rc in pendingRechargeAlerts)
                                                    {
                                                        var title = !string.IsNullOrWhiteSpace(rc.VehicleNo) ? rc.VehicleNo : (!string.IsNullOrWhiteSpace(rc.Imei) ? rc.Imei : rc.Iccid);
                                                        <div class="notification-item urgent-today" id="recharge-item-@rc.Id">
                                                            <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 8px;">
                                                                <div>
                                                                    <div style="font-weight: 700; font-size: 0.88rem; color: var(--text-main); display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">
                                                                        <span>⚡ @title</span>
                                                                        <span class="expiry-tag" style="background: #fef3c7; color: #b45309; border-color: #fcd34d;">PENDING ACTIVATION</span>
                                                                        @if (!string.IsNullOrWhiteSpace(rc.NetworkOperator))
                                                                        {
                                                                            <span class="badge" style="font-size: 0.7rem; background: #e0f2fe; color: #0369a1;">@rc.NetworkOperator</span>
                                                                        }
                                                                    </div>
                                                                    <div style="font-size: 0.78rem; color: var(--muted); margin-top: 3px;">
                                                                        @(string.IsNullOrWhiteSpace(rc.Vendor) ? "Vendor" : rc.Vendor) &bull; Scheduled: @(string.IsNullOrWhiteSpace(rc.RechargeDate) ? "Immediate" : rc.RechargeDate)
                                                                    </div>
                                                                </div>
                                                                <button type="button" class="btn-dismiss-alert" onclick="dismissRechargeAlert('@rc.Id')" title="Dismiss notification">&times;</button>
                                                            </div>
                                                            <div class="notification-actions" style="margin-top: 8px;">
                                                                <a asp-controller="Recharges" asp-action="Index" class="button-renew" style="background: #d97706; border-color: #b45309;">
                                                                    Process in Recharges &rarr;
                                                                </a>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }

                                        @if (unpaidRechargeAlerts.Any())
                                        {
                                            <div class="notification-section" data-section-id="unpaid-recharges">
                                                <div class="notification-section-divider unpaid-recharge-divider" data-section="unpaid-recharges" onclick="toggleAlertSection('unpaid-recharges', this)" onkeydown="onSectionHeaderKeydown(event, 'unpaid-recharges')" role="button" aria-expanded="false" tabindex="0">
                                                    <span class="section-title">💳 Unpaid Recharges (@unpaidRechargeAlerts.Count)</span>
                                                    <span class="section-chevron"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></span>
                                                </div>
                                                <div id="section-body-unpaid-recharges" class="notification-section-body" style="display:none;">
                                                    @foreach (var rc in unpaidRechargeAlerts)
                                                    {
                                                        var title = !string.IsNullOrWhiteSpace(rc.VehicleNo) ? rc.VehicleNo : (!string.IsNullOrWhiteSpace(rc.Imei) ? rc.Imei : rc.Iccid);
                                                        var dev = allFleetDevices.FirstOrDefault(d => !string.IsNullOrEmpty(rc.VehicleNo) && string.Equals(d.VehicleNo.Trim(), rc.VehicleNo.Trim(), StringComparison.OrdinalIgnoreCase));
                                                        var rawPhone = dev?.CellNo?.Trim() ?? "";
                                                        var cleanPhone = new string(rawPhone.Where(char.IsDigit).ToArray());
                                                        if (cleanPhone.Length == 10) cleanPhone = "91" + cleanPhone;

                                                        var vendorName = rc.Vendor?.Trim() ?? "";
                                                        vendorPhoneMap.TryGetValue(vendorName, out var vendorPhone);
                                                        var cleanVendorPhone = new string((vendorPhone ?? "").Where(char.IsDigit).ToArray());
                                                        if (cleanVendorPhone.Length == 10) cleanVendorPhone = "91" + cleanVendorPhone;

                                                        var msgOwner = $"*MYGTS SERVICES*\n\u200B\nDear Customer,\n\u200B\nThe GPS recharge for vehicle *{rc.VehicleNo}* was processed on *{rc.RechargeDate}*. Kindly clear the pending payment to maintain uninterrupted tracking services.\n\u200B\nThank you,\n*MYGTS SERVICES*";
                                                        var msgVendor = $"*MYGTS SERVICES*\n\u200B\nDear {(string.IsNullOrWhiteSpace(vendorName) ? "Vendor" : vendorName)},\n\u200B\nThe GPS recharge for vehicle *{rc.VehicleNo}* was processed on *{rc.RechargeDate}*. Please clear the pending payment.\n\u200B\nThank you,\n*MYGTS SERVICES*";

                                                        var waOwnerUrl = !string.IsNullOrEmpty(cleanPhone)
                                                            ? $"https://web.whatsapp.com/send?phone={cleanPhone}&text={Uri.EscapeDataString(msgOwner)}"
                                                            : $"https://web.whatsapp.com/send?text={Uri.EscapeDataString(msgOwner)}";
                                                        var waVendorUrl = !string.IsNullOrEmpty(cleanVendorPhone)
                                                            ? $"https://web.whatsapp.com/send?phone={cleanVendorPhone}&text={Uri.EscapeDataString(msgVendor)}"
                                                            : $"https://web.whatsapp.com/send?text={Uri.EscapeDataString(msgVendor)}";

                                                        <div class="notification-item urgent-overdue" id="recharge-item-@rc.Id">
                                                            <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 8px;">
                                                                <div>
                                                                    <div style="font-weight: 700; font-size: 0.88rem; color: var(--text-main); display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">
                                                                        <span>💳 @title</span>
                                                                        <span class="expiry-tag" style="background: #fee2e2; color: #dc2626; border-color: #fca5a5;">PAYMENT DUE</span>
                                                                        @if (!string.IsNullOrWhiteSpace(rc.NetworkOperator))
                                                                        {
                                                                            <span class="badge" style="font-size: 0.7rem; background: #e0f2fe; color: #0369a1;">@rc.NetworkOperator</span>
                                                                        }
                                                                    </div>
                                                                    <div style="font-size: 0.78rem; color: var(--muted); margin-top: 3px;">
                                                                        @(string.IsNullOrWhiteSpace(rc.Vendor) ? "Vendor" : rc.Vendor) &bull; Processed: @rc.RechargeDate
                                                                    </div>
                                                                </div>
                                                                <button type="button" class="btn-dismiss-alert" onclick="dismissRechargeAlert('@rc.Id')" title="Dismiss notification">&times;</button>
                                                            </div>
                                                            <div class="notification-actions" style="margin-top: 8px;">
                                                                <div class="wa-picker" style="position: relative; display: inline-flex;">
                                                                    <button type="button" class="button-wa-alert"
                                                                        data-owner-url="@waOwnerUrl"
                                                                        data-vendor-url="@waVendorUrl"
                                                                        data-owner-name="@(dev?.Owner ?? "")"
                                                                        data-cell-no="@(dev?.CellNo ?? "")"
                                                                        data-vendor-name="@vendorName"
                                                                        data-vendor-phone="@(vendorPhone ?? "")"
                                                                        onclick="openWaPickerPortal(this)" title="Send WhatsApp message">
                                                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
                                                                        WhatsApp ▾
                                                                    </button>
                                                                </div>
                                                                @if (!string.IsNullOrWhiteSpace(rc.VehicleNo))
                                                                {
                                                                    <a asp-controller="Transactions" asp-action="Create" asp-route-VehicleNo="@rc.VehicleNo" asp-route-PaymentFor="None" class="button-renew">
                                                                        Collect Payment
                                                                    </a>
                                                                }
                                                                <a asp-controller="Recharges" asp-action="Index" class="btn-micro-archive" style="font-size: 0.74rem; text-decoration: none; padding: 4px 8px; border-radius: 4px; border: 1px solid var(--border); color: var(--text-main);">
                                                                    View in Recharges &rarr;
                                                                </a>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>

                                <div class="notification-footer">
                                    <button type="button" class="btn-batch-whatsapp" onclick="openBatchWhatsAppModal()" title="Compose Batch WhatsApp Message">
                                        <span>📢</span> Batch WhatsApp
                                    </button>
                                    <a asp-controller="Reminders" asp-action="Index" class="link-view-all-reminders">View All Reminders &rarr;</a>
                                </div>
                            </div>
                    </div>

                    <!-- Short Role Chip -->
                    <span class="role-chip">@shortRole</span>

                    <!-- User Profile Dropdown with Sign Out hidden inside -->
                    <div class="user-profile-dropdown">
                        <label class="popup" style="margin: 0;">
                            <input type="checkbox" id="user-profile-toggle">
                            <div class="user-menu-btn" tabindex="0" title="@User.Identity?.Name (@role)">
                                <span class="avatar">@(User.Identity?.Name?.FirstOrDefault().ToString().ToUpperInvariant() ?? "U")</span>
                                <span class="user-name">@User.Identity?.Name</span>
                                <svg class="dropdown-chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
                            </div>
                            <nav class="popup-window user-dropdown-nav" style="--nav-position-left: unset; --nav-position-right: 0;">
                                <div style="padding: 8px 12px; border-bottom: 1px solid var(--border); margin-bottom: 4px;">
                                    <div style="font-weight: 700; font-size: 0.85rem; color: var(--text-main);">@User.Identity?.Name</div>
                                    <div style="font-size: 0.72rem; color: var(--muted); margin-top: 1px;">@role Account</div>
                                </div>
                                <a href="/Users/Profile" class="user-dropdown-item" style="width: 100%; text-align: left; background: none; border: none; cursor: pointer; display: flex; align-items: center; gap: 8px; padding: 8px 12px; font-size: 0.82rem; color: var(--text-main); text-decoration: none;">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: #2563eb;"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                                    <span>My Profile &amp; Credentials</span>
                                </a>
                                <button type="button" class="user-dropdown-item" onclick="openWhatsAppPreferenceModal()" style="width: 100%; text-align: left; background: none; border: none; cursor: pointer; display: flex; align-items: center; gap: 8px; padding: 8px 12px; font-size: 0.82rem; color: var(--text-main);">
                                    <span style="font-size: 1rem; color: #25D366;">💬</span>
                                    <span>WhatsApp Client</span>
                                    <span id="userWaPrefBadge" class="badge" style="margin-left: auto; font-size: 0.65rem; background: rgba(37, 211, 102, 0.15); color: #25D366; font-weight: 700; border-radius: 4px; padding: 2px 6px;">@userWhatsAppPref</span>
                                </button>
                                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" style="margin: 0; border-top: 1px solid var(--border); margin-top: 4px;">
                                    <button class="user-dropdown-item" type="submit" data-testid="logout-button">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--danger);"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                                        <span>Sign out</span>
                                    </button>
                                </form>
                            </nav>
                        </label>
                    </div>
                </div>
            </header>
            <main class="content-area @ViewData["BodyClass"]" role="main">
                @if (TempData["Success"] is string success) { 
                    <script>
                        document.addEventListener("DOMContentLoaded", function() {
                            Swal.fire({
                                toast: true,
                                position: 'bottom-end',
                                icon: 'success',
                                title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(success)),
                                showConfirmButton: false,
                                timer: 4000,
                                timerProgressBar: true
                            });
                        });
                    </script> 
                }
                @if (TempData["Error"] is string error) { 
                    <script>
                        document.addEventListener("DOMContentLoaded", function() {
                            Swal.fire({
                                toast: true,
                                position: 'bottom-end',
                                icon: 'error',
                                title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(error)),
                                showConfirmButton: false,
                                timer: 5000,
                                timerProgressBar: true
                            });
                        });
                    </script> 
                }
                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
    @RenderBody()
}

<!-- Back to top button -->
<!-- Global Batch WhatsApp Composer Modal -->
<div id="batchWaModalOverlay" class="batch-wa-overlay" onclick="handleBatchWaOverlayClick(event)">
    <div class="batch-wa-modal" onclick="event.stopPropagation()">
        <div class="batch-wa-header">
            <h3>
                <span style="color: #25D366; display: flex; align-items: center;">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
                </span>
                Batch WhatsApp Renewal Composer
            </h3>
            <button type="button" class="btn-dismiss-alert" onclick="closeBatchWhatsAppModal()" style="font-size: 1.5rem; line-height: 1;">&times;</button>
        </div>
        <div class="batch-wa-body">
            <!-- Left Column: Controls & Vehicles Queue -->
            <div class="batch-wa-col">
                <div>
                    <label class="form-label" style="font-weight: 700; font-size: 0.82rem; margin-bottom: 4px; display: block;">Select Vendor</label>
                    <select id="batchVendorSelect" class="input" onchange="onBatchVendorSelectChanged()" style="width: 100%;">
                        <option value="">-- Choose Vendor --</option>
                    </select>
                </div>

                <div>
                    <label class="form-label" style="font-weight: 700; font-size: 0.82rem; margin-bottom: 4px; display: block;">Vendor WhatsApp Phone</label>
                    <input type="text" id="batchVendorPhone" class="input" placeholder="e.g. 9876543210" style="width: 100%;" />
                </div>

                <div>
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                        <label class="form-label" style="font-weight: 700; font-size: 0.82rem; margin: 0;">Expiring Vehicles Queue</label>
                        <span id="batchVehicleCountBadge" style="font-size: 0.72rem; font-weight: 700; padding: 2px 7px; border-radius: 12px; background: rgba(14, 165, 233, 0.15); color: #0ea5e9;">0 selected</span>
                    </div>
                    <div id="batchVehicleList" style="max-height: 180px; overflow-y: auto; display: flex; flex-direction: column; gap: 6px; padding: 6px; border: 1px solid var(--line); border-radius: 8px; background: rgba(0,0,0,0.02);">
                        <div style="padding: 14px; text-align: center; color: var(--muted); font-size: 0.8rem;">Select a vendor to auto-load expiring vehicles</div>
                    </div>
                </div>

                <!-- Add Extra Vehicle Manual Input -->
                <div style="padding-top: 6px; border-top: 1px dashed var(--line);">
                    <label class="form-label" style="font-weight: 700; font-size: 0.8rem; margin-bottom: 4px; display: block;">+ Add Another Vehicle</label>
                    <div style="display: flex; gap: 6px;">
                        <input type="text" id="batchManualVehNo" class="input" placeholder="Vehicle No (e.g. KA25AB1234)" style="flex: 1; font-size: 0.8rem;" />
                        <input type="date" id="batchManualExpiry" class="input" style="width: 130px; font-size: 0.8rem;" />
                        <button type="button" class="button secondary small" onclick="addManualVehicleToBatch()" style="white-space: nowrap; font-size: 0.8rem;">Add</button>
                    </div>
                </div>
            </div>

            <!-- Right Column: Bilingual Preview -->
            <div class="batch-wa-col">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <label class="form-label" style="font-weight: 700; font-size: 0.82rem; margin: 0;">Bilingual Message Preview (English &amp; ಕನ್ನಡ)</label>
                    <button type="button" class="button ghost small" onclick="copyBatchMessageText()" style="font-size: 0.75rem; color: var(--blue-600); font-weight: 600;">📋 Copy</button>
                </div>
                <textarea id="batchMessagePreview" class="batch-preview-textarea" spellcheck="false" placeholder="Message preview will appear here..."></textarea>
            </div>
        </div>
        <div class="batch-wa-footer">
            <button type="button" class="button ghost" onclick="closeBatchWhatsAppModal()">Cancel</button>
            <div style="display: flex; gap: 8px;">
                <button type="button" class="button secondary" onclick="exportBatchVehiclesExcel()" style="color: #16a34a; font-weight: 600; display: inline-flex; align-items: center; gap: 6px;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                    Export Excel
                </button>
