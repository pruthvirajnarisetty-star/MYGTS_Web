        <div class="app-main">
            <header class="topbar">
                <button class="menu-toggle" type="button" data-menu-toggle aria-label="Toggle navigation" data-testid="menu-toggle">☰</button>
                <div class="topbar-context">
                    <span class="eyebrow">
