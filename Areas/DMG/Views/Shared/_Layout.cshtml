            max-width: 820px;
            max-height: 90vh;
            border-radius: 16px;
            border: 1px solid var(--line, #e2e8f0);
            box-shadow: 0 20px 48px rgba(0,0,0,0.3);
            display: flex;
            flex-direction: column;
            overflow: hidden;
