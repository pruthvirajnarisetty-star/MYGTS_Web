                    <a class="nav-link" asp-area="@currentBranch" asp-controller="Devices" asp-action="Export" data-testid="nav-export-workbook" title="Export complete multi-sheet Excel workbook"><span class="nav-icon"><svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span class="nav-text">Export Workbook</span></a>
