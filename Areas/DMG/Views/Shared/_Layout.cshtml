            display: none;
            align-items: center;
            justify-content: center;
            padding: 16px;
        }
        .batch-wa-overlay.open {
            display: flex;
            animation: batchFadeIn 0.2s ease-out;
        }
        @@keyframes batchFadeIn {
            from { opacity: 0; transform: scale(0.97); }
            to { opacity: 1; transform: scale(1); }
