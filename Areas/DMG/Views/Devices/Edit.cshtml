<script>
    const allDevicesJson = @Html.Raw(ViewBag.DevicesJson ?? "[]");
</script>

<script>
(function() {
    const activationInput = document.getElementById("ActivationDate");
    const expiryInput = document.getElementById("LatestExpiryDate");
    
    function updateExpiry() {
        if (!activationInput || !expiryInput || !activationInput.value) return;
        const parts = activationInput.value.split('-');
        if (parts.length === 3) {
            const year = parseInt(parts[0], 10);
            const month = parseInt(parts[1], 10) - 1;
            const day = parseInt(parts[2], 10);
            
            const date = new Date(year, month, day);
            let addMonths = parseInt('@((ViewBag.ActivationExpiryMonths as string) ?? "11")', 10) || 11;
            const addDays = parseInt('@((ViewBag.ActivationExpiryDays as string) ?? "15")', 10) || 15;
            
            const branch = '@(Context.Request.Cookies["mygts_branch"] == "RTO" ? "RTO" : "DMG")';
            const typeInput = document.getElementById("Type");
            if (branch === "RTO" && typeInput && (typeInput.value === "New" || typeInput.value === "NEW")) {
                addMonths += 12; // 2 years for RTO branch
            }
            
            date.setMonth(date.getMonth() + addMonths);
            date.setDate(date.getDate() + addDays);
            
            const yyyy = date.getFullYear();
            const mm = String(date.getMonth() + 1).padStart(2, '0');
            const dd = String(date.getDate()).padStart(2, '0');
            
            expiryInput.value = `${yyyy}-${mm}-${dd}`;
        }
    }
    
    if (activationInput && expiryInput) {
        activationInput.addEventListener("change", updateExpiry);
        activationInput.addEventListener("input", updateExpiry);
        
        const typeInput = document.getElementById("Type");
        if (typeInput) {
            typeInput.addEventListener("change", updateExpiry);
        }
        
        // Run immediately on script execution and DOM load
        updateExpiry();
        document.addEventListener("DOMContentLoaded", updateExpiry);
    }

    const unlockCheckbox = document.getElementById("unlock-inventory-fields");
    if (unlockCheckbox) {
        unlockCheckbox.addEventListener("change", function() {
            const isUnlocked = this.checked;
            const fields = ["InvoiceId", "Imei", "Iccid", "DeviceSerialNo", "SimAirtel", "SimBsnl"];
            fields.forEach(id => {
                const el = document.getElementById(id);
                if (el) {
                    if (isUnlocked) {
                        el.removeAttribute("readonly");
                        el.style.backgroundColor = "";
                        el.style.cursor = "";
                    } else {
                        el.setAttribute("readonly", "readonly");
                        el.style.backgroundColor = "#f3f4f6";
                        el.style.cursor = "not-allowed";
                    }
                }
            });
            
            const deviceNameEl = document.getElementById("DeviceName");
            if (deviceNameEl) {
                if (isUnlocked) {
                    deviceNameEl.style.pointerEvents = "auto";
                    deviceNameEl.style.backgroundColor = "";
                    deviceNameEl.style.opacity = "1";
                    deviceNameEl.tabIndex = 0;
                } else {
                    deviceNameEl.style.pointerEvents = "none";
                    deviceNameEl.style.backgroundColor = "#f3f4f6";
                    deviceNameEl.style.opacity = "0.8";
                    deviceNameEl.tabIndex = -1;
                }
            }
            
            const networkOperatorEl = document.getElementById("NetworkOperator");
            if (networkOperatorEl) {
                if (isUnlocked) {
                    networkOperatorEl.style.pointerEvents = "auto";
                    networkOperatorEl.style.backgroundColor = "";
                    networkOperatorEl.style.opacity = "1";
                    networkOperatorEl.tabIndex = 0;
                } else {
                    networkOperatorEl.style.pointerEvents = "none";
                    networkOperatorEl.style.backgroundColor = "#f3f4f6";
                    networkOperatorEl.style.opacity = "0.8";
                    networkOperatorEl.tabIndex = -1;
                }
            }
        });
    }

    
    // --- Not In Use (Mute) Mode Logic ---
    const notInUseToggle = document.getElementById("not-in-use-toggle");
    const notInUseBadge = document.getElementById("not-in-use-badge");

    function applyNotInUseState(isMuted) {
        if (notInUseBadge) notInUseBadge.style.display = isMuted ? "inline-block" : "none";
    }

    if (notInUseToggle) {
        notInUseToggle.addEventListener("change", function() {
            applyNotInUseState(this.checked);
        });
        if (notInUseToggle.checked) {
            applyNotInUseState(true);
        }
    }

    const unlockDateCheckbox = document.getElementById("unlock-activation-date");
    if (unlockDateCheckbox) {
        unlockDateCheckbox.addEventListener("change", function() {
            const isUnlocked = this.checked;
            const fields = ["ActivationDate", "LatestExpiryDate"];
            fields.forEach(id => {
                const el = document.getElementById(id);
                if (el) {
                    if (isUnlocked) {
                        el.removeAttribute("readonly");
                        el.style.backgroundColor = "";
                        el.style.cursor = "";
                    } else {
                        el.setAttribute("readonly", "readonly");
                        el.style.backgroundColor = "#f3f4f6";
                        el.style.cursor = "not-allowed";
                    }
                }
            });
        });
    }

    const lifecycleSelect = document.getElementById("LifecycleStatus");
    if (lifecycleSelect && activationInput) {
        lifecycleSelect.addEventListener("change", function() {
            if (this.value === "Active" && !activationInput.value) {
                activationInput.value = new Date().toISOString().split('T')[0];
                updateExpiry();
            }
        });
    }
    
    // Instant S.No Duplicate Validation
    const slNoInput = document.getElementById("SlNo");
    if (slNoInput && typeof allDevicesJson !== 'undefined') {
        const errorSpan = document.querySelector('[data-valmsg-for="SlNo"]');
        const currentId = '@Model.Id';
        function validateSlNo() {
            const val = (slNoInput.value || '').trim().toLowerCase();
            if (!val) return true;
            const duplicate = allDevicesJson.find(d => String(d.SlNo || '').trim().toLowerCase() === val && d.Id !== currentId);
            if (duplicate) {
                if(errorSpan) {
                    errorSpan.textContent = "This serial number is already given to another device.";
                    errorSpan.classList.remove('field-validation-valid');
                    errorSpan.classList.add('field-validation-error');
                }
                return false;
            } else {
                if(errorSpan) {
                    errorSpan.textContent = "";
                    errorSpan.classList.remove('field-validation-error');
                    errorSpan.classList.add('field-validation-valid');
                }
                return true;
            }
        }
        slNoInput.addEventListener('input', validateSlNo);
        
        const form = slNoInput.closest('form');
        if (form) {
            form.addEventListener('submit', function(e) {
                if (!validateSlNo()) {
                    e.preventDefault();
                    slNoInput.focus();
                }
            });
        }
    }
})();
</script>

<script>
// ── Replace Vehicle in Form (DMG Branch) ──
function selectReplaceVehicleOption() {
    const vehInput = document.getElementById('VehicleNo');
    const currentVeh = (vehInput?.value || '').trim();
    if (!currentVeh) {
        Swal.fire({
            icon: 'info',
            title: 'No Vehicle to Replace',
            text: 'There is currently no vehicle number entered in the form to replace.',
            confirmButtonColor: '#2563eb'
        });
        return;
    }

    Swal.fire({
        title: 'Replace Vehicle?',
        html: `<div style="text-align: left; font-size: 0.9rem; line-height: 1.55; color: #374151;">
            <p style="margin-bottom: 8px;">Are you sure you want to replace vehicle <strong>${currentVeh}</strong>?</p>
            <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 10px 12px; margin-bottom: 10px; font-size: 0.83rem;">
                <div><strong>• Moving to History:</strong> Vehicle ${currentVeh} and all ownership details will be archived.</div>
                <div><strong>• Preserving Untouched:</strong> IMEI, ICCID, SIMs, Invoice, Dates, and Lifecycle remain unchanged.</div>
            </div>
            <p style="margin: 0; color: #2563eb; font-weight: 500;">Vehicle and ownership fields will be cleared so you can enter the new vehicle's details right here in this form.</p>
        </div>`,
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#2563eb',
        cancelButtonColor: '#6b7280',
        confirmButtonText: 'Yes, Push to History & Replace',
        cancelButtonText: 'Cancel'
    }).then(result => {
        if (!result.isConfirmed) return;

        // 1. Snapshot current values
        const nowStr = new Date().toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
        const owner = (document.getElementById('Owner')?.value || '').trim();
        const vendor = (document.getElementById('vendorSelectEdit')?.value || document.getElementById('vendorInputEdit')?.value || '').trim();
        const cell = (document.getElementById('CellNo')?.value || '').trim();
        const eng = (document.getElementById('EngineNo')?.value || '').trim();
        const chasis = (document.getElementById('ChasisNo')?.value || '').trim();
        const vMake = (document.getElementById('VehicleMake')?.value || '').trim();
        const vModel = (document.getElementById('VehicleModel')?.value || '').trim();
        const poa = (document.getElementById('ProofOfAddress')?.value || '').trim();
        const docNum = (document.getElementById('DocumentNumber')?.value || '').trim();
        const addr = (document.getElementById('Address')?.value || '').trim();

        // Build history log
        let historyEntry = `Replaced from: ${currentVeh}`;
        const metaParts = [];
        if (vendor) metaParts.push(`Vendor: ${vendor}`);
        if (owner) metaParts.push(`Owner: ${owner}`);
        if (cell) metaParts.push(`Cell: ${cell}`);
        if (eng) metaParts.push(`Engine: ${eng}`);
        if (chasis) metaParts.push(`Chassis: ${chasis}`);
        metaParts.push(`Date: ${nowStr}`);
        historyEntry += ` (${metaParts.join(', ')})`;

        // 2. Push to HardwareHistory hidden input
        const hhInput = document.getElementById('HardwareHistory');
        if (hhInput) {
            const prevHh = (hhInput.value || '').trim();
            hhInput.value = prevHh ? `${prevHh} | ${historyEntry}` : historyEntry;
        }

        // Set InstallType
        const installTypeInput = document.getElementById('InstallType');
        if (installTypeInput) installTypeInput.value = 'Replacement';

        // Set ReplacedDeviceSnapshot
        const snapInput = document.getElementById('ReplacedDeviceSnapshot');
        if (snapInput) {
            const snapObj = {
                PreviousVehicleNo: currentVeh,
                PreviousOwner: owner,
                PreviousVendor: vendor,
                PreviousCellNo: cell,
                PreviousEngineNo: eng,
                PreviousChasisNo: chasis,
                PreviousProofOfAddress: poa,
                PreviousDocumentNumber: docNum,
                PreviousAddress: addr,
                ReplacedAt: new Date().toISOString()
            };
            snapInput.value = JSON.stringify(snapObj);
        }

        // 3. Clear Vehicle Number & Ownership Section fields
        vehInput.value = '';
        if (document.getElementById('Owner')) document.getElementById('Owner').value = '';
        if (document.getElementById('CellNo')) document.getElementById('CellNo').value = '';
        if (document.getElementById('EngineNo')) document.getElementById('EngineNo').value = '';
        if (document.getElementById('ChasisNo')) document.getElementById('ChasisNo').value = '';
        if (document.getElementById('VehicleMake')) document.getElementById('VehicleMake').value = '';
        if (document.getElementById('VehicleModel')) document.getElementById('VehicleModel').value = '';
        if (document.getElementById('ProofOfAddress')) document.getElementById('ProofOfAddress').value = '';
        if (document.getElementById('DocumentNumber')) document.getElementById('DocumentNumber').value = '';
        if (document.getElementById('Address')) document.getElementById('Address').value = '';
        if (document.getElementById('vendorSelectEdit')) document.getElementById('vendorSelectEdit').value = '';
        if (document.getElementById('vendorInputEdit')) document.getElementById('vendorInputEdit').value = '';
        if (document.getElementById('vendorCustomWrapEdit')) document.getElementById('vendorCustomWrapEdit').style.display = 'none';

        // 4. Update the option card in the form to reflect replacement state
        const card = document.getElementById('formReplaceVehicleCard');
        if (card) {
            card.style.background = '#f0fdf4';
            card.style.borderColor = '#86efac';
            card.innerHTML = `
                <div style="display: flex; align-items: center; gap: 12px; width: 100%;">
                    <div style="width: 34px; height: 34px; border-radius: 50%; background: #16a34a; color: #fff; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                    </div>
                    <div style="flex: 1;">
                        <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                            <strong style="color: #166534; font-size: 0.92rem;">✓ Pushed to History:</strong>
                            <code style="background: #dcfce7; color: #166534; padding: 2px 7px; border-radius: 4px; font-size: 0.8rem;">${historyEntry}</code>
                        </div>
                        <span style="color: #15803d; font-size: 0.8rem; display: block; margin-top: 2px;">
                            Old vehicle &amp; ownership data archived. Enter the <strong>new vehicle number</strong> and <strong>ownership details</strong> below and click <strong>Save changes</strong>.
                        </span>
                    </div>
                    <span style="background: #16a34a; color: #ffffff; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; padding: 4px 10px; border-radius: 20px; white-space: nowrap;">Replacement Active</span>
                </div>
            `;
        }

        // 5. Highlight & Focus the Vehicle Number input
        vehInput.focus();
        vehInput.style.borderColor = '#2563eb';
        vehInput.style.boxShadow = '0 0 0 3px rgba(37,99,235,0.2)';
        setTimeout(() => {
            vehInput.style.borderColor = '';
            vehInput.style.boxShadow = '';
        }, 3000);

        Swal.fire({
            icon: 'success',
            title: 'Pushed to History!',
            text: `Vehicle ${currentVeh} details saved. Enter new vehicle number & ownership details below and save.`,
            timer: 2200,
            showConfirmButton: false
        });
    });
}
</script>

