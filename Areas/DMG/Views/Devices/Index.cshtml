                    @if (currentBranch == "RTO")



                    {



                        <th><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-Paid="@Model.Paid" asp-route-NetworkOperator="@Model.NetworkOperator" asp-route-SortColumn="@NextCol("deviceserial")" asp-route-SortDirection="@SortDir("deviceserial")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">Device Serial No @SortIcon("deviceserial")</a></th>



                    }



                    <th>Device Sim (Airtel)</th>



                    <th>Device Sim (BSNL)</th>



                    <th><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-Paid="@Model.Paid" asp-route-NetworkOperator="@Model.NetworkOperator" asp-route-SortColumn="@NextCol("status")" asp-route-SortDirection="@SortDir("status")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">Status @SortIcon("status")</a></th>



                    @if (currentBranch == "RTO")



                    {



                        <th style="text-align: center;"><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-Paid="@Model.Paid" asp-route-NetworkOperator="@Model.NetworkOperator" asp-route-SortColumn="@NextCol("cdacc")" asp-route-SortDirection="@SortDir("cdacc")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">CDAC-C @SortIcon("cdacc")</a></th>



                        <th style="text-align: center;"><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-Paid="@Model.Paid" asp-route-NetworkOperator="@Model.NetworkOperator" asp-route-SortColumn="@NextCol("vldtc")" asp-route-SortDirection="@SortDir("vldtc")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">VLDT-C @SortIcon("vldtc")</a></th>



                        <th><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-Paid="@Model.Paid" asp-route-NetworkOperator="@Model.NetworkOperator" asp-route-SortColumn="@NextCol("type")" asp-route-SortDirection="@SortDir("type")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">Type @SortIcon("type")</a></th>



                    }



                    <th>Latest Expiry Date</th>



                    @if (currentBranch == "RTO")



                    {



                        <th><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-Paid="@Model.Paid" asp-route-NetworkOperator="@Model.NetworkOperator" asp-route-SortColumn="@NextCol("registration")" asp-route-SortDirection="@SortDir("registration")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">Registration Date @SortIcon("registration")</a></th>



                    }



                    <th><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-Paid="@Model.Paid" asp-route-NetworkOperator="@Model.NetworkOperator" asp-route-SortColumn="@NextCol("vendor")" asp-route-SortDirection="@SortDir("vendor")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">VENDOR @SortIcon("vendor")</a></th>



                    <th>Owner Details</th>



                    <th>Cell No</th>



                    <th><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-Paid="@Model.Paid" asp-route-NetworkOperator="@Model.NetworkOperator" asp-route-SortColumn="@NextCol("activation")" asp-route-SortDirection="@SortDir("activation")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">Activation Date @SortIcon("activation")</a></th>



                    <th><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-Paid="@Model.Paid" asp-route-NetworkOperator="@Model.NetworkOperator" asp-route-SortColumn="@NextCol("device")" asp-route-SortDirection="@SortDir("device")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">Device Name @SortIcon("device")</a></th>



                    <th>Network Operator</th>



                    @if (currentBranch == "RTO")



                    {



                        <th><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-Paid="@Model.Paid" asp-route-NetworkOperator="@Model.NetworkOperator" asp-route-SortColumn="@NextCol("engine")" asp-route-SortDirection="@SortDir("engine")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">Engine No @SortIcon("engine")</a></th>



                        <th><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-Paid="@Model.Paid" asp-route-NetworkOperator="@Model.NetworkOperator" asp-route-SortColumn="@NextCol("chasis")" asp-route-SortDirection="@SortDir("chasis")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">Chassis No @SortIcon("chasis")</a></th>



                        <th><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-Paid="@Model.Paid" asp-route-NetworkOperator="@Model.NetworkOperator" asp-route-SortColumn="@NextCol("make")" asp-route-SortDirection="@SortDir("make")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">Vehicle Manufacture @SortIcon("make")</a></th>



                        <th><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-Paid="@Model.Paid" asp-route-NetworkOperator="@Model.NetworkOperator" asp-route-SortColumn="@NextCol("model")" asp-route-SortDirection="@SortDir("model")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">Vehicle Model @SortIcon("model")</a></th>



                        <th><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-Paid="@Model.Paid" asp-route-NetworkOperator="@Model.NetworkOperator" asp-route-SortColumn="@NextCol("rto")" asp-route-SortDirection="@SortDir("rto")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">RTO @SortIcon("rto")</a></th>



                        <th style="min-width: 140px; max-width: 160px;"><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-Paid="@Model.Paid" asp-route-NetworkOperator="@Model.NetworkOperator" asp-route-SortColumn="@NextCol("address")" asp-route-SortDirection="@SortDir("address")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">Address @SortIcon("address")</a></th>



                        <th>Proof of Identity</th>



                        <th><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-Paid="@Model.Paid" asp-route-NetworkOperator="@Model.NetworkOperator" asp-route-SortColumn="@NextCol("docno")" asp-route-SortDirection="@SortDir("docno")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">ID Number @SortIcon("docno")</a></th>



                    }



                    else



                    {



                        <th>Engine No</th>



                        <th>Chasis No</th>



                        <th>Proof Of Address</th>



                        <th>Document Number</th>



                    }



                    <th>Invoice ID</th>



                    <th>Notes</th>



                    @if (currentBranch != "RTO")



                    {



                        <th>Previous IMEI</th>



                        <th>Hardware History</th>



                    }



                </tr>



            </thead>



            <tbody>



                @if (Model.Devices.Count == 0)



                {



                    <tr>



                        <td colspan="35" style="padding: 48px 24px; text-align: center;">



                            <div style="max-width: 440px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 10px;">



                                <div style="width: 52px; height: 52px; border-radius: 50%; background: rgba(15, 98, 254, 0.08); display: flex; align-items: center; justify-content: center; color: var(--blue-600); margin-bottom: 4px;">



                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">



                                        <circle cx="11" cy="11" r="8"></circle>



                                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>



                                    </svg>



                                </div>



                                @if (!string.IsNullOrWhiteSpace(Model.Query))



                                {



                                    <h3 style="font-size: 1.05rem; font-weight: 600; margin: 0; color: var(--text-main);">No device found matching "@Model.Query"</h3>



                                    <p style="font-size: 0.88rem; color: var(--muted); margin: 0;">This IMEI or keyword does not exist in the database.</p>



                                    <a href="/@currentBranch/Devices?clear=true" class="button secondary" style="margin-top: 8px; font-size: 0.85rem; padding: 6px 16px; border-radius: 6px;">Clear Search</a>



                                }



                                else



                                {



                                    <h3 style="font-size: 1.05rem; font-weight: 600; margin: 0; color: var(--text-main);">No devices match this filter set</h3>



                                    <p style="font-size: 0.88rem; color: var(--muted); margin: 0;">Try adjusting your selected filters to view fleet devices.</p>



                                    <a href="/@currentBranch/Devices?clear=true" class="button secondary" style="margin-top: 8px; font-size: 0.85rem; padding: 6px 16px; border-radius: 6px;">Reset All Filters</a>



                                }



                            </div>



                        </td>



                    </tr>



                }



                else



                {



                    @foreach (var device in Model.Devices)



                    {



                        var lifecycle = device.LifecycleStatus.ToLowerInvariant();



                        <tr class="batch-row @GetBatchClass(device.InvoiceId)">



                                <td class="col-select" style="text-align: center;">



                                    <input type="checkbox" class="row-select-checkbox" value="@device.Id" data-vehicle="@device.VehicleNo" data-vendor="@device.Vendor" data-imei="@device.Imei" onchange="onRowSelectionChange()" style="cursor: pointer; width: 16px; height: 16px;" />



                                </td>



                                @if (User.CanEditModule("Devices"))



                                {



                                    <td class="col-action" style="overflow: visible;">
                                    <label class="popup">



                                          <input type="checkbox">



                                          <div class="burger" tabindex="0">



                                            <span></span>



                                            <span></span>



                                            <span></span>



                                          </div>



                                          <nav class="popup-window">



                                            <legend>Actions</legend>



                                            <ul>



                                              <li>



                                                <a href="/@currentBranch/Transactions/Create?vehicleNo=@Uri.EscapeDataString(device.VehicleNo ?? "")&deviceId=@device.Id&imei=@Uri.EscapeDataString(device.Imei ?? "")" style="display: flex; align-items: center; gap: 8px;">
                                                  <svg stroke-linejoin="round" stroke-linecap="round" stroke-width="2" stroke="currentColor" fill="none" viewBox="0 0 24 24" height="14" width="14"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                                                  <span>Record Transaction</span>
                                                </a>
                                              </li>
                                              <hr>
                                              <li>
                                                <a asp-action="Edit" asp-route-id="@device.Id">



                                                  <svg stroke-linejoin="round" stroke-linecap="round" stroke-width="2" stroke="currentColor" fill="none" viewBox="0 0 24 24" height="14" width="14" xmlns="http://www.w3.org/2000/svg">



                                                    <polygon points="16 3 21 8 8 21 3 21 3 16 16 3"></polygon>



                                                  </svg>



                                                  <span>Edit</span>



                                                </a>



                                              </li>



                                              <hr>



                                              <li>



                                                <form asp-action="Delete" method="post" style="margin: 0; width: 100%;">



                                                  <input type="hidden" name="id" value="@device.Id" />



                                                  <button type="submit" onclick="return confirm('Remove this device?')">



                                                    <svg stroke-linejoin="round" stroke-linecap="round" stroke-width="2" stroke="currentColor" fill="none" viewBox="0 0 24 24" height="14" width="14" xmlns="http://www.w3.org/2000/svg">



                                                      <line y2="18" x2="6" y1="6" x1="18"></line>



                                                      <line y2="18" x2="18" y1="6" x1="6"></line>



                                                    </svg>



                                                    <span>Delete</span>



                                                  </button>



                                                </form>



                                              </li>



                                            </ul>



                                          </nav>



                                        </label>



                                    </td>



                                }



                                else



                                {



                                    <td class="col-action"></td>



                                }



                            <td class="col-slno text-sm">@device.SlNo</td>



                            <td class="col-vehicleno">
                                @(string.IsNullOrWhiteSpace(device.VehicleNo) ? "—" : device.VehicleNo)
                                @if (device.IsNotInUse)
                                {
                                    <span style="color: #ef4444; font-weight: 700; margin-left: 4px; font-size: 0.72rem;">(Not In Use)</span>
                                }
                            </td>



                            <td class="col-paid" style="text-align: center; white-space: nowrap;">



                                @{



                                    var paidSet = ViewBag.PaidVehicles as HashSet<string> ?? new HashSet<string>();
                                    var paidImeis = ViewBag.PaidImeis as HashSet<string> ?? new HashSet<string>();
                                    bool isPaid;
                                    if (string.Equals(device.Paid, "Yes", StringComparison.OrdinalIgnoreCase)) isPaid = true;
                                    else if (string.Equals(device.Paid, "No", StringComparison.OrdinalIgnoreCase)) isPaid = false;
                                    else {
                                        var normImei = (device.Imei ?? "").Trim();
                                        var norm = (device.VehicleNo ?? "").Replace(" ", "").Trim();
                                        bool hasDigit = norm.Any(char.IsDigit);
                                        bool isVendor = !string.IsNullOrWhiteSpace(device.Vendor) && norm.Equals(device.Vendor.Replace(" ", "").Trim(), StringComparison.OrdinalIgnoreCase);

                                        isPaid = (!string.IsNullOrEmpty(normImei) && paidImeis.Contains(normImei))
                                              || (!string.IsNullOrEmpty(norm) && hasDigit && !isVendor && paidSet.Contains(norm));
                                    }



                                }



                                <span class="badge-paid-readonly @(isPaid ? "paid-yes" : "paid-no")">@(isPaid ? "Yes" : "No")</span>



                            </td>



                            <td><strong>@(string.IsNullOrWhiteSpace(device.Iccid) ? "—" : device.Iccid)</strong></td>



                            <td>@(string.IsNullOrWhiteSpace(device.Imei) ? "—" : device.Imei)</td>



                            @if (currentBranch == "RTO")



                            {



                                <td>@(string.IsNullOrWhiteSpace(device.DeviceSerialNo) ? "—" : device.DeviceSerialNo)</td>



                            }



                            <td>@(string.IsNullOrWhiteSpace(device.SimAirtel) ? "—" : device.SimAirtel)</td>



                            <td>@(string.IsNullOrWhiteSpace(device.SimBsnl) ? "—" : device.SimBsnl)</td>



                            <td><span class="badge @(device.LifecycleStatus.ToLowerInvariant())">@device.LifecycleStatus</span></td>



                            @if (currentBranch == "RTO")



                            {



                                <td style="text-align: center; @(string.Equals(device.CdacCertificate, "YES", StringComparison.OrdinalIgnoreCase) ? "" : "background: rgba(239, 68, 68, 0.08);")">
                                    @if (string.Equals(device.CdacCertificate, "YES", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge active" style="font-weight: 600; padding: 2px 8px; border-radius: 4px;">YES</span>
                                    }
                                    else
                                    {
                                        <span class="badge dead cert-badge-no" style="background: #fee2e2; color: #991b1b; border: 1.5px solid #f87171; font-weight: 700; padding: 2px 8px; border-radius: 4px; box-shadow: 0 0 8px rgba(239, 68, 68, 0.25);">NO</span>
                                    }
                                </td>



                                <td style="text-align: center; @(string.Equals(device.VldtCertificate, "YES", StringComparison.OrdinalIgnoreCase) ? "" : "background: rgba(239, 68, 68, 0.08);")">
                                    @if (string.Equals(device.VldtCertificate, "YES", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge active" style="font-weight: 600; padding: 2px 8px; border-radius: 4px;">YES</span>
                                    }
                                    else
                                    {
                                        <span class="badge dead cert-badge-no" style="background: #fee2e2; color: #991b1b; border: 1.5px solid #f87171; font-weight: 700; padding: 2px 8px; border-radius: 4px; box-shadow: 0 0 8px rgba(239, 68, 68, 0.25);">NO</span>
                                    }
                                </td>



                                <td>@MygtsMvc.Services.SpreadsheetService.NormalizeType(device.Type)</td>



                            }



                            <td>@(string.IsNullOrWhiteSpace(DateValue.Short(device.LatestExpiryDate)) ? "—" : DateValue.Short(device.LatestExpiryDate))</td>



                            @if (currentBranch == "RTO")



                            {



                                <td>@(string.IsNullOrWhiteSpace(DateValue.Short(device.RegistrationDate)) ? "—" : DateValue.Short(device.RegistrationDate))</td>



                            }



                            <td>@(string.IsNullOrWhiteSpace(device.Vendor) ? "—" : device.Vendor)</td>



                            <td>@(string.IsNullOrWhiteSpace(device.Owner) ? "—" : device.Owner)</td>



                            <td>@(string.IsNullOrWhiteSpace(device.CellNo) ? "—" : device.CellNo)</td>



                            <td>@(string.IsNullOrWhiteSpace(DateValue.Short(device.ActivationDate)) ? "—" : DateValue.Short(device.ActivationDate))</td>



                            <td>@(string.IsNullOrWhiteSpace(device.DeviceName) ? "—" : device.DeviceName)</td>



                            <td>



                                @if (!string.IsNullOrWhiteSpace(device.NetworkOperator))



                                {



