                    <th class="col-vehicleno" style="width: 140px; min-width: 140px; max-width: 140px;"><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-NetworkOperator="@Model.NetworkOperator" asp-route-Paid="@Model.Paid" asp-route-SortColumn="@NextCol("vehicle")" asp-route-SortDirection="@SortDir("vehicle")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">Vehicle No @SortIcon("vehicle")</a></th>



                    <th class="col-paid" style="width: 85px; min-width: 85px; text-align: center;"><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-NetworkOperator="@Model.NetworkOperator" asp-route-Paid="@Model.Paid" asp-route-SortColumn="@NextCol("paid")" asp-route-SortDirection="@SortDir("paid")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">Paid @SortIcon("paid")</a></th>



                    <th><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-NetworkOperator="@Model.NetworkOperator" asp-route-Paid="@Model.Paid" asp-route-SortColumn="@NextCol("iccid")" asp-route-SortDirection="@SortDir("iccid")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">ICCID @SortIcon("iccid")</a></th>



