            <div style="font-size: 0.9rem; color: var(--muted);">



                Showing @((Model.Page - 1) * Model.PageSize + 1) to @Math.Min(Model.Page * Model.PageSize, Model.TotalItems) of @Model.TotalItems entries



            </div>



        <div style="display: flex; gap: 4px; align-items: center;">



            @{



                var startPage = Math.Max(1, Model.Page - 2);



                var endPage = Math.Min(Model.TotalPages, Model.Page + 2);



                



                if (startPage > 1) {



                    <a class="button secondary" asp-action="Index" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-Paid="@Model.Paid" asp-route-NetworkOperator="@Model.NetworkOperator" asp-route-SortColumn="@Model.SortColumn" asp-route-SortDirection="@Model.SortDirection" asp-route-PageSize="@Model.PageSize" asp-route-Page="1" style="padding: 4px 10px; min-width: auto; height: 32px; font-size: 13px;">1</a>



                    if (startPage > 2) {



                        <span style="padding: 4px 8px; color: var(--muted);">...</span>



                    }



                }



                



                for (int i = startPage; i <= endPage; i++)



                {



                    if (i == Model.Page) {



                        <button class="button primary" disabled style="padding: 4px 10px; min-width: auto; height: 32px; font-size: 13px;">@i</button>



                    } else {



                        <a class="button secondary" asp-action="Index" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-Paid="@Model.Paid" asp-route-NetworkOperator="@Model.NetworkOperator" asp-route-SortColumn="@Model.SortColumn" asp-route-SortDirection="@Model.SortDirection" asp-route-PageSize="@Model.PageSize" asp-route-Page="@i" style="padding: 4px 10px; min-width: auto; height: 32px; font-size: 13px;">@i</a>



                    }



                }



                



                if (endPage < Model.TotalPages) {



                    if (endPage < Model.TotalPages - 1) {



                        <span style="padding: 4px 8px; color: var(--muted);">...</span>



                    }



                    <a class="button secondary" asp-action="Index" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-Paid="@Model.Paid" asp-route-NetworkOperator="@Model.NetworkOperator" asp-route-SortColumn="@Model.SortColumn" asp-route-SortDirection="@Model.SortDirection" asp-route-PageSize="@Model.PageSize" asp-route-Page="@Model.TotalPages" style="padding: 4px 10px; min-width: auto; height: 32px; font-size: 13px;">@Model.TotalPages</a>



                }



            }



        </div>



        </div>



    }



</section>







