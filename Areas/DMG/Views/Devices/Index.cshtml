@model DeviceFilterViewModel



@{



    ViewData["Title"] = "Devices";



    string SortDir(string col) => Model.SortColumn == col && Model.SortDirection == "asc" ? "desc" : "asc";



    string SortIcon(string col) => Model.SortColumn == col ? (Model.SortDirection == "desc" ? " ↓" : " ↑") : " ↑↓";



    string NextCol(string col) => Model.SortColumn == col && Model.SortDirection == "desc" ? "" : col;



    var currentBranch = Context.Request.Cookies["mygts_branch"] == "RTO" ? "RTO" : "DMG";



    var batchMap = ViewBag.BatchColorMap as Dictionary<string, int>;



    string GetBatchClass(string? invoiceId) => MygtsMvc.Services.BatchColorHelper.GetBatchClass(invoiceId, batchMap);



}







<style>



    /* Row selection checkbox column: visible and styled */



    .col-select {



        display: table-cell !important;



    }







    /* Highlight rows that are selected */



    .data-table tr.row-selected,
    .data-table tr.batch-row.row-selected,
    tr.row-selected {
        background-color: rgba(37, 99, 235, 0.16) !important;
        outline: 2px solid rgba(37, 99, 235, 0.45) !important;
        outline-offset: -2px !important;
    }







    /* Paid badge styles */



    .badge-paid-btn {



        display: inline-flex;



        align-items: center;



        justify-content: center;



        min-width: 48px;



        padding: 2px 10px;



        border-radius: 9999px;



        font-size: 0.76rem;



        font-weight: 600;



        text-transform: uppercase;



        letter-spacing: 0.04em;



        cursor: pointer;



        border: 1px solid transparent;



        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);



        outline: none;



        user-select: none;



    }



    .badge-paid-readonly {



        display: inline-flex;



        align-items: center;



        justify-content: center;



        min-width: 48px;



        padding: 2px 10px;



        border-radius: 9999px;



        font-size: 0.76rem;



        font-weight: 600;



        text-transform: uppercase;



        letter-spacing: 0.04em;



        user-select: none;



        cursor: default;



    }



    .paid-yes {



        background-color: rgba(36, 161, 72, 0.15) !important;



        color: #198038 !important;



        border-color: rgba(36, 161, 72, 0.35) !important;



    }



    .paid-no {



        background-color: rgba(218, 30, 40, 0.12) !important;



        color: #da1e28 !important;



        border-color: rgba(218, 30, 40, 0.3) !important;



    }



    .badge-paid-btn:hover {



        transform: translateY(-1px) scale(1.05);



        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);



    }



    .badge-paid-btn.paid-yes:hover {



        background-color: #24a148 !important;



        color: #ffffff !important;



    }



    .badge-paid-btn.paid-no:hover {



        background-color: #da1e28 !important;



        color: #ffffff !important;



    }



.badge.not-in-use,
.badge.status-not-in-use {
    background: rgba(239, 68, 68, 0.12) !important;
    color: #dc2626 !important;
    border: 1px solid rgba(239, 68, 68, 0.25) !important;
    font-weight: 700 !important;
}
body:has(#theme:checked) .badge.not-in-use,
body:has(#theme:checked) .badge.status-not-in-use {
    background: rgba(239, 68, 68, 0.25) !important;
    color: #f87171 !important;
    border-color: rgba(239, 68, 68, 0.4) !important;
}
</style>







<div class="page-heading">



    <div>



        <div class="eyebrow">Fleet registry / traceability</div>



        <h1>Devices</h1>



        <p>Search, segment, and maintain the GPS fleet from one operational record.</p>



    </div>







    <div class="page-heading-actions">



        @* Standard Download Dropdown *@



        <div class="dropdown-wrapper" style="position: relative; display: inline-block;">



            <button type="button" class="button secondary" onclick="toggleExportMenu('exportMenu')" data-testid="devices-export" style="display: inline-flex; align-items: center; gap: 6px;">



                <span>↓ Download Sheet</span>



                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>



            </button>



            <div id="exportMenu" class="export-dropdown-panel" style="display: none; position: absolute; right: 0; top: calc(100% + 4px); background: var(--paper); border: 1px solid var(--line); border-radius: 8px; box-shadow: 0 10px 25px rgba(0,0,0,0.15); min-width: 280px; z-index: 100; overflow: hidden; padding: 6px 0;">



                <div style="padding: 6px 16px 2px; font-size: 0.68rem; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em;">Default Format</div>



                <a class="export-opt" href="javascript:void(0)" onclick="handleDownloadOptionClick('')" style="display: flex; flex-direction: column; padding: 8px 16px; text-decoration: none; color: var(--text-main); transition: background 0.15s;">



                    <strong style="font-size: 0.84rem;">☑️ Select Rows to Download (<span class="sel-count-badge">0</span>)</strong>



                    <span style="font-size: 0.74rem; color: var(--muted);">Click to show checkboxes & select specific rows for export</span>



                </a>



                <a class="export-opt" asp-action="ExportAll" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-NetworkOperator="@Model.NetworkOperator" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-Paid="@Model.Paid" asp-route-FromDate="@Model.FromDate" asp-route-ToDate="@Model.ToDate" asp-route-DateType="@Model.DateType" asp-route-SortColumn="@Model.SortColumn" asp-route-SortDirection="@Model.SortDirection" asp-route-Page="@Model.Page" asp-route-PageSize="@Model.PageSize" asp-route-thisPageOnly="true" style="display: flex; flex-direction: column; padding: 8px 16px; text-decoration: none; color: var(--text-main); transition: background 0.15s;">



                    <strong style="font-size: 0.84rem;">📄 Download This Page Only</strong>



                    <span style="font-size: 0.74rem; color: var(--muted);">Page @Model.Page of @Model.TotalPages (@Model.Devices.Count rows on this page)</span>



                </a>



                <a class="export-opt" asp-action="ExportAll" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-NetworkOperator="@Model.NetworkOperator" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-Paid="@Model.Paid" asp-route-FromDate="@Model.FromDate" asp-route-ToDate="@Model.ToDate" asp-route-DateType="@Model.DateType" asp-route-SortColumn="@Model.SortColumn" asp-route-SortDirection="@Model.SortDirection" asp-route-thisPageOnly="false" style="display: flex; flex-direction: column; padding: 8px 16px; text-decoration: none; color: var(--text-main); transition: background 0.15s;">



                    <strong style="font-size: 0.84rem;">📊 Download All Filtered Records</strong>



                    <span style="font-size: 0.74rem; color: var(--muted);">Export all @Model.TotalItems matching records across all pages</span>



                </a>



            </div>



        </div>







        @if (currentBranch == "RTO")



        {



            <a class="button secondary" asp-action="DownloadSample" asp-route-branch="@currentBranch" asp-route-format="kyc_upload" title="Download KYC Upload Form sample (.xls)" style="display: inline-flex; align-items: center; gap: 6px; border-color: #2563eb; color: #2563eb; font-weight: 600;">



                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>



                <span>📥 Sample Upload Form (.xls)</span>



            </a>



            <a class="button secondary" asp-action="DownloadSample" asp-route-branch="@currentBranch" asp-route-format="kyc_cl" title="Download KYC Common Layer sample (.xls)" style="display: inline-flex; align-items: center; gap: 6px; border-color: #10b981; color: #10b981; font-weight: 600;">



                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>



                <span>📥 Sample Common Layer (.xls)</span>



            </a>



        }



        <script>



            function toggleExportMenu(id) {



                const target = document.getElementById(id);



                if (!target) return;



                const isCurrentlyOpen = target.style.display === 'block';



                document.querySelectorAll('.export-dropdown-panel').forEach(p => p.style.display = 'none');



                



                if (!isCurrentlyOpen) {



                    target.style.display = 'block';



                } else {



                    target.style.display = 'none';



                }



            }







            document.addEventListener('click', function(e) {



                const dropdownWrapper = e.target.closest('.dropdown-wrapper');



                const isExportDropdown = e.target.closest('.export-dropdown-panel');







                // 1. Collapse export dropdown if clicked outside dropdown wrapper



                if (!dropdownWrapper && !isExportDropdown) {



                    document.querySelectorAll('.export-dropdown-panel').forEach(p => p.style.display = 'none');



                }







                // 2. If selection mode is active and user clicks anywhere other than the checkboxes or bottom bar:



                if (document.body.classList.contains('selection-mode-active')) {



                    const isCheckbox = e.target.closest('.row-select-checkbox') 



                        || e.target.closest('#selectAllCheckbox') 



                        || e.target.closest('.col-select');



                    const isSelectionBar = e.target.closest('#selectionBar');



                    const isSelectRowsOption = e.target.closest('.export-opt') || e.target.closest('a[onclick*="handleDownloadOptionClick"]');



                    const isDownloadDropdownBtn = e.target.closest('[data-testid="devices-export"]');







                    if (!isCheckbox && !isSelectionBar && !isSelectRowsOption && !isDownloadDropdownBtn) {



                        if (typeof exitSelectionMode === 'function') {



                            exitSelectionMode();



                        }



                        document.querySelectorAll('.export-dropdown-panel').forEach(p => p.style.display = 'none');



                    }



                }



            });



        </script>



        <a class="button secondary" asp-action="DownloadSample" asp-route-branch="@currentBranch" title="Download sample devices Excel template (.xlsx)">📥 Sample sheet</a>



        @if (User.CanEditModule("Devices"))



        {



            <a class="button secondary" asp-action="Import" data-testid="devices-import">↑ Import devices</a>



            <a class="button btn-primary" asp-action="Create" data-testid="devices-add">+ Add device</a>



        }



        else



        {



        }



    </div>



</div>







<form class="card toolbar" method="get" asp-action="Index" data-testid="device-filters">



    <div class="filter-grid" style="align-items: flex-end; width: 100%;">



        <div class="field toolbar-search">



            <label for="QueryInput" class="form-label" style="margin-bottom: 4px; display: block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-main);">SEARCH</label>



            <div style="position: relative; width: 100%;">



                <button type="button" style="position: absolute; top: 50%; transform: translateY(-50%); left: 16px; padding: 0; background: transparent; border: none; display: flex; align-items: center; justify-content: center;">



                    <svg width="17" height="16" fill="none" xmlns="http://www.w3.org/2000/svg" style="width: 20px; height: 20px; color: #4b5563;">



                        <path d="M7.667 12.667A5.333 5.333 0 107.667 2a5.333 5.333 0 000 10.667zM14.334 14l-2.9-2.9" stroke="currentColor" stroke-width="1.333" stroke-linecap="round" stroke-linejoin="round"></path>



                    </svg>



                </button>



                <input type="hidden" asp-for="Query" id="Query" />



                <input type="hidden" asp-for="SpecialFilter" />



                <input type="hidden" asp-for="SortColumn" />



                <input type="hidden" asp-for="SortDirection" />



                <input id="QueryInput" name="QueryInput" class="input shadow-md w-full" style="padding: 0 44px; border-radius: 9999px; height: 42px; width: 100%; border: 1px solid var(--line); outline: none; transition: all 0.3s; font-size: 14px;" placeholder="Add a filter..." type="text" data-testid="device-search" onfocus="this.style.borderColor='#3b82f6'" onblur="this.style.borderColor='var(--line)'" />



                <button type="button" onclick="document.getElementById('QueryInput').value=''; document.getElementById('Query').value=''; this.closest('form').submit();" style="position: absolute; top: 50%; transform: translateY(-50%); right: 12px; padding: 0; background: transparent; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center;">



                    <svg xmlns="http://www.w3.org/2000/svg" style="width: 20px; height: 20px; color: #4b5563;" fill="none" viewBox="0 0 24 24" stroke="currentColor">



                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>



                    </svg>



                </button>



            </div>



        </div>







        <div class="field" style="min-width: 150px;">
            <label class="form-label" asp-for="Vendor">Vendor</label>
            <select class="select @(!string.IsNullOrEmpty(Model.Vendor) ? "filter-active" : "")" asp-for="Vendor" style="min-width: 150px;">



                <option value="">All vendors</option>



                @foreach (var vendor in Model.Vendors)



                {



                    <option value="@vendor">@vendor</option>



                }



            </select>



        </div>







        <div class="field">



            <label class="form-label" asp-for="NetworkOperator">Network Operator</label>



            <select class="select @(!string.IsNullOrEmpty(Model.NetworkOperator) ? "filter-active" : "")" asp-for="NetworkOperator">



                <option value="">All operators</option>



                @foreach (var op in Model.NetworkOperators)



                {



                    <option value="@op">@op</option>



                }



            </select>



        </div>







        <div class="field">



            <label class="form-label" asp-for="Lifecycle">Lifecycle</label>



            <select class="select @(!string.IsNullOrEmpty(Model.Lifecycle) ? "filter-active" : "")" asp-for="Lifecycle">



                <option value="">All statuses</option>



                @foreach (var option in Model.LifecycleOptions)



                {



                    <option value="@option">@option</option>



                }



            </select>



        </div>







        <div class="field">



            <label class="form-label" asp-for="Stock">Stock</label>



            <select class="select @(!string.IsNullOrEmpty(Model.Stock) ? "filter-active" : "")" asp-for="Stock">



                <option value="">All stocks</option>



                @foreach (var option in Model.StockOptions)



                {



                    <option value="@option">@option</option>



                }



            </select>



        </div>







        <div class="field">



            <label class="form-label" asp-for="Paid">Paid</label>



            <select class="select @(!string.IsNullOrEmpty(Model.Paid) ? "filter-active" : "")" asp-for="Paid" onchange="this.form.requestSubmit ? this.form.requestSubmit() : this.form.submit()">



                <option value="">All</option>



                <option value="Yes">Yes</option>



                <option value="No">No</option>



            </select>



        </div>

        <div class="field" style="min-width: 130px; flex: 0 0 auto;">
            <label class="form-label" for="DateType" style="margin-bottom: 4px; display: block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-main);">Date Type</label>
            <select id="DateType" name="DateType" class="select @(!string.IsNullOrEmpty(Model.DateType) && Model.DateType != "All" && (!string.IsNullOrEmpty(Model.FromDate) || !string.IsNullOrEmpty(Model.ToDate)) ? "filter-active" : "")" style="height: 42px; border-radius: 8px; width: 100%; font-size: 13px;" onchange="this.form.requestSubmit ? this.form.requestSubmit() : this.form.submit()">
                <option value="All" selected="@(string.IsNullOrEmpty(Model.DateType) || Model.DateType == "All")">All</option>
                <option value="Expiry" selected="@(Model.DateType == "Expiry")">Expiry Date</option>
                <option value="Activation" selected="@(Model.DateType == "Activation")">Activation Date</option>
            </select>
        </div>

        <div class="field" style="min-width: 140px; flex: 0 0 auto;">
            <label class="form-label" for="FromDate" style="margin-bottom: 4px; display: block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-main);">From Date</label>
            <input type="date" id="FromDate" name="FromDate" value="@Model.FromDate" class="input @(!string.IsNullOrEmpty(Model.FromDate) ? "filter-active" : "")" style="height: 42px; border-radius: 8px; width: 100%; font-size: 13px;" onchange="this.form.requestSubmit ? this.form.requestSubmit() : this.form.submit()" />
        </div>

        <div class="field" style="min-width: 140px; flex: 0 0 auto;">
            <label class="form-label" for="ToDate" style="margin-bottom: 4px; display: block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-main);">To Date</label>
            <input type="date" id="ToDate" name="ToDate" value="@Model.ToDate" class="input @(!string.IsNullOrEmpty(Model.ToDate) ? "filter-active" : "")" style="height: 42px; border-radius: 8px; width: 100%; font-size: 13px;" onchange="this.form.requestSubmit ? this.form.requestSubmit() : this.form.submit()" />
        </div>







        <div class="field">



            <label class="form-label" asp-for="PageSize">Rows per page</label>



            <select class="select" asp-for="PageSize" onchange="this.form.requestSubmit ? this.form.requestSubmit() : this.form.submit()">



                <option value="10">10</option>
                <option value="20">20</option>
                <option value="50">50</option>
                <option value="100">100</option>
                <option value="1000000">All</option>
            </select>



        </div>







        <div class="field" style="min-width: 140px;">



            <label class="form-label" for="PageSelect" style="margin-bottom: 4px; display: block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-main);">Page</label>



            <div style="display: flex; align-items: center; gap: 4px;">



                <button type="button" class="button secondary" title="Previous Page" @(Model.Page <= 1 ? "disabled" : "") onclick="goToTopPage(@(Model.Page - 1))" style="padding: 0 8px; height: 42px; border-radius: 8px; min-width: 34px; display: inline-flex; align-items: center; justify-content: center; @(Model.Page <= 1 ? "opacity: 0.4; cursor: not-allowed;" : "")">



                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>



                </button>



                <select class="select" id="PageSelect" name="Page" onchange="goToTopPage(this.value)" style="height: 42px; border-radius: 8px; padding: 0 26px 0 10px; font-weight: 600; width: auto;">



                    @for (int p = 1; p <= Math.Max(1, Model.TotalPages); p++)



                    {



                        if (p == Model.Page)



                        {



                            <option value="@p" selected>@p / @(Model.TotalPages == 0 ? 1 : Model.TotalPages)</option>



                        }



                        else



                        {



                            <option value="@p">@p / @(Model.TotalPages == 0 ? 1 : Model.TotalPages)</option>



                        }



                    }



                </select>



                <button type="button" class="button secondary" title="Next Page" @(Model.Page >= Model.TotalPages ? "disabled" : "") onclick="goToTopPage(@(Model.Page + 1))" style="padding: 0 8px; height: 42px; border-radius: 8px; min-width: 34px; display: inline-flex; align-items: center; justify-content: center; @(Model.Page >= Model.TotalPages ? "opacity: 0.4; cursor: not-allowed;" : "")">



                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>



                </button>



            </div>



        </div>







        <div class="field toolbar-actions">



            <button class="button btn-primary" type="submit" data-testid="device-search-submit" style="height: 42px; border-radius: 8px; padding: 0 20px; white-space: nowrap;">Apply filters</button>



            <a asp-action="Index" asp-route-clear="true" class="button secondary" style="height: 42px; border-radius: 8px; padding: 0 16px; display: inline-flex; align-items: center; gap: 6px; text-decoration: none; white-space: nowrap;" title="Reset all filters">



                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>



                <span>Clear filters</span>



            </a>



        </div>



    </div>



    @{



        var queryTerms = string.IsNullOrWhiteSpace(Model.Query) ? Array.Empty<string>() : Model.Query.Trim().Split('|', StringSplitOptions.RemoveEmptyEntries);
        var hasDateRange = !string.IsNullOrEmpty(Model.FromDate) || !string.IsNullOrEmpty(Model.ToDate);



    }



    @if (queryTerms.Length > 0 || hasDateRange)



    {



        <div class="flex flex-wrap gap-2 mt-4" style="padding-bottom: 8px; width: 100%;">



            @foreach (var term in queryTerms)



            {



                <span class="filter-chip inline-flex items-center gap-1 px-3 py-1 text-sm rounded-full">



                    @term



                    <button type="button" onclick="removeChip('@term')" class="text-gray-400 hover:text-gray-700">



                        <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>



                    </button>



                </span>



            }

            @if (hasDateRange)
            {
                <span class="filter-chip inline-flex items-center gap-1 px-3 py-1 text-sm rounded-full">
                    @(Model.DateType == "Activation" ? "Activation" : (Model.DateType == "Expiry" ? "Expiry" : "Date")): @(Model.FromDate ?? "...") to @(Model.ToDate ?? "...")
                    <button type="button" onclick="clearDateFields()" class="text-gray-400 hover:text-gray-700">
                        <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </button>
                </span>
            }



        </div>



    }



</form>







<script>



    function goToTopPage(pageNum) {
        if (!pageNum || pageNum < 1) pageNum = 1;
        var form = document.querySelector('form.toolbar');
        if (!form) return;
        var pageSelect = document.getElementById('PageSelect');
        if (pageSelect) pageSelect.value = pageNum;
        var queryInput = document.getElementById('QueryInput');
        if (queryInput && queryInput.value.trim() === '') {
            queryInput.disabled = true;
        }
        window._isPageChange = true;
        if (form.requestSubmit) {
            form.requestSubmit();
        } else {
            form.submit();
        }
    }







    document.querySelector('form.toolbar').addEventListener('submit', function(e) {



        var queryInput = document.getElementById('QueryInput');



        var queryHidden = document.getElementById('Query');



        if (queryInput && queryInput.value.trim() !== '') {



            var current = queryHidden.value ? queryHidden.value + '|' : '';



            queryHidden.value = current + queryInput.value.trim();



            queryInput.value = ''; // Don't submit the visual input



        }



        if (!window._isPageChange) {



            var pageSelect = document.getElementById('PageSelect');



            if (pageSelect) pageSelect.value = '1';



            var pageInput = this.querySelector('input[name="Page"]');



            if (pageInput) pageInput.value = '1';



        }



        window._isPageChange = false;



    });







    function removeChip(term) {



        var queryHidden = document.getElementById('Query');



        var terms = queryHidden.value.split('|').filter(t => t !== '' && t !== term);



        queryHidden.value = terms.join('|');



        window._isPageChange = false;



        document.querySelector('form.toolbar').submit();



    }

    function clearDateFields() {
        var fd = document.getElementById('FromDate');
        var td = document.getElementById('ToDate');
        var dt = document.getElementById('DateType');
        if (fd) fd.value = '';
        if (td) td.value = '';
        if (dt) dt.value = 'All';
        window._isPageChange = false;
        var form = document.querySelector('form.toolbar');
        if (form) (form.requestSubmit ? form.requestSubmit() : form.submit());
    }



</script>







<section class="card">



    <div class="section-heading" style="padding: 0 20px; margin: 20px 0 12px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">



        <div>



            <h2>@Model.TotalItems.ToString("N0") device records</h2>



            <p>Records exclude unused inventory unless explicitly filtered; source lifecycle labels are preserved. Page @Model.Page of @(Model.TotalPages == 0 ? 1 : Model.TotalPages)</p>



        </div>



        @if (Model.TotalPages > 1)



        {



            <div style="display: flex; align-items: center; gap: 6px;">



                <span style="font-size: 0.82rem; color: var(--muted); font-weight: 500;">Jump to page:</span>



                <button type="button" class="button secondary" title="Previous Page" @(Model.Page <= 1 ? "disabled" : "") onclick="goToTopPage(@(Model.Page - 1))" style="padding: 0 8px; height: 32px; min-width: 32px; display: inline-flex; align-items: center; justify-content: center; @(Model.Page <= 1 ? "opacity: 0.4; cursor: not-allowed;" : "")">



                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>



                </button>



                <select class="select page-jump-select" data-pagination="true" onchange="goToTopPage(this.value)" style="height: 32px; padding: 0 24px 0 8px; font-size: 0.82rem; font-weight: 600; width: auto; background-image: none !important;">



                    @for (int p = 1; p <= Model.TotalPages; p++)



                    {



                        if (p == Model.Page)



                        {



                            <option value="@p" selected>Page @p of @Model.TotalPages</option>



                        }



                        else



                        {



                            <option value="@p">Page @p of @Model.TotalPages</option>



                        }



                    }



                </select>



                <button type="button" class="button secondary" title="Next Page" @(Model.Page >= Model.TotalPages ? "disabled" : "") onclick="goToTopPage(@(Model.Page + 1))" style="padding: 0 8px; height: 32px; min-width: 32px; display: inline-flex; align-items: center; justify-content: center; @(Model.Page >= Model.TotalPages ? "opacity: 0.4; cursor: not-allowed;" : "")">



                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>



                </button>



            </div>



        }



    </div>







    <div class="table-wrap">



        <table class="data-table" data-testid="devices-table">



            <thead>



                <tr>



                    <th class="col-select" style="width: 38px; min-width: 38px; text-align: center;"><input type="checkbox" id="selectAllCheckbox" title="Select all rows on this page" onchange="toggleSelectAllRows(this.checked)" style="cursor: pointer; width: 16px; height: 16px;" /></th>



