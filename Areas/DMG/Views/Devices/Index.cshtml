        }



        <button type="button" id="btnDownloadDefault" class="button small" onclick="downloadSelected('')" style="background: #475569; color: #fff; border: none; padding: 6px 14px; border-radius: 9999px; font-size: 0.8rem; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 4px;">



            <span>↓ Download (<span class="sel-count-badge">0</span>)</span>



        </button>







        <button type="button" onclick="clearRowSelection()" style="background: transparent; color: #f87171; border: 1px solid rgba(239, 68, 68, 0.4); border-radius: 9999px; padding: 5px 12px; font-size: 0.78rem; cursor: pointer; display: inline-flex; align-items: center; gap: 4px; font-weight: 500; margin-left: 4px;" title="Deselect all rows">



            ✕ Clear



        </button>



    </div>



</div>







<script>



    let currentTargetFormat = '';







    function enableSelectionMode(targetFormat, keepMenuOpen) {



        currentTargetFormat = targetFormat || '';



        document.body.classList.add('selection-mode-active');



        



        if (!keepMenuOpen) {



            // Automatically collapse any open export dropdown menus



            document.querySelectorAll('.export-dropdown-panel').forEach(p => p.style.display = 'none');



        }



        



        updateFloatingBarFormatHighlight(targetFormat);



        



        const bar = document.getElementById('selectionBar');



        if (bar) bar.style.display = 'flex';



    }







    function exitSelectionMode() {



        document.body.classList.remove('selection-mode-active');



        clearRowSelection();



        const bar = document.getElementById('selectionBar');



        if (bar) bar.style.display = 'none';



        currentTargetFormat = '';



        document.querySelectorAll('.export-dropdown-panel').forEach(p => p.style.display = 'none');



    }







    function handleDownloadOptionClick(format) {



        // Automatically collapse dropdown menu



        document.querySelectorAll('.export-dropdown-panel').forEach(p => p.style.display = 'none');







        const isSelectionActive = document.body.classList.contains('selection-mode-active');



        const checked = Array.from(document.querySelectorAll('.row-select-checkbox:checked')).map(cb => cb.value);







        if (!isSelectionActive) {



            // First time selecting the download option: show checkboxes and bottom section



            enableSelectionMode(format, false);



        } else {



            // Already in selection mode: if rows checked, download them!



            if (checked.length > 0) {



                downloadSelected(format);



            } else {



                updateFloatingBarFormatHighlight(format);



            }



        }



    }







    function updateFloatingBarFormatHighlight(format) {



        const kycUploadBtn = document.getElementById('btnDownloadKycUpload');



        const kycClBtn = document.getElementById('btnDownloadKycCl');



        const defaultBtn = document.getElementById('btnDownloadDefault');







        [kycUploadBtn, kycClBtn, defaultBtn].forEach(b => {



            if (b) {



                b.style.boxShadow = 'none';



                b.style.outline = 'none';



            }



        });







        if (format === 'kyc_upload' && kycUploadBtn) {



            kycUploadBtn.style.boxShadow = '0 0 0 3px rgba(37, 99, 235, 0.45)';



        } else if (format === 'kyc_cl' && kycClBtn) {



            kycClBtn.style.boxShadow = '0 0 0 3px rgba(16, 185, 129, 0.45)';



        } else if (format === '' && defaultBtn) {



            defaultBtn.style.boxShadow = '0 0 0 3px rgba(148, 163, 184, 0.45)';



        }



    }







    function toggleSelectAllRows(checked) {
        const headerCb = document.getElementById('selectAllCheckbox');
        if (typeof checked !== 'boolean') {
            checked = headerCb ? headerCb.checked : true;
        }
        const allBoxes = document.querySelectorAll('.row-select-checkbox');
        allBoxes.forEach(cb => {
            cb.checked = checked;
            const tr = cb.closest('tr');
            if (tr) {
                if (checked) tr.classList.add('row-selected');
                else tr.classList.remove('row-selected');
            }
        });
        if (headerCb) {
            headerCb.checked = checked;
            headerCb.indeterminate = false;
        }
        onRowSelectionChange();
    }

    
    // Easy click on selection cell
    document.addEventListener('click', function(e) {
        const colSelect = e.target.closest('td.col-select');
        if (colSelect && e.target.tagName !== 'INPUT') {
            const cb = colSelect.querySelector('.row-select-checkbox');
            if (cb) {
                cb.checked = !cb.checked;
                onRowSelectionChange();
            }
        }
    });

    function onRowSelectionChange() {
        const allBoxes = document.querySelectorAll('.row-select-checkbox');
        const checkedBoxes = Array.from(document.querySelectorAll('.row-select-checkbox:checked'));
        const count = checkedBoxes.length;
        const totalRows = allBoxes.length;

        // update row highlighting
        allBoxes.forEach(cb => {
            const tr = cb.closest('tr');
            if (tr) {
                if (cb.checked) tr.classList.add('row-selected');
                else tr.classList.remove('row-selected');
            }
        });

        // update header checkbox
        const selectAll = document.getElementById('selectAllCheckbox');
        if (selectAll) {
            selectAll.checked = count > 0 && count === totalRows;
            selectAll.indeterminate = count > 0 && count < totalRows;
        }

        document.querySelectorAll('.sel-count-badge').forEach(b => b.textContent = count);
        const countEl = document.getElementById('floatingSelectedCount');
        if (countEl) countEl.textContent = count;

        // Middle bottom floating selection dock
        const bar = document.getElementById('selectionBar');
        if (bar) {
            if (count > 0 || document.body.classList.contains('selection-mode-active')) {
                bar.style.display = 'flex';
            } else {
                bar.style.display = 'none';
            }
        }

        // Action buttons inside middle bottom dock
        const btnSingle = document.getElementById('btnSingleTransaction');
        const btnBulk = document.getElementById('btnBulkPayment');
        const singleVeh = document.getElementById('singleVehicleLabel');

        if (count === 1) {
            const cb = checkedBoxes[0];
            const veh = (cb.dataset.vehicle || '').trim();
            const imei = (cb.dataset.imei || '').trim();
            const label = veh || imei || 'Device';
            if (btnSingle) {
                btnSingle.style.display = 'inline-flex';
                if (singleVeh) singleVeh.textContent = label;
            }
            if (btnBulk) {
                btnBulk.style.display = 'none';
            }
        } else if (count > 1) {
            if (btnSingle) {
                btnSingle.style.display = 'none';
            }
            if (btnBulk) {
                btnBulk.style.display = 'inline-flex';
            }
        } else {
            if (btnSingle) btnSingle.style.display = 'none';
            if (btnBulk) btnBulk.style.display = 'none';
        }
    }

    function proceedToSingleTransaction() {
        const checkedBoxes = Array.from(document.querySelectorAll('.row-select-checkbox:checked'));
        if (checkedBoxes.length === 0) return;
        const cb = checkedBoxes[0];
        const vehicle = (cb.dataset.vehicle || '').trim();
        const deviceId = (cb.value || '').trim();
        const imei = (cb.dataset.imei || '').trim();

        const params = new URLSearchParams();
        if (vehicle) params.append('vehicleNo', vehicle);
        if (deviceId) params.append('deviceId', deviceId);
        if (imei) params.append('imei', imei);

        window.location.href = `/@currentBranch/Transactions/Create?${params.toString()}`;
    }

    function proceedToBulkPayment() {
        const checkedBoxes = Array.from(document.querySelectorAll('.row-select-checkbox:checked'));
        if (checkedBoxes.length === 0) {
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    icon: 'info',
                    title: 'No Vehicles Selected',
                    text: 'Please select at least one vehicle using the checkboxes to create a bulk payment.',
                    confirmButtonColor: '#2563eb'
                });
            } else {
                alert('Please select at least one vehicle to create a bulk payment.');
            }
            return;
        }

        const selectedIds = checkedBoxes.map(cb => cb.value).filter(Boolean);
        const selectedVehicles = checkedBoxes.map(cb => cb.dataset.vehicle || '').filter(Boolean);

        const form = document.getElementById('bulkSplitSelectedForm');
        document.getElementById('bulkSplitSelectedIds').value = selectedIds.join(',');
        document.getElementById('bulkSplitSelectedVehicles').value = selectedVehicles.join(',');
        form.submit();
    }

    function clearRowSelection() {
        document.querySelectorAll('.row-select-checkbox').forEach(cb => {
            cb.checked = false;
            const tr = cb.closest('tr');
            if (tr) tr.classList.remove('row-selected');
        });
        const selectAll = document.getElementById('selectAllCheckbox');
        if (selectAll) {
            selectAll.checked = false;
            selectAll.indeterminate = false;
        }
        const bar = document.getElementById('selectionBar');
        if (bar && !document.body.classList.contains('selection-mode-active')) {
            bar.style.display = 'none';
        }
        const btnSingle = document.getElementById('btnSingleTransaction');
        if (btnSingle) btnSingle.style.display = 'none';
        const btnBulk = document.getElementById('btnBulkPayment');
        if (btnBulk) btnBulk.style.display = 'none';
        document.querySelectorAll('.sel-count-badge').forEach(b => b.textContent = '0');
        const countEl = document.getElementById('floatingSelectedCount');
        if (countEl) countEl.textContent = '0';
    }

    function downloadSelected(format) {



        const checked = Array.from(document.querySelectorAll('.row-select-checkbox:checked')).map(cb => cb.value);



        if (checked.length === 0) {



            if (typeof Swal !== 'undefined') {



                Swal.fire({



                    icon: 'info',



                    title: 'No Rows Selected',



                    text: 'Please select at least one row using the checkboxes to download.',



                    confirmButtonColor: '#2563eb'



                });



            } else {



                alert('Please select at least one row using the checkboxes to download.');



            }



            return;



        }



        document.getElementById('selectedDownloadFormat').value = format;



        document.getElementById('selectedDownloadIds').value = checked.join(',');



        document.getElementById('selectedDownloadForm').submit();



    }







    async function toggleDevicePaid(deviceId, btn) {



        if (!deviceId || btn.dataset.busy === 'true') return;



        btn.dataset.busy = 'true';



        btn.style.opacity = '0.5';



        const isCurrentlyYes = btn.classList.contains('paid-yes');



        const newStatus = isCurrentlyYes ? 'No' : 'Yes';



        



        try {



            const branchMatch = (document.cookie.match(/mygts_branch=([^;]+)/) || [])[1];



            const branch = branchMatch ? decodeURIComponent(branchMatch) : 'DMG';



            const resp = await fetch(`/${branch}/Devices/TogglePaid`, {



                method: 'POST',



                headers: { 'Content-Type': 'application/json' },



                body: JSON.stringify({ id: deviceId, paid: newStatus })



            });



            if (resp.ok) {



                const data = await resp.json();



                if (data.success) {



                    if (data.paid === 'Yes') {



                        btn.classList.remove('paid-no');



                        btn.classList.add('paid-yes');



                        btn.textContent = 'Yes';



                    } else {



                        btn.classList.remove('paid-yes');



                        btn.classList.add('paid-no');



                        btn.textContent = 'No';



                    }



                } else {



                    alert(data.error || 'Failed to update Paid status.');



                }



            } else {



                alert('Only executives or above can change the Paid status.');



            }



        } catch (e) {



            console.error(e);



            alert('Network error updating Paid status.');



        } finally {



            btn.dataset.busy = 'false';



            btn.style.opacity = '1';



        }



    }



</script>







