<!-- Floating Selection Bar -->
<form id="inv-export-selected-form" method="post" action="/Inventory/ExportBatch" style="display: none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="invoiceNo" id="invSelectedBatch" value="Selected" />
    <input type="hidden" name="format" id="invSelectedFormat" value="" />
    <input type="hidden" name="selectedIdsJson" id="invSelectedIdsJson" value="" />
</form>

<div id="invFloatingBar" style="display: none; position: fixed; bottom: 28px; left: 50%; transform: translateX(-50%); background: #1e293b; color: white; padding: 10px 22px; border-radius: 9999px; box-shadow: 0 12px 30px rgba(0,0,0,0.35); z-index: 1000; align-items: center; gap: 14px; border: 1px solid #334155;">
    <span id="invSelectedCount" style="font-weight: 700; font-size: 0.88rem; color: #38bdf8;">0 selected</span>
    <button type="button" class="button btn-primary small" onclick="exportSelected('default')" style="padding: 6px 14px; font-size: 0.82rem; border-radius: 9999px; font-weight: 600;">Download Excel (.xlsx)</button>
    <button type="button" class="button secondary small" onclick="exportSelected('taisys')" style="padding: 6px 14px; font-size: 0.82rem; border-radius: 9999px; background: #334155; color: white; border: 1px solid #475569; font-weight: 600;">Download Taisys Bulk</button>
    <button type="button" class="button ghost small" onclick="deselectAllInventory()" style="color: #94a3b8; border: none; font-size: 0.82rem; cursor: pointer; background: transparent;">Deselect</button>
</div>

@section Scripts {
    <script>
        function toggleDropdown(id) {
            event.stopPropagation();
            document.querySelectorAll('.dropdown-menu').forEach(el => {
                if (el.id !== id) el.style.display = 'none';
            });
            const el = document.getElementById(id);
            if (el) el.style.display = el.style.display === 'none' ? 'block' : 'none';
        }

        document.addEventListener('click', function(e) {
            if (!e.target.closest('.dropdown')) {
                document.querySelectorAll('.dropdown-menu').forEach(el => el.style.display = 'none');
            }
        });

        function toggleBatchSelectAll(masterCb, batchNo) {
            const isChecked = masterCb.checked;
            document.querySelectorAll('.inv-row-select[data-batch="' + batchNo + '"]').forEach(cb => {
                cb.checked = isChecked;
            });
            updateInventorySelectionBar();
        }

        function updateInventorySelectionBar() {
            const selected = document.querySelectorAll('.inv-row-select:checked');
            const bar = document.getElementById('invFloatingBar');
            const countEl = document.getElementById('invSelectedCount');
            if (selected.length > 0) {
                bar.style.display = 'flex';
                countEl.textContent = `${selected.length} device${selected.length > 1 ? 's' : ''} selected`;
            } else {
                bar.style.display = 'none';
            }
        }

        function deselectAllInventory() {
            document.querySelectorAll('.inv-row-select, .inv-batch-select-all').forEach(cb => cb.checked = false);
            updateInventorySelectionBar();
        }

        function showCheckboxWarning(message) {
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    icon: 'warning',
                    title: 'Selection Required',
                    text: message || 'Please select at least one device checkbox before downloading Taisys Bulk format.',
                    confirmButtonColor: '#2563eb'
                });
            } else {
                alert(message || 'Please select at least one device checkbox before downloading Taisys Bulk format.');
            }
        }

        function downloadBatchTaisys(batchNo) {
            const batchChecked = Array.from(document.querySelectorAll('.inv-row-select[data-batch="' + batchNo + '"]:checked')).map(cb => cb.value);
            if (batchChecked.length === 0) {
                showCheckboxWarning('Please select at least one device checkbox in batch ' + batchNo + ' before downloading Taisys Bulk format.');
                return;
            }
            document.getElementById('invSelectedBatch').value = batchNo;
            document.getElementById('invSelectedIdsJson').value = JSON.stringify(batchChecked);
            document.getElementById('invSelectedFormat').value = 'taisys';
            document.getElementById('inv-export-selected-form').submit();
        }

        function downloadAllTaisys() {
            const allChecked = Array.from(document.querySelectorAll('.inv-row-select:checked')).map(cb => cb.value);
            if (allChecked.length === 0) {
                showCheckboxWarning('Please select at least one device checkbox before downloading Taisys Bulk format.');
                return;
            }
            document.getElementById('invSelectedBatch').value = 'All';
            document.getElementById('invSelectedIdsJson').value = JSON.stringify(allChecked);
            document.getElementById('invSelectedFormat').value = 'taisys';
            document.getElementById('inv-export-selected-form').submit();
        }

        function exportSelected(format) {
            const selected = Array.from(document.querySelectorAll('.inv-row-select:checked')).map(cb => cb.value);
            if (selected.length === 0) {
                if (format === 'taisys') {
                    showCheckboxWarning('Please select at least one device checkbox before downloading Taisys Bulk format.');
                } else {
                    showCheckboxWarning('Please select at least one device checkbox to download.');
                }
                return;
            }
            document.getElementById('invSelectedBatch').value = 'Selected';
            document.getElementById('invSelectedIdsJson').value = JSON.stringify(selected);
            document.getElementById('invSelectedFormat').value = format;
            document.getElementById('inv-export-selected-form').submit();
        }

        function toggleBatch(headerEl) {
            const tableWrap = headerEl.nextElementSibling;
            const chevron = headerEl.querySelector('.batch-chevron');
            if (tableWrap && tableWrap.classList.contains('table-wrap')) {
                if (tableWrap.style.display === 'none') {
                    tableWrap.style.display = '';
                    chevron.style.transform = 'rotate(0deg)';
                } else {
                    tableWrap.style.display = 'none';
                    chevron.style.transform = 'rotate(-90deg)';
                }
            }
        }

        function toggleAllBatches() {
            const tableWraps = document.querySelectorAll('.inventory-container .table-wrap');
            const chevrons = document.querySelectorAll('.inventory-container .batch-chevron');
            const btn = document.getElementById('toggleAllBatchesBtn');
            const anyCollapsed = Array.from(tableWraps).some(tw => tw.style.display === 'none');
            
            tableWraps.forEach(tw => tw.style.display = anyCollapsed ? '' : 'none');
            chevrons.forEach(ch => ch.style.transform = anyCollapsed ? 'rotate(0deg)' : 'rotate(-90deg)');
            if (btn) btn.textContent = anyCollapsed ? 'Collapse all' : 'Expand all';
        }

        document.addEventListener("DOMContentLoaded", function() {
            const bulkForm = document.getElementById('bulk-update-form');
            if (!bulkForm) return;

            function syncStatuses() {
                // Clear any previously injected status inputs (leave __RequestVerificationToken intact)
                bulkForm.querySelectorAll('input[type="hidden"]:not([name="__RequestVerificationToken"])').forEach(el => el.remove());

                // Find only selects that were actually changed
                const selects = document.querySelectorAll('select[data-device-id]');
                let count = 0;
                selects.forEach(sel => {
                    const isChanged = sel.dataset.changed === 'true' || (sel.dataset.original && sel.value.toLowerCase() !== sel.dataset.original.toLowerCase());
                    if (isChanged) {
                        const hidden = document.createElement('input');
                        hidden.type = 'hidden';
                        hidden.name = 'statuses[' + sel.dataset.deviceId + ']';
                        hidden.value = sel.value;
                        bulkForm.appendChild(hidden);
                        count++;
                    }
                });
                return count;
            }

            bulkForm.addEventListener('submit', function() {
                syncStatuses();
            });

            // Attach click to Save statuses button
            const saveBtn = document.querySelector('button[form="bulk-update-form"]');
            if (saveBtn) {
                saveBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    const changedCount = syncStatuses();
                    if (changedCount === 0) {
                        if (typeof Swal !== 'undefined') {
                            Swal.fire({
                                toast: true,
                                position: 'bottom-end',
                                icon: 'info',
                                title: 'No status changes to save.',
                                showConfirmButton: false,
                                timer: 2500,
                                timerProgressBar: true
                            });
                        } else {
                            alert('No status changes to save.');
                        }
                        return;
                    }

                    saveBtn.disabled = true;
                    saveBtn.textContent = 'Saving...';
                    bulkForm.submit();
                });
            }
        });
    </script>
}
