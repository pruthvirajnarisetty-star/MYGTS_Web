@model InventoryViewModel
@{
    ViewData["Title"] = "Inventory";
    var currentBranch = Context.Request.Cookies["mygts_branch"] == "RTO" ? "RTO" : "DMG";
    var batchMap = ViewBag.BatchColorMap as Dictionary<string, int>;
    string GetBatchClass(string? invoiceId) => MygtsMvc.Services.BatchColorHelper.GetBatchClass(invoiceId, batchMap);
    var isSearchActive = !string.IsNullOrWhiteSpace(Model.Query);
}

<style>
    .bg-new { background-color: #e0e7ff !important; color: #4338ca !important; border-color: #c7d2fe !important; }
    .bg-activated { background-color: #e0f2fe !important; color: #0369a1 !important; border-color: #7dd3fc !important; }
    .bg-used { background-color: #eef9f0 !important; color: #176b35 !important; border-color: #a7d7b5 !important; }
    .bg-dead { background-color: #fff1f0 !important; color: var(--danger) !important; border-color: #f1bbb5 !important; }
    .bg-error { background-color: #fff1f0 !important; color: var(--danger) !important; border-color: #f1bbb5 !important; }

    body:has(#theme:checked) .bg-new { background-color: #1e1b4b !important; color: #a5b4fc !important; border-color: #4f46e5 !important; font-weight: 700 !important; }
    body:has(#theme:checked) .bg-activated { background-color: #082f49 !important; color: #38bdf8 !important; border-color: #0284c7 !important; font-weight: 700 !important; }
    body:has(#theme:checked) .bg-used { background-color: #14532d !important; color: #4ade80 !important; border-color: #22c55e !important; font-weight: 700 !important; }
    body:has(#theme:checked) .bg-dead, body:has(#theme:checked) .bg-error { background-color: #450a0a !important; color: #f87171 !important; border-color: #ef4444 !important; font-weight: 700 !important; }

    .pill-activated { background: #e0f2fe; color: #0369a1; font-weight: 700; font-size: 0.78rem; padding: 2px 10px; border-radius: 9999px; border: 1px solid #7dd3fc; display: inline-flex; align-items: center; gap: 4px; }
    .batch-count-pill.pill-activated { background: #e0f2fe; color: #0369a1; font-weight: 700; font-size: 0.76rem; padding: 2px 8px; border-radius: 9999px; border: 1px solid #7dd3fc; display: inline-flex; align-items: center; gap: 3px; }

    body:has(#theme:checked) .pill-activated,
    body:has(#theme:checked) .batch-count-pill.pill-activated {
        background: #082f49 !important;
        color: #38bdf8 !important;
        border-color: #0284c7 !important;
    }

    body:has(#theme:checked) .inventory-container .card {
        background-color: #0b0f19 !important;
        border-color: #1e293b !important;
    }
    body:has(#theme:checked) .inventory-container .section-heading {
        background: #151e2e !important;
        border-bottom: 1px solid #1e293b !important;
    }
    body:has(#theme:checked) .inventory-container .section-heading h2 {
        color: #f8fafc !important;
    }
    body:has(#theme:checked) .inventory-container .section-heading p {
        color: #94a3b8 !important;
    }
    body:has(#theme:checked) .inventory-container .section-heading p strong {
        color: #e2e8f0 !important;
    }
    body:has(#theme:checked) .inventory-container .button.secondary {
        background: #1e293b !important;
        color: #e2e8f0 !important;
        border-color: #475569 !important;
    }
    body:has(#theme:checked) .inventory-container .button.secondary:hover {
        background: #334155 !important;
        color: #ffffff !important;
    }
    body:has(#theme:checked) .inventory-container .serial-range-badge {
        background: rgba(56, 189, 248, 0.12) !important;
        color: #38bdf8 !important;
        border: 1px solid rgba(56, 189, 248, 0.25) !important;
    }
    body:has(#theme:checked) .inventory-container .data-table tr.colored-row td {
        background-color: var(--row-bg, #0b0f19) !important;
        color: #f8fafc !important;
    }
    body:has(#theme:checked) .inventory-container .data-table tr.colored-row:hover td {
        background-color: var(--row-hover-bg, #1e293b) !important;
    }
    body:has(#theme:checked) .inventory-container select.select {
        border-radius: 6px;
    }
    body:has(#theme:checked) .inventory-container select.select option {
        background-color: #0f172a !important;
        color: #f8fafc !important;
    }
    body:has(#theme:checked) .inventory-container .data-table td span {
        color: #e2e8f0 !important;
    }
    body:has(#theme:checked) .pill-used {
        background: rgba(22, 101, 52, 0.35) !important;
        color: #4ade80 !important;
        border-color: rgba(74, 222, 128, 0.4) !important;
    }
    body:has(#theme:checked) .pill-unused {
        background: rgba(180, 83, 9, 0.35) !important;
        color: #fde047 !important;
        border-color: rgba(253, 224, 71, 0.4) !important;
    }
    body:has(#theme:checked) .pill-dead {
        background: rgba(185, 28, 28, 0.35) !important;
        color: #f87171 !important;
        border-color: rgba(248, 113, 113, 0.4) !important;
    }
</style>

<div class="page-heading">
    <div>
        <div class="eyebrow">Fleet management</div>
        <h1>Inventory</h1>
        <p>Manage new devices before they are deployed to the field.</p>
    </div>
    <form id="bulk-update-form" asp-action="BulkUpdateStatus" method="post" style="display: none;"></form>
    <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
        <div class="dropdown" style="position: relative; display: inline-block;">
            <button type="button" class="button secondary" onclick="toggleDropdown('downloadAllDropdown')" style="display: flex; align-items: center; gap: 6px; font-weight: 600;">
                <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                <span>Download all batches</span>
                <svg width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </button>
            <div id="downloadAllDropdown" class="dropdown-menu" style="display: none; position: absolute; right: 0; top: 100%; margin-top: 6px; background: var(--paper, #fff); border: 1px solid var(--line, #e2e8f0); border-radius: 8px; box-shadow: 0 10px 25px rgba(0,0,0,0.15); min-width: 230px; z-index: 100; overflow: hidden; text-align: left;">
                <a href="/Inventory/ExportAllBatches" class="dropdown-item" style="display: flex; align-items: center; gap: 8px; padding: 10px 14px; color: var(--text-main); text-decoration: none; font-size: 0.85rem; border-bottom: 1px solid var(--line, #e2e8f0);">
                    <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                    <span>Excel (.xlsx - All sheets)</span>
                </a>
                <a href="javascript:void(0)" onclick="downloadAllTaisys()" class="dropdown-item" style="display: flex; align-items: center; gap: 8px; padding: 10px 14px; color: var(--text-main); text-decoration: none; font-size: 0.85rem;">
                    <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
                    <span>Taisys Bulk Format (.xlsx)</span>
                </a>
            </div>
        </div>
        @if (User.CanEditModule("Inventory"))
        {
            <button type="submit" form="bulk-update-form" class="button secondary">Save statuses</button>
            <a class="button btn-primary" asp-controller="Devices" asp-action="Create" asp-route-returnUrl="/Inventory">+ Add device</a>
        }
    </div>
</div>

<form class="card toolbar" method="get" asp-action="Index" style="margin-top: 24px; padding: 12px 20px;">
    <div class="filter-grid" style="display: flex; gap: 16px; align-items: flex-end;">
    <div class="field grow" style="margin: 0; flex-grow: 1;">
        <label for="QueryInput" class="form-label" style="margin-bottom: 4px; display: block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-main);">SEARCH INVENTORY</label>
        <div style="position: relative; width: 100%;">
            <button type="button" style="position: absolute; top: 50%; transform: translateY(-50%); left: 16px; padding: 0; background: transparent; border: none; display: flex; align-items: center; justify-content: center;">
                <svg width="17" height="16" fill="none" xmlns="http://www.w3.org/2000/svg" style="width: 20px; height: 20px; color: #4b5563;">
                    <path d="M7.667 12.667A5.333 5.333 0 107.667 2a5.333 5.333 0 000 10.667zM14.334 14l-2.9-2.9" stroke="currentColor" stroke-width="1.333" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
            </button>
            <input type="hidden" asp-for="Query" id="Query" />
            <input id="QueryInput" name="QueryInput" class="input shadow-md w-full" style="padding: 0 44px; border-radius: 9999px; height: 42px; width: 100%; border: 1px solid var(--line); outline: none; transition: all 0.3s; font-size: 14px;" placeholder="Add a filter..." type="text" onfocus="this.style.borderColor='#3b82f6'" onblur="this.style.borderColor='var(--line)'" />
            <button type="button" onclick="document.getElementById('QueryInput').value=''; document.getElementById('Query').value=''; this.closest('form').submit();" style="position: absolute; top: 50%; transform: translateY(-50%); right: 12px; padding: 0; background: transparent; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center;">
                <svg xmlns="http://www.w3.org/2000/svg" style="width: 20px; height: 20px; color: #4b5563;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>
    </div>
        
    <div class="field" style="margin: 0;">
        <button class="button btn-primary" type="submit" style="height: 42px; border-radius: 8px; padding: 0 24px;">Search</button>
    </div>
    </div>
    @{
        var queryTerms = string.IsNullOrWhiteSpace(Model.Query) ? Array.Empty<string>() : Model.Query.Trim().Split('|', StringSplitOptions.RemoveEmptyEntries);
    }
    @if (queryTerms.Length > 0)
    {
        <div class="flex flex-wrap gap-2 mt-4" style="padding-bottom: 8px; width: 100%;">
            @foreach (var term in queryTerms)
            {
                <span class="inline-flex items-center gap-1 px-3 py-1 text-sm bg-white border border-dashed border-gray-400 rounded-full text-gray-700">
                    @term
                    <button type="button" onclick="removeChip('@term')" class="text-gray-400 hover:text-gray-700">
                        <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </button>
                </span>
            }
        </div>
    }
</form>

<script>
    document.querySelector('form.toolbar').addEventListener('submit', function(e) {
        var queryInput = document.getElementById('QueryInput');
        var queryHidden = document.getElementById('Query');
        if (queryInput && queryInput.value.trim() !== '') {
            var current = queryHidden.value ? queryHidden.value + '|' : '';
            queryHidden.value = current + queryInput.value.trim();
            queryInput.value = ''; // Don't submit the visual input
        }
    });

    function removeChip(term) {
        var queryHidden = document.getElementById('Query');
        var terms = queryHidden.value.split('|').filter(t => t !== '' && t !== term);
        queryHidden.value = terms.join('|');
        document.querySelector('form.toolbar').submit();
    }
</script>

@{
    bool IsUsed(DeviceRecord d) =>
        !string.IsNullOrWhiteSpace(d.VehicleNo) &&
        !string.Equals(d.StockStatus, "Dead", StringComparison.OrdinalIgnoreCase) &&
        !string.Equals(d.StockStatus, "Error", StringComparison.OrdinalIgnoreCase);

    bool IsDead(DeviceRecord d) =>
        string.Equals(d.StockStatus, "Dead", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(d.StockStatus, "Error", StringComparison.OrdinalIgnoreCase);

    bool IsActivated(DeviceRecord d) =>
        !IsUsed(d) && !IsDead(d) &&
        (string.Equals(d.StockStatus, "Activated", StringComparison.OrdinalIgnoreCase) ||
         string.Equals(d.StockStatus, "Used", StringComparison.OrdinalIgnoreCase) ||
         !string.IsNullOrWhiteSpace(d.ActivationDate));

    bool IsUnused(DeviceRecord d) =>
        !IsUsed(d) && !IsActivated(d) && !IsDead(d);

    var allInventoryDevices = Model.Batches.SelectMany(b => b.Devices).ToList();
    var grandTotalUnits = allInventoryDevices.Count;
    var grandTotalUsed = allInventoryDevices.Count(IsUsed);
    var grandTotalActivated = allInventoryDevices.Count(IsActivated);
    var grandTotalDead = allInventoryDevices.Count(IsDead);
    var grandTotalUnused = allInventoryDevices.Count(IsUnused);
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-top: 24px; margin-bottom: -16px; flex-wrap: wrap; gap: 12px;">
    <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
        <span style="font-size: 0.88rem; color: var(--muted); font-weight: 700;">@Model.Batches.Count batches (collapsed by default)</span>
        <span style="height: 14px; width: 1px; background: var(--line);"></span>
        <span style="font-size: 0.84rem; color: var(--text-main); font-weight: 600;">@grandTotalUnits total devices:</span>
        <span class="pill-used" style="background: #dcfce7; color: #15803d; font-weight: 700; font-size: 0.78rem; padding: 2px 10px; border-radius: 9999px; border: 1px solid #86efac; display: inline-flex; align-items: center; gap: 4px;" title="@grandTotalUsed used and deployed on vehicles">
            ✓ @grandTotalUsed Used
        </span>
        @if (grandTotalActivated > 0)
        {
            <span class="pill-activated" title="@grandTotalActivated activated devices awaiting deployment">
                ⚡ @grandTotalActivated Activated
            </span>
        }
        else
        {
            <span class="pill-activated" style="background: #f1f5f9; color: #64748b; font-weight: 600; font-size: 0.78rem; padding: 2px 10px; border-radius: 9999px; border: 1px solid #e2e8f0; display: inline-flex; align-items: center; gap: 4px;">
                0 Activated
            </span>
        }
        @if (grandTotalUnused > 0)
        {
            <span class="pill-unused" style="background: #fef3c7; color: #b45309; font-weight: 700; font-size: 0.78rem; padding: 2px 10px; border-radius: 9999px; border: 1px solid #fde047; display: inline-flex; align-items: center; gap: 4px;" title="@grandTotalUnused unused devices across batches">
                ⚠ @grandTotalUnused Unused
            </span>
        }
        else
        {
            <span class="pill-unused" style="background: #f1f5f9; color: #64748b; font-weight: 600; font-size: 0.78rem; padding: 2px 10px; border-radius: 9999px; border: 1px solid #e2e8f0; display: inline-flex; align-items: center; gap: 4px;">
                0 Unused
            </span>
        }
        @if (grandTotalDead > 0)
        {
            <span class="pill-dead" style="background: #fee2e2; color: #b91c1c; font-weight: 700; font-size: 0.78rem; padding: 2px 10px; border-radius: 9999px; border: 1px solid #fca5a5; display: inline-flex; align-items: center; gap: 4px;">
                ✕ @grandTotalDead Dead/Error
            </span>
        }
    </div>
    <button type="button" class="button secondary small" onclick="toggleAllBatches()" id="toggleAllBatchesBtn" style="font-size: 0.8rem; padding: 4px 12px; border-radius: 6px;">
        @(isSearchActive ? "Collapse all" : "Expand all")
    </button>
</div>

<div class="inventory-container" style="display: flex; flex-direction: column; gap: 32px; margin-top: 24px;">
    @if (Model.Batches.Count == 0)
    {
        <div class="card" style="padding: 40px; text-align: center; color: var(--muted);">
            No new devices found in inventory.
        </div>
    }

    @foreach (var batch in Model.Batches)
    {
        var batchClass = GetBatchClass(batch.InvoiceNo);
        var batchUsed = batch.Devices.Count(IsUsed);
        var batchActivated = batch.Devices.Count(IsActivated);
        var batchDead = batch.Devices.Count(IsDead);
        var batchUnused = batch.Devices.Count(IsUnused);

        <section class="card @batchClass" style="background-color: var(--batch-bg, var(--paper)); overflow: hidden; border: 1px solid var(--batch-border, var(--line));">
            <div class="section-heading" style="padding: 16px 20px; margin: 0; background: var(--batch-pill-bg, rgba(255, 255, 255, 0.4)); border-bottom: 1px solid var(--batch-border, rgba(0,0,0,0.05)); cursor: pointer;" onclick="toggleBatch(this)">
                <div style="display: flex; align-items: center; gap: 12px;">
                    <svg class="batch-chevron" style="transition: transform 0.2s; transform: @(isSearchActive ? "rotate(0deg)" : "rotate(-90deg)");" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                    <div>
                        <h2 style="font-size: 1.1rem; margin-bottom: 4px;">
                            Batch: @batch.InvoiceNo
                            @if (MygtsMvc.Services.BatchColorHelper.RtoInvoiceToBatchMap.TryGetValue(batch.InvoiceNo, out var bAlias))
                            {
                                <span style="font-size: 0.85rem; color: var(--muted); font-weight: 500;">(@bAlias)</span>
                            }
                            @if (batch.Devices.Count > 0)
                            {
                                var sorted = batch.Devices.OrderBy(d => d.SlNoSortable).ToList();
                                <span class="serial-range-badge" style="color: var(--text-main); font-size: 0.95rem; font-weight: 700; margin-left: 8px; background: rgba(0,0,0,0.06); padding: 2px 8px; border-radius: 4px;">
                                    S.No. @sorted.First().SlNo - @sorted.Last().SlNo
                                </span>
                            }
                        </h2>
                        <p style="font-size: 0.85rem; color: var(--muted); margin: 0; display: flex; align-items: center; flex-wrap: wrap; gap: 6px;">
                            <span>Date: @(batch.Date == "9999-12-31" ? "Unknown" : DateValue.Short(batch.Date))</span>
                            <span>&nbsp;&middot;&nbsp;</span>
                            <span>Device type: <strong>@(string.IsNullOrWhiteSpace(batch.DeviceType) ? (batch.Devices.FirstOrDefault(d => !string.IsNullOrWhiteSpace(d.DeviceName))?.DeviceName ?? "Unknown") : batch.DeviceType)</strong></span>
                            <span>&nbsp;&middot;&nbsp;</span>
                            <span><strong>@batch.Devices.Count</strong> units</span>
                            <span>&bull;</span>
                            <span class="batch-count-pill pill-used" style="background: #dcfce7; color: #15803d; font-weight: 700; font-size: 0.76rem; padding: 2px 8px; border-radius: 9999px; border: 1px solid #86efac; display: inline-flex; align-items: center; gap: 3px;" title="@batchUsed used devices">
                                ✓ @batchUsed used
                            </span>
                            @if (batchActivated > 0)
                            {
                                <span class="batch-count-pill pill-activated" title="@batchActivated activated devices awaiting deployment">
                                    ⚡ @batchActivated activated
                                </span>
                            }
                            else
                            {
                                <span class="batch-count-pill pill-activated" style="background: #f1f5f9; color: #64748b; font-weight: 600; font-size: 0.76rem; padding: 2px 8px; border-radius: 9999px; border: 1px solid #e2e8f0; display: inline-flex; align-items: center; gap: 3px;">
                                    0 activated
                                </span>
                            }
                            @if (batchUnused > 0)
                            {
                                <span class="batch-count-pill pill-unused" style="background: #fef3c7; color: #b45309; font-weight: 700; font-size: 0.76rem; padding: 2px 8px; border-radius: 9999px; border: 1px solid #fde047; display: inline-flex; align-items: center; gap: 3px;" title="@batchUnused unused devices in batch @batch.InvoiceNo">
                                    ⚠ @batchUnused unused
                                </span>
                            }
                            else
                            {
                                <span class="batch-count-pill pill-unused" style="background: #f1f5f9; color: #64748b; font-weight: 600; font-size: 0.76rem; padding: 2px 8px; border-radius: 9999px; border: 1px solid #e2e8f0; display: inline-flex; align-items: center; gap: 3px;">
                                    0 unused
                                </span>
                            }
                            @if (batchDead > 0)
                            {
                                <span class="batch-count-pill pill-dead" style="background: #fee2e2; color: #b91c1c; font-weight: 700; font-size: 0.76rem; padding: 2px 8px; border-radius: 9999px; border: 1px solid #fca5a5; display: inline-flex; align-items: center; gap: 3px;">
                                    ✕ @batchDead dead
                                </span>
                            }
                        </p>
                    </div>
                </div>
                <div style="display: flex; gap: 8px; align-items: center;" onclick="event.stopPropagation();">
                    <div class="dropdown" style="position: relative; display: inline-block;">
                        <button type="button" class="button secondary small" onclick="toggleDropdown('batchDrop_@batch.InvoiceNo')" style="font-size: 0.8rem; padding: 4px 10px; display: inline-flex; align-items: center; gap: 4px;" title="Download batch @batch.InvoiceNo">
                            <svg width="13" height="13" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                            <span>Download</span>
                            <svg width="10" height="10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                        </button>
                        <div id="batchDrop_@batch.InvoiceNo" class="dropdown-menu" style="display: none; position: absolute; right: 0; top: 100%; margin-top: 4px; background: var(--paper, #fff); border: 1px solid var(--line, #e2e8f0); border-radius: 6px; box-shadow: 0 8px 20px rgba(0,0,0,0.12); min-width: 180px; z-index: 50; text-align: left;">
                            <a href="/Inventory/ExportBatch?invoiceNo=@batch.InvoiceNo" class="dropdown-item" style="display: block; padding: 8px 12px; color: var(--text-main); text-decoration: none; font-size: 0.8rem; border-bottom: 1px solid var(--line, #e2e8f0);">Batch Excel (.xlsx)</a>
                            <a href="javascript:void(0)" onclick="downloadBatchTaisys('@batch.InvoiceNo')" class="dropdown-item" style="display: block; padding: 8px 12px; color: var(--text-main); text-decoration: none; font-size: 0.8rem;">Taisys Bulk (.xlsx)</a>
                        </div>
                    </div>
                    @if (User.CanEditModule("Inventory"))
                    {
                        @if (!string.IsNullOrWhiteSpace(batch.InvoiceId))
                        {
                            <a class="button secondary small" asp-controller="Invoices" asp-action="Edit" asp-route-id="@batch.InvoiceId" style="font-size: 0.8rem; padding: 4px 10px;" title="Edit invoice @batch.InvoiceNo">Edit Invoice</a>
                        }
                        else
                        {
                            <a class="button secondary small" asp-controller="Invoices" asp-action="EditByBatch" asp-route-batch="@batch.InvoiceNo" style="font-size: 0.8rem; padding: 4px 10px;" title="Edit invoice @batch.InvoiceNo">Edit Invoice</a>
                        }
                        <a class="button secondary small" asp-controller="Invoices" asp-action="Create" asp-route-mode="multiple" asp-route-addon="true" asp-route-batch="@batch.InvoiceNo" style="font-size: 0.8rem; padding: 4px 10px;" title="Add more devices to batch @batch.InvoiceNo">+ Add devices</a>
                        <form asp-action="DeleteBatch" method="post" style="margin: 0;">
                            <input type="hidden" name="invoiceNo" value="@batch.InvoiceNo" />
                            <button type="submit" class="button ghost small" style="color: var(--danger); border-color: rgba(180, 35, 24, 0.3); background: transparent;" onclick="return confirmDoubleDelete(event, 'entire batch')">Delete Batch</button>
                        </form>
                    }
                </div>
            </div>

            <div class="table-wrap" style="@(isSearchActive ? "" : "display: none;")">
                @{
                    var isWeTrackBatch = string.Equals(batch.DeviceType, "WeTrack", StringComparison.OrdinalIgnoreCase)
                        || batch.Devices.Any(d => string.Equals(d.DeviceName, "WeTrack", StringComparison.OrdinalIgnoreCase));
                    var isOldBatch = batch.InvoiceNo.StartsWith("old_", StringComparison.OrdinalIgnoreCase)
                        || string.Equals(batch.DeviceType, "Wetrack140", StringComparison.OrdinalIgnoreCase)
                        || string.Equals(batch.DeviceType, "Teltonika", StringComparison.OrdinalIgnoreCase)
                        || batch.Devices.Any(d => string.Equals(d.DeviceName, "Wetrack140", StringComparison.OrdinalIgnoreCase));
                    var showOperatorCol = isWeTrackBatch && !isOldBatch;
                }
                <table class="data-table">
                    <thead>
                        <tr>
                            <th style="width: 44px; text-align: center;"><input type="checkbox" class="inv-batch-select-all" data-batch="@batch.InvoiceNo" title="Select all in batch" onclick="event.stopPropagation();" onchange="toggleBatchSelectAll(this, '@batch.InvoiceNo')" style="cursor: pointer; width: 15px; height: 15px;" /></th>
                            <th style="width: 70px;">S.No.</th>
                            <th style="min-width: 170px;">IMEI</th>
                            <th style="min-width: 190px;">ICCID</th>
                            @if (showOperatorCol)
                            {
                                <th style="min-width: 140px;">Network Operator</th>
                            }
                            @if (currentBranch == "RTO")
                            {
                                <th style="min-width: 150px;">Device Serial No</th>
                            }
                            <th style="min-width: 150px;">Device Sim (Airtel)</th>
                            <th style="min-width: 150px;">Device Sim (BSNL)</th>
                            <th style="width: 250px; text-align: right; padding-right: 20px;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var device in batch.Devices)
                        {
                            var isDevUsed = IsUsed(device);
                            var isDevDead = IsDead(device);
                            var isDevActivated = IsActivated(device);
                            var rowStatusKey = isDevDead ? device.StockStatus.ToLowerInvariant() : (isDevUsed ? "used" : (isDevActivated ? "activated" : "new"));
                            var rowClass = $"row-status-{rowStatusKey}";
                            var selectVal = isDevDead ? device.StockStatus : (isDevActivated || isDevUsed ? "Activated" : "New");
                            var selectBgClass = isDevDead ? $"bg-{device.StockStatus.ToLowerInvariant()}" : (isDevActivated ? "bg-activated" : (isDevUsed ? "bg-used" : "bg-new"));
                            <tr class="colored-row @rowClass" style="--default-bg: var(--batch-bg, var(--paper)); --default-hover: var(--batch-hover, var(--soft));">
                                <td style="text-align: center;">
                                    <input type="checkbox" class="inv-row-select" value="@device.Id" data-batch="@batch.InvoiceNo" onchange="updateInventorySelectionBar()" style="cursor: pointer; width: 15px; height: 15px;" />
                                </td>
                                <td style="color: var(--muted); font-size: 0.75rem;">@device.SlNo</td>
                                <td>
                                    @(string.IsNullOrEmpty(device.Imei) ? "—" : device.Imei)
                                </td>
                                <td>
                                    <strong>@(string.IsNullOrEmpty(device.Iccid) ? "—" : device.Iccid)</strong>
                                </td>
                                @if (showOperatorCol)
                                {
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(device.NetworkOperator))
                                        {
                                            if (device.NetworkOperator.Contains("BABU", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <div style="display: inline-flex; align-items: center; gap: 6px;">
                                                    <span class="badge" style="font-size: 0.75rem; font-weight: 600; padding: 2px 7px; border-radius: 4px; background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe;">Taisys</span>
                                                    <span class="badge" style="font-size: 0.7rem; font-weight: 700; padding: 2px 6px; border-radius: 4px; background: #fef3c7; color: #92400e; border: 1px solid #fde68a; letter-spacing: 0.5px;">BABU</span>
                                                </div>
                                            }
                                            else if (device.NetworkOperator.Contains("MYGTS", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <div style="display: inline-flex; align-items: center; gap: 6px;">
                                                    <span class="badge" style="font-size: 0.75rem; font-weight: 600; padding: 2px 7px; border-radius: 4px; background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe;">Taisys</span>
                                                    <span class="badge" style="font-size: 0.7rem; font-weight: 700; padding: 2px 6px; border-radius: 4px; background: #f0fdf4; color: #166534; border: 1px solid #bbf7d0; letter-spacing: 0.5px;">MYGTS</span>
                                                </div>
                                            }
                                            else if (device.NetworkOperator.Equals("Sensorise", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="badge" style="font-size: 0.75rem; font-weight: 600; padding: 2px 7px; border-radius: 4px; background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0;">Sensorise</span>
                                            }
                                            else
                                            {
                                                <span class="badge" style="font-size: 0.75rem; font-weight: 600; padding: 2px 7px; border-radius: 4px; background: #f3f4f6; color: #374151; border: 1px solid #e5e7eb;">@device.NetworkOperator</span>
                                            }
                                        }
                                        else
                                        {
                                            <span style="color: var(--muted); opacity: 0.5;">—</span>
                                        }
                                    </td>
                                }
                                @if (currentBranch == "RTO")
                                {
                                    <td>
                                        @(string.IsNullOrEmpty(device.DeviceSerialNo) ? "—" : device.DeviceSerialNo)
                                    </td>
                                }
                                <td>
                                    @(string.IsNullOrEmpty(device.SimAirtel) ? "—" : device.SimAirtel)
                                </td>
                                <td>
                                    @(string.IsNullOrEmpty(device.SimBsnl) ? "—" : device.SimBsnl)
                                </td>
                                <td style="text-align: right; padding-right: 20px;">
                                    <div style="display: flex; gap: 8px; align-items: center; justify-content: flex-end;">
                                        @if (User.CanEditModule("Inventory"))
                                        {
                                                <select data-device-id="@device.Id"
                                                        data-original="@selectVal"
                                                        class="select @selectBgClass"
                                                        required
                                                        style="padding: 6px 12px; min-height: 0; font-size: 0.85rem; width: auto; font-weight: 600;"
                                                        onchange="this.className = 'select bg-' + this.value.toLowerCase(); this.dataset.changed = 'true';">
                                                    <option value="New" selected="@(selectVal == "New" ? "selected" : null)">New</option>
                                                    <option value="Activated" selected="@(selectVal == "Activated" ? "selected" : null)">Activated</option>
                                                    <option value="Dead" selected="@(string.Equals(device.StockStatus, "Dead", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Dead</option>
                                                    <option value="Error" selected="@(string.Equals(device.StockStatus, "Error", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Error</option>
                                                </select>

                                            @if (isDevUsed)
                                            {
                                                <span class="badge" style="font-weight: 700; font-size: 0.78rem; background: #dcfce7; color: #15803d; border: 1px solid #86efac; padding: 4px 8px; border-radius: 6px; white-space: nowrap;" title="Device assigned to vehicle @device.VehicleNo">
                                                    ✓ Used (@device.VehicleNo)
                                                </span>
                                            }
                                            else
                                            {
                                                <a class="button small btn-primary" asp-controller="Devices" asp-action="Edit" asp-route-id="@device.Id" asp-route-returnUrl="/Inventory" style="white-space: nowrap; font-size: 0.8rem; padding: 4px 12px; border-radius: 6px;" title="Assign vehicle and deploy device">Use</a>
                                            }

                                            <form asp-action="DeleteDevice" method="post" style="margin: 0;">
                                                <input type="hidden" name="id" value="@device.Id" />
                                                <button type="submit" class="button ghost small" style="color: var(--danger); border-color: transparent; padding: 0 6px; background: transparent;" onclick="return confirmDoubleDelete(event, 'device')" title="Delete Device">
                                                    <svg height="17" width="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            @if (isDevUsed)
                                            {
                                                <span class="badge" style="font-weight: 700; font-size: 0.78rem; background: #dcfce7; color: #15803d; border: 1px solid #86efac; padding: 4px 8px; border-radius: 6px;">Used (@device.VehicleNo)</span>
                                            }
                                            else if (isDevActivated)
                                            {
                                                <span class="badge bg-activated" style="font-weight: 700; font-size: 0.78rem; padding: 4px 8px; border-radius: 6px;">Activated</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-@(device.StockStatus.ToLowerInvariant())">@device.StockStatus</span>
                                            }
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>


<script>
    function confirmDoubleDelete(event, itemType) {
        if (!confirm(`Are you sure you want to delete this ${itemType}?`)) {
            event.preventDefault();
            return false;
        }
        if (!confirm(`Are you ABSOLUTELY sure? This ${itemType} will be permanently removed and cannot be undone.`)) {
            event.preventDefault();
            return false;
        }
        return true;
    }
</script>

<style>
.editBtn {
  width: 42px;
  height: 42px;
  border-radius: 12px;
  border: none;
  background-color: var(--blue-600);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0px 5px 10px rgba(15, 98, 254, 0.2);
  cursor: pointer;
  position: relative;
  overflow: hidden;
  transition: all 0.3s;
}
.editBtn::before {
  content: "";
  width: 200%;
  height: 200%;
  background-color: var(--blue-500);
  position: absolute;
  z-index: 1;
  transform: scale(0);
  transition: all 0.3s;
  border-radius: 50%;
  filter: blur(10px);
}
.editBtn:hover::before {
  transform: scale(1);
}
.editBtn:hover {
  box-shadow: 0px 5px 10px rgba(15, 98, 254, 0.4);
}

.editBtn svg {
  height: 16px;
  fill: white;
  z-index: 3;
  transition: all 0.2s;
  transform-origin: bottom;
}
.editBtn:hover svg {
  transform: rotate(-15deg) translateX(5px);
}
.editBtn::after {
  content: "";
  width: 20px;
  height: 1.5px;
  position: absolute;
  bottom: 12px;
  left: -5px;
  background-color: white;
  border-radius: 2px;
  z-index: 2;
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.5s ease-out;
}
.editBtn:hover::after {
  transform: scaleX(1);
  left: 0px;
  transform-origin: right;
}

