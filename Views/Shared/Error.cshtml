@model ErrorViewModel
@{
    Layout = null;
    ViewData["Title"] = "Application Error";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Application Notice · MYGTS</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2" />
    <link rel="shortcut icon" href="/favicon.ico?v=2" />
    <link rel="stylesheet" href="/css/site.css" />
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background: #0f172a;
            color: #f8fafc;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
        }
        .error-card {
            background: #1e293b;
            border: 1px solid #334155;
            border-radius: 12px;
            padding: 36px 40px;
            max-width: 580px;
            width: 90%;
            box-shadow: 0 10px 40px rgba(0,0,0,0.4);
        }
        .eyebrow {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: #94a3b8;
            margin-bottom: 8px;
        }
        h1 {
            font-size: 1.8rem;
            margin: 0 0 16px;
            color: #f1f5f9;
        }
        p {
            font-size: 0.92rem;
            color: #cbd5e1;
            line-height: 1.5;
            margin: 0 0 16px;
        }
        .alert-box {
            background: #450a0a;
            border: 1px solid #7f1d1d;
            border-radius: 8px;
            padding: 12px 14px;
            color: #fecaca;
            font-size: 0.82rem;
            font-family: monospace;
            word-break: break-all;
            margin-bottom: 20px;
        }
        .actions {
            display: flex;
            gap: 12px;
            margin-top: 24px;
        }
        .btn {
            display: inline-block;
            padding: 10px 18px;
            border-radius: 6px;
            font-size: 0.88rem;
            font-weight: 500;
            text-decoration: none;
            cursor: pointer;
        }
        .btn-primary {
            background: #2563eb;
            color: #ffffff;
            border: none;
        }
        .btn-secondary {
            background: #334155;
            color: #e2e8f0;
            border: 1px solid #475569;
        }
    </style>
</head>
<body>
    <div class="error-card">
        <div class="eyebrow">MYGTS Fleet intelligence / System Notice</div>
        <h1>Something went wrong</h1>
        <p>The application encountered an issue while processing your request.</p>
        
        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert-box">
                @Model.ErrorMessage
            </div>
        }

        @if (Model.ShowRequestId)
        {
            <p style="font-size: 0.76rem; color: #64748b; font-family: monospace;">
                Trace ID: @Model.RequestId
            </p>
        }

        <div class="actions">
            <a href="/Account/Login" class="btn btn-primary">Return to Sign in</a>
            <a href="/Dashboard" class="btn btn-secondary">Try Dashboard</a>
        </div>
    </div>
</body>
</html>
