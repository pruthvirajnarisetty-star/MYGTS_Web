@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
    ViewData["BodyClass"] = "form-background-container";
}

<div class="public-shell" style="display: flex; align-items: center; justify-content: center; min-height: 100vh; background: url('/login_page_MYGTS.svg') center/cover no-repeat; padding: 20px; box-sizing: border-box;">
    
    <section class="public-form-panel" style="background: #ffffff; border-radius: 16px; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2); padding: clamp(32px, 5vw, 48px); width: 100% !important; max-width: 480px !important; min-width: min(100%, 480px) !important; flex: 0 0 auto; box-sizing: border-box; min-height: auto;">
        <div class="login-card" style="width: 100%; box-sizing: border-box;">
            <a class="brand-lockup" asp-controller="Home" asp-action="Index" style="color: #111; margin-bottom: 40px; justify-content: center; display: flex;">
                <img src="/images/logo.jpg" alt="MYGTS Logo" style="height: 40px; border-radius: 4px; margin-right: 12px;" />
                <span><strong style="color: #111;">MYGTS</strong><small style="color: rgba(0,0,0,0.6);">Fleet intelligence</small></span>
            </a>
            
            <h1 style="color: #111; text-align: center; margin-bottom: 8px; font-size: 2.2rem;">Welcome back.</h1>
            <p class="lede" style="color: rgba(0,0,0,0.6); text-align: center; margin-bottom: 20px;">Sign in to your operating view.</p>

            <!-- Database Connectivity Status Indicator (Only shown on error) -->
            @if (!Model.IsDatabaseConnected)
            {
                <div id="db-connection-status" style="margin-bottom: 24px;">
                    <div style="display: flex; flex-direction: column; gap: 6px; background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; padding: 12px 14px; font-size: 0.85rem; color: #991b1b;">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <span style="display: inline-block; width: 9px; height: 9px; border-radius: 50%; background: #ef4444; box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.25);"></span>
                            <strong style="font-weight: 600;">Database Not Connected</strong>
                        </div>
                        <div style="font-size: 0.78rem; color: #b91c1c; line-height: 1.4;">
                            @(string.IsNullOrWhiteSpace(Model.DatabaseStatusMessage) ? "Unable to open database. Check file existence and IIS permissions." : Model.DatabaseStatusMessage)
                        </div>
                        @if (!string.IsNullOrEmpty(Model.DatabasePath))
                        {
                            <div style="font-size: 0.72rem; color: #7f1d1d; font-family: monospace; word-break: break-all; margin-top: 2px;">
                                Target: @Model.DatabasePath
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Session Expiry / Kicked Notice -->
            @if (Context.Request.Query["reason"] == "kicked")
            {
                <div style="background: #fffbeb; border: 1px solid #fde68a; border-left: 4px solid #f59e0b; border-radius: 8px; padding: 12px 14px; margin-bottom: 20px; color: #92400e; font-size: 0.86rem; line-height: 1.45;">
                    <div style="display: flex; align-items: center; gap: 6px; font-weight: 700; margin-bottom: 4px;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                        Session Reset Notice
                    </div>
                    <div>Your previous session has been refreshed or closed. Please sign in below with your credentials.</div>
                </div>
            }

            <!-- Login Error Alerts -->
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.TryGetValue(string.Empty, out var modelErrors) && modelErrors.Errors.Count > 0)
            {
                <div style="background: #fff1f2; border: 1px solid #fecdd3; border-left: 4px solid #e11d48; border-radius: 8px; padding: 12px 14px; margin-bottom: 20px; color: #9f1239; font-size: 0.86rem; line-height: 1.45;">
                    <div style="display: flex; align-items: center; gap: 6px; font-weight: 600; margin-bottom: 4px;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                        Authentication Error
                    </div>
                    @foreach (var error in modelErrors.Errors)
                    {
                        <div style="margin-top: 2px;">@error.ErrorMessage</div>
                    }
                </div>
            }

            <form asp-action="Login" method="post" novalidate>
                <div class="field" style="margin-bottom: 20px;">
                    <label asp-for="Branch" class="form-label" style="color: #333; font-weight: 600; font-size: 0.88rem; margin-bottom: 6px; display: block;">Branch</label>
                    <select asp-for="Branch" class="select" data-testid="login-branch" style="background: #f8f9fa; border: 1px solid #dee2e6; color: #111; width: 100%; height: 42px; border-radius: 8px; padding: 0 12px; font-size: 0.95rem; font-weight: 600; cursor: pointer;">
                        <option value="DMG">DMG</option>
                        <option value="RTO">RTO</option>
                        <option value="Expenditure">EXPENDITURE</option>
                    </select>
                </div>

                <div class="field" style="margin-bottom: 20px;">
                    <label asp-for="Email" class="form-label" style="color: #333;">Username or Email</label>
                    <input asp-for="Email" class="input user-email" autocomplete="username" placeholder="e.g. admin@mygts or user@company.com" data-testid="login-email" style="background: #f8f9fa; border: 1px solid #dee2e6; color: #111;" />
                    <span asp-validation-for="Email" style="color: #ff3333;"></span>
                </div>
                
                <div class="field" style="margin-bottom: 20px;">
                    <label asp-for="Password" class="form-label" style="color: #333;">Password</label>
                    <div style="position: relative; display: flex; align-items: center;">
                        <input asp-for="Password" id="LoginPassword" class="input user-password" autocomplete="current-password" placeholder="e.g. your password" data-testid="login-password" style="background: #f8f9fa; border: 1px solid #dee2e6; color: #111; padding-right: 40px;" />
                        <button type="button" onclick="toggleLoginPassword(this)" title="Show/Hide password" style="position: absolute; right: 8px; background: transparent; border: none; cursor: pointer; color: #666; padding: 4px; display: flex; align-items: center; justify-content: center;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                        </button>
                    </div>
                    <span asp-validation-for="Password" style="color: #ff3333;"></span>
                </div>

                <button class="button" type="submit" style="width: 100%; background: #0056b3; color: #ffffff; font-weight: 600; margin-top: 8px;" data-testid="login-submit-button">
                    Sign in to MYGTS <span aria-hidden="true">→</span>
                </button>
            </form>


        </div>
    </section>
</div>

@section Scripts {
    <script>
        var loginForm = document.querySelector('form');
        if (loginForm) {
            loginForm.addEventListener('submit', function () {
                try { localStorage.setItem('mygts_last_activity', Date.now().toString()); } catch (_) {}
            });
        }

        function toggleLoginPassword(btn) {
            const input = document.getElementById('LoginPassword');
            if (input) {
                if (input.type === 'password') {
                    input.type = 'text';
                    btn.style.color = '#0056b3';
                } else {
                    input.type = 'password';
                    btn.style.color = '#666';
                }
            }
        }
    </script>
}
