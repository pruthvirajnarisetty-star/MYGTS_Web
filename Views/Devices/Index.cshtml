    position: sticky;
    top: 0;
    z-index: 10;
    background: #f8fafc;
    box-shadow: 0 1px 2px rgba(0,0,0,0.05);
}

/* Default frozen columns (when checkboxes are hidden) */
.col-action {
    position: sticky;
    left: 0;
    width: 50px;
    min-width: 50px;
    max-width: 50px;
    z-index: 5;
    background-color: #ffffff !important;
    border-right: 1px solid rgba(0,0,0,0.08);
}

.col-slno {
    position: sticky;
    left: 50px;
    width: 70px;
    min-width: 70px;
    max-width: 70px;
    z-index: 5;
