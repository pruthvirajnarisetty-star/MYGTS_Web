@model DeviceFilterViewModel
@{
    ViewData["Title"] = "Devices";
    string SortDir(string col) => Model.SortColumn == col && Model.SortDirection == "asc" ? "desc" : "asc";
    string SortIcon(string col) => Model.SortColumn == col ? (Model.SortDirection == "desc" ? " ↓" : " ↑") : " ↑↓";
    string NextCol(string col) => Model.SortColumn == col && Model.SortDirection == "desc" ? "" : col;
    var currentBranch = Context.Request.Cookies["mygts_branch"] == "RTO" ? "RTO" : "DMG";
    var batchMap = ViewBag.BatchColorMap as Dictionary<string, int>;
    string GetBatchClass(string? invoiceId) => MygtsMvc.Services.BatchColorHelper.GetBatchClass(invoiceId, batchMap);
}

<style>
    /* Row selection checkbox column: hidden by default */
    .col-select {
        display: none !important;
    }

    /* Checkbox column only appears when row selection mode is activated */
    body.selection-mode-active .col-select,
    .selection-mode-active .col-select {
        display: table-cell !important;
    }

    /* Highlight rows that are selected */
    tr.row-selected {
        background-color: rgba(37, 99, 235, 0.08) !important;
    }
</style>

<div class="page-heading">
    <div>
        <div class="eyebrow">Fleet registry / traceability</div>
        <h1>Devices</h1>
        <p>Search, segment, and maintain the GPS fleet from one operational record.</p>
    </div>

    <div class="page-heading-actions">
        @* Standard Download Dropdown *@
        <div class="dropdown-wrapper" style="position: relative; display: inline-block;">
            <button type="button" class="button secondary" onclick="toggleExportMenu('exportMenu')" data-testid="devices-export" style="display: inline-flex; align-items: center; gap: 6px;">
                <span>↓ Download Sheet</span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div id="exportMenu" class="export-dropdown-panel" style="display: none; position: absolute; right: 0; top: calc(100% + 4px); background: var(--paper); border: 1px solid var(--line); border-radius: 8px; box-shadow: 0 10px 25px rgba(0,0,0,0.15); min-width: 280px; z-index: 100; overflow: hidden; padding: 6px 0;">
                <div style="padding: 6px 16px 2px; font-size: 0.68rem; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em;">Default Format</div>
                <a class="export-opt" href="javascript:void(0)" onclick="handleDownloadOptionClick('')" style="display: flex; flex-direction: column; padding: 8px 16px; text-decoration: none; color: var(--text-main); transition: background 0.15s;">
                    <strong style="font-size: 0.84rem;">☑️ Select Rows to Download (<span class="sel-count-badge">0</span>)</strong>
                    <span style="font-size: 0.74rem; color: var(--muted);">Click to show checkboxes & select specific rows for export</span>
                </a>
                <a class="export-opt" asp-action="ExportAll" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-SortColumn="@Model.SortColumn" asp-route-SortDirection="@Model.SortDirection" asp-route-Page="@Model.Page" asp-route-PageSize="@Model.PageSize" asp-route-thisPageOnly="true" style="display: flex; flex-direction: column; padding: 8px 16px; text-decoration: none; color: var(--text-main); transition: background 0.15s;">
                    <strong style="font-size: 0.84rem;">📄 Download This Page Only</strong>
                    <span style="font-size: 0.74rem; color: var(--muted);">Page @Model.Page of @Model.TotalPages (@Model.Devices.Count rows on this page)</span>
                </a>
                <a class="export-opt" asp-action="ExportAll" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-SortColumn="@Model.SortColumn" asp-route-SortDirection="@Model.SortDirection" asp-route-thisPageOnly="false" style="display: flex; flex-direction: column; padding: 8px 16px; text-decoration: none; color: var(--text-main); transition: background 0.15s;">
                    <strong style="font-size: 0.84rem;">📊 Download All Filtered Records</strong>
                    <span style="font-size: 0.74rem; color: var(--muted);">Export all @Model.TotalItems matching records across all pages</span>
                </a>
            </div>
        </div>

        @if (currentBranch == "RTO")
        {
            <a class="button secondary" asp-action="DownloadSample" asp-route-branch="@currentBranch" asp-route-format="kyc_upload" title="Download KYC Upload Form sample (.xls)" style="display: inline-flex; align-items: center; gap: 6px; border-color: #2563eb; color: #2563eb; font-weight: 600;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                <span>📥 Sample Upload Form (.xls)</span>
            </a>
            <a class="button secondary" asp-action="DownloadSample" asp-route-branch="@currentBranch" asp-route-format="kyc_cl" title="Download KYC Common Layer sample (.xls)" style="display: inline-flex; align-items: center; gap: 6px; border-color: #10b981; color: #10b981; font-weight: 600;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                <span>📥 Sample Common Layer (.xls)</span>
            </a>
        }
        <script>
            function toggleExportMenu(id) {
                const target = document.getElementById(id);
                if (!target) return;
                const isCurrentlyOpen = target.style.display === 'block';
                document.querySelectorAll('.export-dropdown-panel').forEach(p => p.style.display = 'none');
                
                if (!isCurrentlyOpen) {
                    target.style.display = 'block';
                } else {
                    target.style.display = 'none';
                }
            }

            document.addEventListener('click', function(e) {
                const dropdownWrapper = e.target.closest('.dropdown-wrapper');
                const isExportDropdown = e.target.closest('.export-dropdown-panel');

                // 1. Collapse export dropdown if clicked outside dropdown wrapper
                if (!dropdownWrapper && !isExportDropdown) {
                    document.querySelectorAll('.export-dropdown-panel').forEach(p => p.style.display = 'none');
                }

                // 2. If selection mode is active and user clicks anywhere other than the checkboxes or bottom bar:
                if (document.body.classList.contains('selection-mode-active')) {
                    const isCheckbox = e.target.closest('.row-select-checkbox') 
                        || e.target.closest('#selectAllCheckbox') 
                        || e.target.closest('.col-select');
                    const isSelectionBar = e.target.closest('#selectionBar');
                    const isSelectRowsOption = e.target.closest('.export-opt') || e.target.closest('a[onclick*="handleDownloadOptionClick"]');
                    const isDownloadDropdownBtn = e.target.closest('[data-testid="devices-export"]');

                    if (!isCheckbox && !isSelectionBar && !isSelectRowsOption && !isDownloadDropdownBtn) {
                        if (typeof exitSelectionMode === 'function') {
                            exitSelectionMode();
                        }
                        document.querySelectorAll('.export-dropdown-panel').forEach(p => p.style.display = 'none');
                    }
                }
            });
        </script>
        <a class="button secondary" asp-action="DownloadSample" asp-route-branch="@currentBranch" title="Download sample devices Excel template (.xlsx)">📥 Sample sheet</a>
        @if (User.CanEditModule("Devices"))
        {
            <a class="button secondary" asp-action="Import" data-testid="devices-import">↑ Import devices</a>
            <a class="button btn-primary" asp-action="Create" data-testid="devices-add">+ Add device</a>
        }
        else
        {
        }
    </div>
</div>

<form class="card toolbar" method="get" asp-action="Index" data-testid="device-filters">
    <div class="filter-grid" style="align-items: flex-end;">
        <div class="field grow">
            <label for="QueryInput" class="form-label" style="margin-bottom: 4px; display: block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-main);">SEARCH</label>
            <div style="position: relative; width: 100%;">
                <button type="button" style="position: absolute; top: 50%; transform: translateY(-50%); left: 16px; padding: 0; background: transparent; border: none; display: flex; align-items: center; justify-content: center;">
                    <svg width="17" height="16" fill="none" xmlns="http://www.w3.org/2000/svg" style="width: 20px; height: 20px; color: #4b5563;">
                        <path d="M7.667 12.667A5.333 5.333 0 107.667 2a5.333 5.333 0 000 10.667zM14.334 14l-2.9-2.9" stroke="currentColor" stroke-width="1.333" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                </button>
                <input type="hidden" asp-for="Query" id="Query" />
                <input type="hidden" asp-for="SpecialFilter" />
                <input type="hidden" asp-for="SortColumn" />
                <input type="hidden" asp-for="SortDirection" />
                <input id="QueryInput" name="QueryInput" class="input shadow-md w-full" style="padding: 0 44px; border-radius: 9999px; height: 42px; width: 100%; border: 1px solid var(--line); outline: none; transition: all 0.3s; font-size: 14px;" placeholder="Add a filter..." type="text" data-testid="device-search" onfocus="this.style.borderColor='#3b82f6'" onblur="this.style.borderColor='var(--line)'" />
                <button type="button" onclick="document.getElementById('QueryInput').value=''; document.getElementById('Query').value=''; this.closest('form').submit();" style="position: absolute; top: 50%; transform: translateY(-50%); right: 12px; padding: 0; background: transparent; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center;">
                    <svg xmlns="http://www.w3.org/2000/svg" style="width: 20px; height: 20px; color: #4b5563;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>
        </div>

        <div class="field">
            <label class="form-label" asp-for="Vendor">Vendor</label>
            <select class="select" asp-for="Vendor">
                <option value="">All vendors</option>
                @foreach (var vendor in Model.Vendors)
                {
                    <option value="@vendor">@vendor</option>
                }
            </select>
        </div>

        <div class="field">
            <label class="form-label" asp-for="Lifecycle">Lifecycle</label>
            <select class="select" asp-for="Lifecycle">
                <option value="">All statuses</option>
                @foreach (var option in Model.LifecycleOptions)
                {
                    <option value="@option">@option</option>
                }
            </select>
        </div>

        <div class="field">
            <label class="form-label" asp-for="Stock">Stock</label>
            <select class="select" asp-for="Stock">
                <option value="">All stocks</option>
                @foreach (var option in Model.StockOptions)
                {
                    <option value="@option">@option</option>
                }
            </select>
        </div>

        <div class="field">
            <label class="form-label" asp-for="PageSize">Rows per page</label>
            <select class="select" asp-for="PageSize" onchange="this.form.requestSubmit ? this.form.requestSubmit() : this.form.submit()">
                <option value="10">10</option>
                <option value="20">20</option>
                <option value="50">50</option>
                <option value="100">100</option>
                <option value="1000000">All</option>
            </select>
        </div>

        <div class="field">
            <button class="button btn-primary" type="submit" data-testid="device-search-submit" style="height: 42px; border-radius: 8px; padding: 0 24px;">Apply filters</button>
        </div>
    </div>
    @{
        var queryTerms = string.IsNullOrWhiteSpace(Model.Query) ? Array.Empty<string>() : Model.Query.Trim().Split('|', StringSplitOptions.RemoveEmptyEntries);
    }
    @if (queryTerms.Length > 0)
    {
        <div class="flex flex-wrap gap-2 mt-4" style="padding-bottom: 8px; width: 100%;">
            @foreach (var term in queryTerms)
            {
                <span class="inline-flex items-center gap-1 px-3 py-1 text-sm bg-white border border-dashed border-gray-400 rounded-full text-gray-700">
                    @term
                    <button type="button" onclick="removeChip('@term')" class="text-gray-400 hover:text-gray-700">
                        <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </button>
                </span>
            }
        </div>
    }
</form>

<script>
    document.querySelector('form.toolbar').addEventListener('submit', function(e) {
        var queryInput = document.getElementById('QueryInput');
        var queryHidden = document.getElementById('Query');
        if (queryInput && queryInput.value.trim() !== '') {
            var current = queryHidden.value ? queryHidden.value + '|' : '';
            queryHidden.value = current + queryInput.value.trim();
            queryInput.value = ''; // Don't submit the visual input
        }
    });

    function removeChip(term) {
        var queryHidden = document.getElementById('Query');
        var terms = queryHidden.value.split('|').filter(t => t !== '' && t !== term);
        queryHidden.value = terms.join('|');
        document.querySelector('form.toolbar').submit();
    }
</script>

<section class="card">
    <div class="section-heading" style="padding: 0 20px; margin: 20px 0 12px;">
        <div>
            <h2>@Model.TotalItems.ToString("N0") device records</h2>
            <p>Records exclude unused inventory unless explicitly filtered; source lifecycle labels are preserved. Page @Model.Page of @(Model.TotalPages == 0 ? 1 : Model.TotalPages)</p>
        </div>
    </div>

    <div class="table-wrap" style="min-height: 360px; overflow-x: auto; padding-bottom: 90px;">
        <table class="data-table" data-testid="devices-table">
            <thead>
                <tr>
                    <th class="col-select" style="width: 38px; min-width: 38px; text-align: center;"><input type="checkbox" id="selectAllCheckbox" title="Select all rows on this page" onchange="toggleSelectAllRows(this.checked)" style="cursor: pointer; width: 16px; height: 16px;" /></th>
                    <th class="col-action" style="width: 50px; min-width: 50px;"></th>
                    <th class="col-slno" style="width: 70px; min-width: 70px;"><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-SortColumn="@NextCol("slno")" asp-route-SortDirection="@SortDir("slno")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">SLNo @SortIcon("slno")</a></th>
                    <th class="col-vehicleno" style="width: 140px; min-width: 140px; max-width: 140px;"><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-SortColumn="@NextCol("vehicle")" asp-route-SortDirection="@SortDir("vehicle")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">Vehicle No @SortIcon("vehicle")</a></th>
                    <th><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-SortColumn="@NextCol("iccid")" asp-route-SortDirection="@SortDir("iccid")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">ICCID @SortIcon("iccid")</a></th>
                    <th><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-SortColumn="@NextCol("imei")" asp-route-SortDirection="@SortDir("imei")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">IMEI Number @SortIcon("imei")</a></th>
                    @if (currentBranch == "RTO")
                    {
                        <th><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-SortColumn="@NextCol("deviceserial")" asp-route-SortDirection="@SortDir("deviceserial")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">Device Serial No @SortIcon("deviceserial")</a></th>
                    }
                    <th>Device Sim (Airtel)</th>
                    <th>Device Sim (BSNL)</th>
                    <th><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-SortColumn="@NextCol("status")" asp-route-SortDirection="@SortDir("status")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">Status @SortIcon("status")</a></th>
                    @if (currentBranch == "RTO")
                    {
                        <th style="text-align: center;"><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-SortColumn="@NextCol("cdacc")" asp-route-SortDirection="@SortDir("cdacc")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">CDAC-C @SortIcon("cdacc")</a></th>
                        <th style="text-align: center;"><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-SortColumn="@NextCol("vldtc")" asp-route-SortDirection="@SortDir("vldtc")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">VLDT-C @SortIcon("vldtc")</a></th>
                        <th><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-SortColumn="@NextCol("type")" asp-route-SortDirection="@SortDir("type")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">Type @SortIcon("type")</a></th>
                    }
                    <th>Latest Expiry Date</th>
                    @if (currentBranch == "RTO")
                    {
                        <th><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-SortColumn="@NextCol("registration")" asp-route-SortDirection="@SortDir("registration")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">Registration Date @SortIcon("registration")</a></th>
                    }
                    <th><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-SortColumn="@NextCol("vendor")" asp-route-SortDirection="@SortDir("vendor")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">VENDOR @SortIcon("vendor")</a></th>
                    <th>Owner Details</th>
                    <th>Cell No</th>
                    <th><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-SortColumn="@NextCol("activation")" asp-route-SortDirection="@SortDir("activation")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">Activation Date @SortIcon("activation")</a></th>
                    <th><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-SortColumn="@NextCol("device")" asp-route-SortDirection="@SortDir("device")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">Device Name @SortIcon("device")</a></th>
                    <th>Network Operator</th>
                    @if (currentBranch == "RTO")
                    {
                        <th><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-SortColumn="@NextCol("engine")" asp-route-SortDirection="@SortDir("engine")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">Engine No @SortIcon("engine")</a></th>
                        <th><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-SortColumn="@NextCol("chasis")" asp-route-SortDirection="@SortDir("chasis")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">Chassis No @SortIcon("chasis")</a></th>
                        <th><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-SortColumn="@NextCol("make")" asp-route-SortDirection="@SortDir("make")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">Vehicle Manufacture @SortIcon("make")</a></th>
                        <th><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-SortColumn="@NextCol("model")" asp-route-SortDirection="@SortDir("model")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">Vehicle Model @SortIcon("model")</a></th>
                        <th><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-SortColumn="@NextCol("rto")" asp-route-SortDirection="@SortDir("rto")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">RTO @SortIcon("rto")</a></th>
                        <th style="min-width: 140px; max-width: 160px;"><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-SortColumn="@NextCol("address")" asp-route-SortDirection="@SortDir("address")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">Address @SortIcon("address")</a></th>
                        <th>Proof of Identity</th>
                        <th><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-SortColumn="@NextCol("docno")" asp-route-SortDirection="@SortDir("docno")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">ID Number @SortIcon("docno")</a></th>
                    }
                    else
                    {
                        <th>Engine No</th>
                        <th>Chasis No</th>
                        <th>Proof Of Address</th>
                        <th>Document Number</th>
                    }
                    <th>Invoice ID</th>
                    <th>Notes</th>
                    @if (currentBranch != "RTO")
                    {
                        <th>Previous IMEI</th>
                        <th>Hardware History</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Model.Devices.Count == 0)
                {
                    <tr>
                        <td colspan="35" style="padding: 48px 24px; text-align: center;">
                            <div style="max-width: 440px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 10px;">
                                <div style="width: 52px; height: 52px; border-radius: 50%; background: rgba(15, 98, 254, 0.08); display: flex; align-items: center; justify-content: center; color: var(--blue-600); margin-bottom: 4px;">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="11" cy="11" r="8"></circle>
                                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                    </svg>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(Model.Query))
                                {
                                    <h3 style="font-size: 1.05rem; font-weight: 600; margin: 0; color: var(--text-main);">No device found matching "@Model.Query"</h3>
                                    <p style="font-size: 0.88rem; color: var(--muted); margin: 0;">This IMEI or keyword does not exist in the database.</p>
                                    <a href="/Devices" class="button secondary" style="margin-top: 8px; font-size: 0.85rem; padding: 6px 16px; border-radius: 6px;">Clear Search</a>
                                }
                                else
                                {
                                    <h3 style="font-size: 1.05rem; font-weight: 600; margin: 0; color: var(--text-main);">No devices match this filter set</h3>
                                    <p style="font-size: 0.88rem; color: var(--muted); margin: 0;">Try adjusting your selected filters to view fleet devices.</p>
                                    <a href="/Devices" class="button secondary" style="margin-top: 8px; font-size: 0.85rem; padding: 6px 16px; border-radius: 6px;">Reset All Filters</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var device in Model.Devices)
                    {
                        var lifecycle = device.LifecycleStatus.ToLowerInvariant();
                        <tr class="batch-row @GetBatchClass(device.InvoiceId)">
                                <td class="col-select" style="text-align: center;">
                                    <input type="checkbox" class="row-select-checkbox" value="@device.Id" onchange="onRowSelectionChange()" style="cursor: pointer; width: 16px; height: 16px;" />
                                </td>
                                @if (User.CanEditModule("Devices"))
                                {
                                    <td class="col-action" style="overflow: visible;">
                                        <label class="popup">
                                          <input type="checkbox">
                                          <div class="burger" tabindex="0">
                                            <span></span>
                                            <span></span>
                                            <span></span>
                                          </div>
                                          <nav class="popup-window">
                                            <legend>Actions</legend>
                                            <ul>
                                              <li>
                                                <a asp-action="Edit" asp-route-id="@device.Id">
                                                  <svg stroke-linejoin="round" stroke-linecap="round" stroke-width="2" stroke="currentColor" fill="none" viewBox="0 0 24 24" height="14" width="14" xmlns="http://www.w3.org/2000/svg">
                                                    <polygon points="16 3 21 8 8 21 3 21 3 16 16 3"></polygon>
                                                  </svg>
                                                  <span>Edit</span>
                                                </a>
                                              </li>
                                              <hr>
                                              <li>
                                                <form asp-action="Delete" method="post" style="margin: 0; width: 100%;">
                                                  <input type="hidden" name="id" value="@device.Id" />
                                                  <button type="submit" onclick="return confirm('Remove this device?')">
                                                    <svg stroke-linejoin="round" stroke-linecap="round" stroke-width="2" stroke="currentColor" fill="none" viewBox="0 0 24 24" height="14" width="14" xmlns="http://www.w3.org/2000/svg">
                                                      <line y2="18" x2="6" y1="6" x1="18"></line>
                                                      <line y2="18" x2="18" y1="6" x1="6"></line>
                                                    </svg>
                                                    <span>Delete</span>
                                                  </button>
                                                </form>
                                              </li>
                                            </ul>
                                          </nav>
                                        </label>
                                    </td>
                                }
                                else
                                {
                                    <td class="col-action"></td>
                                }
                            <td class="col-slno text-sm">@device.SlNo</td>
                            <td class="col-vehicleno">@device.VehicleNo</td>
                            <td><strong>@(string.IsNullOrWhiteSpace(device.Iccid) ? "—" : device.Iccid)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(device.Imei) ? "—" : device.Imei)</td>
                            @if (currentBranch == "RTO")
                            {
                                <td>@(string.IsNullOrWhiteSpace(device.DeviceSerialNo) ? "—" : device.DeviceSerialNo)</td>
                            }
                            <td>@(string.IsNullOrWhiteSpace(device.SimAirtel) ? "—" : device.SimAirtel)</td>
                            <td>@(string.IsNullOrWhiteSpace(device.SimBsnl) ? "—" : device.SimBsnl)</td>
                            <td><span class="badge @(device.LifecycleStatus.ToLowerInvariant())">@device.LifecycleStatus</span></td>
                            @if (currentBranch == "RTO")
                            {
                                <td style="text-align: center;">
                                    @if (string.Equals(device.CdacCertificate, "YES", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge active" style="font-weight: 600; padding: 2px 8px; border-radius: 4px;">YES</span>
                                    }
                                    else
                                    {
                                        <span class="badge neutral" style="color: var(--muted); padding: 2px 8px; border-radius: 4px;">NO</span>
                                    }
                                </td>
                                <td style="text-align: center;">
                                    @if (string.Equals(device.VldtCertificate, "YES", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge active" style="font-weight: 600; padding: 2px 8px; border-radius: 4px;">YES</span>
                                    }
                                    else
                                    {
                                        <span class="badge neutral" style="color: var(--muted); padding: 2px 8px; border-radius: 4px;">NO</span>
                                    }
                                </td>
                                <td>@MygtsMvc.Services.SpreadsheetService.NormalizeType(device.Type)</td>
                            }
                            <td>@(string.IsNullOrWhiteSpace(DateValue.Short(device.LatestExpiryDate)) ? "—" : DateValue.Short(device.LatestExpiryDate))</td>
                            @if (currentBranch == "RTO")
                            {
                                <td>@(string.IsNullOrWhiteSpace(DateValue.Short(device.RegistrationDate)) ? "—" : DateValue.Short(device.RegistrationDate))</td>
                            }
                            <td>@(string.IsNullOrWhiteSpace(device.Vendor) ? "—" : device.Vendor)</td>
                            <td>@(string.IsNullOrWhiteSpace(device.Owner) ? "—" : device.Owner)</td>
                            <td>@(string.IsNullOrWhiteSpace(device.CellNo) ? "—" : device.CellNo)</td>
                            <td>@(string.IsNullOrWhiteSpace(DateValue.Short(device.ActivationDate)) ? "—" : DateValue.Short(device.ActivationDate))</td>
                            <td>@(string.IsNullOrWhiteSpace(device.DeviceName) ? "—" : device.DeviceName)</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(device.NetworkOperator))
                                {
                                    if (device.NetworkOperator.Contains("BABU", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <div style="display: inline-flex; align-items: center; gap: 6px;">
                                            <span class="badge" style="font-size: 0.75rem; font-weight: 600; padding: 2px 7px; border-radius: 4px; background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe;">Taisys</span>
                                            <span class="badge" style="font-size: 0.7rem; font-weight: 700; padding: 2px 6px; border-radius: 4px; background: #fef3c7; color: #92400e; border: 1px solid #fde68a; letter-spacing: 0.5px;">BABU</span>
                                        </div>
                                    }
                                    else if (device.NetworkOperator.Contains("MYGTS", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <div style="display: inline-flex; align-items: center; gap: 6px;">
                                            <span class="badge" style="font-size: 0.75rem; font-weight: 600; padding: 2px 7px; border-radius: 4px; background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe;">Taisys</span>
                                            <span class="badge" style="font-size: 0.7rem; font-weight: 700; padding: 2px 6px; border-radius: 4px; background: #f0fdf4; color: #166534; border: 1px solid #bbf7d0; letter-spacing: 0.5px;">MYGTS</span>
                                        </div>
                                    }
                                    else if (device.NetworkOperator.Equals("Sensorise", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge" style="font-size: 0.75rem; font-weight: 600; padding: 2px 7px; border-radius: 4px; background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0;">Sensorise</span>
                                    }
                                    else if (device.NetworkOperator.Equals("Taisys", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge" style="font-size: 0.75rem; font-weight: 600; padding: 2px 7px; border-radius: 4px; background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe;">Taisys</span>
                                    }
                                    else
                                    {
                                        <span>@device.NetworkOperator</span>
                                    }
                                }
                                else
                                {
                                    <span style="color: var(--muted); opacity: 0.5;">—</span>
                                }
                            </td>
                            @if (currentBranch == "RTO")
                            {
                                <td>@(string.IsNullOrWhiteSpace(device.EngineNo) ? "—" : device.EngineNo)</td>
                                <td>@(string.IsNullOrWhiteSpace(device.ChasisNo) ? "—" : device.ChasisNo)</td>
                                <td>@(string.IsNullOrWhiteSpace(device.VehicleMake) ? "—" : device.VehicleMake)</td>
                                <td>@(string.IsNullOrWhiteSpace(device.VehicleModel) ? "—" : device.VehicleModel)</td>
                                <td>@(string.IsNullOrWhiteSpace(device.Rto) ? "—" : device.Rto)</td>
                                <td title="@device.Address" style="max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; cursor: help;">
                                    @if (!string.IsNullOrWhiteSpace(device.Address))
                                    {
                                        <span title="@device.Address">@device.Address</span>
                                    }
                                    else
                                    {
                                        <span style="color: var(--muted); opacity: 0.5;">—</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(device.ProofOfAddress))
                                    {
                                        <span class="badge neutral" style="font-weight: 600; padding: 2px 7px; border-radius: 4px;">@device.ProofOfAddress</span>
                                    }
                                    else
                                    {
                                        <span style="color: var(--muted); opacity: 0.5;">—</span>
                                    }
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(device.DocumentNumber) ? "—" : device.DocumentNumber)</td>
                            }
                            else
                            {
                                <td>@device.EngineNo</td>
                                <td>@device.ChasisNo</td>
                                <td>@device.ProofOfAddress</td>
                                <td>@device.DocumentNumber</td>
                            }
                            <td>
                                @if (!string.IsNullOrWhiteSpace(device.InvoiceId))
                                {
                                    <span class="batch-badge">
                                        @device.InvoiceId
                                        @if (MygtsMvc.Services.BatchColorHelper.RtoInvoiceToBatchMap.TryGetValue(device.InvoiceId, out var bAlias))
                                        {
                                            <span style="opacity: 0.75; font-size: 0.75rem; margin-left: 3px;">(@bAlias)</span>
                                        }
                                    </span>
                                }
                                else
                                {
                                    <span style="color: var(--muted); opacity: 0.5;">—</span>
                                }
                            </td>
                            <td>@device.Notes</td>
                            @if (currentBranch != "RTO")
                            {
                                <td>@device.PreviousImei</td>
                                <td>@device.HardwareHistory</td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    
    @if (Model.TotalItems > 0)
    {
        <div style="padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; border-top: 1px solid rgba(0,0,0,0.05);">
            <div style="font-size: 0.9rem; color: var(--muted);">
                Showing @((Model.Page - 1) * Model.PageSize + 1) to @Math.Min(Model.Page * Model.PageSize, Model.TotalItems) of @Model.TotalItems entries
            </div>
        <div style="display: flex; gap: 4px; align-items: center;">
            @{
                var startPage = Math.Max(1, Model.Page - 2);
                var endPage = Math.Min(Model.TotalPages, Model.Page + 2);
                
                if (startPage > 1) {
                    <a class="button secondary" asp-action="Index" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-SortColumn="@Model.SortColumn" asp-route-SortDirection="@Model.SortDirection" asp-route-PageSize="@Model.PageSize" asp-route-Page="1" style="padding: 4px 10px; min-width: auto; height: 32px; font-size: 13px;">1</a>
                    if (startPage > 2) {
                        <span style="padding: 4px 8px; color: var(--muted);">...</span>
                    }
                }
                
                for (int i = startPage; i <= endPage; i++)
                {
                    if (i == Model.Page) {
                        <button class="button primary" disabled style="padding: 4px 10px; min-width: auto; height: 32px; font-size: 13px;">@i</button>
                    } else {
                        <a class="button secondary" asp-action="Index" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-SortColumn="@Model.SortColumn" asp-route-SortDirection="@Model.SortDirection" asp-route-PageSize="@Model.PageSize" asp-route-Page="@i" style="padding: 4px 10px; min-width: auto; height: 32px; font-size: 13px;">@i</a>
                    }
                }
                
                if (endPage < Model.TotalPages) {
                    if (endPage < Model.TotalPages - 1) {
                        <span style="padding: 4px 8px; color: var(--muted);">...</span>
                    }
                    <a class="button secondary" asp-action="Index" asp-route-Query="@Model.Query" asp-route-Vendor="@Model.Vendor" asp-route-Lifecycle="@Model.Lifecycle" asp-route-Stock="@Model.Stock" asp-route-SpecialFilter="@Model.SpecialFilter" asp-route-SortColumn="@Model.SortColumn" asp-route-SortDirection="@Model.SortDirection" asp-route-PageSize="@Model.PageSize" asp-route-Page="@Model.TotalPages" style="padding: 4px 10px; min-width: auto; height: 32px; font-size: 13px;">@Model.TotalPages</a>
                }
            }
        </div>
        </div>
    }
</section>

<style>
/* Freeze table header */
