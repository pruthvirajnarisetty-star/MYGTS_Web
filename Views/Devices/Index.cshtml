}

/* When Row Selection Mode is active (checkboxes displayed at left: 0) */
body.selection-mode-active .col-select,
.selection-mode-active .col-select {
    position: sticky;
    left: 0;
    width: 38px;
    min-width: 38px;
    max-width: 38px;
    z-index: 5;
    background-color: #ffffff !important;
    border-right: 1px solid rgba(0,0,0,0.08);
}

body.selection-mode-active .col-action,
.selection-mode-active .col-action {
    left: 38px;
}

body.selection-mode-active .col-slno,
.selection-mode-active .col-slno {
    left: 88px;
}

body.selection-mode-active .col-vehicleno,
.selection-mode-active .col-vehicleno {
    left: 158px;
}

/* Ensure frozen headers stay above frozen column cells */
.data-table th.col-select,
.data-table th.col-action,
.data-table th.col-slno,
.data-table th.col-vehicleno {
    z-index: 25 !important;
    background-color: #f1f5f9 !important;
}

/* Elevate z-index when action popup is open so it overlaps rows below and right */
.data-table td.col-action:has(.popup input:checked),
.data-table td.col-action:focus-within,
.data-table td.col-action:hover {
    z-index: 35 !important;
}

/* Dark mode support - 100% OPAQUE backgrounds so NO scrolling content bleeds through */
body:has(#theme:checked) .data-table th {
    background-color: #0b0f19 !important;
    color: #38bdf8 !important;
    border-color: #1e293b !important;
}

body:has(#theme:checked) .data-table th.col-select,
body:has(#theme:checked) .data-table th.col-action,
body:has(#theme:checked) .data-table th.col-slno,
body:has(#theme:checked) .data-table th.col-vehicleno {
    background-color: #0b0f19 !important;
    color: #38bdf8 !important;
    border-right-color: #1e293b !important;
}
