    border-right: 2px solid #334155 !important;
    box-shadow: 5px 0 10px -2px rgba(0, 0, 0, 0.6) !important;
}

body:has(#theme:checked) .data-table td.col-select,
body:has(#theme:checked) .data-table td.col-action,
body:has(#theme:checked) .data-table td.col-slno,
body:has(#theme:checked) .data-table td.col-vehicleno {
    background-color: #0f172a !important;
    color: #f8fafc !important;
    border-right: 1px solid #1e293b !important;
}
body:has(#theme:checked) .data-table td.col-vehicleno {
    border-right: 2px solid #334155 !important;
    box-shadow: 5px 0 10px -2px rgba(0, 0, 0, 0.6) !important;
}

/* Preserve subtle batch row tint over solid background without ANY transparency bleed */
body:has(#theme:checked) .data-table tr.batch-row td.col-select,
body:has(#theme:checked) .data-table tr.batch-row td.col-action,
body:has(#theme:checked) .data-table tr.batch-row td.col-slno,
body:has(#theme:checked) .data-table tr.batch-row td.col-vehicleno {
