<script>
    function switchTab(tab) {
        const btnPdf  = document.getElementById('tabBtnPdf');
        const btnSpec = document.getElementById('tabBtnSpec');
        const pdfPane = document.getElementById('tabContentPdf');
        const specPane = document.getElementById('tabContentSpec');
        if (tab === 'pdf') {
            btnPdf.classList.add('active');   btnSpec.classList.remove('active');
            pdfPane.style.display = 'block';  specPane.style.display = 'none';
        } else {
            btnSpec.classList.add('active');  btnPdf.classList.remove('active');
            specPane.style.display = 'block'; pdfPane.style.display = 'none';
        }
    }
</script>
