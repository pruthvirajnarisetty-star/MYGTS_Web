@{
    var reqBranch = Context.Request.Query["branch"].ToString();
    if (string.IsNullOrWhiteSpace(reqBranch))
    {
        reqBranch = Context.Request.Cookies["mygts_branch"] ?? "";
    }
    if (string.IsNullOrWhiteSpace(reqBranch) && Context.Request.Headers.Referer.ToString().Contains("/Expenditure", StringComparison.OrdinalIgnoreCase))
    {
        reqBranch = "Expenditure";
    }
    var isExpenditure = string.Equals(reqBranch, "Expenditure", StringComparison.OrdinalIgnoreCase);
    var isRto = string.Equals(reqBranch, "RTO", StringComparison.OrdinalIgnoreCase);

    if (isExpenditure)
    {
        Layout = "~/Areas/Expenditure/Views/Shared/_Layout.cshtml";
    }
    else if (isRto)
    {
        Layout = "~/Areas/RTO/Views/Shared/_Layout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
    ViewData["Title"] = "System Requirements Contract & Specification (SRC)";
    var pdfExists = (bool)(ViewBag.PdfExists ?? false);
    var pdfUrl = (string)(ViewBag.PdfUrl ?? "/docs/MYGTS_SRC_Specification.pdf");
    var pdfSizeKb = (string)(ViewBag.PdfSizeKb ?? "0");
    var pdfDate = (string)(ViewBag.PdfLastModified ?? DateTime.Now.ToString("dd MMM yyyy"));
}

