                        </a>
                    </li>
                }
                @if (showTaisys)
                {
                    <li class="manual-nav-item">
                        <a href="#sec-taisys" class="manual-nav-link">
                            <span>Taisys Advance Batches</span>
                            <span class="manual-nav-pill @(canEditTai ? "pill-full" : "pill-view")">@(canEditTai ? "Edit" : "View")</span>
                        </a>
                    </li>
                }
                @if (showInventory)
                {
                    <li class="manual-nav-item">
                        <a href="#sec-inventory" class="manual-nav-link">
                            <span>Inventory & Hardware Stock</span>
                            <span class="manual-nav-pill @(canEditInv ? "pill-full" : "pill-view")">@(canEditInv ? "Edit" : "View")</span>
                        </a>
                    </li>
                }
                @if (showInvoices)
                {
                    <li class="manual-nav-item">
                        <a href="#sec-invoices" class="manual-nav-link">
                            <span>Customer Billing & Invoices</span>
                            <span class="manual-nav-pill @(canEditInvs ? "pill-full" : "pill-view")">@(canEditInvs ? "Edit" : "View")</span>
                        </a>
                    </li>
                }
                @if (showReminders)
                {
                    <li class="manual-nav-item">
                        <a href="#sec-reminders" class="manual-nav-link">
                            <span>Reminders & Follow-Ups</span>
                            <span class="manual-nav-pill @(canEditRem ? "pill-full" : "pill-view")">@(canEditRem ? "Edit" : "View")</span>
                        </a>
                    </li>
                }
                @if (showVendors)
                {
                    <li class="manual-nav-item">
                        <a href="#sec-vendors" class="manual-nav-link">
                            <span>Vendors Directory</span>
                            <span class="manual-nav-pill @(canEditVen ? "pill-full" : "pill-view")">@(canEditVen ? "Edit" : "View")</span>
                        </a>
                    </li>
                }
                @if (showExpenditure)
