@model BulkSplitViewModel
@{
    ViewData["Title"] = "Bulk split";
    ViewData["BodyClass"] = "form-background-container";
    var knownVendorsList = (ViewBag.KnownVendors as IEnumerable<string> ?? Enumerable.Empty<string>()).ToList();
}

<div class="glass-wrapper">
<div class="page-heading">
    <div>
        <div class="eyebrow">Financial operations / allocation</div>
        <h1>Bulk split</h1>
        <p>Distribute one payment across multiple vehicles and retain the shared batch identity.</p>
    </div>
    <a class="button ghost" asp-action="Index">← Back to transactions</a>
</div>

<form class="card form-card bulk-split-card" asp-action="BulkSplit" method="post" id="bulk-split-form" style="margin: 0 auto; max-width: 1050px;">
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
    
    <div class="form-grid">
        <div class="field">
            <label asp-for="Date" class="form-label">Date</label>
            <input asp-for="Date" class="input" id="Date" />
        </div>

        <div class="field">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                <label asp-for="Vendor" class="form-label" style="margin: 0;">Vendor</label>
                <button type="button" id="btnToggleCustomVendor" onclick="toggleCustomVendorInput()" style="background: none; border: none; color: var(--cyan); font-size: 0.78rem; font-weight: 600; cursor: pointer; padding: 0;">+ New Vendor</button>
            </div>
            <select class="select" id="vendorSelect" onchange="onVendorSelectChange(this.value)">
                <option value="">-- Select Vendor from List --</option>
                @foreach (var v in knownVendorsList)
                {
                    <option value="@v" selected="@(string.Equals(Model?.Vendor, v, StringComparison.OrdinalIgnoreCase))">@v</option>
                }
            </select>
            <div id="vendorCustomWrap" style="display: none; margin-top: 6px;">
                <input asp-for="Vendor" id="vendorInput" class="input" placeholder="Type vendor name..." autocomplete="off" oninput="onVendorInputChange(this.value)" />
            </div>
            <span asp-validation-for="Vendor" class="validation-summary-errors"></span>
        </div>

        <div class="field">
            <label asp-for="PaymentMode" class="form-label">Payment mode</label>
            <select asp-for="PaymentMode" class="select">
                <option>Bank transfer</option>
                <option>UPI</option>
                <option>Cash</option>
            </select>
        </div>

        <div class="field">
            <label asp-for="Utr" class="form-label">UTR / reference</label>
            <input asp-for="Utr" class="input" />
        </div>

        <div class="field">
            <label asp-for="PaidTo" class="form-label">Paid to</label>
            <input asp-for="PaidTo" class="input" />
        </div>
        
        <div class="field">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                <label asp-for="BatchId" class="form-label" style="margin: 0;">Batch ID</label>
                <span style="font-size: 0.72rem; color: var(--muted);" id="batchIdHint">Format: XXX - DDMYYYY</span>
            </div>
            <input asp-for="BatchId" class="input" id="BatchId" placeholder="e.g. GOV - 26092026" style="font-family: monospace; font-weight: 600; letter-spacing: 0.05em;" />
        </div>
        
        <div class="field">
            <label asp-for="TotalPayment" class="form-label">Total payment</label>
            <input asp-for="TotalPayment" class="input" type="number" step="0.01" min="0.01" id="total-payment-input" />
        </div>
        
        <div class="field full" style="background: rgba(0,0,0,0.02); padding: 20px; border-radius: 10px; border: 1px solid var(--line);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                <label class="form-label" style="margin: 0; font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">Bulk Allocations</label>
                <span style="font-size: 0.78rem; color: var(--muted);">Allocate portions of the total payment per vehicle</span>
            </div>

            <!-- Column Headings for Allocations -->
            <div class="bulk-allocations-header" style="display: grid; grid-template-columns: 2fr 1.3fr 1.6fr 1.6fr 40px; gap: 10px; margin-bottom: 8px; padding: 0 4px;">
                <div style="font-size: 0.73rem; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em;">Vehicle Number</div>
                <div style="font-size: 0.73rem; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em;">Amount (₹)</div>
                <div style="font-size: 0.73rem; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em;">Activation Date</div>
                <div style="font-size: 0.73rem; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em;">New Expiry Date</div>
                <div></div>
            </div>

            <div id="bulk-rows-container" style="display: flex; flex-direction: column; gap: 8px;">
                <div class="bulk-row" style="display: grid; grid-template-columns: 2fr 1.3fr 1.6fr 1.6fr 40px; gap: 10px; align-items: center;">
                    <input name="BulkAllocations[0].VehicleNo" type="text" class="input bulk-vehicle-input" placeholder="e.g. KA34C8377" required />
                    <input name="BulkAllocations[0].Amount" type="number" step="0.01" class="input bulk-amount-input" placeholder="Amount" required />
                    <input name="BulkAllocations[0].ActivationDate" type="date" class="input bulk-activation-input" title="Activation Date" />
                    <input name="BulkAllocations[0].NewExpiryDate" type="date" class="input bulk-expiry-input" title="Expiry Date" style="background: var(--line);" readonly tabindex="-1" />
                    <button type="button" class="deleteButton" style="width: 32px; height: 32px; justify-self: center;" onclick="if(document.querySelectorAll('.bulk-row').length > 1) { this.closest('.bulk-row').remove(); window.calculateRemaining && window.calculateRemaining(); }">
                      <svg viewBox="0 0 448 512" class="bin"><path d="M135.2 17.7L128 32H32C14.3 32 0 46.3 0 64S14.3 96 32 96H416c17.7 0 32-14.3 32-32s-14.3-32-32-32H320l-7.2-14.3C307.4 6.8 296.3 0 284.2 0H163.8c-12.1 0-23.2 6.8-28.6 17.7zM416 128H32L53.2 467c1.6 25.3 22.6 45 47.9 45H346.9c25.3 0 46.3-19.7 47.9-45L416 128z"></path></svg>
                    </button>
                </div>
            </div>
            
            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 14px; padding-top: 12px; border-top: 1px dashed var(--line);">
                <button type="button" class="button ghost" id="add-bulk-row" style="padding: 7px 14px; font-size: 0.85rem; font-weight: 600;">+ Add Vehicle</button>
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="font-size: 0.85rem; color: var(--muted); font-weight: 500;">Unallocated Balance:</span>
                    <input type="text" id="bulk-unallocated" class="input" style="width: 140px; font-weight: 700; font-size: 1.05rem; background: transparent; border: none; padding: 0; text-align: right; color: var(--text);" readonly tabindex="-1" value="₹0.00" />
                </div>
            </div>
        </div>
    </div>
    
    <div class="trace-grid" style="margin-top: 20px; display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 16px;">
        <div class="card" style="padding: 16px;">
            <span class="eyebrow">Total Allocated</span>
            <strong style="display:block; margin-top: 8px; font-size: 1.55rem; color: var(--blue-600);" id="trace-allocated">₹0.00</strong>
        </div>
        
        <div class="card" style="padding: 16px;">
            <span class="eyebrow">Unallocated Balance</span>
            <strong style="display:block; margin-top: 8px; font-size: 1.55rem; color: var(--text);" id="trace-unallocated">₹0.00</strong>
        </div>
        
        <div class="card" style="padding: 16px;">
            <span class="eyebrow">Original Total</span>
            <strong style="display:block; margin-top: 8px; font-size: 1.55rem; color: var(--success);" id="trace-total">₹0.00</strong>
        </div>
    </div>
    
    <div class="permission-note" style="margin-top: 20px;">
        The server creates one transaction per vehicle based on your exact allocations with the shared Batch ID.
    </div>
    
    <div class="form-actions">
        <a class="button ghost" asp-action="Index">Cancel</a>
        <button class="button btn-primary" type="submit">Create split transactions</button>
    </div>
</form>
</div>

<script>
document.addEventListener("DOMContentLoaded", function() {
    const totalInput = document.getElementById("total-payment-input");
    const unallocatedInput = document.getElementById("bulk-unallocated");
    const bulkRowsContainer = document.getElementById("bulk-rows-container");
    const addBulkRowBtn = document.getElementById("add-bulk-row");
    const dateInput = document.getElementById("Date");
    const batchInput = document.getElementById("BatchId");
    const vendorSelect = document.getElementById("vendorSelect");
    const vendorInput = document.getElementById("vendorInput");
    const vendorCustomWrap = document.getElementById("vendorCustomWrap");
    const btnToggleCustom = document.getElementById("btnToggleCustomVendor");

    // Vendor prefix mapping passed from controller
    const vendorPrefixMap = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.VendorPrefixMap ?? new Dictionary<string, string>()));

    let rowCount = 1;
    let isBatchManuallyEdited = false;

    if (batchInput) {
        batchInput.addEventListener("input", function() {
            // If user types into batch ID, mark as manually edited unless emptied
            isBatchManuallyEdited = this.value.trim().length > 0;
        });
    }

    // Helper to calculate fallback prefix if not customized on vendor profile
    function generateFallbackPrefix(name) {
        if (!name || !name.trim()) return "VEN";
        const parts = name.trim().split(/[\s\-_\.\/]+/).filter(Boolean);
        if (parts.length === 0) return "VEN";
        if (parts.length >= 3) {
            // e.g. "a m transport" -> "AMT"
            return (parts[0][0] + parts[1][0] + parts[2][0]).toUpperCase();
        } else if (parts.length === 2) {
            const p1 = parts[0];
            const p2 = parts[1];
            // e.g. "rrl sufion" -> "RRL"
            if (p1.length === 3) return p1.toUpperCase();
            // e.g. "anil blackbuck" or "anil balckbuck" -> 'A' + 'BB' -> "ABB"
            if (p2.length >= 2) return (p1[0] + p2[0] + p2[1]).toUpperCase();
            return (p1[0] + p2[0] + 'X').toUpperCase();
        } else {
            // Single word e.g. "govesh" -> "GOV"
            const clean = parts[0].replace(/[^a-zA-Z0-9]/g, '');
            return (clean.length >= 3 ? clean.substring(0, 3) : clean.padEnd(3, 'X')).toUpperCase();
        }
    }

    function getVendorPrefix(vendorName) {
        if (!vendorName) return "VEN";
        const trimmed = vendorName.trim();
        if (vendorPrefixMap) {
            if (vendorPrefixMap[trimmed]) return vendorPrefixMap[trimmed].toUpperCase();
            const lower = trimmed.toLowerCase();
            for (const k in vendorPrefixMap) {
                if (k.toLowerCase() === lower && vendorPrefixMap[k]) {
                    return vendorPrefixMap[k].toUpperCase();
                }
            }
        }
        return generateFallbackPrefix(trimmed);
    }

    function formatDateDigits(dateVal) {
        if (!dateVal) return "";
        const str = dateVal.trim();
        // If yyyy-mm-dd
        if (str.includes('-')) {
            const parts = str.split('-');
            if (parts.length === 3) {
                if (parts[0].length === 4) {
                    // yyyy-mm-dd -> ddMMyyyy
                    return parts[2].padStart(2, '0') + parts[1].padStart(2, '0') + parts[0];
                } else if (parts[2].length === 4) {
                    // dd-mm-yyyy -> ddMMyyyy
                    return parts[0].padStart(2, '0') + parts[1].padStart(2, '0') + parts[2];
                }
            }
        }
        return str.replace(/\D/g, '');
    }

    function updateAutoBatchId() {
        if (!batchInput) return;
        const currentVendor = (vendorCustomWrap.style.display !== 'none' && vendorInput.value)
            ? vendorInput.value
            : (vendorSelect.value || vendorInput.value || "");

        const dateVal = dateInput ? dateInput.value : "";
        const prefix = getVendorPrefix(currentVendor);
        const dateDigits = formatDateDigits(dateVal);

        if (prefix && dateDigits) {
            batchInput.value = `${prefix} - ${dateDigits}`;
        } else if (prefix) {
            batchInput.value = `${prefix} - `;
        }
    }

    window.toggleCustomVendorInput = function() {
        if (vendorCustomWrap.style.display === 'none') {
            vendorCustomWrap.style.display = 'block';
            vendorSelect.value = '';
            btnToggleCustom.textContent = '← Choose from List';
            vendorInput.focus();
        } else {
            vendorCustomWrap.style.display = 'none';
            btnToggleCustom.textContent = '+ New Vendor';
        }
        updateAutoBatchId();
    };

    window.onVendorSelectChange = function(val) {
        if (val) {
            vendorInput.value = val;
            vendorCustomWrap.style.display = 'none';
            btnToggleCustom.textContent = '+ New Vendor';
        }
        updateAutoBatchId();
    };

    window.onVendorInputChange = function(val) {
        updateAutoBatchId();
    };

    if (dateInput) {
        dateInput.addEventListener("change", function() {
            if (!isBatchManuallyEdited) updateAutoBatchId();
        });
        dateInput.addEventListener("input", function() {
            if (!isBatchManuallyEdited) updateAutoBatchId();
        });
    }

    // Initialize auto batch id if empty on load
    if (batchInput && !batchInput.value) {
        updateAutoBatchId();
    }

    window.calculateRemaining = function() {
        const total = parseFloat(totalInput.value) || 0;
        let allocated = 0;
        document.querySelectorAll('.bulk-amount-input').forEach(input => {
            allocated += parseFloat(input.value) || 0;
        });
        
        const unallocated = total - allocated;
        const formatCurrency = (val) => new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR', minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(val);
        
        if(unallocatedInput) {
            unallocatedInput.value = formatCurrency(unallocated);
            unallocatedInput.style.color = unallocated < 0 ? "var(--danger)" : "var(--text)";
        }
        
        const traceAllocated = document.getElementById("trace-allocated");
        const traceUnallocated = document.getElementById("trace-unallocated");
        const traceTotal = document.getElementById("trace-total");
        
        if (traceAllocated) traceAllocated.textContent = formatCurrency(allocated);
        if (traceTotal) traceTotal.textContent = formatCurrency(total);
        if (traceUnallocated) {
            traceUnallocated.textContent = formatCurrency(unallocated);
            traceUnallocated.style.color = unallocated < 0 ? "var(--danger)" : (unallocated === 0 ? "var(--success)" : "var(--text)");
        }
    };

    function bindEvents(row) {
        row.querySelector('.bulk-amount-input').addEventListener("input", window.calculateRemaining);
        
        const actInput = row.querySelector('.bulk-activation-input');
        const expInput = row.querySelector('.bulk-expiry-input');
        actInput.addEventListener("change", function() {
            if (!actInput.value) { expInput.value = ''; return; }
            // Auto calculate expiry
            const date = new Date(actInput.value);
            date.setMonth(date.getMonth() + parseInt('@(ViewBag.ActivationExpiryMonths ?? "11")'));
            date.setDate(date.getDate() + parseInt('@(ViewBag.ActivationExpiryDays ?? "15")'));
            expInput.value = date.toISOString().split('T')[0];
        });
    }

    if(document.querySelector('.bulk-row')) bindEvents(document.querySelector('.bulk-row'));
    totalInput.addEventListener("input", window.calculateRemaining);

    const bulkSplitForm = document.getElementById("bulk-split-form");
    if (bulkSplitForm) {
        bulkSplitForm.addEventListener("submit", function() {
            if (vendorCustomWrap.style.display === 'none' && vendorSelect.value) {
                vendorInput.value = vendorSelect.value;
            }
        });
    }

    addBulkRowBtn.addEventListener("click", function() {
        const row = document.createElement("div");
        row.className = "bulk-row";
        row.style.display = "grid";
        row.style.gridTemplateColumns = "2fr 1.3fr 1.6fr 1.6fr 40px";
        row.style.gap = "10px";
        row.style.alignItems = "center";
        
        row.innerHTML = `
            <input name="BulkAllocations[${rowCount}].VehicleNo" type="text" class="input bulk-vehicle-input" placeholder="e.g. KA34C8377" required />
            <input name="BulkAllocations[${rowCount}].Amount" type="number" step="0.01" class="input bulk-amount-input" placeholder="Amount" required />
            <input name="BulkAllocations[${rowCount}].ActivationDate" type="date" class="input bulk-activation-input" title="Activation Date" />
            <input name="BulkAllocations[${rowCount}].NewExpiryDate" type="date" class="input bulk-expiry-input" title="Expiry Date" style="background: var(--line);" readonly tabindex="-1" />
            <button type="button" class="deleteButton" style="width: 32px; height: 32px; justify-self: center;" onclick="if(document.querySelectorAll('.bulk-row').length > 1) { this.closest('.bulk-row').remove(); window.calculateRemaining(); }">
              <svg viewBox="0 0 448 512" class="bin"><path d="M135.2 17.7L128 32H32C14.3 32 0 46.3 0 64S14.3 96 32 96H416c17.7 0 32-14.3 32-32s-14.3-32-32-32H320l-7.2-14.3C307.4 6.8 296.3 0 284.2 0H163.8c-12.1 0-23.2 6.8-28.6 17.7zM416 128H32L53.2 467c1.6 25.3 22.6 45 47.9 45H346.9c25.3 0 46.3-19.7 47.9-45L416 128z"></path></svg>
            </button>
        `;
        bulkRowsContainer.appendChild(row);
        bindEvents(row);
        rowCount++;
    });
});
</script>
