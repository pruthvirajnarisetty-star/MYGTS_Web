@model TransactionFilterViewModel
@{
    ViewData["Title"] = "Transactions";
    string SortDir(string col) => Model.SortColumn == col && Model.SortDirection == "asc" ? "desc" : "asc";
    string SortIcon(string col) => Model.SortColumn == col ? (Model.SortDirection == "desc" ? " ↓" : " ↑") : " ↑↓";
    var currentBranch = Context.Request.Cookies["mygts_branch"] == "RTO" ? "RTO" : "DMG";
}

<style>
    .content-area { max-width: none !important; padding-left: 20px !important; padding-right: 20px !important; }
</style>

<div class="page-heading">
    <div>
        <div class="eyebrow">Financial operations / ledger</div>
        <h1>Transactions</h1>
        <p>Record device payments, recharges, expiry changes, and vendor movement with source-level clarity.</p>
    </div>
    
    <div class="page-heading-actions">
        <a class="button secondary" asp-action="DownloadSample" asp-route-branch="@currentBranch" title="Download sample transactions Excel template (.xlsx)">📥 Sample sheet</a>
        @if (User.CanEditModule("Transactions"))
        {
            <a class="button secondary" asp-action="Import" data-testid="transactions-import">↑ Import transactions</a>
            <a class="button secondary" asp-action="ExportAll" asp-route-Query="@Model.Query" asp-route-PaymentMode="@Model.PaymentMode" asp-route-FilterVendor="@Model.FilterVendor" asp-route-PaymentFor="@Model.PaymentFor" asp-route-SortColumn="@Model.SortColumn" asp-route-SortDirection="@Model.SortDirection" data-testid="transactions-export">↓ Export transactions</a>
            <a class="button secondary" asp-action="BulkSplit" data-testid="bulk-split-link">Bulk split</a>
            <a class="button btn-primary" asp-action="Create" data-testid="transaction-add">+ Add transaction</a>
        }
        else
        {
            <a class="button secondary" asp-action="ExportAll" asp-route-Query="@Model.Query" asp-route-PaymentMode="@Model.PaymentMode" asp-route-FilterVendor="@Model.FilterVendor" asp-route-PaymentFor="@Model.PaymentFor" asp-route-SortColumn="@Model.SortColumn" asp-route-SortDirection="@Model.SortDirection" data-testid="transactions-export">↓ Export transactions</a>
        }
    </div>
</div>

<form class="card toolbar" method="get" asp-action="Index">
    <div class="filter-grid" style="align-items: flex-end;">
        <div class="field grow">
            <label for="QueryInput" class="form-label" style="margin-bottom: 4px; display: block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-main);">SEARCH</label>
            <div style="position: relative; width: 100%;">
                <button type="button" style="position: absolute; top: 50%; transform: translateY(-50%); left: 16px; padding: 0; background: transparent; border: none; display: flex; align-items: center; justify-content: center;">
                    <svg width="17" height="16" fill="none" xmlns="http://www.w3.org/2000/svg" style="width: 20px; height: 20px; color: #4b5563;">
                        <path d="M7.667 12.667A5.333 5.333 0 107.667 2a5.333 5.333 0 000 10.667zM14.334 14l-2.9-2.9" stroke="currentColor" stroke-width="1.333" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                </button>
                <input type="hidden" asp-for="Query" id="Query" />
                <input type="hidden" asp-for="SortColumn" />
                <input type="hidden" asp-for="SortDirection" />
                <input id="QueryInput" name="QueryInput" class="input shadow-md w-full" style="padding: 0 44px; border-radius: 9999px; height: 42px; width: 100%; border: 1px solid var(--line); outline: none; transition: all 0.3s; font-size: 14px;" placeholder="Add a filter..." type="text" onfocus="this.style.borderColor='#3b82f6'" onblur="this.style.borderColor='var(--line)'" />
                <button type="button" onclick="document.getElementById('QueryInput').value=''; document.getElementById('Query').value=''; this.closest('form').submit();" style="position: absolute; top: 50%; transform: translateY(-50%); right: 12px; padding: 0; background: transparent; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center;">
                    <svg xmlns="http://www.w3.org/2000/svg" style="width: 20px; height: 20px; color: #4b5563;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>
        </div>
        
        <div class="field">
            <label asp-for="PaymentMode" class="form-label">Payment mode</label>
            <select asp-for="PaymentMode" class="select">
                <option value="">All modes</option>
                @foreach (var option in Model.PaymentModeOptions)
                {
                    <option value="@option">@option</option>
                }
            </select>
        </div>
        
        <div class="field">
            <label asp-for="PaymentFor" class="form-label">Payment for</label>
            <select asp-for="PaymentFor" class="select">
                <option value="">All types</option>
                @foreach (var option in Model.PaymentForOptions)
                {
                    <option value="@option">@option</option>
                }
            </select>
        </div>
        
        <div class="field">
            <label asp-for="FilterVendor" class="form-label">Vendor</label>
            <select asp-for="FilterVendor" asp-items="Model.VendorOptions" class="select">
                <option value="">All vendors</option>
            </select>
        </div>

        <div class="field">
            <label class="form-label" asp-for="PageSize">Rows per page</label>
            <select class="select" asp-for="PageSize" onchange="this.form.requestSubmit ? this.form.requestSubmit() : this.form.submit()">
                <option value="10">10</option>
                <option value="20">20</option>
                <option value="50">50</option>
                <option value="100">100</option>
                <option value="1000000">All</option>
            </select>
        </div>

        <div class="field">
            <button class="button btn-primary" type="submit" style="height: 42px; border-radius: 8px; padding: 0 24px;">Apply filters</button>
        </div>
    </div>
    @{
        var queryTerms = string.IsNullOrWhiteSpace(Model.Query) ? Array.Empty<string>() : Model.Query.Trim().Split('|', StringSplitOptions.RemoveEmptyEntries);
    }
    @if (queryTerms.Length > 0)
    {
        <div class="flex flex-wrap gap-2 mt-4" style="padding-bottom: 8px; width: 100%;">
            @foreach (var term in queryTerms)
            {
                <span class="inline-flex items-center gap-1 px-3 py-1 text-sm bg-white border border-dashed border-gray-400 rounded-full text-gray-700">
                    @term
                    <button type="button" onclick="removeChip('@term')" class="text-gray-400 hover:text-gray-700">
                        <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </button>
                </span>
            }
        </div>
    }
</form>

<script>
    document.querySelector('form.toolbar').addEventListener('submit', function(e) {
        var queryInput = document.getElementById('QueryInput');
        var queryHidden = document.getElementById('Query');
        if (queryInput && queryInput.value.trim() !== '') {
            var current = queryHidden.value ? queryHidden.value + '|' : '';
            queryHidden.value = current + queryInput.value.trim();
            queryInput.value = ''; // Don't submit the visual input
        }
    });

    function removeChip(term) {
        var queryHidden = document.getElementById('Query');
        var terms = queryHidden.value.split('|').filter(t => t !== '' && t !== term);
        queryHidden.value = terms.join('|');
        document.querySelector('form.toolbar').submit();
    }
</script>

<div style="display: flex; gap: 32px; background: var(--surface); border: 1px solid var(--line); border-radius: 8px; padding: 16px 24px; margin-bottom: 14px; align-items: center;">
    <div style="flex: 1;">
        <div style="font-size: 0.75rem; font-weight: 600; color: var(--cyan); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 6px;">Filtered Amount</div>
        <div style="font-size: 1.75rem; font-weight: 500; color: var(--fg); margin-bottom: 4px;">@Model.TotalFilteredAmount.ToString("C")</div>
        <div style="font-size: 0.85rem; color: var(--muted);">@Model.TotalItems.ToString("N0") records in view</div>
    </div>
    
    <div style="width: 1px; height: 60px; background: var(--line);"></div>
    
    <div style="flex: 1;">
        <div style="font-size: 0.75rem; font-weight: 600; color: var(--green); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 6px;">Filtered Profit</div>
        <div style="font-size: 1.75rem; font-weight: 500; color: var(--fg); margin-bottom: 4px;">@Model.TotalFilteredProfit.ToString("C")</div>
        <div style="font-size: 0.85rem; color: var(--muted);">Total net margin across filtered records</div>
    </div>
</div>

<section class="card" style="width: 100%; overflow: hidden;">
    <div class="table-wrap" style="width: 100%; overflow-x: auto; min-height: 400px;">
        <table class="data-table" style="width: 100%; min-width: 1800px;">
            <thead>
                <tr>
                    <th style="width: 50px; min-width: 50px;"></th>
                    <th style="width: 70px; min-width: 70px;"><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-PaymentMode="@Model.PaymentMode" asp-route-FilterVendor="@Model.FilterVendor" asp-route-PaymentFor="@Model.PaymentFor" asp-route-SortColumn="slno" asp-route-SortDirection="@SortDir("slno")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">S.No. @SortIcon("slno")</a></th>
                    <th><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-PaymentMode="@Model.PaymentMode" asp-route-FilterVendor="@Model.FilterVendor" asp-route-PaymentFor="@Model.PaymentFor" asp-route-SortColumn="vehicle" asp-route-SortDirection="@SortDir("vehicle")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">Vehicle No @SortIcon("vehicle")</a></th>
                    <th><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-PaymentMode="@Model.PaymentMode" asp-route-FilterVendor="@Model.FilterVendor" asp-route-PaymentFor="@Model.PaymentFor" asp-route-SortColumn="date" asp-route-SortDirection="@SortDir("date")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">Date @SortIcon("date")</a></th>
                    <th><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-PaymentMode="@Model.PaymentMode" asp-route-FilterVendor="@Model.FilterVendor" asp-route-PaymentFor="@Model.PaymentFor" asp-route-SortColumn="vendor" asp-route-SortDirection="@SortDir("vendor")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">Vendor @SortIcon("vendor")</a></th>
                    <th><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-PaymentMode="@Model.PaymentMode" asp-route-FilterVendor="@Model.FilterVendor" asp-route-PaymentFor="@Model.PaymentFor" asp-route-SortColumn="mode" asp-route-SortDirection="@SortDir("mode")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">Payment Mode @SortIcon("mode")</a></th>
                    <th><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-PaymentMode="@Model.PaymentMode" asp-route-FilterVendor="@Model.FilterVendor" asp-route-PaymentFor="@Model.PaymentFor" asp-route-SortColumn="payment" asp-route-SortDirection="@SortDir("payment")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">Payment For @SortIcon("payment")</a></th>
                    <th class="numeric"><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-PaymentMode="@Model.PaymentMode" asp-route-FilterVendor="@Model.FilterVendor" asp-route-PaymentFor="@Model.PaymentFor" asp-route-SortColumn="amount" asp-route-SortDirection="@SortDir("amount")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">Amount @SortIcon("amount")</a></th>
                    <th>UTR / Transaction ID</th>
                    <th>Paid To</th>
                    @if (currentBranch != "RTO")
                    {
                        <th>Extras</th>
                    }
                    <th>Activation Date</th>
                    <th>New Expiry Date</th>
                    <th class="numeric"><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-PaymentMode="@Model.PaymentMode" asp-route-FilterVendor="@Model.FilterVendor" asp-route-PaymentFor="@Model.PaymentFor" asp-route-SortColumn="profit" asp-route-SortDirection="@SortDir("profit")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">Profits @SortIcon("profit")</a></th>
                    <th><a style="color:inherit; text-decoration:none;" asp-action="Index" asp-route-Query="@Model.Query" asp-route-PaymentMode="@Model.PaymentMode" asp-route-FilterVendor="@Model.FilterVendor" asp-route-PaymentFor="@Model.PaymentFor" asp-route-SortColumn="batch" asp-route-SortDirection="@SortDir("batch")" asp-route-PageSize="@Model.PageSize" asp-route-Page="1">Batch ID @SortIcon("batch")</a></th>
                    <th>Notes</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Transactions.Count == 0)
                {
                    <tr>
                        <td colspan="@(currentBranch == "RTO" ? 15 : 16)">
                            <div class="empty-state">No transactions match this filter set.</div>
                        </td>
                    </tr>
                }
                else
                {
                    var sno = (Model.Page - 1) * Model.PageSize + 1;
                    @foreach (var item in Model.Transactions)
                    {
                        <tr>
                            <td style="overflow: visible;">
                                @if (User.CanEditModule("Transactions"))
                                {
                                    <label class="popup">
                                          <input type="checkbox">
                                          <div class="burger" tabindex="0">
                                            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                                              <path d="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/>
                                            </svg>
                                          </div>
                                          <nav class="popup-window">
                                            <legend>Actions</legend>
                                            <ul>
                                              <li>
                                                <a asp-action="Edit" asp-route-id="@item.Id" style="display: flex; align-items: center; justify-content: flex-start; gap: var(--nav-button-distance); padding: var(--nav-button-padding-y) var(--nav-button-padding-x); text-decoration: none; color: inherit;">
                                                  <svg stroke-linejoin="round" stroke-linecap="round" stroke-width="2" stroke="currentColor" fill="none" viewBox="0 0 24 24" height="14" width="14" xmlns="http://www.w3.org/2000/svg">
                                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                                  </svg>
                                                  <span>Edit</span>
                                                </a>
                                              </li>
                                              <li>
                                                <form asp-action="Delete" method="post" style="margin: 0; width: 100%;">
                                                  <input type="hidden" name="id" value="@item.Id" />
                                                  <button type="submit" onclick="return confirm('Delete this transaction?')" style="width: 100%; display: flex; align-items: center; justify-content: flex-start; gap: var(--nav-button-distance); padding: var(--nav-button-padding-y) var(--nav-button-padding-x); background: transparent; border: none; color: var(--danger); font-family: var(--nav-font-family); font-size: var(--nav-button-font-size); border-radius: var(--nav-button-border-radius); cursor: pointer; text-decoration: none; transition: var(--burger-transition);">
                                                    <svg stroke-linejoin="round" stroke-linecap="round" stroke-width="2" stroke="currentColor" fill="none" viewBox="0 0 24 24" height="14" width="14" xmlns="http://www.w3.org/2000/svg">
                                                      <line x1="18" y1="6" x2="6" y2="18"></line>
                                                      <line x1="6" y1="6" x2="18" y2="18"></line>
                                                    </svg>
                                                    <span>Delete</span>
                                                  </button>
                                                </form>
                                              </li>
                                            </ul>
                                          </nav>
                                        </label>
                                }
                            </td>
                            <td style="color: var(--muted); font-size: 0.75rem; min-width: 70px;">@(sno++)</td>
                            <td style="white-space: nowrap;"><strong>@(string.IsNullOrWhiteSpace(item.VehicleNo) ? "—" : item.VehicleNo)</strong></td>
                            <td style="white-space: nowrap;">@(string.IsNullOrWhiteSpace(item.Date) ? "—" : DateValue.Short(item.Date))</td>
                            <td style="white-space: nowrap;">@(string.IsNullOrWhiteSpace(item.Vendor) ? "—" : item.Vendor)</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.PaymentMode))
                                {
                                    <span class="badge neutral">@item.PaymentMode</span>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                            <td style="white-space: nowrap;">@(string.IsNullOrWhiteSpace(item.PaymentFor) ? "—" : item.PaymentFor)</td>
                            <td class="numeric"><strong>@(item.Amount.HasValue ? item.Amount.Value.ToString("C") : "—")</strong></td>
                            <td style="white-space: nowrap;"><div class="muted">@(string.IsNullOrWhiteSpace(item.Utr) ? "—" : item.Utr)</div></td>
                            <td style="white-space: nowrap;">@(string.IsNullOrWhiteSpace(item.PaidTo) ? "—" : item.PaidTo)</td>
                            @if (currentBranch != "RTO")
                            {
                                <td style="white-space: nowrap;">
                                    @if(!string.IsNullOrWhiteSpace(item.Extras)) {
                                        <span class="badge neutral" style="background: rgba(14, 116, 144, 0.1);">@item.Extras</span>
                                    }
                                </td>
                            }
                            <td style="white-space: nowrap;">@(string.IsNullOrWhiteSpace(item.ActivationDate) ? "—" : DateValue.Short(item.ActivationDate))</td>
                            <td style="white-space: nowrap;">@(string.IsNullOrWhiteSpace(item.NewExpiryDate) ? "—" : DateValue.Short(item.NewExpiryDate))</td>
                            <td class="numeric" style="color: var(--success);">@(item.Profit.HasValue ? item.Profit.Value.ToString("C") : "—")</td>
                            <td style="white-space: nowrap;">
                                @if (!string.IsNullOrWhiteSpace(item.BatchId) && item.BatchId != "-")
                                {
                                    <span class="badge neutral" style="background: rgba(37, 99, 235, 0.08); color: var(--primary); font-size: 0.75rem; border: 1px solid rgba(37, 99, 235, 0.2);">@item.BatchId</span>
                                }
                                else
                                {
                                    <span class="muted">—</span>
                                }
                            </td>
                            <td style="max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@item.Notes">@item.Notes</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    
    @if (Model.TotalItems > 0)
    {
        <div style="padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; border-top: 1px solid rgba(0,0,0,0.05);">
            <div style="font-size: 0.9rem; color: var(--muted);">
                Showing @((Model.Page - 1) * Model.PageSize + 1) to @Math.Min(Model.Page * Model.PageSize, Model.TotalItems) of @Model.TotalItems entries
            </div>
        <div style="display: flex; gap: 4px; align-items: center;">
            @{
                var startPage = Math.Max(1, Model.Page - 2);
                var endPage = Math.Min(Model.TotalPages, Model.Page + 2);
                
                if (startPage > 1) {
                    <a class="button secondary" asp-action="Index" asp-route-Query="@Model.Query" asp-route-PaymentMode="@Model.PaymentMode" asp-route-FilterVendor="@Model.FilterVendor" asp-route-PaymentFor="@Model.PaymentFor" asp-route-SortColumn="@Model.SortColumn" asp-route-SortDirection="@Model.SortDirection" asp-route-PageSize="@Model.PageSize" asp-route-Page="1" style="padding: 4px 10px; min-width: auto; height: 32px; font-size: 13px;">1</a>
                    if (startPage > 2) {
                        <span style="padding: 4px 8px; color: var(--muted);">...</span>
                    }
                }
                
                for (int i = startPage; i <= endPage; i++)
                {
                    if (i == Model.Page) {
                        <button class="button primary" disabled style="padding: 4px 10px; min-width: auto; height: 32px; font-size: 13px;">@i</button>
                    } else {
                        <a class="button secondary" asp-action="Index" asp-route-Query="@Model.Query" asp-route-PaymentMode="@Model.PaymentMode" asp-route-FilterVendor="@Model.FilterVendor" asp-route-PaymentFor="@Model.PaymentFor" asp-route-SortColumn="@Model.SortColumn" asp-route-SortDirection="@Model.SortDirection" asp-route-PageSize="@Model.PageSize" asp-route-Page="@i" style="padding: 4px 10px; min-width: auto; height: 32px; font-size: 13px;">@i</a>
                    }
                }
                
                if (endPage < Model.TotalPages) {
                    if (endPage < Model.TotalPages - 1) {
                        <span style="padding: 4px 8px; color: var(--muted);">...</span>
                    }
                    <a class="button secondary" asp-action="Index" asp-route-Query="@Model.Query" asp-route-PaymentMode="@Model.PaymentMode" asp-route-FilterVendor="@Model.FilterVendor" asp-route-PaymentFor="@Model.PaymentFor" asp-route-SortColumn="@Model.SortColumn" asp-route-SortDirection="@Model.SortDirection" asp-route-PageSize="@Model.PageSize" asp-route-Page="@Model.TotalPages" style="padding: 4px 10px; min-width: auto; height: 32px; font-size: 13px;">@Model.TotalPages</a>
                }
            }
        </div>
        </div>
    }
</section>

<style>
/* Freeze table header */
.data-table th {
    position: sticky;
    top: 0;
    z-index: 10;
    background: #f8fafc;
    box-shadow: 0 1px 2px rgba(0,0,0,0.05);
}

/* Freeze 1st column (Action Menu) */
.data-table th:nth-child(1),
.data-table td:nth-child(1) {
    position: sticky;
    left: 0;
    width: 50px;
    min-width: 50px;
    max-width: 50px;
    z-index: 5;
    background-color: #ffffff !important;
    border-right: 1px solid rgba(0,0,0,0.08);
}

/* Elevate z-index when popup is open so it overlaps rows below and right */
.data-table td:nth-child(1):has(.popup input:checked),
.data-table td:nth-child(1):focus-within,
.data-table td:nth-child(1):hover {
    z-index: 35 !important;
}

/* Freeze 2nd column (SLNo) */
.data-table th:nth-child(2),
.data-table td:nth-child(2) {
    position: sticky;
    left: 50px;
    width: 70px;
    min-width: 70px;
    max-width: 70px;
    z-index: 5;
    background-color: #ffffff !important;
    border-right: 1px solid rgba(0,0,0,0.08);
}

/* Freeze 3rd column (Date) */
.data-table th:nth-child(3),
.data-table td:nth-child(3) {
    position: sticky;
    left: 120px;
    width: 140px;
    min-width: 140px;
    max-width: 140px;
    z-index: 5;
    background-color: #ffffff !important;
    border-right: 2px solid #cbd5e1 !important;
    box-shadow: 4px 0 8px -2px rgba(0, 0, 0, 0.12) !important;
}

/* Ensure frozen headers stay above frozen columns */
.data-table th:nth-child(1),
.data-table th:nth-child(2),
.data-table th:nth-child(3) {
    z-index: 25 !important;
    background-color: #f1f5f9 !important;
}

/* Dark mode support - 100% OPAQUE backgrounds so NO scrolling content bleeds through */
body:has(#theme:checked) .data-table th,
body:has(#theme:checked) .data-table th:nth-child(1),
body:has(#theme:checked) .data-table th:nth-child(2),
body:has(#theme:checked) .data-table th:nth-child(3) {
    background-color: #0b0f19 !important;
    color: #38bdf8 !important;
    border-color: #1e293b !important;
}
body:has(#theme:checked) .data-table th:nth-child(3) {
    border-right: 2px solid #334155 !important;
    box-shadow: 5px 0 10px -2px rgba(0, 0, 0, 0.6) !important;
}

body:has(#theme:checked) .data-table td:nth-child(1),
body:has(#theme:checked) .data-table td:nth-child(2),
