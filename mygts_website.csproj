<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <UseAppHost>false</UseAppHost>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>MygtsMvc</RootNamespace>
    <AssemblyName>MygtsMvc</AssemblyName>
    <DefaultItemExcludes>$(DefaultItemExcludes);publish/**;Data/backups/**;wwwroot/reports/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="wwwroot\reports\**" />
    <None Remove="wwwroot\reports\**" />
    <Compile Remove="publish\**" />
    <Content Remove="publish\**" />
    <EmbeddedResource Remove="publish\**" />
    <None Remove="publish\**" />
    <Content Update="Data\**\*" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" Watch="false" />
    
    <!-- ========================================================================================= -->
    <!-- [TITLE: PREVENT DATABASE OVERWRITE ON PUBLISH]                                             -->
    <!-- Previous code copied the static project database to publish output on every publish,      -->
    <!-- which was overriding live production data:                                                -->
    <!-- <Content Include="Data/mygts_database.db" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" /> -->
    <!--                                                                                           -->
    <!-- Current rules: live database files are never packaged or overwritten on publish or build: -->
    <!-- ========================================================================================= -->
    <Content Update="Data\**\*.db*" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" Watch="false" />
    <Content Remove="Data\**\*.db*" />
    <None Remove="Data\**\*.db*" />

    <!-- ========================================================================================= -->
    <!-- [TITLE: PREVENT DOTNET WATCH RESTART LOOPS]                                                -->
    <!-- Exclude database files, automated backups, logs, and reports from triggering watch restart: -->
    <!-- ========================================================================================= -->
    <Watch Remove="Data\**\*" />
    <Watch Remove="publish\**\*" />
    <Watch Remove="logs\**\*" />
    <Watch Remove="wwwroot\reports\**\*" />
    <Watch Remove="**\*.db*" />
    <Watch Remove="**\*.log" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
